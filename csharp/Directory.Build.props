<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.3</Version>
    <Authors>deterministic-code</Authors>
    <Company>deterministic-code</Company>
    <Description>Data-access and object-relational mapper with generated repositories.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/deterministic-code/datasources</PackageProjectUrl>
    <RepositoryUrl>https://github.com/deterministic-code/datasources</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/</PackageOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="
    '$(MSBuildProjectName)' == 'Datasources' or
    '$(MSBuildProjectName)' == 'Datasources.Json' or
    '$(MSBuildProjectName)' == 'Datasources.Memory' or
    '$(MSBuildProjectName)' == 'Datasources.Sqlite' or
    '$(MSBuildProjectName)' == 'Datasources.Xml' or
    '$(MSBuildProjectName)' == 'Datasources.Yaml' or
    '$(MSBuildProjectName)' == 'Datasources.Mysql' or
    '$(MSBuildProjectName)' == 'Datasources.SqlServer' or
    '$(MSBuildProjectName)' == 'Datasources.Postgres' or
    '$(MSBuildProjectName)' == 'Datasources.Oracle' or
    '$(MSBuildProjectName)' == 'Datasources.MongoDb' or
    '$(MSBuildProjectName)' == 'Datasources.DynamoDb'
  ">
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) AND $(MSBuildProjectDirectory.Contains('Providers'))">
    <Compile Include="$(MSBuildThisFileDirectory)Providers\RegisterCreateTests.cs" Link="RegisterCreateTests.cs" />
  </ItemGroup>
</Project>

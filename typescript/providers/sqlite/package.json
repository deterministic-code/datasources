{
  "name": "@deterministic-code/datasources-sqlite",
  "version": "0.1.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../rewrite-declaration-extensions.mjs dist",
    "prepack": "npm run build",
    "test": "vitest run --coverage --exclude tests/**/*.repository.integration.test.ts",
    "test:integration": "vitest run tests/*.repository.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deterministic-code/datasources": "*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@deterministic-code/datasources-code-generators": "*",
    "@deterministic-code/deterministic-generators-common": "github:deterministic-code/deterministic-generators-common#main",
    "@deterministic-code/generators-common": "github:deterministic-code/generators-common#main",
    "yaml": "^2.8.0"
  }
}

{
  "name": "@datasources/sqlite",
  "version": "0.1.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../rewrite-declaration-extensions.mjs dist",
    "prepack": "npm run build",
    "test": "vitest run --coverage --exclude tests/**/*.repository.integration.test.ts",
    "test:e2e": "vitest run tests/*.repository.integration.test.ts",
    "test:e2e:ci": "vitest run tests/*.repository.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@datasources/core": "*",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.10.0"
  },
  "devDependencies": {
    "yaml": "^2.8.0"
  }
}

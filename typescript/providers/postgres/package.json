{
  "name": "@deterministic-code/datasources-postgres",
  "version": "0.1.2",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../rewrite-declaration-extensions.mjs dist",
    "prepack": "npm run build",
    "test": "vitest run --coverage --exclude tests/**/*.integration.test.ts",
    "test:e2e": "vitest run tests/postgres.integration.test.ts tests/*.repository.integration.test.ts --fileParallelism=false --testTimeout=30000",
    "test:e2e:ci": "SKIP_DOCKER=1 vitest run tests/postgres.integration.test.ts tests/*.repository.integration.test.ts --fileParallelism=false --testTimeout=30000",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deterministic-code/datasources": "*",
    "@types/pg": "^8.15.5",
    "pg": "^8.16.0",
    "pg-query-stream": "^4.17.0"
  },
  "devDependencies": {
    "@deterministic-code/datasources-code-generators": "*",
    "@deterministic-code/deterministic-generators-common": "github:deterministic-code/deterministic-generators-common#main",
    "@deterministic-code/generators-common": "github:deterministic-code/generators-common#main",
    "yaml": "^2.8.0"
  }
}

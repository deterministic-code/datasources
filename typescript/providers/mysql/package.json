{
  "name": "@deterministic-code/datasources-mysql",
  "version": "0.1.2",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../rewrite-declaration-extensions.mjs dist",
    "prepack": "npm run build",
    "test": "vitest run --coverage --exclude tests/**/*.integration.test.ts",
    "test:e2e": "vitest run tests/mysql.integration.test.ts tests/mysql.repository.integration.test.ts",
    "test:e2e:ci": "SKIP_DOCKER=1 vitest run tests/mysql.integration.test.ts tests/mysql.repository.integration.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deterministic-code/datasources": "*",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "yaml": "^2.8.0"
  }
}

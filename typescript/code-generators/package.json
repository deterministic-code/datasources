{
  "name": "@deterministic-code/datasources-code-generators",
  "version": "0.1.2",
  "type": "module",
  "exports": {
    ".": "./src/generateSql.ts",
    "./generate-sql": "./src/generate-sql.ts",
    "./sql/generate-sql": "./src/sql/generate-sql.ts",
    "./generate-stored-procedures": "./src/generate-stored-procedures.ts",
    "./sql/generate-stored-procedures": "./src/sql/generate-stored-procedures.ts",
    "./common/sql-dialect": "./src/sql/common/sql-dialect.ts",
    "./sql/common/write-inclusion": "./src/sql/common/write-inclusion.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../rewrite-declaration-extensions.mjs dist && rm -rf dist/sql/templates && cp -R src/sql/templates dist/sql/templates",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deterministic-code/datasources": "*",
    "@deterministic-code/deterministic-generators-common": "github:deterministic-code/deterministic-generators-common#main",
    "@deterministic-code/generators-common": "github:deterministic-code/generators-common#main",
    "pluralize": "^8.0.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pluralize": "^0.0.33",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}

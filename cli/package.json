{
  "name": "@datasources/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "datasources": "./bin/datasources.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "cli": "node --experimental-strip-types src/main.ts",
    "setup": "node --experimental-strip-types src/main.ts setup",
    "test": "node scripts/build-generators.mjs && vitest run --coverage",
    "typecheck": "node scripts/build-generators.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@deterministic-code/csharp-generators": "github:deterministic-code/generators-csharp#main",
    "@deterministic-code/deterministic-specifications-typescript": "github:deterministic-code/deterministic-specifications-typescript#main",
    "@deterministic-code/generators-common": "github:deterministic-code/generators-common#main",
    "@deterministic-code/generators-sql": "github:deterministic-code/generators-sql#main",
    "@deterministic-code/rust-generators": "github:deterministic-code/generators-rust#main",
    "@deterministic-code/typescript-generators": "github:deterministic-code/generators-typescript#main",
    "@inquirer/prompts": "^7.8.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^3.1.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}

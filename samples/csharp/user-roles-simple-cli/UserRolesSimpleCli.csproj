<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UserRolesSimpleCli</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="*Tests.cs" />
    <Compile Remove="CliE2ETests.cs" />
    <Compile Remove="matrix/**" />
    <Compile Include="..\..\..\csharp\Providers\SchemaSpec.cs" Link="SchemaSpec.cs" />
    <EmbeddedResource Include="..\..\user-roles-simple-cli-shared\mysql-procedures.sql" Link="mysql-procedures.sql">
      <LogicalName>mysql-procedures.sql</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\csharp\Datasources\Datasources.csproj" />
    <ProjectReference Include="..\..\..\csharp\Providers\Sqlite\Datasources.Sqlite.csproj" />
    <ProjectReference Include="..\..\..\csharp\Providers\Sqlite.Microsoft\Datasources.Sqlite.Microsoft.csproj" />
    <ProjectReference Include="..\..\..\csharp\Providers\Mysql\Datasources.Mysql.csproj" />
    <ProjectReference Include="..\..\..\csharp\Providers\Postgres\Datasources.Postgres.csproj" />
  </ItemGroup>
</Project>

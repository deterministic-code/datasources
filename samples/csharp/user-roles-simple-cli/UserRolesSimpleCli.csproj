<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UserRolesSimpleCli</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="*Tests.cs" />
    <Compile Remove="matrix/**" />
    <Compile Remove="perf/**" />
    <EmbeddedResource Include="mysql-procedures.sql">
      <LogicalName>mysql-procedures.sql</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Datasources" Version="0.1.22" />
    <PackageReference Include="Datasources.Mysql" Version="0.1.22" />
    <PackageReference Include="Datasources.Postgres" Version="0.1.22" />
    <PackageReference Include="Datasources.Sqlite" Version="0.1.22" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
</Project>

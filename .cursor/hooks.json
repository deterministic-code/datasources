{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": ".cursor/hooks/lock-interface.py",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/lock-interface.py",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/sync-examples.mjs"
      }
    ],
    "afterTabFileEdit": [
      {
        "command": ".cursor/hooks/sync-examples.mjs"
      }
    ]
  }
}

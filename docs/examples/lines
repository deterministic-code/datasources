{"file":"docs/examples/create-parents-and-children/enriched.bulk_create_writes_parents_and_children.rust","test":"rust/datasources/tests/enriched.rs#bulk_create_writes_parents_and_children","from":1088,"to":1126,"raw":"#[tokio::test]\nasync fn bulk_create_writes_parents_and_children() {\n    let connection = setup(&mut []).await;\n    let mut options = CRUDRepositoryOptions::default();\n    options.entity = \"Parent\".into();\n    let mut parents = BulkCRUDRepository::new(connection.clone(), options).unwrap();\n    let mut child_options = CRUDRepositoryOptions::default();\n    child_options.entity = \"Child\".into();\n    let children = Arc::new(BulkCRUDRepository::new(connection, child_options).unwrap());\n    parents.add_enriched(\n        Enrichment::new(\"children\", \"id\", \"parent_id\", None, datasources::EnrichmentPropertyType::List),\n        children.clone(),\n        None,\n    );\n    let ids = parents\n        .create_bulk(&mut [\n            record(&[(\n                \"children\",\n                encode_rows(&[record(&[(\"label\", Value::from(\"a\"))])]),\n            )]),\n            record(&[(\n                \"children\",\n                encode_rows(&[\n                    record(&[(\"label\", Value::from(\"b\"))]),\n                    record(&[(\"label\", Value::from(\"c\"))]),\n                ]),\n            )]),\n        ])\n        .await\n        .unwrap();\n    let stored_parents = parents.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n    assert_eq!(stored_parents.len(), 2);\n    assert_eq!(children.read(None, None, None).try_collect::<Vec<_>>().await.unwrap().len(), 3);\n    let mut created_ids: Vec<_> = ids.iter().map(|row| num(row, \"id\")).collect();\n    let mut stored_ids: Vec<_> = stored_parents.iter().map(|row| num(row, \"id\")).collect();\n    created_ids.sort();\n    stored_ids.sort();\n    assert_eq!(created_ids, stored_ids);\n}"}

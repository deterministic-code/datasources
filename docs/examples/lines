{"file":"docs/examples/roll-back-a-bulk-update/BulkCRUDRepository.test.rolls-back-a-bulk-update-when-usetransaction-is-on.typescript","test":"typescript/datasources/src/BulkCRUDRepository.test.ts#rolls-back-a-bulk-update-when-usetransaction-is-on","from":104,"to":127,"raw":"  it(\"rolls back a bulk update when useTransaction is on\", async () => {\n    const parentsRepo = new BulkCRUDRepository<Parent>(await setup(), {\n      type: Parent,\n      write: new DefaultWriteEnrichmentStrategy(undefined, undefined, undefined, true),\n    });\n    const first = await parentsRepo.create(Object.assign(new Parent(), { label: \"a\" }));\n    expect(first.id).toBeGreaterThan(0);\n    const second = await parentsRepo.create(Object.assign(new Parent(), { label: \"b\" }));\n    expect(second.id).toBeGreaterThan(0);\n    let seen = 0;\n    parentsRepo.addMiddleware({\n      beforeCommand() {\n        seen += 1;\n        if (seen === 2) throw new DatasourceError(\"stop\");\n      },\n      afterCommand() {},\n    });\n    await expect(parentsRepo.updateBulk([\n      Object.assign(new Parent(), { id: first.id, label: \"changed\" }),\n      Object.assign(new Parent(), { id: first.id, label: \"later\" }),\n    ])).rejects.toThrow(/stop/);\n    const stored = await collectAsync(parentsRepo.read());\n    expect(stored.find((parent) => parent.id === first.id)?.label).toBe(\"a\");\n  });"}
{"file":"docs/examples/roll-back-a-bulk-update/BulkCRUDRepositoryTests.BatchUpdateRollsBackWhenTransactionIsOn.csharp","test":"csharp/Datasources.Tests/BulkCRUDRepositoryTests.cs#BatchUpdateRollsBackWhenTransactionIsOn","from":125,"to":144,"raw":"    [Fact]\n    public async Task BatchUpdateRollsBackWhenTransactionIsOn()\n    {\n        var connection = await Setup();\n        var parentsRepo = new BulkCRUDRepository<Parent>(connection, new CRUDRepositoryOptions<Parent>\n        {\n            Write = new DefaultWriteEnrichmentStrategy<Parent>(useTransaction: true),\n        });\n        var first = await parentsRepo.Create(new Parent { label = \"a\" });\n        Assert.True(first.id > 0);\n        var second = await parentsRepo.Create(new Parent { label = \"b\" });\n        Assert.True(second.id > 0);\n        parentsRepo.AddMiddleware(new FailAfter());\n        await Assert.ThrowsAsync<DatasourceException>(() => parentsRepo.Update(\n        [\n            new Parent { id = first.id, label = \"changed\" },\n            new Parent { id = first.id, label = \"later\" }\n        ]));\n        Assert.Equal(\"a\", (await parentsRepo.Read().ToListAsync()).Single(parent => parent.id == first.id).label);\n    }"}
{"file":"docs/examples/roll-back-a-bulk-update/enriched.bulk_update_rolls_back_when_transaction_is_on.rust","test":"rust/datasources/tests/enriched.rs#bulk_update_rolls_back_when_transaction_is_on","from":956,"to":1005,"raw":"#[tokio::test]\nasync fn bulk_update_rolls_back_when_transaction_is_on() {\n    let connection = setup(&mut []).await;\n    let mut options = CRUDRepositoryOptions::default();\n    options.entity = \"Parent\".into();\n    options.write = Some(Arc::new(DefaultWriteEnrichmentStrategy::new(\n        None, None, None, true,\n    )));\n    let parents = BulkCRUDRepository::new(connection, options).unwrap();\n    let created = parents\n        .create_bulk(&mut [\n            record(&[(\"label\", Value::from(\"a\"))]),\n            record(&[(\"label\", Value::from(\"b\"))]),\n        ])\n        .await\n        .unwrap();\n    let stored = parents.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n    let mut created_ids: Vec<_> = created.iter().map(|row| num(row, \"id\")).collect();\n    let mut stored_ids: Vec<_> = stored.iter().map(|row| num(row, \"id\")).collect();\n    created_ids.sort();\n    stored_ids.sort();\n    assert_eq!(created_ids, stored_ids);\n    let first_id = stored\n        .iter()\n        .find(|row| row.get(\"label\") == Some(&Value::from(\"a\")))\n        .unwrap()\n        .get(\"id\")\n        .unwrap()\n        .clone();\n    let error = parents\n        .update_bulk(\n            &[\n                record(&[(\"id\", first_id.clone()), (\"label\", Value::from(\"changed\"))]),\n                record(&[(\"label\", Value::from(\"nope\"))]),\n            ],\n            None,\n        )\n        .await\n        .unwrap_err();\n    assert!(error.to_string().contains(\"Missing Id\"));\n    let after = parents.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n    assert_eq!(\n        after\n            .iter()\n            .find(|row| row.get(\"id\") == Some(&first_id))\n            .unwrap()\n            .get(\"label\"),\n        Some(&Value::from(\"a\"))\n    );\n}"}

{"file":"docs/examples/persist-list-children/bulk_write_strategy.batch_persists_children_in_one_command.rust","test":"rust/datasources/src/tests/bulk_write_strategy.rs#batch_persists_children_in_one_command","from":347,"to":385,"raw":"#[tokio::test]\nasync fn batch_persists_children_in_one_command() {\n    let (repo, command) = family(\n        Arc::new(BatchCommandIBulkWriteStrategy::new()),\n        Arc::new(BatchCommandIBulkWriteStrategy::new()),\n    );\n    repo.create_bulk(&mut [\n        row(&[\n            (\"id\", Value::Int(1)),\n            (\"label\", Value::from(\"a\")),\n            (\n                \"children\",\n                crate::default_write_enrichment_strategy::encode_rows(&[row(&[\n                    (\"id\", Value::Int(10)),\n                    (\"label\", Value::from(\"x\")),\n                ])]),\n            ),\n        ]),\n        row(&[\n            (\"id\", Value::Int(2)),\n            (\"label\", Value::from(\"b\")),\n            (\n                \"children\",\n                crate::default_write_enrichment_strategy::encode_rows(&[row(&[\n                    (\"id\", Value::Int(11)),\n                    (\"label\", Value::from(\"y\")),\n                ])]),\n            ),\n        ]),\n    ])\n    .await\n    .unwrap();\n    let logs = command.execute_logs.lock().unwrap();\n    assert_eq!(logs.len(), 2);\n    assert!(logs[0].0.contains(\"INSERT INTO parents\"));\n    assert!(logs[1].0.contains(\"INSERT INTO children\"));\n    assert!(logs[1].0.contains(\"label__0\"));\n    assert!(logs[1].0.contains(\"label__1\"));\n}"}

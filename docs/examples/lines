{"file":"docs/examples/skip-child-deletes/CRUDRepository.test.delete-strategy-can-skip-children.typescript","test":"typescript/datasources/src/CRUDRepository.test.ts#delete-strategy-can-skip-children","from":367,"to":380,"raw":"  it(\"delete strategy can skip children\", async () => {\n    const connection = await setup();\n    const childrenRepo = repo(Child, connection);\n    const parentsRepo = repo(Parent, connection, new DefaultWriteEnrichmentStrategy(new SkipDelete()));\n    const parent = await parentsRepo.create(new Parent());\n    expect(parent.Id).toBeGreaterThan(0);\n    const child = await childrenRepo.create(Object.assign(new Child(), { ParentId: parent.Id, Label: \"a\" }));\n    expect(child.Id).toBeGreaterThan(0);\n    parentsRepo.addEnriched({ destinationProperty: \"Children\", sourceProperty: \"Id\", relatedKey: \"ParentId\", type: \"list\" }, childrenRepo);\n    const removed = await parentsRepo.delete(Object.assign(new Parent(), { Id: parent.Id }));\n    expect(removed.rowsAffected).toBe(1);\n    expect(await collectAsync(parentsRepo.read())).toEqual([]);\n    expect((await childrenRepo.readSingle())?.Label).toBe(\"a\");\n  });"}
{"file":"docs/examples/skip-child-deletes/CRUDRepositoryTests.DeleteStrategyCanSkipChildren.csharp","test":"csharp/Datasources.Tests/CRUDRepositoryTests.cs#DeleteStrategyCanSkipChildren","from":324,"to":339,"raw":"    [Fact]\n    public async Task DeleteStrategyCanSkipChildren()\n    {\n        var connection = await Setup();\n        var childrenRepo = Open<Child>(connection);\n        var parentsRepo = Open(connection, new DefaultWriteEnrichmentStrategy<Parent>(new SkipDelete<Parent>()));\n        var parent = await parentsRepo.Create(new Parent());\n        Assert.True(parent.Id > 0);\n        var child = await childrenRepo.Create(new Child { ParentId = parent.Id, Label = \"a\" });\n        Assert.True(child.Id > 0);\n        parentsRepo.AddEnriched(new(\"Children\", \"Id\", \"ParentId\", Type: EnrichmentPropertyType.List), childrenRepo);\n        var removed = await parentsRepo.Delete(new Parent { Id = parent.Id });\n        Assert.Equal(1, removed.RowsAffected);\n        Assert.Empty(await parentsRepo.Read().ToListAsync());\n        Assert.Equal(\"a\", Assert.Single(await childrenRepo.Read().ToListAsync()).Label);\n    }"}
{"file":"docs/examples/skip-child-deletes/delete_enrichment_strategy.delete_strategy_can_skip_children.rust","test":"rust/datasources/src/delete_enrichment_strategy.rs#delete_strategy_can_skip_children","from":92,"to":118,"raw":"    #[tokio::test]\n    async fn delete_strategy_can_skip_children() {\n        let write = Arc::new(DefaultWriteEnrichmentStrategy::new(\n            Some(Arc::new(SkipDelete)),\n            None,\n            None,\n            false,\n        ));\n        let children = Arc::new(CRUDRepository::memory(vec![]));\n        let mut parents = CRUDRepository::memory_with(vec![], Some(write));\n        let parent = Row::new();\n        let created = parents.create(parent).await.unwrap();\n        let mut child = Row::new();\n        child.insert(\"parent_id\".into(), created.get(\"id\").unwrap().clone());\n        child.insert(\"label\".into(), Value::from(\"a\"));\n        children.create(child).await.unwrap();\n        parents.add_enriched(\n            Enrichment::new(\"children\", \"id\", \"parent_id\", None, crate::EnrichmentPropertyType::List),\n            children.clone(),\n            None,\n        );\n        parents.delete(created, None).await.unwrap();\n        let left = children.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n        assert_eq!(left.len(), 1);\n        assert_eq!(left[0].get(\"label\"), Some(&Value::from(\"a\")));\n        assert!(parents.read(None, None, None).try_collect::<Vec<_>>().await.unwrap().is_empty());\n    }"}
{"file":"docs/examples/skip-unloaded-lists/user_view.lazy_write_skips_unloaded_links.rust","test":"rust/datasources/tests/user_view.rs#lazy_write_skips_unloaded_links","from":460,"to":561,"raw":"#[tokio::test]\nasync fn lazy_write_skips_unloaded_links() {\n    let (mut users, seeded) = open(Some(Arc::new(LazyWriteEnrichmentStrategy::new(\n        None, None, None, false,\n    ))))\n    .await;\n    link(&mut users, &seeded);\n    let creating = record(&[\n        (\"username\", Value::from(\"ada\")),\n        (\"is_enabled\", Value::Bool(true)),\n        (\"user_type_id\", seeded.admin_type.get(\"id\").unwrap().clone()),\n        (\"groups\", encode_rows(&[seeded.engineering.clone()])),\n    ]);\n    let created = users.create(creating).await.unwrap();\n    let created_role_links = seeded.user_roles.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n    let created_group_links = seeded.user_groups.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n    let next = record(&[\n        (\"id\", created.get(\"id\").unwrap().clone()),\n        (\"username\", Value::from(\"ada\")),\n        (\"is_enabled\", Value::Bool(false)),\n        (\"user_type_id\", seeded.admin_type.get(\"id\").unwrap().clone()),\n    ]);\n    let skipped = users.update(next, None).await.unwrap();\n    let after_skip = users\n        .read_single_by_id(created.get(\"id\").unwrap())\n        .await\n        .unwrap()\n        .unwrap();\n    let skipped_role_links = seeded.user_roles.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n    let skipped_group_links = seeded.user_groups.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n    let linked_row = record(&[\n        (\"id\", created.get(\"id\").unwrap().clone()),\n        (\"username\", Value::from(\"ada\")),\n        (\"is_enabled\", Value::Bool(false)),\n        (\"user_type_id\", seeded.admin_type.get(\"id\").unwrap().clone()),\n        (\"roles\", encode_rows(&[seeded.editor_role.clone()])),\n    ]);\n    let linked = users.update(linked_row, None).await.unwrap();\n    let linked_role_links = seeded.user_roles.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n    let linked_group_links = seeded.user_groups.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n    let removed = users\n        .delete(record(&[(\"id\", created.get(\"id\").unwrap().clone())]), None)\n        .await\n        .unwrap();\n    assert_eq!(num(&created, \"id\") > 0, true);\n    assert!(created_role_links.is_empty());\n    assert_eq!(\n        ints(&created_group_links, \"user_id\"),\n        vec![num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&created_group_links, \"group_id\"),\n        vec![num(&seeded.engineering, \"id\")]\n    );\n    assert_eq!(skipped.rows_affected, 1);\n    assert_eq!(num(&after_skip, \"id\"), num(&created, \"id\"));\n    assert_eq!(after_skip.get(\"username\"), Some(&Value::from(\"ada\")));\n    assert_eq!(after_skip.get(\"is_enabled\"), Some(&Value::Bool(false)));\n    assert!(skipped_role_links.is_empty());\n    assert_eq!(\n        ints(&skipped_group_links, \"user_id\"),\n        vec![num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&skipped_group_links, \"group_id\"),\n        vec![num(&seeded.engineering, \"id\")]\n    );\n    assert_eq!(linked.rows_affected, 1);\n    assert_eq!(\n        ints(&linked_role_links, \"user_id\"),\n        vec![num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&linked_role_links, \"role_id\"),\n        vec![num(&seeded.editor_role, \"id\")]\n    );\n    assert_eq!(\n        ints(&linked_group_links, \"user_id\"),\n        vec![num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&linked_group_links, \"group_id\"),\n        vec![num(&seeded.engineering, \"id\")]\n    );\n    assert_eq!(\n        names(&seeded.roles.read(None, None, None).try_collect::<Vec<_>>().await.unwrap()),\n        vec![\"admin\".to_string(), \"editor\".to_string()]\n    );\n    assert_eq!(\n        names(&seeded.groups.read(None, None, None).try_collect::<Vec<_>>().await.unwrap()),\n        vec![\"engineering\".to_string(), \"ops\".to_string()]\n    );\n    assert_eq!(removed.rows_affected, 1);\n    assert!(users.read(None, None, None).try_collect::<Vec<_>>().await.unwrap().is_empty());\n    assert!(seeded.user_roles.read(None, None, None).try_collect::<Vec<_>>().await.unwrap().is_empty());\n    assert!(seeded\n        .user_groups\n        .read(None, None, None)\n        .try_collect::<Vec<_>>().await\n        .unwrap()\n        .is_empty());\n}"}
{"file":"docs/examples/skip-unloaded-lists/UserViewCRUDRepository.test.lazy-write-skips-unloaded-links.typescript","test":"typescript/datasources/src/UserViewCRUDRepository.test.ts#lazy-write-skips-unloaded-links","from":248,"to":302,"raw":"  it(\"lazy write skips unloaded links\", async () => {\n    const seeded = await graph(new LazyWriteEnrichmentStrategy());\n    link(seeded.usersRepo, seeded);\n    const created = await seeded.usersRepo.create(Object.assign(new UserView(), {\n      username: \"ada\",\n      is_enabled: true,\n      user_type_id: seeded.adminType.id,\n      roles: null,\n      groups: [seeded.engineering],\n    }));\n    const createdRoleLinks = await collectAsync(seeded.userRolesRepo.read());\n    const createdGroupLinks = await collectAsync(seeded.userGroupsRepo.read());\n    const skipped = await seeded.usersRepo.update(Object.assign(new UserView(), {\n      id: created.id,\n      username: \"ada\",\n      is_enabled: false,\n      user_type_id: seeded.adminType.id,\n    }));\n    const afterSkip = await seeded.usersRepo.readSingleById(created.id);\n    const skippedRoleLinks = await collectAsync(seeded.userRolesRepo.read());\n    const skippedGroupLinks = await collectAsync(seeded.userGroupsRepo.read());\n    const linked = await seeded.usersRepo.update(Object.assign(new UserView(), {\n      id: created.id,\n      username: \"ada\",\n      is_enabled: false,\n      user_type_id: seeded.adminType.id,\n      roles: [seeded.editorRole],\n    }));\n    const linkedRoleLinks = await collectAsync(seeded.userRolesRepo.read());\n    const linkedGroupLinks = await collectAsync(seeded.userGroupsRepo.read());\n    const removed = await seeded.usersRepo.delete(Object.assign(new UserView(), { id: created.id, roles: null, groups: null }));\n\n    expect(created.id > 0).toEqual(true);\n    expect(createdRoleLinks).toEqual([]);\n    expect(createdGroupLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id]);\n    expect(createdGroupLinks.map((linkRow) => linkRow.group_id)).toEqual([seeded.engineering.id]);\n    expect(skipped.rowsAffected).toEqual(1);\n    expect(afterSkip?.id).toEqual(created.id);\n    expect(afterSkip?.username).toEqual(\"ada\");\n    expect(afterSkip?.is_enabled).toEqual(false);\n    expect(skippedRoleLinks).toEqual([]);\n    expect(skippedGroupLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id]);\n    expect(skippedGroupLinks.map((linkRow) => linkRow.group_id)).toEqual([seeded.engineering.id]);\n    expect(linked.rowsAffected).toEqual(1);\n    expect(linkedRoleLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id]);\n    expect(linkedRoleLinks.map((linkRow) => linkRow.role_id)).toEqual([seeded.editorRole.id]);\n    expect(linkedGroupLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id]);\n    expect(linkedGroupLinks.map((linkRow) => linkRow.group_id)).toEqual([seeded.engineering.id]);\n    expect((await collectAsync(seeded.rolesRepo.read())).map((role) => role.name).sort()).toEqual([\"admin\", \"editor\"]);\n    expect((await collectAsync(seeded.groupsRepo.read())).map((group) => group.name).sort()).toEqual([\"engineering\", \"ops\"]);\n    expect(removed.rowsAffected).toEqual(1);\n    expect(await collectAsync(seeded.usersRepo.read())).toEqual([]);\n    expect(await collectAsync(seeded.userRolesRepo.read())).toEqual([]);\n    expect(await collectAsync(seeded.userGroupsRepo.read())).toEqual([]);\n  });"}
{"file":"docs/examples/skip-unloaded-lists/UserViewCRUDRepositoryTests.LazyCreateAndUpdateSkipUnloadedCollectionsAndDeleteCascades.csharp","test":"csharp/Providers/Sqlite.Tests/UserViewCRUDRepositoryTests.cs#LazyCreateAndUpdateSkipUnloadedCollectionsAndDeleteCascades","from":332,"to":400,"schema":"user-view-links","raw":"    [Fact]\n    public async Task LazyCreateAndUpdateSkipUnloadedCollectionsAndDeleteCascades()\n    {\n        var ds = Datasource.Default;\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"user-view-links\");\n        var graph = await GraphAsync(connection, new LazyWriteEnrichmentStrategy<UserView>());\n        var userViewRepo = Enrich(graph.UsersRepo, graph);\n\n        var created = await userViewRepo.Create(new UserView\n        {\n            Username = \"ada\",\n            IsEnabled = true,\n            UserTypeId = graph.AdminType.Id,\n            Roles = null,\n            Groups = [graph.Engineering]\n        });\n        var createdRoleLinks = await graph.UserRolesRepo.Read().ToListAsync();\n        var createdGroupLinks = await graph.UserGroupsRepo.Read().ToListAsync();\n        var skipped = await userViewRepo.Update(new UserView\n        {\n            Id = created.Id,\n            Username = \"ada\",\n            IsEnabled = false,\n            UserTypeId = graph.AdminType.Id,\n            Roles = null,\n            Groups = null\n        });\n        var afterSkip = await userViewRepo.ReadSingleById(created.Id);\n        var skippedRoleLinks = await graph.UserRolesRepo.Read().ToListAsync();\n        var skippedGroupLinks = await graph.UserGroupsRepo.Read().ToListAsync();\n        var linked = await userViewRepo.Update(new UserView\n        {\n            Id = created.Id,\n            Username = \"ada\",\n            IsEnabled = false,\n            UserTypeId = graph.AdminType.Id,\n            Roles = [graph.EditorRole],\n            Groups = null\n        });\n        var linkedRoleLinks = await graph.UserRolesRepo.Read().ToListAsync();\n        var linkedGroupLinks = await graph.UserGroupsRepo.Read().ToListAsync();\n        var roles = await graph.RolesRepo.Read().ToListAsync();\n        var groups = await graph.GroupsRepo.Read().ToListAsync();\n        var removed = await userViewRepo.Delete(new UserView { Id = created.Id, Roles = null, Groups = null });\n\n        Assert.True(created.Id > 0);\n        Assert.Empty(createdRoleLinks);\n        Assert.Equal((created.Id, graph.Engineering.Id), (createdGroupLinks[0].UserId, createdGroupLinks[0].GroupId));\n        Assert.Equal(1, skipped.RowsAffected);\n        Assert.Equal(created.Id, afterSkip!.Id);\n        Assert.Equal(\"ada\", afterSkip.Username);\n        Assert.False(afterSkip.IsEnabled);\n        Assert.Empty(skippedRoleLinks);\n        Assert.Equal((created.Id, graph.Engineering.Id), (skippedGroupLinks[0].UserId, skippedGroupLinks[0].GroupId));\n        Assert.Equal(1, linked.RowsAffected);\n        Assert.Equal([created.Id], linkedRoleLinks.Select(link => link.UserId));\n        Assert.Equal([graph.EditorRole.Id], linkedRoleLinks.Select(link => link.RoleId));\n        Assert.Equal((created.Id, graph.Engineering.Id), (linkedGroupLinks[0].UserId, linkedGroupLinks[0].GroupId));\n        Assert.Equal([\"admin\", \"editor\"], roles.Select(role => role.Name).OrderBy(name => name));\n        Assert.Equal([\"engineering\", \"ops\"], groups.Select(group => group.Name).OrderBy(name => name));\n        Assert.Equal(1, removed.RowsAffected);\n        Assert.Empty(await graph.UsersRepo.Read().ToListAsync());\n        Assert.Empty(await graph.UserRolesRepo.Read().ToListAsync());\n        Assert.Empty(await graph.UserGroupsRepo.Read().ToListAsync());\n        Assert.Equal([\"admin\", \"editor\"], (await graph.RolesRepo.Read().ToListAsync()).Select(role => role.Name).OrderBy(name => name));\n        Assert.Equal([\"engineering\", \"ops\"], (await graph.GroupsRepo.Read().ToListAsync()).Select(group => group.Name).OrderBy(name => name));\n        Assert.Equal(\"admin\", Assert.Single(await graph.UserTypesRepo.Read().ToListAsync()).Name);\n    }"}

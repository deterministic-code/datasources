{"file":"docs/examples/group-aggregate-order-and-limit/statement_compile.groups_aggregates_orders_and_limits.rust","test":"rust/datasources/src/tests/statement_compile.rs#groups_aggregates_orders_and_limits","from":59,"to":82,"raw":"#[test]\nfn groups_aggregates_orders_and_limits() {\n    let count = Aggregate::count(\"*\");\n    let total = Aggregate::sum(\"amount\");\n    let grouped_fields = [\"status\", count.as_str(), total.as_str()];\n    let where_clause = Where::new(Operator::equals(\"status\", \"open\"));\n    let grouped = SelectStatement::new(SelectStatementOptions {\n        where_clause: Some(&where_clause),\n        joins: &[Join::inner(\n            \"customers\",\n            \"orders.customer_id\",\n            \"customers.id\",\n        )],\n        group_by: &[\"status\"],\n        order_by: &[OrderBy::desc(\"total\"), OrderBy::asc(\"status\")],\n        limit: Some(10),\n        aliases: &[None, Some(\"n\"), Some(\"total\")],\n        ..SelectStatementOptions::new(\"orders\", &grouped_fields)\n    });\n    assert_eq!(\n        stmt_text(&grouped),\n        \"SELECT status, COUNT(*) AS n, SUM(amount) AS total FROM orders INNER JOIN customers ON orders.customer_id = customers.id WHERE status = $status GROUP BY status ORDER BY total DESC, status ASC LIMIT 10\"\n    );\n}"}
{"file":"docs/examples/group-aggregate-order-and-limit/StatementCompile.test.groups-aggregates-orders-and-limits.typescript","test":"typescript/datasources/src/statements/StatementCompile.test.ts#groups-aggregates-orders-and-limits","from":86,"to":100,"raw":"  it(\"groups aggregates orders and limits\", () => {\n    const grouped = new SelectStatement({\n      table: \"orders\",\n      fields: [\"status\", Aggregate.count(\"*\"), Aggregate.sum(\"amount\")],\n      aliases: [undefined, \"n\", \"total\"],\n      where: new Where(new Operator.Equals(\"status\", \"open\")),\n      joins: [Join.inner(\"customers\", \"orders.customer_id\", \"customers.id\")],\n      groupBy: [\"status\"],\n      orderBy: [OrderBy.desc(\"total\"), OrderBy.asc(\"status\")],\n      limit: 10,\n    });\n    expect(DefaultStatementTextRenderer.instance.render(grouped)).toBe(\n      \"SELECT status, COUNT(*) AS n, SUM(amount) AS total FROM orders INNER JOIN customers ON orders.customer_id = customers.id WHERE status = $status GROUP BY status ORDER BY total DESC, status ASC LIMIT 10\",\n    );\n  });"}

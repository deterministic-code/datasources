{"file":"docs/examples/read-a-row/command.run_execute_reader_on_a_simple_list.rust","test":"rust/providers/sqlite/tests/command.rs#run_execute_reader_on_a_simple_list","from":77,"to":107,"schema":"items","raw":"#[tokio::test]\nasync fn run_execute_reader_on_a_simple_list() {\n    let _guard = super::env_lock();\n    let ds = default().unwrap();\n    let command = ds.create_command(None).await.unwrap();\n    apply_schema(ds.create_connection().await.unwrap().as_ref(), \"items\").await.unwrap();\n    command\n        .execute_native(&Native::new(\"INSERT INTO items (id, name) VALUES (1, 'ada')\"), None)\n        .await\n        .unwrap();\n    command\n        .execute_native(&Native::new(\"INSERT INTO items (id, name) VALUES (2, 'grace')\"), None)\n        .await\n        .unwrap();\n    command\n        .execute_native(&Native::new(\"INSERT INTO items (id, name) VALUES (3, 'bea')\"), None)\n        .await\n        .unwrap();\n    let reader = command\n        .execute_reader(\"SELECT id, name FROM items\", None)\n        .await\n        .unwrap();\n    let rows: Vec<_> = reader.read().try_collect().await.unwrap();\n    assert_eq!(rows.len(), 3);\n    assert_eq!(rows[0].get(\"id\"), Some(&Value::Int(1)));\n    assert_eq!(rows[0].get(\"name\"), Some(&Value::from(\"ada\")));\n    assert_eq!(rows[1].get(\"id\"), Some(&Value::Int(2)));\n    assert_eq!(rows[1].get(\"name\"), Some(&Value::from(\"grace\")));\n    assert_eq!(rows[2].get(\"id\"), Some(&Value::Int(3)));\n    assert_eq!(rows[2].get(\"name\"), Some(&Value::from(\"bea\")));\n}"}
{"file":"docs/examples/read-a-row/sqlite.integration.test.run-executereader-on-a-simple-list.typescript","test":"typescript/providers/sqlite/tests/sqlite.integration.test.ts#run-executereader-on-a-simple-list","from":91,"to":105,"schema":"items","raw":"  it(\"run executeReader on a simple list\", async () => {\n    const ds = Datasource.default;\n    const command = await ds.createCommand();\n    await applySchema(command.connection, \"items\");\n    await command.executeNative(new Native(\"INSERT INTO items (id, name) VALUES (1, 'ada')\"));\n    await command.executeNative(new Native(\"INSERT INTO items (id, name) VALUES (2, 'grace')\"));\n    await command.executeNative(new Native(\"INSERT INTO items (id, name) VALUES (3, 'bea')\"));\n    await using reader = await command.executeReader(\"SELECT id, name FROM items\");\n    const rows = await Array.fromAsync(reader.read());\n    expect(rows).toEqual([\n      { id: 1, name: \"ada\" },\n      { id: 2, name: \"grace\" },\n      { id: 3, name: \"bea\" },\n    ]);\n  });"}
{"file":"docs/examples/read-a-row/SqliteCommandIntegrationTests.RunExecuteReaderOnASimpleList.csharp","test":"csharp/Providers/Sqlite.Tests/SqliteCommandIntegrationTests.cs#RunExecuteReaderOnASimpleList","from":73,"to":91,"schema":"items","raw":"    [Fact]\n    public async Task RunExecuteReaderOnASimpleList()\n    {\n        var ds = Datasource.Default;\n        var command = await ds.CreateCommand();\n        await SchemaSpec.Apply(command.Connection, \"items\");\n        await command.Execute(Native.N(\"INSERT INTO items (id, name) VALUES (1, 'ada')\"));\n        await command.Execute(Native.N(\"INSERT INTO items (id, name) VALUES (2, 'grace')\"));\n        await command.Execute(Native.N(\"INSERT INTO items (id, name) VALUES (3, 'bea')\"));\n        await using var reader = await command.ExecuteReader(\"SELECT id, name FROM items\");\n        var rows = await reader.Read().ToListAsync();\n        Assert.Equal(3, rows.Count);\n        Assert.Equal(new Value.Int(1), rows[0][\"id\"]);\n        Assert.Equal(new Value.Text(\"ada\"), rows[0][\"name\"]);\n        Assert.Equal(new Value.Int(2), rows[1][\"id\"]);\n        Assert.Equal(new Value.Text(\"grace\"), rows[1][\"name\"]);\n        Assert.Equal(new Value.Int(3), rows[2][\"id\"]);\n        Assert.Equal(new Value.Text(\"bea\"), rows[2][\"name\"]);\n    }"}
{"file":"docs/examples/read-a-user-by-guid-username-and-created/readonly_repository.reads_user_by_guid_username_and_created.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#reads_user_by_guid_username_and_created","from":172,"to":238,"schema":"user-account","raw":"#[tokio::test]\nasync fn reads_user_by_guid_username_and_created() {\n    let built = datasource();\n    let ds: &dyn Datasource = &*built;\n    let connection = open(ds).await;\n    apply_schema(connection.as_ref(), \"user-account\").await.unwrap();\n    execute_sql(\n        &connection,\n        &format!(\n            \"\n        INSERT INTO user (id, username, is_enabled, created) VALUES\n            ('{ADA}', 'ada', 1, '2020-01-01T00:00:00.000Z'),\n            ('{GRACE}', 'grace', 1, '2024-06-01T00:00:00.000Z'),\n            ('{LIN}', 'lin', 0, '2024-06-01T00:00:00.000Z');\n        \"\n        ),\n    )\n    .await;\n    let mut options = create_readonly_repository_mapping_options::<UserAccount>();\n    options.entity_mapper = Some(std::sync::Arc::new(DictionaryMapper::new([(\n        \"UserAccount\".to_string(),\n        \"user\".to_string(),\n    )])));\n    options.property_mappings = Some(std::sync::Arc::new(DictionaryMapper::new([\n        (\"Key\".to_string(), \"id\".to_string()),\n        (\"Login\".to_string(), \"username\".to_string()),\n        (\"Active\".to_string(), \"is_enabled\".to_string()),\n        (\"Opened\".to_string(), \"created\".to_string()),\n    ])));\n    let repo = ds.create_readonly_repository::<UserAccount>(Some(connection), Some(options));\n    let opened = Utc.with_ymd_and_hms(2024, 1, 1, 0, 0, 0).unwrap();\n    let by_id = repo\n        .read_single(\n            Some(&Where::binary(\"Key\", eq, Uuid::parse_str(ADA).unwrap())),\n            None, None\n        )\n        .await\n        .unwrap()\n        .unwrap();\n    let by_login = repo\n        .read(\n            Some(&Where::binary(\"Login\", eq, \"ada\").and(\"Active\", eq, true)),\n            None, None\n        )\n        .try_collect::<Vec<_>>().await\n        .unwrap();\n    let later = repo\n        .read(\n            Some(&Where::binary(\"Active\", eq, true).and(\"Opened\", gt, opened)),\n            None, None\n        )\n        .try_collect::<Vec<_>>().await\n        .unwrap();\n    assert_eq!(by_id.get(\"Login\"), Some(&Value::from(\"ada\")));\n    assert_eq!(by_id.get(\"Key\"), Some(&Value::from(ADA)));\n    assert_eq!(by_id.get(\"Active\"), Some(&Value::Bool(true)));\n    assert_eq!(\n        by_id.get(\"Opened\"),\n        Some(&Value::DateTime(\n            Utc.with_ymd_and_hms(2020, 1, 1, 0, 0, 0).unwrap()\n        ))\n    );\n    assert_eq!(by_login.len(), 1);\n    assert_eq!(by_login[0].get(\"Login\"), Some(&Value::from(\"ada\")));\n    assert_eq!(later.len(), 1);\n    assert_eq!(later[0].get(\"Login\"), Some(&Value::from(\"grace\")));\n}"}
{"file":"docs/examples/read-a-user-by-guid-username-and-created/readonly.repository.integration.test.reads-user-by-guid-username-and-created.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#reads-user-by-guid-username-and-created","from":116,"to":151,"schema":"user-account","raw":"  it(\"reads user by guid username and created\", async () => {\n    const ds = new Datasource(\"sqlite\", new SqliteDriver(), { DATASOURCE_URL: \"sqlite:///:memory:\" });\n    const connection = await open(ds);\n    await applySchema(connection, \"user-account\");\n    await executeSql(connection, `\n      INSERT INTO user (id, username, is_enabled, created) VALUES\n        ('${ada}', 'ada', 1, '2020-01-01T00:00:00.000Z'),\n        ('${grace}', 'grace', 1, '2024-06-01T00:00:00.000Z'),\n        ('${lin}', 'lin', 0, '2024-06-01T00:00:00.000Z');\n    `);\n    const repo = ds.createReadonlyRepository(UserAccount, connection, {\n      entityMapper: new DictionaryMapper([[\"UserAccount\", \"user\"]]),\n      propertyMappings: new DictionaryMapper([\n        [\"Key\", \"id\"],\n        [\"Login\", \"username\"],\n        [\"Active\", \"is_enabled\"],\n        [\"Opened\", \"created\"],\n      ]),\n    });\n    const opened = new Date(\"2024-01-01T00:00:00.000Z\");\n    const byId = await repo.readSingle(new Where(\"Key\", eq, ada));\n    const byLogin: UserAccount[] = [];\n    for await (const row of repo.read(new Where(\"Login\", eq, \"ada\").and(\"Active\", eq, true)))\n      byLogin.push(row);\n    const later: UserAccount[] = [];\n    for await (const row of repo.read(new Where(\"Active\", eq, true).and(\"Opened\", gt, opened)))\n      later.push(row);\n    expect(byId?.Login).toBe(\"ada\");\n    expect(byId?.Key).toBe(ada);\n    expect(byId?.Active).toBe(true);\n    expect(byId?.Opened).toBe(\"2020-01-01T00:00:00.000Z\");\n    expect(byLogin.length).toBe(1);\n    expect(byLogin[0]?.Login).toBe(\"ada\");\n    expect(later.length).toBe(1);\n    expect(later[0]?.Login).toBe(\"grace\");\n  });"}
{"file":"docs/examples/read-a-user-by-guid-username-and-created/ReadonlyRepositoryIntegrationTests.ReadsUserByGuidUsernameAndCreated.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#ReadsUserByGuidUsernameAndCreated","from":118,"to":157,"schema":"user-account","raw":"    [Fact]\n    public async Task ReadsUserByGuidUsernameAndCreated()\n    {\n        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"DATASOURCE_URL\"] = \"sqlite:///:memory:\" });\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"user-account\");\n        await Execute(connection, $\"\"\"\n            INSERT INTO user (id, username, is_enabled, created) VALUES\n                ('{Ada}', 'ada', 1, '2020-01-01T00:00:00.000Z'),\n                ('{Grace}', 'grace', 1, '2024-06-01T00:00:00.000Z'),\n                ('{Lin}', 'lin', 0, '2024-06-01T00:00:00.000Z');\n            \"\"\");\n        var repo = ds.CreateReadonlyRepository<UserAccount>(connection, new ReadonlyRepositoryMappingOptions<UserAccount>\n        {\n            EntityMapper = new DictionaryMapper<string>(new Dictionary<string, string> { [\"UserAccount\"] = \"user\" }),\n            PropertyMappings = new DictionaryMapper<string>(new Dictionary<string, string>\n            {\n                [\"Key\"] = \"id\",\n                [\"Login\"] = \"username\",\n                [\"Active\"] = \"is_enabled\",\n                [\"Opened\"] = \"created\",\n            }),\n        });\n\n        var opened = new DateTime(2024, 1, 1, 0, 0, 0, DateTimeKind.Utc);\n        var byId = await repo.ReadSingle(new Where(\"Key\", eq, Ada));\n        var byLogin = new List<UserAccount>();\n        await foreach (var row in repo.Read(new Where(\"Login\", eq, \"ada\").And(\"Active\", eq, true)))\n            byLogin.Add(row);\n        var later = new List<UserAccount>();\n        await foreach (var row in repo.Read(new Where(\"Active\", eq, true).And(\"Opened\", gt, opened)))\n            later.Add(row);\n\n        Assert.Equal(\"ada\", byId!.Login);\n        Assert.Equal(Ada, byId.Key);\n        Assert.True(byId.Active);\n        Assert.Equal(2020, byId.Opened.Year);\n        Assert.Equal(\"ada\", Assert.Single(byLogin).Login);\n        Assert.Equal(\"grace\", Assert.Single(later).Login);\n    }"}
{"file":"docs/examples/read-and-apply-case-mappings/command.read_and_apply_case_mappings.rust","test":"rust/providers/sqlite/tests/command.rs#read_and_apply_case_mappings","from":109,"to":140,"schema":"case-contacts","raw":"#[tokio::test]\nasync fn read_and_apply_case_mappings() {\n    let _guard = super::env_lock();\n    let ds = default().unwrap();\n    let command = ds.create_command(None).await.unwrap();\n    apply_schema(ds.create_connection().await.unwrap().as_ref(), \"case-contacts\").await.unwrap();\n    command\n        .execute_native(\n            &Native::new(\"INSERT INTO contacts (user_id, first_name) VALUES (1, 'Ada')\"),\n            None,\n        )\n        .await\n        .unwrap();\n    let reader = command\n        .execute_reader(\"SELECT user_id, first_name FROM contacts\", None)\n        .await\n        .unwrap();\n    let casing = ChangeCasingMapper::new(Casing::Pascal, Casing::Snake);\n    let mapped: Vec<Row> = reader\n        .read()\n        .map_ok(|source| {\n            source\n                .into_iter()\n                .map(|(key, value)| (Mapper::reverse_map(&casing, key), value))\n                .collect()\n        })\n        .try_collect()\n        .await\n        .unwrap();\n    assert_eq!(mapped[0].get(\"UserId\"), Some(&Value::Int(1)));\n    assert_eq!(mapped[0].get(\"FirstName\"), Some(&Value::from(\"Ada\")));\n}"}
{"file":"docs/examples/read-and-apply-case-mappings/sqlite.integration.test.read-and-apply-case-mappings.typescript","test":"typescript/providers/sqlite/tests/sqlite.integration.test.ts#read-and-apply-case-mappings","from":107,"to":118,"schema":"case-contacts","raw":"  it(\"read and apply case mappings\", async () => {\n    const ds = Datasource.default;\n    const command = await ds.createCommand();\n    await applySchema(command.connection, \"case-contacts\");\n    await command.executeNative(new Native(\"INSERT INTO contacts (user_id, first_name) VALUES (1, 'Ada')\"));\n    await using reader = await command.executeReader(\"SELECT user_id, first_name FROM contacts\");\n    const casing = new ChangeCasingMapper(\"pascalCase\", \"snakeCase\");\n    const mapped = await Array.fromAsync(reader.read(), (source) =>\n      Object.fromEntries(Object.entries(source).map(([key, value]) => [casing.reverseMap(key), value])),\n    );\n    expect(mapped).toEqual([{ UserId: 1, FirstName: \"Ada\" }]);\n  });"}
{"file":"docs/examples/read-and-apply-case-mappings/SqliteCommandIntegrationTests.ReadAndApplyCaseMappings.csharp","test":"csharp/Providers/Sqlite.Tests/SqliteCommandIntegrationTests.cs#ReadAndApplyCaseMappings","from":93,"to":106,"schema":"case-contacts","raw":"    [Fact]\n    public async Task ReadAndApplyCaseMappings()\n    {\n        var ds = Datasource.Default;\n        var command = await ds.CreateCommand();\n        await SchemaSpec.Apply(command.Connection, \"case-contacts\");\n        await command.Execute(Native.N(\"INSERT INTO contacts (user_id, first_name) VALUES (1, 'Ada')\"));\n        await using var reader = await command.ExecuteReader(\"SELECT user_id, first_name FROM contacts\");\n        var casing = new ChangeCasingMapper(Casing.Pascal, Casing.Snake);\n        var mapped = await reader.Read().Select(source =>\n            new Row(source.ToDictionary(cell => casing.ReverseMap(cell.Key), cell => cell.Value))).ToListAsync();\n        Assert.Equal(new Value.Int(1), mapped[0][\"UserId\"]);\n        Assert.Equal(new Value.Text(\"Ada\"), mapped[0][\"FirstName\"]);\n    }"}

{"file":"docs/examples/execute-insert-update-and-delete/command.execute_insert_update_and_delete.rust","test":"rust/providers/sqlite/tests/command.rs#execute_insert_update_and_delete","from":273,"to":337,"schema":"items","raw":"#[tokio::test]\nasync fn execute_insert_update_and_delete() {\n    let _guard = super::env_lock();\n    let ds = default().unwrap();\n    let connection = ds.create_connection().await.unwrap();\n    connection.open().await.unwrap();\n    apply_schema(connection.as_ref(), \"items\").await.unwrap();\n    let command = connection.create_command();\n    command\n        .execute(\n            \"INSERT INTO items (id, name) VALUES ($id, $name)\",\n            Some(&[Parameter::new(\"id\", 1_i64), Parameter::new(\"name\", \"a\")]),\n        )\n        .await\n        .unwrap();\n    command\n        .execute(\n            \"UPDATE items SET name = $name WHERE id = $id\",\n            Some(&[Parameter::new(\"id\", 1_i64), Parameter::new(\"name\", \"A\")]),\n        )\n        .await\n        .unwrap();\n    let converter = RowTypeConverter::of::<Item>();\n    let updated = {\n        let reader = command\n            .execute_reader(\n                \"SELECT id, name FROM items WHERE id = $id\",\n                Some(&[Parameter::new(\"id\", 1_i64)]),\n            )\n            .await\n            .unwrap();\n        let row = if reader.next().await.unwrap() {\n            Some(converter.convert(&reader.current().unwrap()).unwrap())\n        } else {\n            None\n        };\n        row\n    };\n    command\n        .execute(\n            \"DELETE FROM items WHERE id = $id\",\n            Some(&[Parameter::new(\"id\", 1_i64)]),\n        )\n        .await\n        .unwrap();\n    let gone = {\n        let reader = command\n            .execute_reader(\n                \"SELECT id, name FROM items WHERE id = $id\",\n                Some(&[Parameter::new(\"id\", 1_i64)]),\n            )\n            .await\n            .unwrap();\n        let row = if reader.next().await.unwrap() {\n            Some(converter.convert(&reader.current().unwrap()).unwrap())\n        } else {\n            None\n        };\n        row\n    };\n    let updated = updated.unwrap();\n    assert_eq!(updated.get(\"id\"), Some(&Value::Int(1)));\n    assert_eq!(updated.get(\"name\"), Some(&Value::from(\"A\")));\n    assert!(gone.is_none());\n}"}
{"file":"docs/examples/execute-insert-update-and-delete/sqlite.integration.test.executes-insert-update-and-delete.typescript","test":"typescript/providers/sqlite/tests/sqlite.integration.test.ts#executes-insert-update-and-delete","from":183,"to":216,"schema":"items","raw":"  it(\"executes insert update and delete\", async () => {\n    const ds = Datasource.default;\n    await using connection = await ds.createConnection();\n    await connection.open();\n    const command = connection.createCommand();\n    await applySchema(connection, \"items\");\n    await command.execute(\"INSERT INTO items (id, name) VALUES ($id, $name)\", [\n      { name: \"id\", value: 1 },\n      { name: \"name\", value: \"a\" },\n    ]);\n    await command.execute(\"UPDATE items SET name = $name WHERE id = $id\", [\n      { name: \"id\", value: 1 },\n      { name: \"name\", value: \"A\" },\n    ]);\n    const converter = new MetaDataRowTypeConverter<Item>();\n    let updated: Item | undefined;\n    {\n      await using reader = await command.executeReader(\"SELECT id, name FROM items WHERE id = $id\", [\n        { name: \"id\", value: 1 },\n      ]);\n      if (await reader.next()) updated = converter.convert(reader.current!, Item);\n    }\n    await command.execute(\"DELETE FROM items WHERE id = $id\", [{ name: \"id\", value: 1 }]);\n    let gone: Item | undefined;\n    {\n      await using reader = await command.executeReader(\"SELECT id, name FROM items WHERE id = $id\", [\n        { name: \"id\", value: 1 },\n      ]);\n      if (await reader.next()) gone = converter.convert(reader.current!, Item);\n    }\n    expect(updated?.id).toBe(1);\n    expect(updated?.name).toBe(\"A\");\n    expect(gone).toBeUndefined();\n  });"}

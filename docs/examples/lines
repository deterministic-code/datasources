{"file":"docs/examples/read-a-return-value/integration.read_return_value.rust","test":"rust/providers/postgres/tests/integration.rs#read_return_value","from":323,"to":341,"raw":"async fn read_return_value(command: &dyn Command) {\n    use datasources::{Parameter, ReturnStatement};\n    command\n        .execute_native(\n            &Native::new(\"CREATE FUNCTION add_one(n INT) RETURNS INT LANGUAGE sql AS $$ SELECT n + 1 $$\"),\n            None,\n        )\n        .await\n        .unwrap();\n    let parameters = [Parameter::new(\"n\", 4_i64)];\n    let ret = command\n        .execute_statement(\n            &ReturnStatement::new(\"add_one\", &parameters),\n            Some(&parameters),\n        )\n        .await\n        .unwrap();\n    assert_eq!(ret.result, Value::Int(5));\n}"}

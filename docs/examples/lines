{"file":"docs/examples/execute-insert-read-update-and-delete/command.execute_insert_read_update_and_delete.rust","test":"rust/providers/sqlite/tests/command.rs#execute_insert_read_update_and_delete","from":245,"to":322,"schema":"items","raw":"#[tokio::test]\nasync fn execute_insert_read_update_and_delete() {\n    let _guard = super::env_lock();\n    let ds = default().unwrap();\n    let connection = ds.create_connection().await.unwrap();\n    connection.open().await.unwrap();\n    apply_schema(connection.as_ref(), \"items\").await.unwrap();\n    let command = connection.create_command();\n    command\n        .execute(\n            \"INSERT INTO items (id, name) VALUES ($id, $name)\",\n            Some(&[Parameter::new(\"id\", 1_i64), Parameter::new(\"name\", \"a\")]),\n        )\n        .await\n        .unwrap();\n    let converter = RowTypeConverter::of::<Item>();\n    let created_reader = command\n        .execute_reader(\n            \"SELECT id, name FROM items WHERE id = $id\",\n            Some(&[Parameter::new(\"id\", 1_i64)]),\n        )\n        .await\n        .unwrap();\n    let created: Vec<_> = created_reader\n        .read()\n        .map_ok(|row| converter.convert(&row).unwrap())\n        .try_collect()\n        .await\n        .unwrap();\n    drop(created_reader);\n    let response = command\n        .execute(\n            \"UPDATE items SET name = $name WHERE id = $id\",\n            Some(&[Parameter::new(\"id\", 1_i64), Parameter::new(\"name\", \"A\")]),\n        )\n        .await\n        .unwrap();\n    let updated_reader = command\n        .execute_reader(\n            \"SELECT id, name FROM items WHERE id = $id\",\n            Some(&[Parameter::new(\"id\", 1_i64)]),\n        )\n        .await\n        .unwrap();\n    let updated: Vec<_> = updated_reader\n        .read()\n        .map_ok(|row| converter.convert(&row).unwrap())\n        .try_collect()\n        .await\n        .unwrap();\n    drop(updated_reader);\n    command\n        .execute(\n            \"DELETE FROM items WHERE id = $id\",\n            Some(&[Parameter::new(\"id\", 1_i64)]),\n        )\n        .await\n        .unwrap();\n    let gone_reader = command\n        .execute_reader(\n            \"SELECT id, name FROM items WHERE id = $id\",\n            Some(&[Parameter::new(\"id\", 1_i64)]),\n        )\n        .await\n        .unwrap();\n    let gone: Vec<_> = gone_reader\n        .read()\n        .map_ok(|row| converter.convert(&row).unwrap())\n        .try_collect()\n        .await\n        .unwrap();\n    assert_eq!(created[0].get(\"id\"), Some(&Value::Int(1)));\n    assert_eq!(created[0].get(\"name\"), Some(&Value::from(\"a\")));\n    assert_eq!(response.rows_affected, 1);\n    assert_eq!(updated[0].get(\"id\"), Some(&Value::Int(1)));\n    assert_eq!(updated[0].get(\"name\"), Some(&Value::from(\"A\")));\n    assert!(gone.is_empty());\n}"}
{"file":"docs/examples/execute-insert-read-update-and-delete/sqlite.integration.test.execute-insert-read-update-and-delete.typescript","test":"typescript/providers/sqlite/tests/sqlite.integration.test.ts#execute-insert-read-update-and-delete","from":165,"to":197,"schema":"items","raw":"  it(\"execute, insert, read, update, and delete\", async () => {\n    const ds = Datasource.default;\n    await using connection = await ds.createConnection();\n    await connection.open();\n    const command = connection.createCommand();\n    await applySchema(connection, \"items\");\n    await command.execute(\"INSERT INTO items (id, name) VALUES ($id, $name)\", [\n      { name: \"id\", value: 1 },\n      { name: \"name\", value: \"a\" },\n    ]);\n    const converter = new MetaDataRowTypeConverter<Item>();\n    await using createdReader = await command.executeReader(\"SELECT id, name FROM items WHERE id = $id\", [\n      { name: \"id\", value: 1 },\n    ]);\n    const created = await Array.fromAsync(createdReader.read(), (row) => converter.convert(row, Item));\n    const response = await command.execute(\"UPDATE items SET name = $name WHERE id = $id\", [\n      { name: \"id\", value: 1 },\n      { name: \"name\", value: \"A\" },\n    ]);\n    await using updatedReader = await command.executeReader(\"SELECT id, name FROM items WHERE id = $id\", [\n      { name: \"id\", value: 1 },\n    ]);\n    const updated = await Array.fromAsync(updatedReader.read(), (row) => converter.convert(row, Item));\n    await command.execute(\"DELETE FROM items WHERE id = $id\", [{ name: \"id\", value: 1 }]);\n    await using goneReader = await command.executeReader(\"SELECT id, name FROM items WHERE id = $id\", [\n      { name: \"id\", value: 1 },\n    ]);\n    const gone = await Array.fromAsync(goneReader.read(), (row) => converter.convert(row, Item));\n    expect(created).toEqual([{ id: 1, name: \"a\" }]);\n    expect(response.rowsAffected).toBe(1);\n    expect(updated).toEqual([{ id: 1, name: \"A\" }]);\n    expect(gone).toEqual([]);\n  });"}

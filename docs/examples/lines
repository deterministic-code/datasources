{"file":"docs/examples/enriched-contacts-write/contacts.repository.integration.test.writes-enriched-contact.typescript","test":"typescript/providers/sqlite/tests/contacts.repository.integration.test.ts#writes-enriched-contact","from":92,"to":133,"schema":"contacts","raw":"  it(\"writes enriched contact\", async () => {\n    const connection = SqliteConnection.from({ DATASOURCE_URL: \"sqlite:///:memory:\" });\n    await connection.open();\n    const command = new SqliteCommand(connection);\n    await applySchema(connection, \"contacts\");\n    for (const sql of statementsOf(readFileSync(seedPath, \"utf8\")))\n      await command.executeNative(new Native(sql));\n\n    const contactsRepo = new CRUDRepository(connection, {\n      type: Contact,\n      entityMapper: contactEntity,\n      columnMappings: columns,\n      ids: [\"Id\"],\n    });\n    const typesRepo = new CRUDRepository(connection, { type: ContactType, entityMapper: snake, columnMappings: columns, ids: [\"Id\"] });\n    const sourcesRepo = new CRUDRepository(connection, { type: ContactSource, entityMapper: snake, columnMappings: columns, ids: [\"Id\"] });\n    const addressTypesRepo = new CRUDRepository(connection, { type: AddressType, entityMapper: snake, columnMappings: columns, ids: [\"Id\"] });\n    const phoneTypesRepo = new CRUDRepository(connection, { type: PhoneType, entityMapper: snake, columnMappings: columns, ids: [\"Id\"] });\n    const addressesRepo = new CRUDRepository(connection, { type: Address, entityMapper: snake, columnMappings: columns, ids: [\"Id\"] });\n    const phonesRepo = new CRUDRepository(connection, { type: Phone, entityMapper: snake, columnMappings: columns, ids: [\"Id\"] });\n    addressesRepo.addEnriched({ into: \"AddressType\", from: \"AddressType\", by: \"Id\" }, addressTypesRepo);\n    phonesRepo.addEnriched({ into: \"PhoneType\", from: \"PhoneType\", by: \"Id\" }, phoneTypesRepo);\n    contactsRepo.addEnriched({ into: \"ContactType\", from: \"ContactType\", by: \"Id\" }, typesRepo);\n    contactsRepo.addEnriched({ into: \"ContactSource\", from: \"ContactSource\", by: \"Id\" }, sourcesRepo);\n    contactsRepo.addEnriched({ into: \"Addresses\", from: \"Id\", by: \"Contact\", many: true }, addressesRepo);\n    contactsRepo.addEnriched({ into: \"Phones\", from: \"Id\", by: \"Contact\", many: true }, phonesRepo);\n\n    const created = await contactsRepo.create(extraContact(await contactLookupIds(connection)));\n    const loaded = await contactsRepo.readSingle(new Where(new Operator.Equals(\"Id\", created.Id)));\n    expect(created.Id).toBeGreaterThan(0);\n    expect(loaded?.FirstName).toBe(\"Extra\");\n    expect(loaded?.ContactType.Name).toBe(\"Person\");\n    expect(loaded?.ContactSource.Name).toBe(\"Web\");\n    expect(loaded?.Addresses).toHaveLength(1);\n    expect(loaded?.Addresses[0]?.Line1).toBe(\"9 Extra\");\n    expect(loaded?.Addresses[0]?.AddressType.Name).toBe(\"Home\");\n    expect(loaded?.Addresses[0]?.Contact.Id).toBe(loaded?.Id);\n    expect(loaded?.Phones).toHaveLength(1);\n    expect(loaded?.Phones[0]?.Number).toBe(\"555-extra\");\n    expect(loaded?.Phones[0]?.PhoneType.Name).toBe(\"Mobile\");\n    expect(loaded?.Phones[0]?.Contact.Id).toBe(loaded?.Id);\n  });"}
{"file":"docs/examples/enriched-contacts-write/contacts.writes_enriched_contact.rust","test":"rust/providers/sqlite/tests/contacts.rs#writes_enriched_contact","from":129,"to":273,"schema":"contacts","raw":"#[tokio::test]\nasync fn writes_enriched_contact() {\n    let conn = Arc::new(SqliteConnection::new(Some(\":memory:\".into())));\n    conn.open().await.unwrap();\n    apply_schema(conn.as_ref(), \"contacts\").await.unwrap();\n    let command = SqliteCommand::new(conn.clone());\n    let sql = statements_of(&contact_seed(\"sqlite\"));\n    apply_sql(&command, &sql).await.unwrap();\n\n    let field = super::converters::field;\n    let named = [\"Id\", \"Uuid\", \"Created\", \"Updated\", \"Version\", \"Name\", \"Description\"];\n    let address = [\n        \"Id\", \"Uuid\", \"Created\", \"Updated\", \"Version\", \"Contact\", \"AddressType\", \"Line1\", \"Line2\",\n        \"City\", \"Region\", \"PostalCode\", \"Country\",\n    ];\n    let phone = [\n        \"Id\", \"Uuid\", \"Created\", \"Updated\", \"Version\", \"Contact\", \"PhoneType\", \"Number\",\n    ];\n    let base = [\n        \"Id\", \"Uuid\", \"Created\", \"Updated\", \"Version\", \"ContactSource\", \"ContactType\", \"FirstName\",\n        \"LastName\", \"Email\", \"Notes\",\n    ];\n    let mut addresses_repo = contact_repo(conn.clone(), \"Address\", &address, false, field);\n    addresses_repo.add_enriched(\n        datasources::Enrichment::new(\"AddressType\", \"AddressType\", \"Id\", None, false),\n        as_readonly(Arc::new(contact_repo(conn.clone(), \"AddressType\", &named, false, field))),\n        None,\n    );\n    let mut phones_repo = contact_repo(conn.clone(), \"Phone\", &phone, false, field);\n    phones_repo.add_enriched(\n        datasources::Enrichment::new(\"PhoneType\", \"PhoneType\", \"Id\", None, false),\n        as_readonly(Arc::new(contact_repo(conn.clone(), \"PhoneType\", &named, false, field))),\n        None,\n    );\n    let mut contacts_repo = contact_repo(conn.clone(), \"Contact\", &base, true, field);\n    contacts_repo\n        .add_enriched(\n            datasources::Enrichment::new(\"ContactType\", \"ContactType\", \"Id\", None, false),\n            as_readonly(Arc::new(contact_repo(conn.clone(), \"ContactType\", &named, false, field))),\n            None,\n        )\n        .add_enriched(\n            datasources::Enrichment::new(\"ContactSource\", \"ContactSource\", \"Id\", None, false),\n            as_readonly(Arc::new(contact_repo(conn.clone(), \"ContactSource\", &named, false, field))),\n            None,\n        )\n        .add_enriched(\n            datasources::Enrichment::new(\"Addresses\", \"Id\", \"Contact\", None, true),\n            Arc::new(addresses_repo),\n            None,\n        )\n        .add_enriched(\n            datasources::Enrichment::new(\"Phones\", \"Id\", \"Contact\", None, true),\n            Arc::new(phones_repo),\n            None,\n        );\n\n    let ids = contact_lookup_ids(conn).await.unwrap();\n    let stamp = Value::DateTime(\n        chrono::DateTime::parse_from_rfc3339(\"2024-01-01T00:00:00Z\")\n            .expect(\"stamp\")\n            .with_timezone(&chrono::Utc),\n    );\n    let version = Value::Binary(vec![]);\n    let mut created = contact_row(&[\n        (\"Uuid\", Value::Uuid(uuid::Uuid::new_v4())),\n        (\"Created\", stamp.clone()),\n        (\"Updated\", stamp.clone()),\n        (\"Version\", version.clone()),\n        (\"ContactSource\", Value::Int(ids.contact_source_id)),\n        (\"ContactType\", Value::Int(ids.contact_type_id)),\n        (\"FirstName\", Value::from(\"Extra\")),\n        (\"LastName\", Value::from(\"Contact\")),\n        (\n            \"Addresses\",\n            encode_rows(&[contact_row(&[\n                (\"Uuid\", Value::Uuid(uuid::Uuid::new_v4())),\n                (\"Created\", stamp.clone()),\n                (\"Updated\", stamp.clone()),\n                (\"Version\", version.clone()),\n                (\"AddressType\", Value::Int(ids.address_type_id)),\n                (\"Line1\", Value::from(\"9 Extra\")),\n                (\"City\", Value::from(\"Oslo\")),\n            ])]),\n        ),\n        (\n            \"Phones\",\n            encode_rows(&[contact_row(&[\n                (\"Uuid\", Value::Uuid(uuid::Uuid::new_v4())),\n                (\"Created\", stamp.clone()),\n                (\"Updated\", stamp),\n                (\"Version\", version),\n                (\"PhoneType\", Value::Int(ids.phone_type_id)),\n                (\"Number\", Value::from(\"555-extra\")),\n            ])]),\n        ),\n    ]);\n    let created = contacts_repo.create(&mut created).await.unwrap();\n    let Value::Int(id) = created.get(\"Id\").cloned().unwrap_or(Value::Null) else {\n        panic!(\"expected insert id\");\n    };\n    let loaded = contacts_repo\n        .read_single(\n            Some(&Where::new(Operator::equals(\"Id\", Value::Int(id)))),\n            None,\n        )\n        .await\n        .unwrap()\n        .unwrap();\n    assert_eq!(loaded.get(\"FirstName\"), Some(&Value::from(\"Extra\")));\n    assert!(loaded\n        .get(\"ContactType\")\n        .unwrap()\n        .wire_text()\n        .contains(\"Name=Person\")\n        || loaded.get(\"ContactType\").unwrap().wire_text().contains(\"Name%3DPerson\"));\n    assert!(loaded\n        .get(\"ContactSource\")\n        .unwrap()\n        .wire_text()\n        .contains(\"Name=Web\")\n        || loaded.get(\"ContactSource\").unwrap().wire_text().contains(\"Name%3DWeb\"));\n    assert!(loaded\n        .get(\"Addresses\")\n        .unwrap()\n        .wire_text()\n        .contains(\"Line1=9 Extra\"));\n    assert!(loaded\n        .get(\"Addresses\")\n        .unwrap()\n        .wire_text()\n        .contains(\"Name=Home\")\n        || loaded.get(\"Addresses\").unwrap().wire_text().contains(\"Name%3DHome\"));\n    assert!(loaded\n        .get(\"Phones\")\n        .unwrap()\n        .wire_text()\n        .contains(\"Number=555-extra\"));\n    assert!(loaded\n        .get(\"Phones\")\n        .unwrap()\n        .wire_text()\n        .contains(\"Name=Mobile\")\n        || loaded.get(\"Phones\").unwrap().wire_text().contains(\"Name%3DMobile\"));\n}"}
{"file":"docs/examples/enriched-contacts-write/ContactsRepositoryTests.WritesEnrichedContact.csharp","test":"csharp/Providers/Sqlite.Tests/ContactsRepositoryTests.cs#WritesEnrichedContact","from":73,"to":149,"schema":"contacts","raw":"    [Fact]\n    public async Task WritesEnrichedContact()\n    {\n        var conn = new SqliteConnection(new SqliteConnectionOptions\n        {\n            Filename = \":memory:\",\n        });\n        await conn.Open();\n        var command = new SqliteCommand(conn);\n        await SchemaSpec.Apply(conn, \"contacts\");\n        foreach (var sql in StatementsOf(File.ReadAllText(SeedPath())))\n            await command.Execute(new Native(sql));\n\n        var contactsRepo = new CRUDRepository<Contact>(conn, new CRUDRepositoryOptions<Contact>\n        {\n            EntityMapper = ContactColumns.ContactEntity,\n            ColumnMappings = ContactColumns.Columns,\n            Ids = [\"Id\"],\n        });\n        var typesRepo = new CRUDRepository<ContactType>(conn, new CRUDRepositoryOptions<ContactType>\n        {\n            EntityMapper = ContactColumns.Snake,\n            ColumnMappings = ContactColumns.Columns,\n            Ids = [\"Id\"],\n        });\n        var sourcesRepo = new CRUDRepository<ContactSource>(conn, new CRUDRepositoryOptions<ContactSource>\n        {\n            EntityMapper = ContactColumns.Snake,\n            ColumnMappings = ContactColumns.Columns,\n            Ids = [\"Id\"],\n        });\n        var addressTypesRepo = new CRUDRepository<AddressType>(conn, new CRUDRepositoryOptions<AddressType>\n        {\n            EntityMapper = ContactColumns.Snake,\n            ColumnMappings = ContactColumns.Columns,\n            Ids = [\"Id\"],\n        });\n        var phoneTypesRepo = new CRUDRepository<PhoneType>(conn, new CRUDRepositoryOptions<PhoneType>\n        {\n            EntityMapper = ContactColumns.Snake,\n            ColumnMappings = ContactColumns.Columns,\n            Ids = [\"Id\"],\n        });\n        var addressesRepo = new CRUDRepository<Address>(conn, new CRUDRepositoryOptions<Address>\n        {\n            EntityMapper = ContactColumns.Snake,\n            ColumnMappings = ContactColumns.Columns,\n            Ids = [\"Id\"],\n        });\n        var phonesRepo = new CRUDRepository<Phone>(conn, new CRUDRepositoryOptions<Phone>\n        {\n            EntityMapper = ContactColumns.Snake,\n            ColumnMappings = ContactColumns.Columns,\n            Ids = [\"Id\"],\n        });\n        addressesRepo.AddEnriched(new(\"AddressType\", \"AddressType\", \"Id\"), addressTypesRepo);\n        phonesRepo.AddEnriched(new(\"PhoneType\", \"PhoneType\", \"Id\"), phoneTypesRepo);\n        contactsRepo.AddEnriched(new(\"ContactType\", \"ContactType\", \"Id\"), typesRepo);\n        contactsRepo.AddEnriched(new(\"ContactSource\", \"ContactSource\", \"Id\"), sourcesRepo);\n        contactsRepo.AddEnriched(new(\"Addresses\", \"Id\", \"Contact\", Many: true), addressesRepo);\n        contactsRepo.AddEnriched(new(\"Phones\", \"Id\", \"Contact\", Many: true), phonesRepo);\n\n        var created = await contactsRepo.Create(ExtraContact.New(await ContactLookupIds.Resolve(conn)));\n        var loaded = await contactsRepo.ReadSingle(new Where(\"Id\", eq, created.Id));\n\n        Assert.True(created.Id > 0);\n        Assert.NotNull(loaded);\n        Assert.Equal(\"Extra\", loaded.FirstName);\n        Assert.Equal(\"Person\", loaded.ContactType.Name);\n        Assert.Equal(\"Web\", loaded.ContactSource.Name);\n        Assert.Equal(\"9 Extra\", Assert.Single(loaded.Addresses).Line1);\n        Assert.Equal(\"Home\", loaded.Addresses[0].AddressType.Name);\n        Assert.Equal(loaded.Id, loaded.Addresses[0].Contact.Id);\n        Assert.Equal(\"555-extra\", Assert.Single(loaded.Phones).Number);\n        Assert.Equal(\"Mobile\", loaded.Phones[0].PhoneType.Name);\n        Assert.Equal(loaded.Id, loaded.Phones[0].Contact.Id);\n    }"}
{"file":"docs/examples/enriched-crud/readonly_repository.updates_users_view_when_the_version_matches.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#updates_users_view_when_the_version_matches","from":750,"to":867,"schema":"user-view-version","raw":"    #[tokio::test]\n    async fn updates_users_view_when_the_version_matches() {\n        let built = datasource();\n        let ds: &dyn Datasource = &*built;\n        let connection = open(ds).await;\n        apply_schema(connection.as_ref(), \"user-view-version\").await.unwrap();\n        let mut users_options = create_crud_repository_options::<UsersView>();\n        users_options.ids = vec![\"Key\".into()];\n        users_options.entity_mapper = Box::new(DictionaryMapper::new([(\n            \"UsersView\".to_string(),\n            \"user\".to_string(),\n        )]));\n        users_options.column_mappings = Box::new(DictionaryMapper::new([\n            (\"Key\".to_string(), \"id\".to_string()),\n            (\"Login\".to_string(), \"username\".to_string()),\n            (\"Active\".to_string(), \"is_enabled\".to_string()),\n            (\"Opened\".to_string(), \"created\".to_string()),\n            (\"UserTypeId\".to_string(), \"user_type_id\".to_string()),\n            (\"Version\".to_string(), \"version\".to_string()),\n        ]));\n        users_options.row_converter = Some(RowTypeConverter::of::<UsersView>());\n        let casing = ChangeCasingMapper::new(Casing::Pascal, Casing::Snake);\n        let mut type_options = create_crud_repository_options::<UserType>();\n        type_options.entity_mapper =\n            Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        type_options.column_mappings = Box::new(casing);\n        type_options.row_converter = Some(RowTypeConverter::of::<UserType>());\n        let mut role_options = create_crud_repository_options::<UserRole>();\n        role_options.entity_mapper =\n            Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        role_options.column_mappings =\n            Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        role_options.row_converter = Some(RowTypeConverter::of::<UserRole>());\n        let mut users_repo = CRUDRepository::new(connection.clone(), users_options).unwrap();\n        let user_types_repo =\n            Arc::new(CRUDRepository::new(connection.clone(), type_options).unwrap());\n        let user_roles_repo = Arc::new(CRUDRepository::new(connection, role_options).unwrap());\n        users_repo.add_enriched(\n            datasources::Enrichment::new(\n                \"UserType\",\n                \"UserTypeId\",\n                \"Id\",\n                Some(\"Name\".into()),\n                false,\n            ),\n            user_types_repo.clone(),\n            None,\n        );\n        users_repo.add_enriched(\n            datasources::Enrichment::new(\"Roles\", \"Key\", \"UserId\", None, true),\n            user_roles_repo.clone(),\n            None,\n        );\n        let mut admin = datasources::Row::new();\n        admin.insert(\"Name\".into(), Value::from(\"admin\"));\n        let admin = user_types_repo.create(&mut admin).await.unwrap();\n        assert_eq!(admin.get(\"Id\"), Some(&Value::Int(1)));\n        let mut admin_role = datasources::Row::new();\n        admin_role.insert(\"Name\".into(), Value::from(\"admin\"));\n        let mut editor_role = datasources::Row::new();\n        editor_role.insert(\"Name\".into(), Value::from(\"editor\"));\n        let mut user = datasources::Row::new();\n        user.insert(\"Login\".into(), Value::from(\"ada\"));\n        user.insert(\"Active\".into(), Value::Bool(true));\n        user.insert(\"Opened\".into(), Value::from(\"2020-01-01T00:00:00.000Z\"));\n        user.insert(\"UserTypeId\".into(), admin.get(\"Id\").cloned().unwrap());\n        user.insert(\"Version\".into(), Value::Int(1));\n        user.insert(\"Roles\".into(), encode_rows(&[admin_role, editor_role]));\n        let user = users_repo.create(&mut user).await.unwrap();\n        assert_eq!(user.get(\"Key\"), Some(&Value::Int(1)));\n        let key = user.get(\"Key\").cloned().unwrap();\n        let mut loaded = users_repo\n            .read_single(Some(&Where::binary(\"Key\", eq, key.clone())), None)\n            .await\n            .unwrap()\n            .unwrap();\n        let version = loaded.get(\"Version\").cloned().unwrap();\n        loaded.insert(\"Login\".into(), Value::from(\"ada-v2\"));\n        loaded.insert(\"Version\".into(), Value::Int(2));\n        let updated = users_repo\n            .update(\n                &loaded,\n                Some(&Where::binary(\"Key\", eq, key.clone()).and(\"Version\", eq, version.clone())),\n            )\n            .await\n            .unwrap();\n        let current = users_repo\n            .read_single(Some(&Where::binary(\"Key\", eq, key.clone())), None)\n            .await\n            .unwrap()\n            .unwrap();\n        let stale = users_repo\n            .update(\n                &loaded,\n                Some(&Where::binary(\"Key\", eq, key.clone()).and(\"Version\", eq, version)),\n            )\n            .await\n            .unwrap();\n        let removed = users_repo.delete(&loaded, None).await.unwrap();\n        assert_eq!(removed.rows_affected, 1);\n        let gone = users_repo.read_single_by_id(&key).await.unwrap();\n        let roles = user_roles_repo\n            .read(Some(&Where::binary(\"UserId\", eq, key.clone())), None)\n            .await\n            .unwrap();\n        assert_eq!(admin.get(\"Id\"), Some(&Value::Int(1)));\n        assert_eq!(user.get(\"Key\"), Some(&Value::Int(1)));\n        assert_eq!(loaded.get(\"UserType\"), Some(&Value::from(\"admin\")));\n        let mut names = role_names(loaded.get(\"Roles\").unwrap());\n        names.sort();\n        assert_eq!(names, [\"admin\", \"editor\"]);\n        assert_eq!(updated.rows_affected, 1);\n        assert_eq!(current.get(\"Version\"), Some(&Value::Int(2)));\n        assert_eq!(current.get(\"Login\"), Some(&Value::from(\"ada-v2\")));\n        assert_eq!(stale.rows_affected, 0);\n        assert!(gone.is_none());\n        assert!(roles.is_empty());\n    }"}
{"file":"docs/examples/enriched-crud/readonly.repository.integration.test.updates-a-user-view-when-the-version-matches.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#updates-a-user-view-when-the-version-matches","from":269,"to":335,"schema":"user-view-version","raw":"  it(\"updates a user view when the version matches\", async () => {\n    const ds = new Datasource(\"sqlite\", new SqliteDriver(), { DATASOURCE_URL: \"sqlite:///:memory:\" });\n    const connection = await open(ds);\n    await applySchema(connection, \"user-view-version\");\n    const casing = new ChangeCasingMapper(\"pascalCase\", \"snakeCase\");\n    const usersRepo = new CRUDRepository(connection, {\n      ...createCRUDRepositoryOptions(UsersView),\n      ids: [\"Key\"],\n      readProperties: [\"Key\", \"Login\", \"Active\", \"Opened\", \"UserTypeId\", \"Version\"],\n      entityMapper: new DictionaryMapper([[\"UsersView\", \"user\"]]),\n      columnMappings: new DictionaryMapper([\n        [\"Key\", \"id\"],\n        [\"Login\", \"username\"],\n        [\"Active\", \"is_enabled\"],\n        [\"Opened\", \"created\"],\n        [\"UserTypeId\", \"user_type_id\"],\n        [\"Version\", \"version\"],\n      ]),\n    });\n    const userTypesRepo = new CRUDRepository(connection, {\n      ...createCRUDRepositoryOptions(UserType),\n      entityMapper: casing,\n      columnMappings: casing,\n    });\n    const userRolesRepo = new CRUDRepository(connection, {\n      ...createCRUDRepositoryOptions(UserRole),\n      entityMapper: casing,\n      columnMappings: casing,\n    });\n    usersRepo.addEnriched({ into: \"UserType\", from: \"UserTypeId\", by: \"Id\", select: \"Name\" }, userTypesRepo);\n    usersRepo.addEnriched({ into: \"Roles\", from: \"Key\", by: \"UserId\", many: true }, userRolesRepo);\n    const admin = await userTypesRepo.create(Object.assign(new UserType(), { Name: \"admin\" }));\n    expect(admin.Id).toBe(1);\n    const user = Object.assign(new UsersView(), {\n      Login: \"ada\",\n      Active: true,\n      Opened: \"2020-01-01T00:00:00.000Z\",\n      UserTypeId: admin.Id,\n      Version: 1,\n      Roles: [Object.assign(new UserRole(), { Name: \"admin\" }), Object.assign(new UserRole(), { Name: \"editor\" })],\n    });\n    const created = await usersRepo.create(user);\n    expect(created.Key).toBe(1);\n    const loaded = await usersRepo.readSingle(new Where(\"Key\", eq, user.Key));\n    const version = loaded!.Version;\n    loaded!.Login = \"ada-v2\";\n    loaded!.Version = version + 1;\n    const updated = await usersRepo.update(loaded!, new Where(\"Key\", eq, loaded!.Key).and(\"Version\", eq, version));\n    const current = await usersRepo.readSingle(new Where(\"Key\", eq, loaded!.Key));\n    const stale = await usersRepo.update(loaded!, new Where(\"Key\", eq, loaded!.Key).and(\"Version\", eq, version));\n    const removed = await usersRepo.delete(loaded!);\n    expect(removed.rowsAffected).toBe(1);\n    const gone = await usersRepo.readSingleById(loaded!.Key);\n    const roles: UserRole[] = [];\n    for await (const role of userRolesRepo.read(new Where(\"UserId\", eq, loaded!.Key)))\n      roles.push(role);\n    expect(admin.Id).toBe(1);\n    expect(user.Key).toBe(1);\n    expect(loaded?.UserType).toBe(\"admin\");\n    expect(loaded?.Roles.map((role) => role.Name).sort()).toEqual([\"admin\", \"editor\"]);\n    expect(updated.rowsAffected).toBe(1);\n    expect(current?.Version).toBe(2);\n    expect(current?.Login).toBe(\"ada-v2\");\n    expect(stale.rowsAffected).toBe(0);\n    expect(gone).toBeUndefined();\n    expect(roles).toEqual([]);\n  });"}
{"file":"docs/examples/enriched-crud/ReadonlyRepositoryIntegrationTests.UpdatesUsersViewWhenTheVersionMatches.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#UpdatesUsersViewWhenTheVersionMatches","from":613,"to":686,"schema":"user-view-version","raw":"    [Fact]\n    public async Task UpdatesUsersViewWhenTheVersionMatches()\n    {\n        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"DATASOURCE_URL\"] = \"sqlite:///:memory:\" });\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"user-view-version\");\n        var casing = new ChangeCasingMapper(Casing.Pascal, Casing.Snake);\n        var usersRepo = new CRUDRepository<UsersView>(connection, new CRUDRepositoryOptions<UsersView>\n        {\n            Ids = [\"Key\"],\n            ReadProperties = [\"Key\", \"Login\", \"Active\", \"Opened\", \"UserTypeId\", \"Version\"],\n            EntityMapper = new DictionaryMapper<string>(new Dictionary<string, string> { [\"UsersView\"] = \"user\" }),\n            ColumnMappings = new DictionaryMapper<string>(new Dictionary<string, string>\n            {\n                [\"Key\"] = \"id\",\n                [\"Login\"] = \"username\",\n                [\"Active\"] = \"is_enabled\",\n                [\"Opened\"] = \"created\",\n                [\"UserTypeId\"] = \"user_type_id\",\n                [\"Version\"] = \"version\",\n            }),\n        });\n        var userTypesRepo = new CRUDRepository<UserType>(connection, new CRUDRepositoryOptions<UserType>\n        {\n            Ids = [\"Id\"],\n            EntityMapper = casing,\n            ColumnMappings = casing,\n        });\n        var userRolesRepo = new CRUDRepository<UserRole>(connection, new CRUDRepositoryOptions<UserRole>\n        {\n            Ids = [],\n            EntityMapper = casing,\n            ColumnMappings = casing,\n        });\n        usersRepo.AddEnriched(new(\"UserType\", \"UserTypeId\", \"Id\", \"Name\"), userTypesRepo);\n        usersRepo.AddEnriched(new(\"Roles\", \"Key\", \"UserId\", Many: true), userRolesRepo);\n        var admin = await userTypesRepo.Create(new UserType { Name = \"admin\" });\n        Assert.Equal(1, admin.Id);\n        var user = new UsersView\n        {\n            Login = \"ada\",\n            Active = true,\n            Opened = new DateTime(2020, 1, 1, 0, 0, 0, DateTimeKind.Utc),\n            UserTypeId = admin.Id,\n            Version = 1,\n            Roles = [new UserRole { Name = \"admin\" }, new UserRole { Name = \"editor\" }],\n        };\n        var created = await usersRepo.Create(user);\n        Assert.Equal(1, created.Key);\n        var loaded = await usersRepo.ReadSingle(new Where(\"Key\", eq, user.Key));\n        var version = loaded!.Version;\n        loaded.Login = \"ada-v2\";\n        loaded.Version = version + 1;\n        var updated = await usersRepo.Update(loaded, new Where(\"Key\", eq, loaded.Key).And(\"Version\", eq, version));\n        var current = await usersRepo.ReadSingle(new Where(\"Key\", eq, loaded.Key));\n        var stale = await usersRepo.Update(loaded, new Where(\"Key\", eq, loaded.Key).And(\"Version\", eq, version));\n        var removed = await usersRepo.Delete(loaded);\n        Assert.Equal(1, removed.RowsAffected);\n        var gone = await usersRepo.ReadSingleById(loaded.Key);\n        var roles = new List<UserRole>();\n        await foreach (var role in userRolesRepo.Read(new Where(\"UserId\", eq, loaded.Key)))\n            roles.Add(role);\n\n        Assert.Equal(1, admin.Id);\n        Assert.Equal(1, user.Key);\n        Assert.Equal(\"admin\", loaded.UserType);\n        Assert.Equal([\"admin\", \"editor\"], loaded.Roles.Select(role => role.Name).OrderBy(name => name));\n        Assert.Equal(1, updated.RowsAffected);\n        Assert.Equal(2, current!.Version);\n        Assert.Equal(\"ada-v2\", current.Login);\n        Assert.Equal(0, stale.RowsAffected);\n        Assert.Null(gone);\n        Assert.Empty(roles);\n    }"}
{"file":"docs/examples/enriched-crud/user_view.create_update_and_delete_syncs_link_rows.rust","test":"rust/datasources/tests/user_view.rs#create_update_and_delete_syncs_link_rows","from":151,"to":306,"raw":"#[tokio::test]\nasync fn create_update_and_delete_syncs_link_rows() {\n    let (mut users, seeded) = open(None).await;\n    users\n        .add_enriched(\n            Enrichment::new(\"user_type\", \"user_type_id\", \"id\", None, false),\n            seeded.user_types.clone(),\n            None,\n        )\n        .add_linked(\n            Enrichment::new(\"roles\", \"id\", \"id\", None, false)\n                .linked(Association::new(\"user_id\", \"role_id\")),\n            seeded.roles.clone(),\n            seeded.user_roles.clone(),\n            None,\n        )\n        .add_linked(\n            Enrichment::new(\"groups\", \"id\", \"id\", None, false)\n                .linked(Association::new(\"user_id\", \"group_id\")),\n            seeded.groups.clone(),\n            seeded.user_groups.clone(),\n            None,\n        );\n    let created = users\n        .create(&mut ada(\n            &seeded,\n            encode_rows(&[seeded.admin_role.clone(), seeded.editor_role.clone()]),\n            encode_rows(&[seeded.engineering.clone()]),\n        ))\n        .await\n        .unwrap();\n    let created_role_links = seeded.user_roles.read(None, None).await.unwrap();\n    let created_group_links = seeded.user_groups.read(None, None).await.unwrap();\n    let mut next = ada(\n        &seeded,\n        encode_rows(&[seeded.editor_role.clone()]),\n        encode_rows(&[seeded.engineering.clone(), seeded.ops.clone()]),\n    );\n    next.insert(\"id\".into(), created.get(\"id\").unwrap().clone());\n    let saved = users.update(&next, None).await.unwrap();\n    let updated = users\n        .read_single_by_id(created.get(\"id\").unwrap())\n        .await\n        .unwrap()\n        .unwrap();\n    let updated_role_links = seeded.user_roles.read(None, None).await.unwrap();\n    let updated_group_links = seeded.user_groups.read(None, None).await.unwrap();\n    let removed = users\n        .delete(&record(&[(\"id\", created.get(\"id\").unwrap().clone())]), None)\n        .await\n        .unwrap();\n\n    assert_eq!(num(&created, \"id\") > 0, true);\n    assert_eq!(created.get(\"username\"), Some(&Value::from(\"ada\")));\n    assert_eq!(created.get(\"is_enabled\"), Some(&Value::Bool(true)));\n    assert_eq!(num(&created, \"user_type_id\"), num(&seeded.admin_type, \"id\"));\n    assert_eq!(\n        contains_id(&created, \"user_type\", num(&seeded.admin_type, \"id\")),\n        true\n    );\n    assert_eq!(\n        contains_id(&created, \"roles\", num(&seeded.admin_role, \"id\")),\n        true\n    );\n    assert_eq!(\n        contains_id(&created, \"roles\", num(&seeded.editor_role, \"id\")),\n        true\n    );\n    assert_eq!(\n        contains_id(&created, \"groups\", num(&seeded.engineering, \"id\")),\n        true\n    );\n    assert_eq!(\n        ints(&created_role_links, \"user_id\"),\n        vec![num(&created, \"id\"), num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&created_role_links, \"role_id\"),\n        ints(\n            &[seeded.admin_role.clone(), seeded.editor_role.clone()],\n            \"id\"\n        )\n    );\n    assert_eq!(\n        ints(&created_group_links, \"user_id\"),\n        vec![num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&created_group_links, \"group_id\"),\n        vec![num(&seeded.engineering, \"id\")]\n    );\n    assert_eq!(saved.rows_affected, 1);\n    assert_eq!(num(&updated, \"id\"), num(&created, \"id\"));\n    assert_eq!(updated.get(\"username\"), Some(&Value::from(\"ada\")));\n    assert_eq!(updated.get(\"is_enabled\"), Some(&Value::Bool(true)));\n    assert_eq!(num(&updated, \"user_type_id\"), num(&seeded.admin_type, \"id\"));\n    assert_eq!(\n        contains_id(&updated, \"roles\", num(&seeded.editor_role, \"id\")),\n        true\n    );\n    assert_eq!(\n        contains_id(&updated, \"roles\", num(&seeded.admin_role, \"id\")),\n        false\n    );\n    assert_eq!(\n        contains_id(&updated, \"groups\", num(&seeded.engineering, \"id\")),\n        true\n    );\n    assert_eq!(\n        contains_id(&updated, \"groups\", num(&seeded.ops, \"id\")),\n        true\n    );\n    assert_eq!(\n        ints(&updated_role_links, \"user_id\"),\n        vec![num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&updated_role_links, \"role_id\"),\n        vec![num(&seeded.editor_role, \"id\")]\n    );\n    assert_eq!(\n        ints(&updated_group_links, \"user_id\"),\n        vec![num(&created, \"id\"), num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&updated_group_links, \"group_id\"),\n        ints(&[seeded.engineering.clone(), seeded.ops.clone()], \"id\")\n    );\n    assert_eq!(removed.rows_affected, 1);\n    assert_eq!(users.read(None, None).await.unwrap().is_empty(), true);\n    assert_eq!(\n        seeded.user_roles.read(None, None).await.unwrap().is_empty(),\n        true\n    );\n    assert_eq!(\n        seeded\n            .user_groups\n            .read(None, None)\n            .await\n            .unwrap()\n            .is_empty(),\n        true\n    );\n    assert_eq!(\n        names(&seeded.roles.read(None, None).await.unwrap()),\n        vec![\"admin\".to_string(), \"editor\".to_string()]\n    );\n    assert_eq!(\n        names(&seeded.groups.read(None, None).await.unwrap()),\n        vec![\"engineering\".to_string(), \"ops\".to_string()]\n    );\n    assert_eq!(\n        seeded.user_types.read(None, None).await.unwrap()[0][\"name\"],\n        Value::from(\"admin\")\n    );\n}"}
{"file":"docs/examples/enriched-crud/UserViewCRUDRepository.test.creates-updates-and-deletes-through-link-rows.typescript","test":"typescript/datasources/src/UserViewCRUDRepository.test.ts#creates-updates-and-deletes-through-link-rows","from":107,"to":172,"raw":"  it(\"creates, updates, and deletes through link rows\", async () => {\n    const seeded = await graph();\n    const usersRepo = seeded.usersRepo;\n    usersRepo.addEnriched({ into: \"user_type\", from: \"user_type_id\", by: \"id\" }, seeded.userTypesRepo);\n    usersRepo.addLinked(\n      { into: \"roles\", from: \"id\", by: \"id\", association: { parent: \"user_id\", related: \"role_id\" } },\n      seeded.rolesRepo,\n      seeded.userRolesRepo,\n    );\n    usersRepo.addLinked(\n      { into: \"groups\", from: \"id\", by: \"id\", association: { parent: \"user_id\", related: \"group_id\" } },\n      seeded.groupsRepo,\n      seeded.userGroupsRepo,\n    );\n    const created = await usersRepo.create(Object.assign(new UserView(), {\n      username: \"ada\",\n      is_enabled: true,\n      user_type_id: seeded.adminType.id,\n      roles: [seeded.adminRole, seeded.editorRole],\n      groups: [seeded.engineering],\n    }));\n    const createdRoleLinks = await collectAsync(seeded.userRolesRepo.read());\n    const createdGroupLinks = await collectAsync(seeded.userGroupsRepo.read());\n    const saved = await usersRepo.update(Object.assign(new UserView(), {\n      id: created.id,\n      username: \"ada\",\n      is_enabled: true,\n      user_type_id: seeded.adminType.id,\n      roles: [seeded.editorRole],\n      groups: [seeded.engineering, seeded.ops],\n    }));\n    const updated = await usersRepo.readSingleById(created.id);\n    const updatedRoleLinks = await collectAsync(seeded.userRolesRepo.read());\n    const updatedGroupLinks = await collectAsync(seeded.userGroupsRepo.read());\n    const removed = await usersRepo.delete(Object.assign(new UserView(), { id: created.id }));\n\n    expect(created.id > 0).toEqual(true);\n    expect(created.username).toEqual(\"ada\");\n    expect(created.is_enabled).toEqual(true);\n    expect(created.user_type_id).toEqual(seeded.adminType.id);\n    expect(created.user_type?.name).toEqual(\"admin\");\n    expect(ids(created.roles?.map((role) => role.id) ?? [])).toEqual(ids([seeded.adminRole.id, seeded.editorRole.id]));\n    expect(created.groups?.map((group) => group.name)).toEqual([\"engineering\"]);\n    expect(createdRoleLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id, created.id]);\n    expect(ids(createdRoleLinks.map((linkRow) => linkRow.role_id))).toEqual(ids([seeded.adminRole.id, seeded.editorRole.id]));\n    expect(createdGroupLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id]);\n    expect(createdGroupLinks.map((linkRow) => linkRow.group_id)).toEqual([seeded.engineering.id]);\n    expect(saved.rowsAffected).toEqual(1);\n    expect(updated?.id).toEqual(created.id);\n    expect(updated?.username).toEqual(\"ada\");\n    expect(updated?.is_enabled).toEqual(true);\n    expect(updated?.user_type_id).toEqual(seeded.adminType.id);\n    expect(updated?.roles?.map((role) => role.id)).toEqual([seeded.editorRole.id]);\n    expect(ids(updated?.groups?.map((group) => group.id) ?? [])).toEqual(ids([seeded.engineering.id, seeded.ops.id]));\n    expect(updatedRoleLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id]);\n    expect(updatedRoleLinks.map((linkRow) => linkRow.role_id)).toEqual([seeded.editorRole.id]);\n    expect(updatedGroupLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id, created.id]);\n    expect(ids(updatedGroupLinks.map((linkRow) => linkRow.group_id))).toEqual(ids([seeded.engineering.id, seeded.ops.id]));\n    expect(removed.rowsAffected).toEqual(1);\n    expect(await collectAsync(usersRepo.read())).toEqual([]);\n    expect(await collectAsync(seeded.userRolesRepo.read())).toEqual([]);\n    expect(await collectAsync(seeded.userGroupsRepo.read())).toEqual([]);\n    expect((await collectAsync(seeded.rolesRepo.read())).map((role) => role.name).sort()).toEqual([\"admin\", \"editor\"]);\n    expect((await collectAsync(seeded.groupsRepo.read())).map((group) => group.name).sort()).toEqual([\"engineering\", \"ops\"]);\n    expect((await collectAsync(seeded.userTypesRepo.read())).map((type) => type.name)).toEqual([\"admin\"]);\n  });"}
{"file":"docs/examples/enriched-crud/UserViewCRUDRepositoryTests.CreateUpdateAndDeleteSyncsLinkRows.csharp","test":"csharp/Providers/Sqlite.Tests/UserViewCRUDRepositoryTests.cs#CreateUpdateAndDeleteSyncsLinkRows","from":135,"to":210,"schema":"user-view-links","raw":"    [Fact]\n    public async Task CreateUpdateAndDeleteSyncsLinkRows()\n    {\n        var ds = Datasource.Default;\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"user-view-links\");\n        var graph = await GraphAsync(connection);\n        var usersRepo = graph.UsersRepo;\n        usersRepo.AddEnriched(new(\"UserType\", \"UserTypeId\", \"Id\"), graph.UserTypesRepo);\n        usersRepo.AddLinked(new(\"Roles\", \"Id\", \"Id\", Association: new(\"UserId\", \"RoleId\")), graph.RolesRepo, graph.UserRolesRepo);\n        usersRepo.AddLinked(new(\"Groups\", \"Id\", \"Id\", Association: new(\"UserId\", \"GroupId\")), graph.GroupsRepo, graph.UserGroupsRepo);\n        var created = await usersRepo.Create(new UserView\n        {\n            Username = \"ada\",\n            IsEnabled = true,\n            UserTypeId = graph.AdminType.Id,\n            Roles = [graph.AdminRole, graph.EditorRole],\n            Groups = [graph.Engineering],\n        });\n        var createdRoleLinks = await graph.UserRolesRepo.Read().ToListAsync();\n        var createdGroupLinks = await graph.UserGroupsRepo.Read().ToListAsync();\n        var saved = await usersRepo.Update(new UserView\n        {\n            Id = created.Id,\n            Username = \"ada\",\n            IsEnabled = true,\n            UserTypeId = graph.AdminType.Id,\n            Roles = [graph.EditorRole],\n            Groups = [graph.Engineering, graph.Ops],\n        });\n        var updated = await usersRepo.ReadSingleById(created.Id);\n        var updatedRoleLinks = await graph.UserRolesRepo.Read().ToListAsync();\n        var updatedGroupLinks = await graph.UserGroupsRepo.Read().ToListAsync();\n        var removed = await usersRepo.Delete(new UserView { Id = created.Id });\n\n        Assert.True(created.Id > 0);\n        Assert.Equal(\"ada\", created.Username);\n        Assert.True(created.IsEnabled);\n        Assert.Equal(graph.AdminType.Id, created.UserTypeId);\n        Assert.Equal(\"admin\", created.UserType!.Name);\n        Assert.Equal([\"admin\", \"editor\"], created.Roles!.Select(role => role.Name).OrderBy(name => name));\n        Assert.Equal(\n            new[] { graph.AdminRole.Id, graph.EditorRole.Id }.OrderBy(id => id),\n            created.Roles!.Select(role => role.Id).OrderBy(id => id));\n        Assert.Equal([\"engineering\"], created.Groups!.Select(group => group.Name));\n        Assert.Equal([graph.Engineering.Id], created.Groups!.Select(group => group.Id));\n        Assert.Equal([created.Id, created.Id], createdRoleLinks.Select(link => link.UserId));\n        Assert.Equal(\n            new[] { graph.AdminRole.Id, graph.EditorRole.Id }.OrderBy(id => id),\n            createdRoleLinks.Select(link => link.RoleId).OrderBy(id => id));\n        Assert.Equal((created.Id, graph.Engineering.Id), (createdGroupLinks[0].UserId, createdGroupLinks[0].GroupId));\n        Assert.Equal(1, saved.RowsAffected);\n        Assert.Equal(created.Id, updated!.Id);\n        Assert.Equal(\"ada\", updated.Username);\n        Assert.True(updated.IsEnabled);\n        Assert.Equal(graph.AdminType.Id, updated.UserTypeId);\n        Assert.Equal([\"editor\"], updated.Roles!.Select(role => role.Name));\n        Assert.Equal([graph.EditorRole.Id], updated.Roles!.Select(role => role.Id));\n        Assert.Equal([\"engineering\", \"ops\"], updated.Groups!.Select(group => group.Name).OrderBy(name => name));\n        Assert.Equal(\n            new[] { graph.Engineering.Id, graph.Ops.Id }.OrderBy(id => id),\n            updated.Groups!.Select(group => group.Id).OrderBy(id => id));\n        Assert.Equal([created.Id], updatedRoleLinks.Select(link => link.UserId));\n        Assert.Equal([graph.EditorRole.Id], updatedRoleLinks.Select(link => link.RoleId));\n        Assert.Equal([created.Id, created.Id], updatedGroupLinks.Select(link => link.UserId));\n        Assert.Equal(\n            new[] { graph.Engineering.Id, graph.Ops.Id }.OrderBy(id => id),\n            updatedGroupLinks.Select(link => link.GroupId).OrderBy(id => id));\n        Assert.Equal(1, removed.RowsAffected);\n        Assert.Empty(await usersRepo.Read().ToListAsync());\n        Assert.Empty(await graph.UserRolesRepo.Read().ToListAsync());\n        Assert.Empty(await graph.UserGroupsRepo.Read().ToListAsync());\n        Assert.Equal([\"admin\", \"editor\"], (await graph.RolesRepo.Read().ToListAsync()).Select(role => role.Name).OrderBy(name => name));\n        Assert.Equal([\"engineering\", \"ops\"], (await graph.GroupsRepo.Read().ToListAsync()).Select(group => group.Name).OrderBy(name => name));\n        Assert.Equal(\"admin\", Assert.Single(await graph.UserTypesRepo.Read().ToListAsync()).Name);\n    }"}
{"file":"docs/examples/enriched-readonly/readonly_repository.fills_user_type_on_user_view.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#fills_user_type_on_user_view","from":274,"to":346,"schema":"user-type-lookup","raw":"    #[tokio::test]\n    async fn fills_user_type_on_user_view() {\n        let built = datasource();\n        let ds: &dyn Datasource = &*built;\n        let connection = open(ds).await;\n        apply_schema(connection.as_ref(), \"user-type-lookup\").await.unwrap();\n        execute_sql(\n            &connection,\n            &format!(\n                \"\n            INSERT INTO user_type (id, name) VALUES\n                (1, 'admin'),\n                (2, 'user'),\n                (3, 'service');\n            INSERT INTO user (id, username, is_enabled, created, user_type_id) VALUES\n                ('{ADA}', 'ada', 1, '2020-01-01T00:00:00.000Z', 1),\n                ('{GRACE}', 'grace', 1, '2024-06-01T00:00:00.000Z', 2),\n                ('{LIN}', 'lin', 0, '2024-06-01T00:00:00.000Z', 3);\n            \"\n            ),\n        )\n        .await;\n        let mut users_options = create_crud_repository_options::<UserAccount>();\n        users_options.entity = \"user\".into();\n        users_options.column_mappings = Box::new(DictionaryMapper::new([\n            (\"Key\".to_string(), \"id\".to_string()),\n            (\"Login\".to_string(), \"username\".to_string()),\n            (\"Active\".to_string(), \"is_enabled\".to_string()),\n            (\"Opened\".to_string(), \"created\".to_string()),\n            (\"UserTypeId\".to_string(), \"user_type_id\".to_string()),\n        ]));\n        let mut type_options = create_crud_repository_options::<UserType>();\n        type_options.entity = \"UserType\".into();\n        type_options.entity_mapper =\n            Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        type_options.column_mappings =\n            Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        let mut users_repo =\n            ReadonlyRepository::new(connection.clone(), users_options.read).unwrap();\n        let types =\n            ds.create_readonly_repository::<UserType>(Some(connection), Some(type_options.read));\n        users_repo.add_enriched(\n            datasources::Enrichment::new(\n                \"UserType\",\n                \"UserTypeId\",\n                \"Id\",\n                Some(\"Name\".into()),\n                false,\n            ),\n            types,\n            None,\n        );\n        let account = users_repo\n            .read_single(\n                Some(&Where::binary(\"Key\", eq, Uuid::parse_str(ADA).unwrap())),\n                None,\n            )\n            .await\n            .unwrap()\n            .unwrap();\n        let mut users_view = account.clone();\n        users_view.remove(\"UserTypeId\");\n        assert_eq!(account.get(\"UserTypeId\"), Some(&Value::Int(1)));\n        assert_eq!(users_view.get(\"UserType\"), Some(&Value::from(\"admin\")));\n        assert_eq!(users_view.get(\"Login\"), Some(&Value::from(\"ada\")));\n        assert_eq!(users_view.get(\"Key\"), Some(&Value::from(ADA)));\n        assert_eq!(users_view.get(\"Active\"), Some(&Value::Bool(true)));\n        assert_eq!(\n            users_view.get(\"Opened\"),\n            Some(&Value::from(\"2020-01-01T00:00:00.000Z\"))\n        );\n        assert!(users_view.get(\"UserTypeId\").is_none());\n    }"}
{"file":"docs/examples/enriched-readonly/readonly.repository.integration.test.fills-user-type-on-a-user-view.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#fills-user-type-on-a-user-view","from":164,"to":201,"schema":"user-type-lookup","raw":"  it(\"fills user type on a user view\", async () => {\n    const ds = new Datasource(\"sqlite\", new SqliteDriver(), { DATASOURCE_URL: \"sqlite:///:memory:\" });\n    const connection = await open(ds);\n    await applySchema(connection, \"user-type-lookup\");\n    await executeSql(connection, `\n      INSERT INTO user_type (id, name) VALUES\n        (1, 'admin'),\n        (2, 'user'),\n        (3, 'service');\n      INSERT INTO user (id, username, is_enabled, created, user_type_id) VALUES\n        ('${ada}', 'ada', 1, '2020-01-01T00:00:00.000Z', 1),\n        ('${grace}', 'grace', 1, '2024-06-01T00:00:00.000Z', 2),\n        ('${lin}', 'lin', 0, '2024-06-01T00:00:00.000Z', 3);\n    `);\n    const casing = new ChangeCasingMapper(\"pascalCase\", \"snakeCase\");\n    const usersRepo = ds.createReadonlyRepository(UsersView, connection, {\n      entityMapper: new DictionaryMapper([[\"UsersView\", \"user\"]]),\n      columnMappings: new DictionaryMapper([\n        [\"Key\", \"id\"],\n        [\"Login\", \"username\"],\n        [\"Active\", \"is_enabled\"],\n        [\"Opened\", \"created\"],\n        [\"UserType\", \"user_type_id\"],\n      ]),\n    }) as ReadonlyRepository<UsersView>;\n    const typesRepo = ds.createReadonlyRepository(UserType, connection, {\n      entityMapper: casing,\n      columnMappings: casing,\n    });\n    usersRepo.addEnriched({ into: \"UserType\", from: \"UserType\", by: \"Id\", select: \"Name\" }, typesRepo);\n    const usersView = await usersRepo.readSingle(new Where(\"Key\", eq, ada));\n    expect(usersView?.UserType).toBe(\"admin\");\n    expect(usersView?.Login).toBe(\"ada\");\n    expect(usersView?.Key).toBe(ada);\n    expect(usersView?.Active).toBe(true);\n    expect(usersView?.Opened).toBe(\"2020-01-01T00:00:00.000Z\");\n    expect(usersView === undefined || !(\"UserTypeId\" in usersView)).toBe(true);\n  });"}
{"file":"docs/examples/enriched-readonly/ReadonlyRepositoryIntegrationTests.FillsUserTypeOnUsersView.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#FillsUserTypeOnUsersView","from":185,"to":228,"schema":"user-type-lookup","raw":"    [Fact]\n    public async Task FillsUserTypeOnUsersView()\n    {\n        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"DATASOURCE_URL\"] = \"sqlite:///:memory:\" });\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"user-type-lookup\");\n        await Execute(connection, $\"\"\"\n            INSERT INTO user_type (id, name) VALUES\n                (1, 'admin'),\n                (2, 'user'),\n                (3, 'service');\n            INSERT INTO user (id, username, is_enabled, created, user_type_id) VALUES\n                ('{Ada}', 'ada', 1, '2020-01-01T00:00:00.000Z', 1),\n                ('{Grace}', 'grace', 1, '2024-06-01T00:00:00.000Z', 2),\n                ('{Lin}', 'lin', 0, '2024-06-01T00:00:00.000Z', 3);\n            \"\"\");\n        var casing = new ChangeCasingMapper(Casing.Pascal, Casing.Snake);\n        var usersRepo = (ReadonlyRepository<UsersView>)ds.CreateReadonlyRepository<UsersView>(connection, new ReadonlyRepositoryOptions<UsersView>\n        {\n            EntityMapper = new DictionaryMapper<string>(new Dictionary<string, string> { [\"UsersView\"] = \"user\" }),\n            ColumnMappings = new DictionaryMapper<string>(new Dictionary<string, string>\n            {\n                [\"Key\"] = \"id\",\n                [\"Login\"] = \"username\",\n                [\"Active\"] = \"is_enabled\",\n                [\"Opened\"] = \"created\",\n                [\"UserType\"] = \"user_type_id\",\n            }),\n        });\n        var typesRepo = ds.CreateReadonlyRepository<UserType>(connection, new ReadonlyRepositoryOptions<UserType>\n        {\n            EntityMapper = casing,\n            ColumnMappings = casing,\n        });\n        usersRepo.AddEnriched(new(\"UserType\", \"UserType\", \"Id\", \"Name\"), typesRepo);\n        var usersView = await usersRepo.ReadSingle(new Where(\"Key\", eq, Ada));\n\n        Assert.Equal(\"admin\", usersView!.UserType);\n        Assert.Equal(\"ada\", usersView.Login);\n        Assert.Equal(Ada, usersView.Key);\n        Assert.True(usersView.Active);\n        Assert.Equal(2020, usersView.Opened.Year);\n        Assert.Null(typeof(UsersView).GetProperty(\"UserTypeId\"));\n    }"}

{"file":"docs/examples/fill-a-lookup/ReadonlyRepository.test.fills-lookup-select-and-leaves-missing-default.typescript","test":"typescript/datasources/src/ReadonlyRepository.test.ts#fills-lookup-select-and-leaves-missing-default","from":94,"to":106,"raw":"  it(\"fills lookup select and leaves missing default\", async () => {\n    const person: Seed = { name: \"person\" };\n    const gone: Seed = { name: \"gone\" };\n    const typesConnection = await setup([person, gone]);\n    await remove(typesConnection, gone);\n    const connection = await setup([{ type_id: person.id }, { type_id: gone.id }]);\n    const parentsRepo = repo(Parent, connection);\n    const typesRepo = repo(UserType, typesConnection);\n    parentsRepo.addEnriched({ destinationProperty: \"TypeName\", sourceProperty: \"Type\", relatedKey: \"Id\", relatedProperty: \"Name\" }, typesRepo);\n    const items = await collectAsync(parentsRepo.read());\n    expect(items[0]?.TypeName).toBe(\"person\");\n    expect(items[1]?.TypeName).toBe(\"\");\n  });"}
{"file":"docs/examples/fill-a-lookup/ReadonlyRepositoryTests.ReadFillsLookupSelectAndLeavesMissingDefault.csharp","test":"csharp/Datasources.Tests/ReadonlyRepositoryTests.cs#ReadFillsLookupSelectAndLeavesMissingDefault","from":72,"to":88,"raw":"    [Fact]\n    public async Task ReadFillsLookupSelectAndLeavesMissingDefault()\n    {\n        var person = new Row { [\"name\"] = \"person\" };\n        var gone = new Row { [\"name\"] = \"gone\" };\n        var typesConnection = await Setup(person, gone);\n        await typesConnection.CreateCommand().Execute(\"delete\", [new Parameter(\"id\", gone[\"id\"])]);\n        var connection = await Setup(\n            new Row { [\"type_id\"] = person[\"id\"] },\n            new Row { [\"type_id\"] = gone[\"id\"] });\n        var parentsRepo = Open<Parent>(connection);\n        var typesRepo = Open<UserType>(typesConnection);\n        parentsRepo.AddEnriched(new(\"TypeName\", \"Type\", \"Id\", \"Name\"), typesRepo);\n        var items = await parentsRepo.Read().ToListAsync();\n        Assert.Equal(\"person\", items[0].TypeName);\n        Assert.Equal(\"\", items[1].TypeName);\n    }"}
{"file":"docs/examples/fill-an-output-parameter/integration.fill_output_parameter.rust","test":"rust/providers/mysql/tests/integration.rs#fill_output_parameter","from":354,"to":378,"raw":"async fn fill_output_parameter(command: &dyn Command) {\n    use datasources::{ExecuteStoredProcedureStatement, Parameter};\n    command\n        .execute_native(\n            &Native::new(\"CREATE PROCEDURE bump(IN start_n INT, OUT result INT) BEGIN SET result = start_n + 1; END\"),\n            None,\n        )\n        .await\n        .unwrap();\n    let parameters = [\n        Parameter::new(\"start_n\", 4_i64),\n        Parameter::output(\"result\"),\n    ];\n    let call = command\n        .execute_statement(\n            &ExecuteStoredProcedureStatement::new(\"bump\", &parameters),\n            Some(&parameters),\n        )\n        .await\n        .unwrap();\n    assert_eq!(\n        call.parameters.as_ref().unwrap()[1].value,\n        Value::Int(5)\n    );\n}"}
{"file":"docs/examples/fill-an-output-parameter/mysql.integration.test.fillOutputParameter.typescript","test":"typescript/providers/mysql/tests/mysql.integration.test.ts#fillOutputParameter","from":29,"to":43,"raw":"async function fillOutputParameter(command: MysqlCommand) {\n  await command.executeNative(new Native(`\n    CREATE PROCEDURE bump(IN start_n INT, OUT result INT)\n    BEGIN\n      SET result = start_n + 1;\n    END\n  `));\n  const start = { name: \"start_n\", value: 4 };\n  const result = { name: \"result\", direction: ParameterDirection.Output };\n  const call = await command.executeStatement(\n    new ExecuteStoredProcedureStatement(\"bump\", [start, result]),\n    [start, result],\n  );\n  expect(call.parameters?.[1]?.value).toBe(5);\n}"}
{"file":"docs/examples/fill-an-output-parameter/MysqlCommandIntegrationTests.FillOutputParameter.csharp","test":"csharp/Providers/Mysql.Tests/MysqlCommandIntegrationTests.cs#FillOutputParameter","from":68,"to":80,"raw":"    static async Task FillOutputParameter(ICommand command)\n    {\n        await command.Execute(Native.N(\"\"\"\n            CREATE PROCEDURE bump(IN start_n INT, OUT result INT)\n            BEGIN\n              SET result = start_n + 1;\n            END\n            \"\"\"));\n        var start = new Parameter(\"start_n\", 4);\n        var result = new Parameter(\"result\", ParameterDirection.Output);\n        var call = await command.Execute(new ExecuteStoredProcedureStatement(\"bump\", [start, result]), [start, result]);\n        Assert.Equal(new Value.Int(5), call.Parameters![1].Value);\n    }"}
{"file":"docs/examples/fill-roles-from-one-join/readonly_repository.fills_roles_from_a_join.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#fills_roles_from_a_join","from":540,"to":652,"schema":"user-roles-read","raw":"    #[tokio::test]\n    async fn fills_roles_from_a_join() {\n        let built = datasource();\n        let ds: &dyn Datasource = &*built;\n        let connection = open(ds).await;\n        apply_schema(connection.as_ref(), \"user-roles-read\")\n            .await\n            .unwrap();\n        execute_sql(&connection, &seed()).await;\n        let mut options = ReadonlyRepositoryMappingOptions::default();\n        options.entity = \"User\".into();\n        options.entity_mapper = Some(std::sync::Arc::new(DictionaryMapper::new([\n            (\"User\".into(), \"user\".into()),\n            (\"UserType\".into(), \"user_type\".into()),\n            (\"UserRole\".into(), \"user_roles\".into()),\n            (\"Role\".into(), \"roles\".into()),\n        ])));\n        options.property_mappings = Some(std::sync::Arc::new(DictionaryMapper::new([\n            (\"Key\".into(), \"id\".into()),\n            (\"Login\".into(), \"username\".into()),\n            (\"Active\".into(), \"is_enabled\".into()),\n            (\"Opened\".into(), \"created\".into()),\n            (\"UserType\".into(), \"user_type.name\".into()),\n            (\"UserTypeId\".into(), \"user_type_id\".into()),\n            (\"UserId\".into(), \"user_id\".into()),\n            (\"RoleId\".into(), \"role_id\".into()),\n            (\"Name\".into(), \"roles.name\".into()),\n            (\"Id\".into(), \"id\".into()),\n        ])));\n        let mut users_repo = ReadonlyRepository::<Row>::new(connection.clone(), options).unwrap();\n        users_repo.add_enriched(\n            datasources::Enrichment::new(\"Roles\", \"Key\", \"UserId\", None, datasources::EnrichmentPropertyType::List),\n            Arc::new(ReadonlyRepository::<Row>::new(\n                connection.clone(),\n                ReadonlyRepositoryMappingOptions::default(),\n            ).unwrap()),\n            Some(Arc::new(NestedToObjectEnrichmentStrategy::new(\n                TypeMap::new(\n                    \"Key\",\n                    vec![\n                        (\"Key\".into(), TypeMapField::column(\"Key\")),\n                        (\"Login\".into(), TypeMapField::column(\"Login\")),\n                        (\"Active\".into(), TypeMapField::column(\"Active\")),\n                        (\"Opened\".into(), TypeMapField::column(\"Opened\")),\n                        (\"UserType\".into(), TypeMapField::column(\"UserType\")),\n                        (\n                            \"Roles\".into(),\n                            TypeMapField::Group(TypeMapGroup::new(\n                                \"RoleId\",\n                                vec![\n                                    (\"RoleId\".into(), TypeMapField::column(\"RoleId\")),\n                                    (\"UserId\".into(), TypeMapField::column(\"UserId\")),\n                                    (\"Name\".into(), TypeMapField::column(\"Name\")),\n                                ],\n                            )),\n                        ),\n                    ],\n                ),\n            ))),\n        );\n        let joined = joined_users();\n        let items = users_repo.read(Some(&joined), None, None).try_collect::<Vec<_>>().await.unwrap();\n        let view = |login: &str| {\n            items\n                .iter()\n                .find(|item| item.get(\"Login\") == Some(&Value::from(login)))\n                .unwrap()\n                .clone()\n        };\n        let ada = view(\"ada\");\n        let grace = view(\"grace\");\n        let lin = view(\"lin\");\n        assert_eq!(items.len(), 3);\n        assert_eq!(ada.get(\"Key\"), Some(&Value::from(ADA)));\n        assert_eq!(ada.get(\"Login\"), Some(&Value::from(\"ada\")));\n        assert_eq!(ada.get(\"Active\"), Some(&Value::Bool(true)));\n        assert_eq!(\n            ada.get(\"Opened\"),\n            Some(&Value::from(\"2020-01-01T00:00:00.000Z\"))\n        );\n        assert_eq!(ada.get(\"UserType\"), Some(&Value::from(\"admin\")));\n        let mut names = role_names(ada.get(\"Roles\").unwrap());\n        names.sort();\n        assert_eq!(names, [\"admin\", \"editor\"]);\n        assert!(ada\n            .get(\"Roles\")\n            .unwrap()\n            .wire_text()\n            .contains(&format!(\"UserId={ADA}\")));\n        assert_eq!(grace.get(\"Key\"), Some(&Value::from(GRACE)));\n        assert_eq!(grace.get(\"Login\"), Some(&Value::from(\"grace\")));\n        assert_eq!(grace.get(\"Active\"), Some(&Value::Bool(true)));\n        assert_eq!(\n            grace.get(\"Opened\"),\n            Some(&Value::from(\"2024-06-01T00:00:00.000Z\"))\n        );\n        assert_eq!(grace.get(\"UserType\"), Some(&Value::from(\"user\")));\n        assert_eq!(role_names(grace.get(\"Roles\").unwrap()), [\"viewer\"]);\n        assert!(grace\n            .get(\"Roles\")\n            .unwrap()\n            .wire_text()\n            .contains(&format!(\"UserId={GRACE}\")));\n        assert_eq!(lin.get(\"Key\"), Some(&Value::from(LIN)));\n        assert_eq!(lin.get(\"Login\"), Some(&Value::from(\"lin\")));\n        assert_eq!(lin.get(\"Active\"), Some(&Value::Bool(false)));\n        assert_eq!(\n            lin.get(\"Opened\"),\n            Some(&Value::from(\"2024-06-01T00:00:00.000Z\"))\n        );\n        assert_eq!(lin.get(\"UserType\"), Some(&Value::from(\"service\")));\n        assert_eq!(lin.get(\"Roles\"), Some(&Value::from(\"\")));\n    }"}
{"file":"docs/examples/fill-roles-from-one-join/ReadonlyRepositoryIntegrationTests.FillsRolesFromAJoin.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#FillsRolesFromAJoin","from":465,"to":547,"schema":"user-roles-read","raw":"    [Fact]\n    public async Task FillsRolesFromAJoin()\n    {\n        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"DATASOURCE_URL\"] = \"sqlite:///:memory:\" });\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"user-roles-read\");\n        await Execute(connection, Seed());\n        var usersRepo = new ReadonlyRepository<UsersView>(connection, new ReadonlyRepositoryMappingOptions<UsersView>\n        {\n            Entity = \"User\",\n            EntityMapper = new DictionaryMapper<string>(new Dictionary<string, string>\n            {\n                [\"User\"] = \"user\",\n                [\"UserType\"] = \"user_type\",\n                [\"UserRole\"] = \"user_roles\",\n                [\"Role\"] = \"roles\",\n            }),\n            PropertyMappings = new DictionaryMapper<string>(new Dictionary<string, string>\n            {\n                [\"Key\"] = \"id\",\n                [\"Login\"] = \"username\",\n                [\"Active\"] = \"is_enabled\",\n                [\"Opened\"] = \"created\",\n                [\"UserType\"] = \"user_type.name\",\n                [\"UserTypeId\"] = \"user_type_id\",\n                [\"UserId\"] = \"user_id\",\n                [\"RoleId\"] = \"role_id\",\n                [\"Name\"] = \"roles.name\",\n                [\"Id\"] = \"id\",\n            }),\n        });\n        var joined = new SelectStatement(new()\n        {\n            Table = \"User\",\n            Fields =\n            [\n                \"User.Key\",\n                \"User.Login\",\n                \"User.Active\",\n                \"User.Opened\",\n                \"User.UserType\",\n                \"UserRole.UserId\",\n                \"UserRole.RoleId\",\n                \"Role.Name\",\n            ],\n            Joins =\n            [\n                new Join(JoinKind.Left, \"UserType\", \"UserType.Id\", \"User.UserTypeId\"),\n                new Join(JoinKind.Left, \"UserRole\", \"UserRole.UserId\", \"User.Key\"),\n                new Join(JoinKind.Left, \"Role\", \"Role.Id\", \"UserRole.RoleId\"),\n            ],\n        });\n        usersRepo.AddEnriched(\n            new(\"Roles\", \"Key\", \"UserId\", Type: EnrichmentPropertyType.List),\n            usersRepo,\n            new NestedToObjectEnrichmentStrategy<UsersView>(new TypeMap\n            {\n                Key = \"Key\",\n                Fields = new Dictionary<string, TypeMapField>\n                {\n                    [\"Key\"] = \"Key\",\n                    [\"Login\"] = \"Login\",\n                    [\"Active\"] = \"Active\",\n                    [\"Opened\"] = \"Opened\",\n                    [\"UserType\"] = \"UserType\",\n                    [\"Roles\"] = new TypeMapGroup\n                    {\n                        Key = \"RoleId\",\n                        Fields = new Dictionary<string, TypeMapField>\n                        {\n                            [\"RoleId\"] = \"RoleId\",\n                            [\"UserId\"] = \"UserId\",\n                            [\"Name\"] = \"Name\",\n                        }\n                    }\n                }\n            }));\n        var items = new List<UsersView>();\n        await foreach (var item in usersRepo.Read(joined))\n            items.Add(item);\n        var ada = Assert.Single(items, item => item.Login == \"ada\");\n        var grace = Assert.Single(items, item => item.Login == \"grace\");\n        var lin = Assert.Single(items, item => item.Login == \"lin\");"}
{"file":"docs/examples/fill-roles-from-one-join/users-view-roles.repository.integration.test.fills-roles-from-a-join.typescript","test":"typescript/providers/sqlite/tests/users-view-roles.repository.integration.test.ts#fills-roles-from-a-join","from":107,"to":165,"raw":"    const usersRepo = new ReadonlyRepository(connection, {\n      type: UsersView,\n      entity: \"User\",\n      entityMapper: new DictionaryMapper([\n        [\"User\", \"user\"],\n        [\"UserType\", \"user_type\"],\n        [\"UserRole\", \"user_roles\"],\n        [\"Role\", \"roles\"],\n      ]),\n      propertyMappings: new DictionaryMapper([\n        [\"Key\", \"id\"],\n        [\"Login\", \"username\"],\n        [\"Active\", \"is_enabled\"],\n        [\"Opened\", \"created\"],\n        [\"UserType\", \"user_type.name\"],\n        [\"UserTypeId\", \"user_type_id\"],\n        [\"UserId\", \"user_id\"],\n        [\"RoleId\", \"role_id\"],\n        [\"Name\", \"roles.name\"],\n        [\"Id\", \"id\"],\n      ]),\n    });\n    const joined = new SelectStatement({\n      table: \"User\",\n      fields: [\n        \"User.Key\",\n        \"User.Login\",\n        \"User.Active\",\n        \"User.Opened\",\n        \"User.UserType\",\n        \"UserRole.UserId\",\n        \"UserRole.RoleId\",\n        \"Role.Name\",\n      ],\n      joins: [\n        Join.left(\"UserType\", \"UserType.Id\", \"User.UserTypeId\"),\n        Join.left(\"UserRole\", \"UserRole.UserId\", \"User.Key\"),\n        Join.left(\"Role\", \"Role.Id\", \"UserRole.RoleId\"),\n      ],\n    });\n    usersRepo.addEnriched(\n      { destinationProperty: \"Roles\", sourceProperty: \"Key\", relatedKey: \"UserId\", type: \"list\" },\n      usersRepo,\n      new NestedToObjectEnrichmentStrategy<UsersView>({\n        key: \"Key\",\n        fields: {\n          Key: \"Key\",\n          Login: \"Login\",\n          Active: \"Active\",\n          Opened: \"Opened\",\n          UserType: \"UserType\",\n          Roles: {\n            key: \"RoleId\",\n            fields: { RoleId: \"RoleId\", UserId: \"UserId\", Name: \"Name\" },\n          },\n        },\n      }),\n    );\n    const items: UsersView[] = [];"}
{"file":"docs/examples/fill-with-one-query/readonly_repository.fills_roles_with_a_hashset.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#fills_roles_with_a_hashset","from":470,"to":538,"schema":"user-roles-read","raw":"    #[tokio::test]\n    async fn fills_roles_with_a_hashset() {\n        let built = datasource();\n        let ds: &dyn Datasource = &*built;\n        let connection = open(ds).await;\n        apply_schema(connection.as_ref(), \"user-roles-read\")\n            .await\n            .unwrap();\n        execute_sql(&connection, &seed()).await;\n        let mut users_options = create_readonly_repository_mapping_options::<UsersView>();\n        users_options.entity_mapper = Some(std::sync::Arc::new(DictionaryMapper::new([(\n            \"UsersView\".to_string(),\n            \"user\".to_string(),\n        )])));\n        users_options.property_mappings = Some(std::sync::Arc::new(DictionaryMapper::new([\n            (\"Key\".to_string(), \"id\".to_string()),\n            (\"Login\".to_string(), \"username\".to_string()),\n            (\"Active\".to_string(), \"is_enabled\".to_string()),\n            (\"Opened\".to_string(), \"created\".to_string()),\n            (\"UserType\".to_string(), \"user_type_id\".to_string()),\n        ])));\n        let mut type_options = create_readonly_repository_mapping_options::<UserType>();\n        type_options.entity_mapper =\n            Some(std::sync::Arc::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake)));\n        type_options.property_mappings =\n            Some(std::sync::Arc::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake)));\n        let mut role_options = create_readonly_repository_mapping_options::<UserRole>();\n        role_options.entity_mapper = Some(std::sync::Arc::new(DictionaryMapper::new([(\n            \"UserRole\".to_string(),\n            \"user_roles\".to_string(),\n        )])));\n        role_options.property_mappings = Some(std::sync::Arc::new(DictionaryMapper::new([\n            (\"UserId\".to_string(), \"user_id\".to_string()),\n            (\"Name\".to_string(), \"name\".to_string()),\n        ])));\n        let mut users_repo =\n            ReadonlyRepository::<Row>::new(connection.clone(), users_options).unwrap();\n        let types = ds.create_readonly_repository::<UserType>(\n            Some(connection.clone()),\n            Some(type_options),\n        );\n        let roles =\n            ds.create_readonly_repository::<UserRole>(Some(connection), Some(role_options));\n        let strategy = Arc::new(HashsetOptimizedReadonlyEnrichmentStrategy);\n        users_repo.add_enriched(\n            datasources::Enrichment::new(\"UserType\", \"UserType\", \"Id\", Some(\"Name\".into()), datasources::EnrichmentPropertyType::Object),\n            types,\n            Some(strategy.clone()),\n        );\n        users_repo.add_enriched(\n            datasources::Enrichment::new(\"Roles\", \"Key\", \"UserId\", None, datasources::EnrichmentPropertyType::List),\n            roles,\n            Some(strategy),\n        );\n        let users_view = users_repo\n            .read_single(Some(&Where::binary(\"Key\", eq, ADA)), None, None)\n            .await\n            .unwrap()\n            .unwrap();\n        assert_eq!(users_view.get(\"UserType\"), Some(&Value::from(\"admin\")));\n        let mut names = role_names(users_view.get(\"Roles\").unwrap());\n        names.sort();\n        assert_eq!(names, [\"admin\", \"editor\"]);\n        assert!(users_view\n            .get(\"Roles\")\n            .unwrap()\n            .wire_text()\n            .contains(&format!(\"UserId={ADA}\")));\n    }"}

{"file":"docs/examples/user-from-the-type/readonly_repository.updates_users_view_when_the_version_matches.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#updates_users_view_when_the_version_matches","from":604,"to":707,"raw":"    #[tokio::test]\n    async fn updates_users_view_when_the_version_matches() {\n        let built = datasource();\n        let ds: &dyn Datasource = &*built;\n        let connection = open(ds, \"user-view-version\", \"\")\n        .await;\n        let mut users_options = create_crud_repository_options::<UsersView>();\n        users_options.ids = vec![\"Key\".into()];\n        users_options.entity_mapper = Box::new(DictionaryMapper::new([(\n            \"UsersView\".to_string(),\n            \"user\".to_string(),\n        )]));\n        users_options.column_mappings = Box::new(DictionaryMapper::new([\n            (\"Key\".to_string(), \"id\".to_string()),\n            (\"Login\".to_string(), \"username\".to_string()),\n            (\"Active\".to_string(), \"is_enabled\".to_string()),\n            (\"Opened\".to_string(), \"created\".to_string()),\n            (\"UserTypeId\".to_string(), \"user_type_id\".to_string()),\n            (\"Version\".to_string(), \"version\".to_string()),\n        ]));\n        users_options.row_converter = Some(RowTypeConverter::of::<UsersView>());\n        let casing = ChangeCasingMapper::new(Casing::Pascal, Casing::Snake);\n        let mut type_options = create_crud_repository_options::<UserType>();\n        type_options.entity_mapper =\n            Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        type_options.column_mappings = Box::new(casing);\n        type_options.row_converter = Some(RowTypeConverter::of::<UserType>());\n        let mut role_options = create_crud_repository_options::<UserRole>();\n        role_options.entity_mapper =\n            Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        role_options.column_mappings =\n            Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        role_options.row_converter = Some(RowTypeConverter::of::<UserRole>());\n        let mut users_repo = CRUDRepository::new(connection.clone(), users_options).unwrap();\n        let user_types_repo =\n            Arc::new(CRUDRepository::new(connection.clone(), type_options).unwrap());\n        let user_roles_repo = Arc::new(CRUDRepository::new(connection, role_options).unwrap());\n        users_repo.add_enriched(datasources::Enrichment::new(\"UserType\", \"UserTypeId\", \"Id\", Some(\"Name\".into()), false), user_types_repo.clone(), None);\n        users_repo.add_enriched(datasources::Enrichment::new(\"Roles\", \"Key\", \"UserId\", None, true), user_roles_repo.clone(), None);\n        let mut admin = datasources::Row::new();\n        admin.insert(\"Name\".into(), Value::from(\"admin\"));\n        let admin = user_types_repo.create(&mut admin).await.unwrap();\n        assert_eq!(admin.get(\"Id\"), Some(&Value::Int(1)));\n        let mut admin_role = datasources::Row::new();\n        admin_role.insert(\"Name\".into(), Value::from(\"admin\"));\n        let mut editor_role = datasources::Row::new();\n        editor_role.insert(\"Name\".into(), Value::from(\"editor\"));\n        let mut user = datasources::Row::new();\n        user.insert(\"Login\".into(), Value::from(\"ada\"));\n        user.insert(\"Active\".into(), Value::Bool(true));\n        user.insert(\"Opened\".into(), Value::from(\"2020-01-01T00:00:00.000Z\"));\n        user.insert(\"UserTypeId\".into(), admin.get(\"Id\").cloned().unwrap());\n        user.insert(\"Version\".into(), Value::Int(1));\n        user.insert(\"Roles\".into(), encode_rows(&[admin_role, editor_role]));\n        let user = users_repo.create(&mut user).await.unwrap();\n        assert_eq!(user.get(\"Key\"), Some(&Value::Int(1)));\n        let key = user.get(\"Key\").cloned().unwrap();\n        let mut loaded = users_repo\n            .read_single(Some(&Where::binary(\"Key\", eq, key.clone())), None)\n            .await\n            .unwrap()\n            .unwrap();\n        let version = loaded.get(\"Version\").cloned().unwrap();\n        loaded.insert(\"Login\".into(), Value::from(\"ada-v2\"));\n        loaded.insert(\"Version\".into(), Value::Int(2));\n        let updated = users_repo\n            .update(\n                &loaded,\n                Some(&Where::binary(\"Key\", eq, key.clone()).and(\"Version\", eq, version.clone())),\n            )\n            .await\n            .unwrap();\n        let current = users_repo\n            .read_single(Some(&Where::binary(\"Key\", eq, key.clone())), None)\n            .await\n            .unwrap()\n            .unwrap();\n        let stale = users_repo\n            .update(\n                &loaded,\n                Some(&Where::binary(\"Key\", eq, key.clone()).and(\"Version\", eq, version)),\n            )\n            .await\n            .unwrap();\n        let removed = users_repo.delete(&loaded, None).await.unwrap();\n        assert_eq!(removed.rows_affected, 1);\n        let gone = users_repo.read_single_by_id(&key).await.unwrap();\n        let roles = user_roles_repo\n            .read(Some(&Where::binary(\"UserId\", eq, key.clone())), None)\n            .await\n            .unwrap();\n        assert_eq!(admin.get(\"Id\"), Some(&Value::Int(1)));\n        assert_eq!(user.get(\"Key\"), Some(&Value::Int(1)));\n        assert_eq!(loaded.get(\"UserType\"), Some(&Value::from(\"admin\")));\n        let mut names = role_names(loaded.get(\"Roles\").unwrap());\n        names.sort();\n        assert_eq!(names, [\"admin\", \"editor\"]);\n        assert_eq!(updated.rows_affected, 1);\n        assert_eq!(current.get(\"Version\"), Some(&Value::Int(2)));\n        assert_eq!(current.get(\"Login\"), Some(&Value::from(\"ada-v2\")));\n        assert_eq!(stale.rows_affected, 0);\n        assert!(gone.is_none());\n        assert!(roles.is_empty());\n    }"}
{"file":"docs/examples/user-from-the-type/readonly.repository.integration.test.writes-a-user-from-the-type.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#writes-a-user-from-the-type","from":160,"to":182,"raw":"  it(\"writes a user from the type\", async () => {\n    const ds = new Datasource(\"sqlite\", new SqliteDriver(), { filename: \":memory:\" });\n    const connection = await open(ds, \"user-pascal\");\n    const usersRepo = new CRUDRepository(User, connection);\n    const created = await usersRepo.create(Object.assign(new User(), { username: \"ada\", is_enabled: true }));\n    expect(created.id).toBe(1);\n    const byId = await usersRepo.readSingleById(created.id);\n    const matches: User[] = [];\n    for await (const row of usersRepo.read(new Where(\"username\", eq, \"ada\").and(\"is_enabled\", eq, true)))\n      matches.push(row);\n    created.username = \"ada-v2\";\n    const updated = await usersRepo.update(created);\n    expect(updated.rowsAffected).toBe(1);\n    const renamed = await usersRepo.readSingleById(created.id);\n    const removed = await usersRepo.delete(created);\n    expect(removed.rowsAffected).toBe(1);\n    const gone = await usersRepo.readSingleById(created.id);\n    expect(created.id).toBe(1);\n    expect(byId).toEqual({ id: 1, username: \"ada\", is_enabled: 1 });\n    expect(matches.map((row) => row.username)).toEqual([\"ada\"]);\n    expect(renamed?.username).toBe(\"ada-v2\");\n    expect(gone).toBeUndefined();\n  });"}
{"file":"docs/examples/user-from-the-type/ReadonlyRepositoryIntegrationTests.WritesUserFromTheType.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#WritesUserFromTheType","from":383,"to":410,"raw":"    [Fact]\n    public async Task WritesUserFromTheType()\n    {\n        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"filename\"] = \":memory:\" });\n        var connection = await Open(ds, \"user-pascal\");\n        var usersRepo = new CRUDRepository<User>(connection);\n        var created = await usersRepo.Create(new User { username = \"ada\", is_enabled = true });\n        Assert.Equal(1, created.id);\n        var byId = await usersRepo.ReadSingleById(created.id);\n        var matches = new List<User>();\n        await foreach (var row in usersRepo.Read(new Where(\"username\", eq, \"ada\").And(\"is_enabled\", eq, true)))\n            matches.Add(row);\n        created.username = \"ada-v2\";\n        var updated = await usersRepo.Update(created);\n        Assert.Equal(1, updated.RowsAffected);\n        var renamed = await usersRepo.ReadSingleById(created.id);\n        var removed = await usersRepo.Delete(created);\n        Assert.Equal(1, removed.RowsAffected);\n        var gone = await usersRepo.ReadSingleById(created.id);\n\n        Assert.Equal(1, created.id);\n        Assert.Equal(1, byId!.id);\n        Assert.Equal(\"ada\", byId.username);\n        Assert.True(byId.is_enabled);\n        Assert.Equal(\"ada\", Assert.Single(matches).username);\n        Assert.Equal(\"ada-v2\", renamed!.username);\n        Assert.Null(gone);\n    }"}

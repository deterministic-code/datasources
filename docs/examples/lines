abled\"), Some(&Value::Bool(false)));\n}"}
{"file":"docs/examples/simple-readonly/readonly_repository.snake_then_plural.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#snake_then_plural","from":46,"to":56,"raw":"fn snake_then_plural() -> TransformMapper<String, String> {\n    let snake = Arc::new(snake());\n    let forward = snake.clone();\n    let reverse = snake;\n    TransformMapper::new(\n        move |name: String| PluralizerMapper::new().map(Mapper::map(forward.as_ref(), name)),\n        move |name: String| {\n            Mapper::reverse_map(reverse.as_ref(), PluralizerMapper::new().reverse_map(name))\n        },\n    )\n}"}

{"file":"docs/examples/null-datetime-and-version/null_write.omits_null_datetime_and_version.rust","test":"rust/providers/sqlite/tests/null_write.rs#omits_null_datetime_and_version","from":24,"to":81,"raw":"#[tokio::test]\nasync fn omits_null_datetime_and_version() {\n    let conn = Arc::new(SqliteConnection::new(Some(\":memory:\".into())));\n    conn.open().await.unwrap();\n    let command = SqliteCommand::new(conn.clone());\n    for statement in datasources_sql_specs::schema_tables(\"null-write-item\", quote_ident, None) {\n        command.execute_statement(&statement, None).await.unwrap();\n    }\n    let mut options = CRUDRepositoryOptions::default();\n    options.entity = \"item\".into();\n    options.row_converter = Some(item_converter());\n    let repo = CRUDRepository::new(conn, options).unwrap();\n    let mut omitted = Row::new();\n    omitted.insert(\"name\".into(), Value::from(\"ada\"));\n    omitted.insert(\"created\".into(), Value::Null);\n    omitted.insert(\"version\".into(), Value::Null);\n    let mut omitted = repo.create(&mut omitted).await.unwrap();\n    assert!(matches!(omitted.get(\"id\"), Some(Value::Int(id)) if *id > 0));\n    let stored = repo\n        .read_single_by_id(omitted.get(\"id\").unwrap())\n        .await\n        .unwrap()\n        .unwrap();\n    omitted.insert(\"name\".into(), Value::from(\"ada-v2\"));\n    let updated = repo.update(&omitted, None).await.unwrap();\n    assert_eq!(updated.rows_affected, 1);\n    let kept = repo\n        .read_single_by_id(omitted.get(\"id\").unwrap())\n        .await\n        .unwrap()\n        .unwrap();\n    let created = Utc.with_ymd_and_hms(2024, 6, 1, 0, 0, 0).unwrap();\n    let mut explicit = Row::new();\n    explicit.insert(\"name\".into(), Value::from(\"grace\"));\n    explicit.insert(\"created\".into(), Value::DateTime(created));\n    explicit.insert(\"version\".into(), Value::Binary(vec![9, 9]));\n    let explicit = repo.create(&mut explicit).await.unwrap();\n    assert!(matches!(explicit.get(\"id\"), Some(Value::Int(id)) if *id > 0));\n    let written = repo\n        .read_single_by_id(explicit.get(\"id\").unwrap())\n        .await\n        .unwrap()\n        .unwrap();\n\n    assert_eq!(\n        stored.get(\"created\"),\n        Some(&Value::from(\"2020-01-01T00:00:00.000Z\"))\n    );\n    assert_eq!(stored.get(\"version\"), Some(&Value::Binary(vec![1, 2])));\n    assert_eq!(kept.get(\"name\"), Some(&Value::from(\"ada-v2\")));\n    assert_eq!(kept.get(\"created\"), stored.get(\"created\"));\n    assert_eq!(kept.get(\"version\"), stored.get(\"version\"));\n    assert_eq!(\n        written.get(\"created\"),\n        Some(&Value::Text(Value::iso_datetime(created)))\n    );\n    assert_eq!(written.get(\"version\"), Some(&Value::Binary(vec![9, 9])));\n}"}
{"file":"docs/examples/null-datetime-and-version/null-write.repository.integration.test.omits-null-datetime-and-version.typescript","test":"typescript/providers/sqlite/tests/null-write.repository.integration.test.ts#omits-null-datetime-and-version","from":28,"to":54,"raw":"  it(\"omits null datetime and version\", async () => {\n    const connection = await open();\n    const repo = new CRUDRepository(connection, { ...createCRUDRepositoryOptions(Item), entity: \"item\" });\n    const omitted = await repo.create(Object.assign(new Item(), { name: \"ada\" }));\n    expect(omitted.id).toBeGreaterThan(0);\n    const stored = await repo.readSingleById(omitted.id);\n    omitted.name = \"ada-v2\";\n    const updated = await repo.update(omitted);\n    expect(updated.rowsAffected).toBe(1);\n    const kept = await repo.readSingleById(omitted.id);\n    const explicit = Object.assign(new Item(), {\n      name: \"grace\",\n      created: new Date(\"2024-06-01T00:00:00.000Z\"),\n      version: new Uint8Array([9, 9]),\n    });\n    const writtenCreate = await repo.create(explicit);\n    expect(writtenCreate.id).toBeGreaterThan(0);\n    const written = await repo.readSingleById(explicit.id);\n\n    expect(stored?.created).toBe(\"2020-01-01T00:00:00.000Z\");\n    expect(bytes(stored?.version ?? null)).toEqual([1, 2]);\n    expect(kept?.name).toBe(\"ada-v2\");\n    expect(kept?.created).toBe(stored?.created);\n    expect(bytes(kept?.version ?? null)).toEqual(bytes(stored?.version ?? null));\n    expect(written?.created).toBe(\"2024-06-01T00:00:00.000Z\");\n    expect(bytes(written?.version ?? null)).toEqual([9, 9]);\n  });"}
{"file":"docs/examples/null-datetime-and-version/NullWriteTests.OmitsNullDatetimeAndVersion.csharp","test":"csharp/Providers/Sqlite.Tests/NullWriteTests.cs#OmitsNullDatetimeAndVersion","from":17,"to":46,"raw":"    [Fact]\n    public async Task OmitsNullDatetimeAndVersion()\n    {\n        var connection = await Open(\"null-write-item\");\n        var repo = new CRUDRepository<Item>(connection, new CRUDRepositoryOptions<Item> { Entity = \"item\" });\n        var omitted = await repo.Create(new Item { name = \"ada\" });\n        Assert.True(omitted.id > 0);\n        var stored = await repo.ReadSingleById(omitted.id);\n        omitted.name = \"ada-v2\";\n        var updated = await repo.Update(omitted);\n        Assert.Equal(1, updated.RowsAffected);\n        var kept = await repo.ReadSingleById(omitted.id);\n        var explicitItem = new Item\n        {\n            name = \"grace\",\n            created = new DateTime(2024, 6, 1, 0, 0, 0, DateTimeKind.Utc),\n            version = [9, 9]\n        };\n        var writtenCreate = await repo.Create(explicitItem);\n        Assert.True(writtenCreate.id > 0);\n        var written = await repo.ReadSingleById(explicitItem.id);\n\n        Assert.Equal(new DateTime(2020, 1, 1, 0, 0, 0, DateTimeKind.Utc), stored!.created);\n        Assert.Equal(new byte[] { 1, 2 }, stored.version);\n        Assert.Equal(\"ada-v2\", kept!.name);\n        Assert.Equal(stored.created, kept.created);\n        Assert.Equal(stored.version, kept.version);\n        Assert.Equal(explicitItem.created, written!.created);\n        Assert.Equal(explicitItem.version, written.version);\n    }"}

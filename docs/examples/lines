gin\".into(), Value::from(\"ada-v2\"));\n        loaded.insert(\"Version\".into(), Value::Int(2));\n        let updated = users_repo\n            .update(\n                &loaded,\n                Some(&Where::binary(\"Key\", eq, key.clone()).and(\"Version\", eq, version.clone())),\n            )\n            .await\n            .unwrap();\n        let current = users_repo\n            .read_single(Some(&Where::binary(\"Key\", eq, key.clone())), None)\n            .await\n            .unwrap()\n            .unwrap();\n        let stale = users_repo\n            .update(\n                &loaded,\n                Some(&Where::binary(\"Key\", eq, key.clone()).and(\"Version\", eq, version)),\n            )\n            .await\n            .unwrap();\n        let removed = users_repo.delete(&loaded, None).await.unwrap();\n        assert_eq!(removed.rows_affected, 1);"}
{"file":"docs/examples/users-view-with-enrichment-and-a-version/readonly.repository.integration.test.updates-a-user-view-when-the-version-matches.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#updates-a-user-view-when-the-version-matches","from":207,"to":272,"raw":"  it(\"updates a user view when the version matches\", async () => {\n    const ds = new Datasource(\"sqlite\", new SqliteDriver(), { filename: \":memory:\" });\n    const connection = await open(ds, \"user-view-version\");\n    const casing = new ChangeCasingMapper(\"pascalCase\", \"snakeCase\");\n    const usersRepo = new CRUDRepository(connection, {\n      ...createCRUDRepositoryOptions(UsersView),\n      ids: [\"Key\"],\n      readProperties: [\"Key\", \"Login\", \"Active\", \"Opened\", \"UserTypeId\", \"Version\"],\n      entityMapper: new DictionaryMapper([[\"UsersView\", \"user\"]]),\n      columnMappings: new DictionaryMapper([\n        [\"Key\", \"id\"],\n        [\"Login\", \"username\"],\n        [\"Active\", \"is_enabled\"],\n        [\"Opened\", \"created\"],\n        [\"UserTypeId\", \"user_type_id\"],\n        [\"Version\", \"version\"],\n      ]),\n    });\n    const userTypesRepo = new CRUDRepository(connection, {\n      ...createCRUDRepositoryOptions(UserType),\n      entityMapper: casing,\n      columnMappings: casing,\n    });\n    const userRolesRepo = new CRUDRepository(connection, {\n      ...createCRUDRepositoryOptions(UserRole),\n      entityMapper: casing,\n      columnMappings: casing,\n    });\n    usersRepo.addEnriched({ into: \"UserType\", from: \"UserTypeId\", by: \"Id\", select: \"Name\" }, userTypesRepo);\n    usersRepo.addEnriched({ into: \"Roles\", from: \"Key\", by: \"UserId\", many: true }, userRolesRepo);\n    const admin = await userTypesRepo.create(Object.assign(new UserType(), { Name: \"admin\" }));\n    expect(admin.Id).toBe(1);\n    const user = Object.assign(new UsersView(), {\n      Login: \"ada\",\n      Active: true,\n      Opened: \"2020-01-01T00:00:00.000Z\",\n      UserTypeId: admin.Id,\n      Version: 1,\n      Roles: [Object.assign(new UserRole(), { Name: \"admin\" }), Object.assign(new UserRole(), { Name: \"editor\" })],\n    });\n    const created = await usersRepo.create(user);\n    expect(created.Key).toBe(1);\n    const loaded = await usersRepo.readSingle(new Where(\"Key\", eq, user.Key));\n    const version = loaded!.Version;\n    loaded!.Login = \"ada-v2\";\n    loaded!.Version = version + 1;\n    const updated = await usersRepo.update(loaded!, new Where(\"Key\", eq, loaded!.Key).and(\"Version\", eq, version));\n    const current = await usersRepo.readSingle(new Where(\"Key\", eq, loaded!.Key));\n    const stale = await usersRepo.update(loaded!, new Where(\"Key\", eq, loaded!.Key).and(\"Version\", eq, version));\n    const removed = await usersRepo.delete(loaded!);\n    expect(removed.rowsAffected).toBe(1);\n    const gone = await usersRepo.readSingleById(loaded!.Key);\n    const roles: UserRole[] = [];\n    for await (const role of userRolesRepo.read(new Where(\"UserId\", eq, loaded!.Key)))\n      roles.push(role);\n    expect(admin.Id).toBe(1);\n    expect(user.Key).toBe(1);\n    expect(loaded?.UserType).toBe(\"admin\");\n    expect(loaded?.Roles.map((role) => role.Name).sort()).toEqual([\"admin\", \"editor\"]);\n    expect(updated.rowsAffected).toBe(1);\n    expect(current?.Version).toBe(2);\n    expect(current?.Login).toBe(\"ada-v2\");\n    expect(stale.rowsAffected).toBe(0);\n    expect(gone).toBeUndefined();\n    expect(roles).toEqual([]);\n  });"}
{"file":"docs/examples/users-view-with-enrichment-and-a-version/ReadonlyRepositoryIntegrationTests.UpdatesUsersViewWhenTheVersionMatches.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#UpdatesUsersViewWhenTheVersionMatches","from":451,"to":523,"raw":"    [Fact]\n    public async Task UpdatesUsersViewWhenTheVersionMatches()\n    {\n        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"filename\"] = \":memory:\" });\n        var connection = await Open(ds, \"user-view-version\");\n        var casing = new ChangeCasingMapper(Casing.Pascal, Casing.Snake);\n        var usersRepo = new CRUDRepository<UsersView>(connection, new CRUDRepositoryOptions<UsersView>\n        {\n            Ids = [\"Key\"],\n            ReadProperties = [\"Key\", \"Login\", \"Active\", \"Opened\", \"UserTypeId\", \"Version\"],\n            EntityMapper = new DictionaryMapper<string>(new Dictionary<string, string> { [\"UsersView\"] = \"user\" }),\n            ColumnMappings = new DictionaryMapper<string>(new Dictionary<string, string>\n            {\n                [\"Key\"] = \"id\",\n                [\"Login\"] = \"username\",\n                [\"Active\"] = \"is_enabled\",\n                [\"Opened\"] = \"created\",\n                [\"UserTypeId\"] = \"user_type_id\",\n                [\"Version\"] = \"version\",\n            }),\n        });\n        var userTypesRepo = new CRUDRepository<UserType>(connection, new CRUDRepositoryOptions<UserType>\n        {\n            Ids = [\"Id\"],\n            EntityMapper = casing,\n            ColumnMappings = casing,\n        });\n        var userRolesRepo = new CRUDRepository<UserRole>(connection, new CRUDRepositoryOptions<UserRole>\n        {\n            Ids = [],\n            EntityMapper = casing,\n            ColumnMappings = casing,\n        });\n        usersRepo.AddEnriched(new(\"UserType\", \"UserTypeId\", \"Id\", \"Name\"), userTypesRepo);\n        usersRepo.AddEnriched(new(\"Roles\", \"Key\", \"UserId\", Many: true), userRolesRepo);\n        var admin = await userTypesRepo.Create(new UserType { Name = \"admin\" });\n        Assert.Equal(1, admin.Id);\n        var user = new UsersView\n        {\n            Login = \"ada\",\n            Active = true,\n            Opened = new DateTime(2020, 1, 1, 0, 0, 0, DateTimeKind.Utc),\n            UserTypeId = admin.Id,\n            Version = 1,\n            Roles = [new UserRole { Name = \"admin\" }, new UserRole { Name = \"editor\" }],\n        };\n        var created = await usersRepo.Create(user);\n        Assert.Equal(1, created.Key);\n        var loaded = await usersRepo.ReadSingle(new Where(\"Key\", eq, user.Key));\n        var version = loaded!.Version;\n        loaded.Login = \"ada-v2\";\n        loaded.Version = version + 1;\n        var updated = await usersRepo.Update(loaded, new Where(\"Key\", eq, loaded.Key).And(\"Version\", eq, version));\n        var current = await usersRepo.ReadSingle(new Where(\"Key\", eq, loaded.Key));\n        var stale = await usersRepo.Update(loaded, new Where(\"Key\", eq, loaded.Key).And(\"Version\", eq, version));\n        var removed = await usersRepo.Delete(loaded);\n        Assert.Equal(1, removed.RowsAffected);\n        var gone = await usersRepo.ReadSingleById(loaded.Key);\n        var roles = new List<UserRole>();\n        await foreach (var role in userRolesRepo.Read(new Where(\"UserId\", eq, loaded.Key)))\n            roles.Add(role);\n\n        Assert.Equal(1, admin.Id);\n        Assert.Equal(1, user.Key);\n        Assert.Equal(\"admin\", loaded.UserType);\n        Assert.Equal([\"admin\", \"editor\"], loaded.Roles.Select(role => role.Name).OrderBy(name => name));\n        Assert.Equal(1, updated.RowsAffected);\n        Assert.Equal(2, current!.Version);\n        Assert.Equal(\"ada-v2\", current.Login);\n        Assert.Equal(0, stale.RowsAffected);\n        Assert.Null(gone);\n        Assert.Empty(roles);\n    }"}
{"file":"docs/examples/users-with-linked-roles-and-groups/user_view.create_update_and_delete_syncs_link_rows.rust","test":"rust/datasources/tests/user_view.rs#create_update_and_delete_syncs_link_rows","from":151,"to":250,"raw":"#[tokio::test]\nasync fn create_update_and_delete_syncs_link_rows() {\n    let (mut users, seeded) = open(None).await;\n    users\n        .add_enriched(\n            Enrichment::new(\"user_type\", \"user_type_id\", \"id\", None, false),\n            seeded.user_types.clone(),\n            None,\n        )\n        .add_linked(\n            Enrichment::new(\"roles\", \"id\", \"id\", None, false)\n                .linked(Association::new(\"user_id\", \"role_id\")),\n            seeded.roles.clone(),\n            seeded.user_roles.clone(),\n            None,\n        )\n        .add_linked(\n            Enrichment::new(\"groups\", \"id\", \"id\", None, false)\n                .linked(Association::new(\"user_id\", \"group_id\")),\n            seeded.groups.clone(),\n            seeded.user_groups.clone(),\n            None,\n        );\n    let created = users\n        .create(&mut ada(\n            &seeded,\n            encode_rows(&[seeded.admin_role.clone(), seeded.editor_role.clone()]),\n            encode_rows(&[seeded.engineering.clone()]),\n        ))\n        .await\n        .unwrap();\n    let created_role_links = seeded.user_roles.read(None, None).await.unwrap();\n    let created_group_links = seeded.user_groups.read(None, None).await.unwrap();\n    let mut next = ada(\n        &seeded,\n        encode_rows(&[seeded.editor_role.clone()]),\n        encode_rows(&[seeded.engineering.clone(), seeded.ops.clone()]),\n    );\n    next.insert(\"id\".into(), created.get(\"id\").unwrap().clone());\n    let saved = users.update(&next, None).await.unwrap();\n    let updated = users\n        .read_single_by_id(created.get(\"id\").unwrap())\n        .await\n        .unwrap()\n        .unwrap();\n    let updated_role_links = seeded.user_roles.read(None, None).await.unwrap();\n    let updated_group_links = seeded.user_groups.read(None, None).await.unwrap();\n    let removed = users\n        .delete(&record(&[(\"id\", created.get(\"id\").unwrap().clone())]), None)\n        .await\n        .unwrap();\n\n    assert_eq!(num(&created, \"id\") > 0, true);\n    assert_eq!(created.get(\"username\"), Some(&Value::from(\"ada\")));\n    assert_eq!(created.get(\"is_enabled\"), Some(&Value::Bool(true)));\n    assert_eq!(num(&created, \"user_type_id\"), num(&seeded.admin_type, \"id\"));\n    assert_eq!(contains_id(&created, \"user_type\", num(&seeded.admin_type, \"id\")), true);\n    assert_eq!(contains_id(&created, \"roles\", num(&seeded.admin_role, \"id\")), true);\n    assert_eq!(contains_id(&created, \"roles\", num(&seeded.editor_role, \"id\")), true);\n    assert_eq!(contains_id(&created, \"groups\", num(&seeded.engineering, \"id\")), true);\n    assert_eq!(ints(&created_role_links, \"user_id\"), vec![num(&created, \"id\"), num(&created, \"id\")]);\n    assert_eq!(\n        ints(&created_role_links, \"role_id\"),\n        ints(&[seeded.admin_role.clone(), seeded.editor_role.clone()], \"id\")\n    );\n    assert_eq!(ints(&created_group_links, \"user_id\"), vec![num(&created, \"id\")]);\n    assert_eq!(ints(&created_group_links, \"group_id\"), vec![num(&seeded.engineering, \"id\")]);\n    assert_eq!(saved.rows_affected, 1);\n    assert_eq!(num(&updated, \"id\"), num(&created, \"id\"));\n    assert_eq!(updated.get(\"username\"), Some(&Value::from(\"ada\")));\n    assert_eq!(updated.get(\"is_enabled\"), Some(&Value::Bool(true)));\n    assert_eq!(num(&updated, \"user_type_id\"), num(&seeded.admin_type, \"id\"));\n    assert_eq!(contains_id(&updated, \"roles\", num(&seeded.editor_role, \"id\")), true);\n    assert_eq!(contains_id(&updated, \"roles\", num(&seeded.admin_role, \"id\")), false);\n    assert_eq!(contains_id(&updated, \"groups\", num(&seeded.engineering, \"id\")), true);\n    assert_eq!(contains_id(&updated, \"groups\", num(&seeded.ops, \"id\")), true);\n    assert_eq!(ints(&updated_role_links, \"user_id\"), vec![num(&created, \"id\")]);\n    assert_eq!(ints(&updated_role_links, \"role_id\"), vec![num(&seeded.editor_role, \"id\")]);\n    assert_eq!(\n        ints(&updated_group_links, \"user_id\"),\n        vec![num(&created, \"id\"), num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&updated_group_links, \"group_id\"),\n        ints(&[seeded.engineering.clone(), seeded.ops.clone()], \"id\")\n    );\n    assert_eq!(removed.rows_affected, 1);\n    assert_eq!(users.read(None, None).await.unwrap().is_empty(), true);\n    assert_eq!(seeded.user_roles.read(None, None).await.unwrap().is_empty(), true);\n    assert_eq!(seeded.user_groups.read(None, None).await.unwrap().is_empty(), true);\n    assert_eq!(names(&seeded.roles.read(None, None).await.unwrap()), vec![\"admin\".to_string(), \"editor\".to_string()]);\n    assert_eq!(\n        names(&seeded.groups.read(None, None).await.unwrap()),\n        vec![\"engineering\".to_string(), \"ops\".to_string()]\n    );\n    assert_eq!(\n        seeded.user_types.read(None, None).await.unwrap()[0][\"name\"],\n        Value::from(\"admin\")\n    );\n}"}
{"file":"docs/examples/users-with-linked-roles-and-groups/UserViewCRUDRepository.test.creates-updates-and-deletes-through-link-rows.typescript","test":"typescript/datasources/src/UserViewCRUDRepository.test.ts#creates-updates-and-deletes-through-link-rows","from":107,"to":172,"raw":"  it(\"creates, updates, and deletes through link rows\", async () => {\n    const seeded = await graph();\n    const usersRepo = seeded.usersRepo;\n    usersRepo.addEnriched({ into: \"user_type\", from: \"user_type_id\", by: \"id\" }, seeded.userTypesRepo);\n    usersRepo.addLinked(\n      { into: \"roles\", from: \"id\", by: \"id\", association: { parent: \"user_id\", related: \"role_id\" } },\n      seeded.rolesRepo,\n      seeded.userRolesRepo,\n    );\n    usersRepo.addLinked(\n      { into: \"groups\", from: \"id\", by: \"id\", association: { parent: \"user_id\", related: \"group_id\" } },\n      seeded.groupsRepo,\n      seeded.userGroupsRepo,\n    );\n    const created = await usersRepo.create(Object.assign(new UserView(), {\n      username: \"ada\",\n      is_enabled: true,\n      user_type_id: seeded.adminType.id,\n      roles: [seeded.adminRole, seeded.editorRole],\n      groups: [seeded.engineering],\n    }));\n    const createdRoleLinks = await collectAsync(seeded.userRolesRepo.read());\n    const createdGroupLinks = await collectAsync(seeded.userGroupsRepo.read());\n    const saved = await usersRepo.update(Object.assign(new UserView(), {\n      id: created.id,\n      username: \"ada\",\n      is_enabled: true,\n      user_type_id: seeded.adminType.id,\n      roles: [seeded.editorRole],\n      groups: [seeded.engineering, seeded.ops],\n    }));\n    const updated = await usersRepo.readSingleById(created.id);\n    const updatedRoleLinks = await collectAsync(seeded.userRolesRepo.read());\n    const updatedGroupLinks = await collectAsync(seeded.userGroupsRepo.read());\n    const removed = await usersRepo.delete(Object.assign(new UserView(), { id: created.id }));\n\n    expect(created.id > 0).toEqual(true);\n    expect(created.username).toEqual(\"ada\");\n    expect(created.is_enabled).toEqual(true);\n    expect(created.user_type_id).toEqual(seeded.adminType.id);\n    expect(created.user_type?.name).toEqual(\"admin\");\n    expect(ids(created.roles?.map((role) => role.id) ?? [])).toEqual(ids([seeded.adminRole.id, seeded.editorRole.id]));\n    expect(created.groups?.map((group) => group.name)).toEqual([\"engineering\"]);\n    expect(createdRoleLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id, created.id]);\n    expect(ids(createdRoleLinks.map((linkRow) => linkRow.role_id))).toEqual(ids([seeded.adminRole.id, seeded.editorRole.id]));\n    expect(createdGroupLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id]);\n    expect(createdGroupLinks.map((linkRow) => linkRow.group_id)).toEqual([seeded.engineering.id]);\n    expect(saved.rowsAffected).toEqual(1);\n    expect(updated?.id).toEqual(created.id);\n    expect(updated?.username).toEqual(\"ada\");\n    expect(updated?.is_enabled).toEqual(true);\n    expect(updated?.user_type_id).toEqual(seeded.adminType.id);\n    expect(updated?.roles?.map((role) => role.id)).toEqual([seeded.editorRole.id]);\n    expect(ids(updated?.groups?.map((group) => group.id) ?? [])).toEqual(ids([seeded.engineering.id, seeded.ops.id]));\n    expect(updatedRoleLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id]);\n    expect(updatedRoleLinks.map((linkRow) => linkRow.role_id)).toEqual([seeded.editorRole.id]);\n    expect(updatedGroupLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id, created.id]);\n    expect(ids(updatedGroupLinks.map((linkRow) => linkRow.group_id))).toEqual(ids([seeded.engineering.id, seeded.ops.id]));\n    expect(removed.rowsAffected).toEqual(1);\n    expect(await collectAsync(usersRepo.read())).toEqual([]);\n    expect(await collectAsync(seeded.userRolesRepo.read())).toEqual([]);\n    expect(await collectAsync(seeded.userGroupsRepo.read())).toEqual([]);\n    expect((await collectAsync(seeded.rolesRepo.read())).map((role) => role.name).sort()).toEqual([\"admin\", \"editor\"]);\n    expect((await collectAsync(seeded.groupsRepo.read())).map((group) => group.name).sort()).toEqual([\"engineering\", \"ops\"]);\n    expect((await collectAsync(seeded.userTypesRepo.read())).map((type) => type.name)).toEqual([\"admin\"]);\n  });"}
{"file":"docs/examples/users-with-linked-roles-and-groups/UserViewCRUDRepositoryTests.CreateUpdateAndDeleteSyncsLinkRows.csharp","test":"csharp/Providers/Sqlite.Tests/UserViewCRUDRepositoryTests.cs#CreateUpdateAndDeleteSyncsLinkRows","from":120,"to":192,"raw":"    [Fact]\n    public async Task CreateUpdateAndDeleteSyncsLinkRows()\n    {\n        var graph = await GraphAsync();\n        var usersRepo = graph.UsersRepo;\n        usersRepo.AddEnriched(new(\"UserType\", \"UserTypeId\", \"Id\"), graph.UserTypesRepo);\n        usersRepo.AddLinked(new(\"Roles\", \"Id\", \"Id\", Association: new(\"UserId\", \"RoleId\")), graph.RolesRepo, graph.UserRolesRepo);\n        usersRepo.AddLinked(new(\"Groups\", \"Id\", \"Id\", Association: new(\"UserId\", \"GroupId\")), graph.GroupsRepo, graph.UserGroupsRepo);\n        var created = await usersRepo.Create(new UserView\n        {\n            Username = \"ada\",\n            IsEnabled = true,\n            UserTypeId = graph.AdminType.Id,\n            Roles = [graph.AdminRole, graph.EditorRole],\n            Groups = [graph.Engineering],\n        });\n        var createdRoleLinks = await graph.UserRolesRepo.Read().ToListAsync();\n        var createdGroupLinks = await graph.UserGroupsRepo.Read().ToListAsync();\n        var saved = await usersRepo.Update(new UserView\n        {\n            Id = created.Id,\n            Username = \"ada\",\n            IsEnabled = true,\n            UserTypeId = graph.AdminType.Id,\n            Roles = [graph.EditorRole],\n            Groups = [graph.Engineering, graph.Ops],\n        });\n        var updated = await usersRepo.ReadSingleById(created.Id);\n        var updatedRoleLinks = await graph.UserRolesRepo.Read().ToListAsync();\n        var updatedGroupLinks = await graph.UserGroupsRepo.Read().ToListAsync();\n        var removed = await usersRepo.Delete(new UserView { Id = created.Id });\n\n        Assert.True(created.Id > 0);\n        Assert.Equal(\"ada\", created.Username);\n        Assert.True(created.IsEnabled);\n        Assert.Equal(graph.AdminType.Id, created.UserTypeId);\n        Assert.Equal(\"admin\", created.UserType!.Name);\n        Assert.Equal([\"admin\", \"editor\"], created.Roles!.Select(role => role.Name).OrderBy(name => name));\n        Assert.Equal(\n            new[] { graph.AdminRole.Id, graph.EditorRole.Id }.OrderBy(id => id),\n            created.Roles!.Select(role => role.Id).OrderBy(id => id));\n        Assert.Equal([\"engineering\"], created.Groups!.Select(group => group.Name));\n        Assert.Equal([graph.Engineering.Id], created.Groups!.Select(group => group.Id));\n        Assert.Equal([created.Id, created.Id], createdRoleLinks.Select(link => link.UserId));\n        Assert.Equal(\n            new[] { graph.AdminRole.Id, graph.EditorRole.Id }.OrderBy(id => id),\n            createdRoleLinks.Select(link => link.RoleId).OrderBy(id => id));\n        Assert.Equal((created.Id, graph.Engineering.Id), (createdGroupLinks[0].UserId, createdGroupLinks[0].GroupId));\n        Assert.Equal(1, saved.RowsAffected);\n        Assert.Equal(created.Id, updated!.Id);\n        Assert.Equal(\"ada\", updated.Username);\n        Assert.True(updated.IsEnabled);\n        Assert.Equal(graph.AdminType.Id, updated.UserTypeId);\n        Assert.Equal([\"editor\"], updated.Roles!.Select(role => role.Name));\n        Assert.Equal([graph.EditorRole.Id], updated.Roles!.Select(role => role.Id));\n        Assert.Equal([\"engineering\", \"ops\"], updated.Groups!.Select(group => group.Name).OrderBy(name => name));\n        Assert.Equal(\n            new[] { graph.Engineering.Id, graph.Ops.Id }.OrderBy(id => id),\n            updated.Groups!.Select(group => group.Id).OrderBy(id => id));\n        Assert.Equal([created.Id], updatedRoleLinks.Select(link => link.UserId));\n        Assert.Equal([graph.EditorRole.Id], updatedRoleLinks.Select(link => link.RoleId));\n        Assert.Equal([created.Id, created.Id], updatedGroupLinks.Select(link => link.UserId));\n        Assert.Equal(\n            new[] { graph.Engineering.Id, graph.Ops.Id }.OrderBy(id => id),\n            updatedGroupLinks.Select(link => link.GroupId).OrderBy(id => id));\n        Assert.Equal(1, removed.RowsAffected);\n        Assert.Empty(await usersRepo.Read().ToListAsync());\n        Assert.Empty(await graph.UserRolesRepo.Read().ToListAsync());\n        Assert.Empty(await graph.UserGroupsRepo.Read().ToListAsync());\n        Assert.Equal([\"admin\", \"editor\"], (await graph.RolesRepo.Read().ToListAsync()).Select(role => role.Name).OrderBy(name => name));\n        Assert.Equal([\"engineering\", \"ops\"], (await graph.GroupsRepo.Read().ToListAsync()).Select(group => group.Name).OrderBy(name => name));\n        Assert.Equal(\"admin\", Assert.Single(await graph.UserTypesRepo.Read().ToListAsync()).Name);\n    }"}

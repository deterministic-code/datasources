{"file":"docs/examples/fill-an-output-parameter/integration.fill_output_parameter.rust","test":"rust/providers/mysql/tests/integration.rs#fill_output_parameter","from":346,"to":370,"raw":"async fn fill_output_parameter(command: &dyn Command) {\n    use datasources::{ExecuteStoredProcedureStatement, Parameter};\n    command\n        .execute_native(\n            &Native::new(\"CREATE PROCEDURE bump(IN start_n INT, OUT result INT) BEGIN SET result = start_n + 1; END\"),\n            None,\n        )\n        .await\n        .unwrap();\n    let parameters = [\n        Parameter::new(\"start_n\", 4_i64),\n        Parameter::output(\"result\"),\n    ];\n    let call = command\n        .execute_statement(\n            &ExecuteStoredProcedureStatement::new(\"bump\", &parameters),\n            Some(&parameters),\n        )\n        .await\n        .unwrap();\n    assert_eq!(\n        call.parameters.as_ref().unwrap()[1].value,\n        Value::Int(5)\n    );\n}"}
{"file":"docs/examples/fill-an-output-parameter/mysql.integration.test.fillOutputParameter.typescript","test":"typescript/providers/mysql/tests/mysql.integration.test.ts#fillOutputParameter","from":25,"to":39,"raw":"async function fillOutputParameter(command: MysqlCommand) {\n  await command.executeNative(new Native(`\n    CREATE PROCEDURE bump(IN start_n INT, OUT result INT)\n    BEGIN\n      SET result = start_n + 1;\n    END\n  `));\n  const start = { name: \"start_n\", value: 4 };\n  const result = { name: \"result\", direction: ParameterDirection.Output };\n  const call = await command.executeStatement(\n    new ExecuteStoredProcedureStatement(\"bump\", [start, result]),\n    [start, result],\n  );\n  expect(call.parameters?.[1]?.value).toBe(5);\n}"}
{"file":"docs/examples/fill-an-output-parameter/MysqlCommandIntegrationTests.FillOutputParameter.csharp","test":"csharp/Providers/Mysql.Tests/MysqlCommandIntegrationTests.cs#FillOutputParameter","from":67,"to":79,"raw":"    static async Task FillOutputParameter(ICommand command)\n    {\n        await command.Execute(Native.N(\"\"\"\n            CREATE PROCEDURE bump(IN start_n INT, OUT result INT)\n            BEGIN\n              SET result = start_n + 1;\n            END\n            \"\"\"));\n        var start = new Parameter(\"start_n\", 4);\n        var result = new Parameter(\"result\", ParameterDirection.Output);\n        var call = await command.Execute(new ExecuteStoredProcedureStatement(\"bump\", [start, result]), [start, result]);\n        Assert.Equal(new Value.Int(5), call.Parameters![1].Value);\n    }"}

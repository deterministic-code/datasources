{"file":"docs/examples/read-a-user-by-guid-username-and-created/readonly_repository.reads_user_by_guid_username_and_created.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#reads_user_by_guid_username_and_created","from":87,"to":151,"raw":"#[tokio::test]\nasync fn reads_user_by_guid_username_and_created() {\n    let built = datasource();\n    let ds: &dyn Datasource = &*built;\n    let connection = open(\n        ds,\n        \"user-account\",\n        &format!(\n            \"\n        INSERT INTO user (id, username, is_enabled, created) VALUES\n            ('{ADA}', 'ada', 1, '2020-01-01T00:00:00.000Z'),\n            ('{GRACE}', 'grace', 1, '2024-06-01T00:00:00.000Z'),\n            ('{LIN}', 'lin', 0, '2024-06-01T00:00:00.000Z');\n        \"\n        ),\n    )\n    .await;\n    let mut options = create_crud_repository_options::<UserAccount>();\n    options.entity = \"user\".into();\n    options.column_mappings = Box::new(DictionaryMapper::new([\n        (\"Key\".to_string(), \"id\".to_string()),\n        (\"Login\".to_string(), \"username\".to_string()),\n        (\"Active\".to_string(), \"is_enabled\".to_string()),\n        (\"Opened\".to_string(), \"created\".to_string()),\n    ]));\n    let repo = ds.create_readonly_repository::<UserAccount>(Some(connection), Some(options.read));\n    let opened = Utc.with_ymd_and_hms(2024, 1, 1, 0, 0, 0).unwrap();\n    let by_id = repo\n        .read_single(\n            Some(&Where::binary(\n                \"Key\",\n                eq,\n                Uuid::parse_str(ADA).unwrap(),\n            )),\n            None,\n        )\n        .await\n        .unwrap()\n        .unwrap();\n    let by_login = repo\n        .read(\n            Some(&Where::binary(\"Login\", eq, \"ada\").and(\"Active\", eq, true)),\n            None,\n        )\n        .await\n        .unwrap();\n    let later = repo\n        .read(\n            Some(&Where::binary(\"Active\", eq, true).and(\"Opened\", gt, opened)),\n            None,\n        )\n        .await\n        .unwrap();\n    assert_eq!(by_id.get(\"Login\"), Some(&Value::from(\"ada\")));\n    assert_eq!(by_id.get(\"Key\"), Some(&Value::from(ADA)));\n    assert_eq!(by_id.get(\"Active\"), Some(&Value::Int(1)));\n    assert_eq!(\n        by_id.get(\"Opened\"),\n        Some(&Value::from(\"2020-01-01T00:00:00.000Z\"))\n    );\n    assert_eq!(by_login.len(), 1);\n    assert_eq!(by_login[0].get(\"Login\"), Some(&Value::from(\"ada\")));\n    assert_eq!(later.len(), 1);\n    assert_eq!(later[0].get(\"Login\"), Some(&Value::from(\"grace\")));\n}"}
{"file":"docs/examples/read-a-user-by-guid-username-and-created/readonly.repository.integration.test.reads-user-by-guid-username-and-created.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#reads-user-by-guid-username-and-created","from":58,"to":90,"raw":"  it(\"reads user by guid username and created\", async () => {\n    const ds = new Datasource(\"sqlite\", new SqliteDriver(), { filename: \":memory:\" });\n    const connection = await open(ds, \"user-account\", `\n      INSERT INTO user (id, username, is_enabled, created) VALUES\n        ('${ada}', 'ada', 1, '2020-01-01T00:00:00.000Z'),\n        ('${grace}', 'grace', 1, '2024-06-01T00:00:00.000Z'),\n        ('${lin}', 'lin', 0, '2024-06-01T00:00:00.000Z');\n    `);\n    const repo = ds.createReadonlyRepository(UserAccount, connection, {\n      entity: \"user\",\n      columnMappings: new DictionaryMapper([\n        [\"Key\", \"id\"],\n        [\"Login\", \"username\"],\n        [\"Active\", \"is_enabled\"],\n        [\"Opened\", \"created\"],\n      ]),\n    });\n    const opened = new Date(\"2024-01-01T00:00:00.000Z\");\n    const byId = await repo.readSingle(new Where(\"Key\", eq, ada));\n    const byLogin: UserAccount[] = [];\n    for await (const row of repo.read(new Where(\"Login\", eq, \"ada\").and(\"Active\", eq, true)))\n      byLogin.push(row);\n    const later: UserAccount[] = [];\n    for await (const row of repo.read(new Where(\"Active\", eq, true).and(\"Opened\", gt, opened)))\n      later.push(row);\n    expect(byId?.Login).toBe(\"ada\");\n    expect(byId?.Key).toBe(ada);\n    expect(byId?.Active).toBe(1);\n    expect(byId?.Opened).toBe(\"2020-01-01T00:00:00.000Z\");\n    expect(byLogin.length).toBe(1);\n    expect(byLogin[0]?.Login).toBe(\"ada\");\n    expect(later.length).toBe(1);\n    expect(later[0]?.Login).toBe(\"grace\");"}
{"file":"docs/examples/read-a-user-by-guid-username-and-created/ReadonlyRepositoryIntegrationTests.ReadsUserByGuidUsernameAndCreated.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#ReadsUserByGuidUsernameAndCreated","from":55,"to":92,"raw":"    [Fact]\n    public async Task ReadsUserByGuidUsernameAndCreated()\n    {\n        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"filename\"] = \":memory:\" });\n        var connection = await Open(ds, \"user-account\", $\"\"\"\n            INSERT INTO user (id, username, is_enabled, created) VALUES\n                ('{Ada}', 'ada', 1, '2020-01-01T00:00:00.000Z'),\n                ('{Grace}', 'grace', 1, '2024-06-01T00:00:00.000Z'),\n                ('{Lin}', 'lin', 0, '2024-06-01T00:00:00.000Z');\n            \"\"\");\n        var repo = ds.CreateReadonlyRepository<UserAccount>(connection, new ReadonlyRepositoryOptions<UserAccount>\n        {\n            Entity = \"user\",\n            ColumnMappings = new DictionaryMapper<string>(new Dictionary<string, string>\n            {\n                [\"Key\"] = \"id\",\n                [\"Login\"] = \"username\",\n                [\"Active\"] = \"is_enabled\",\n                [\"Opened\"] = \"created\",\n            }),\n        });\n\n        var opened = new DateTime(2024, 1, 1, 0, 0, 0, DateTimeKind.Utc);\n        var byId = await repo.ReadSingle(new Where(\"Key\", eq, Ada));\n        var byLogin = new List<UserAccount>();\n        await foreach (var row in repo.Read(new Where(\"Login\", eq, \"ada\").And(\"Active\", eq, true)))\n            byLogin.Add(row);\n        var later = new List<UserAccount>();\n        await foreach (var row in repo.Read(new Where(\"Active\", eq, true).And(\"Opened\", gt, opened)))\n            later.Add(row);\n\n        Assert.Equal(\"ada\", byId!.Login);\n        Assert.Equal(Ada, byId.Key);\n        Assert.True(byId.Active);\n        Assert.Equal(2020, byId.Opened.Year);\n        Assert.Equal(\"ada\", Assert.Single(byLogin).Login);\n        Assert.Equal(\"grace\", Assert.Single(later).Login);\n    }"}

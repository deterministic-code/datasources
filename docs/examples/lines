{"file":"docs/examples/run-raw-sql/sqlite.integration.test.runs-raw-sql.typescript","test":"typescript/providers/sqlite/tests/sqlite.integration.test.ts#runs-raw-sql","from":104,"to":116,"schema":"items","raw":"  it(\"runs raw sql\", async () => {\n    const ds = Datasource.default;\n    await using connection = await ds.createConnection();\n    await connection.open();\n    const command = connection.createCommand();\n    await applySchema(connection, \"items\");\n    await command.execute(\"INSERT INTO items (id, name) VALUES (1, 'ada')\");\n    await using reader = await command.executeReader(\"SELECT id, name FROM items\");\n    let row: Cells | undefined;\n    if (await reader.next()) row = reader.current;\n    expect(row).toEqual({ id: 1, name: \"ada\" });\n    expect(await reader.next()).toBe(false);\n  });"}
{"file":"docs/examples/run-raw-sql/SqliteCommandIntegrationTests.RunRawSql.csharp","test":"csharp/Providers/Sqlite.Tests/SqliteCommandIntegrationTests.cs#RunRawSql","from":90,"to":105,"schema":"items","raw":"    [Fact]\n    public async Task RunRawSql()\n    {\n        var ds = Datasource.Default;\n        await using var connection = await ds.CreateConnection();\n        await connection.Open();\n        var command = connection.CreateCommand();\n        await SchemaSpec.Apply(connection, \"items\");\n        await command.Execute(\"INSERT INTO items (id, name) VALUES (1, 'ada')\");\n        await using var reader = await command.ExecuteReader(\"SELECT id, name FROM items\");\n        Row? row = null;\n        if (await reader.Next())\n            row = reader.Current;\n        Assert.Equal(new Value.Int(1), row![\"id\"]);\n        Assert.Equal(new Value.Text(\"ada\"), row[\"name\"]);\n    }"}
{"file":"docs/examples/simple-crud/readonly_repository.writes_user_from_the_type.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#writes_user_from_the_type","from":696,"to":748,"schema":"user-pascal","raw":"    #[tokio::test]\n    async fn writes_user_from_the_type() {\n        let built = datasource();\n        let ds: &dyn Datasource = &*built;\n        let connection = open(ds).await;\n        apply_schema(connection.as_ref(), \"user-pascal\").await.unwrap();\n        let mut options = create_crud_repository_options::<User>();\n        options.column_mappings = Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        options.ids = vec![\"Id\".into()];\n        let users_repo = CRUDRepository::new(connection, options).unwrap();\n        let mut created = datasources::Row::new();\n        created.insert(\"Username\".into(), Value::from(\"ada\"));\n        created.insert(\"IsEnabled\".into(), Value::Bool(true));\n        let mut created = users_repo.create(&mut created).await.unwrap();\n        let by_id = users_repo\n            .read_single_by_id(created.get(\"Id\").unwrap())\n            .await\n            .unwrap()\n            .unwrap();\n        let matches = users_repo\n            .read(\n                Some(&Where::binary(\"Username\", eq, \"ada\").and(\n                    \"IsEnabled\",\n                    eq,\n                    Value::Bool(true),\n                )),\n                None,\n            )\n            .await\n            .unwrap();\n        created.insert(\"Username\".into(), Value::from(\"ada-v2\"));\n        let updated = users_repo.update(&created, None).await.unwrap();\n        let renamed = users_repo\n            .read_single_by_id(created.get(\"Id\").unwrap())\n            .await\n            .unwrap()\n            .unwrap();\n        let removed = users_repo.delete(&created, None).await.unwrap();\n        let gone = users_repo\n            .read_single_by_id(created.get(\"Id\").unwrap())\n            .await\n            .unwrap();\n        assert!(matches!(created.get(\"Id\"), Some(Value::Int(id)) if *id > 0));\n        assert_eq!(updated.rows_affected, 1);\n        assert_eq!(removed.rows_affected, 1);\n        assert_eq!(by_id.get(\"Id\"), created.get(\"Id\"));\n        assert_eq!(by_id.get(\"Username\"), Some(&Value::from(\"ada\")));\n        assert_eq!(by_id.get(\"IsEnabled\"), Some(&Value::Bool(true)));\n        assert_eq!(matches.len(), 1);\n        assert_eq!(matches[0].get(\"Username\"), Some(&Value::from(\"ada\")));\n        assert_eq!(renamed.get(\"Username\"), Some(&Value::from(\"ada-v2\")));\n        assert!(gone.is_none());\n    }"}
{"file":"docs/examples/simple-crud/readonly.repository.integration.test.writes-a-user-from-the-type.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#writes-a-user-from-the-type","from":217,"to":244,"schema":"user-pascal","raw":"  it(\"writes a user from the type\", async () => {\n    const ds = new Datasource(\"sqlite\", new SqliteDriver(), { DATASOURCE_URL: \"sqlite:///:memory:\" });\n    const connection = await open(ds);\n    await applySchema(connection, \"user-pascal\");\n    const casing = new ChangeCasingMapper(\"pascalCase\", \"snakeCase\");\n    const usersRepo = new CRUDRepository(connection, {\n      ...createCRUDRepositoryOptions(User),\n      columnMappings: casing,\n      ids: [\"Id\"],\n    });\n    const created = await usersRepo.create(Object.assign(new User(), { Username: \"ada\", IsEnabled: true }));\n    const byId = await usersRepo.readSingleById(created.Id);\n    const matches: User[] = [];\n    for await (const row of usersRepo.read(new Where(\"Username\", eq, \"ada\").and(\"IsEnabled\", eq, true)))\n      matches.push(row);\n    created.Username = \"ada-v2\";\n    const updated = await usersRepo.update(created);\n    const renamed = await usersRepo.readSingleById(created.Id);\n    const removed = await usersRepo.delete(created);\n    const gone = await usersRepo.readSingleById(created.Id);\n    expect(created.Id).toBeGreaterThan(0);\n    expect(updated.rowsAffected).toBe(1);\n    expect(removed.rowsAffected).toBe(1);\n    expect(byId).toEqual({ Id: created.Id, Username: \"ada\", IsEnabled: true });\n    expect(matches.map((row) => row.Username)).toEqual([\"ada\"]);\n    expect(renamed?.Username).toBe(\"ada-v2\");\n    expect(gone).toBeUndefined();\n  });"}
{"file":"docs/examples/simple-crud/ReadonlyRepositoryIntegrationTests.WritesUserFromTheType.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#WritesUserFromTheType","from":479,"to":511,"schema":"user-pascal","raw":"    [Fact]\n    public async Task WritesUserFromTheType()\n    {\n        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"DATASOURCE_URL\"] = \"sqlite:///:memory:\" });\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"user-pascal\");\n        var casing = new ChangeCasingMapper(Casing.Pascal, Casing.Snake);\n        var usersRepo = new CRUDRepository<User>(connection, new CRUDRepositoryOptions<User>\n        {\n            ColumnMappings = casing,\n            Ids = [\"Id\"],\n        });\n        var created = await usersRepo.Create(new User { Username = \"ada\", IsEnabled = true });\n        var byId = await usersRepo.ReadSingleById(created.Id);\n        var matches = new List<User>();\n        await foreach (var row in usersRepo.Read(new Where(\"Username\", eq, \"ada\").And(\"IsEnabled\", eq, true)))\n            matches.Add(row);\n        created.Username = \"ada-v2\";\n        var updated = await usersRepo.Update(created);\n        var renamed = await usersRepo.ReadSingleById(created.Id);\n        var removed = await usersRepo.Delete(created);\n        var gone = await usersRepo.ReadSingleById(created.Id);\n\n        Assert.True(created.Id > 0);\n        Assert.Equal(1, updated.RowsAffected);\n        Assert.Equal(1, removed.RowsAffected);\n        Assert.Equal(created.Id, byId!.Id);\n        Assert.Equal(\"ada\", byId.Username);\n        Assert.True(byId.IsEnabled);\n        Assert.Equal(\"ada\", Assert.Single(matches).Username);\n        Assert.Equal(\"ada-v2\", renamed!.Username);\n        Assert.Null(gone);\n    }"}
{"file":"docs/examples/simple-readonly/readonly_repository.reads_users_by_id_and_by_username_and_enabled.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#reads_users_by_id_and_by_username_and_enabled","from":64,"to":100,"schema":"minimal-users","raw":"#[tokio::test]\nasync fn reads_users_by_id_and_by_username_and_enabled() {\n    let built = datasource();\n    let ds: &dyn Datasource = &*built;\n    let connection = open(ds).await;\n    apply_schema(connection.as_ref(), \"minimal-users\").await.unwrap();\n    execute_sql(\n        &connection,\n        \"\n        INSERT INTO users (id, username, is_enabled) VALUES\n            (1, 'ada', 1),\n            (2, 'grace', 0);\n        \",\n    )\n    .await;\n    let mut options = create_crud_repository_options::<User>();\n    options.entity_mapper = Box::new(snake_then_plural());\n    options.column_mappings = Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n    let repo = ds.create_readonly_repository::<User>(Some(connection), Some(options.read));\n    let by_id = repo\n        .read_single(Some(&Where::binary(\"Id\", eq, 1_i64)), None)\n        .await\n        .unwrap()\n        .unwrap();\n    let disabled = repo\n        .read(\n            Some(&Where::binary(\"Username\", eq, \"grace\").and(\"IsEnabled\", eq, 0_i64)),\n            None,\n        )\n        .await\n        .unwrap();\n    assert_eq!(by_id.get(\"Username\"), Some(&Value::from(\"ada\")));\n    assert_eq!(by_id.get(\"IsEnabled\"), Some(&Value::Bool(true)));\n    assert_eq!(disabled.len(), 1);\n    assert_eq!(disabled[0].get(\"Id\"), Some(&Value::Int(2)));\n    assert_eq!(disabled[0].get(\"IsEnabled\"), Some(&Value::Bool(false)));\n}"}
{"file":"docs/examples/simple-readonly/readonly.repository.integration.test.reads-users-by-id-and-by-username-and-enabled.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#reads-users-by-id-and-by-username-and-enabled","from":68,"to":90,"schema":"minimal-users","raw":"  it(\"reads users by id and by username and enabled\", async () => {\n    const ds = new Datasource(\"sqlite\", new SqliteDriver(), { DATASOURCE_URL: \"sqlite:///:memory:\" });\n    const connection = await open(ds);\n    await applySchema(connection, \"minimal-users\");\n    await executeSql(connection, `\n      INSERT INTO users (id, username, is_enabled) VALUES\n        (1, 'ada', 1),\n        (2, 'grace', 0);\n    `);\n    const repo = ds.createReadonlyRepository(User, connection, {\n      entityMapper: snakeThenPlural,\n      columnMappings: snake,\n    });\n    const byId = await repo.readSingle(new Where(\"Id\", eq, 1));\n    const disabled: User[] = [];\n    for await (const row of repo.read(new Where(\"Username\", eq, \"grace\").and(\"IsEnabled\", eq, 0)))\n      disabled.push(row);\n    expect(byId?.Username).toBe(\"ada\");\n    expect(byId?.IsEnabled).toBe(true);\n    expect(disabled.length).toBe(1);\n    expect(disabled[0]?.Id).toBe(2);\n    expect(disabled[0]?.IsEnabled).toBe(false);\n  });"}
{"file":"docs/examples/simple-readonly/ReadonlyRepositoryIntegrationTests.ReadsUsersByIdAndByUsernameAndEnabled.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#ReadsUsersByIdAndByUsernameAndEnabled","from":36,"to":63,"schema":"minimal-users","raw":"    [Fact]\n    public async Task ReadsUsersByIdAndByUsernameAndEnabled()\n    {\n        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"DATASOURCE_URL\"] = \"sqlite:///:memory:\" });\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"minimal-users\");\n        await Execute(connection, \"\"\"\n            INSERT INTO users (id, username, is_enabled) VALUES\n                (1, 'ada', 1),\n                (2, 'grace', 0);\n            \"\"\");\n        var repo = ds.CreateReadonlyRepository<User>(connection, new ReadonlyRepositoryOptions<User>\n        {\n            EntityMapper = SnakeThenPlural(),\n            ColumnMappings = Snake,\n        });\n\n        var byId = await repo.ReadSingle(new Where(\"Id\", eq, 1));\n        var disabled = new List<User>();\n        await foreach (var row in repo.Read(new Where(\"Username\", eq, \"grace\").And(\"IsEnabled\", eq, 0)))\n            disabled.Add(row);\n\n        Assert.Equal(\"ada\", byId!.Username);\n        Assert.True(byId.IsEnabled);\n        var grace = Assert.Single(disabled);\n        Assert.Equal(2, grace.Id);\n        Assert.False(grace.IsEnabled);\n    }"}
{"file":"docs/examples/skip-child-deletes/delete_enrichment_strategy.delete_strategy_can_skip_children.rust","test":"rust/datasources/src/delete_enrichment_strategy.rs#delete_strategy_can_skip_children","from":77,"to":102,"raw":"    #[tokio::test]\n    async fn delete_strategy_can_skip_children() {\n        let write = Arc::new(DefaultWriteEnrichmentStrategy::new(\n            Some(Arc::new(SkipDelete)),\n            None,\n            false,\n        ));\n        let children = Arc::new(CRUDRepository::memory(vec![]));\n        let mut parents = CRUDRepository::memory_with(vec![], Some(write));\n        let mut parent = Row::new();\n        let created = parents.create(&mut parent).await.unwrap();\n        let mut child = Row::new();\n        child.insert(\"parent_id\".into(), created.get(\"id\").unwrap().clone());\n        child.insert(\"label\".into(), Value::from(\"a\"));\n        children.create(&mut child).await.unwrap();\n        parents.add_enriched(\n            Enrichment::new(\"children\", \"id\", \"parent_id\", None, true),\n            children.clone(),\n            None,\n        );\n        parents.delete(&created, None).await.unwrap();\n        let left = children.read(None, None).await.unwrap();\n        assert_eq!(left.len(), 1);\n        assert_eq!(left[0].get(\"label\"), Some(&Value::from(\"a\")));\n        assert!(parents.read(None, None).await.unwrap().is_empty());\n    }"}
{"file":"docs/examples/skip-child-deletes/EnrichedCRUDRepository.test.delete-strategy-can-skip-children.typescript","test":"typescript/datasources/src/EnrichedCRUDRepository.test.ts#delete-strategy-can-skip-children","from":249,"to":265,"raw":"  it(\"delete strategy can skip children\", async () => {\n    const connection = await setup();\n    const childrenRepo = new CRUDRepository(Child, connection);\n    const parentsRepo = new CRUDRepository(connection, {\n      type: Parent,\n      write: new DefaultWriteEnrichmentStrategy(new SkipDelete()),\n    });\n    const parent = await parentsRepo.create(new Parent());\n    expect(parent.id).toBeGreaterThan(0);\n    const child = await childrenRepo.create(Object.assign(new Child(), { parent_id: parent.id, label: \"a\" }));\n    expect(child.id).toBeGreaterThan(0);\n    parentsRepo.addEnriched({ into: \"children\", from: \"id\", by: \"parent_id\", many: true }, childrenRepo);\n    const removed = await parentsRepo.delete(Object.assign(new Parent(), { id: parent.id }));\n    expect(removed.rowsAffected).toBe(1);\n    expect(await collectAsync(parentsRepo.read())).toEqual([]);\n    expect((await childrenRepo.readSingle())?.label).toBe(\"a\");\n  });"}
{"file":"docs/examples/skip-child-deletes/EnrichedCRUDRepositoryTests.DeleteStrategyCanSkipChildren.csharp","test":"csharp/Datasources.Tests/EnrichedCRUDRepositoryTests.cs#DeleteStrategyCanSkipChildren","from":218,"to":236,"raw":"    [Fact]\n    public async Task DeleteStrategyCanSkipChildren()\n    {\n        var connection = await Setup();\n        var childrenRepo = new CRUDRepository<Child>(connection);\n        var parentsRepo = new CRUDRepository<Parent>(connection, new CRUDRepositoryOptions<Parent>\n        {\n            Write = new DefaultWriteEnrichmentStrategy<Parent>(new SkipDelete<Parent>()),\n        });\n        var parent = await parentsRepo.Create(new Parent());\n        Assert.True(parent.id > 0);\n        var child = await childrenRepo.Create(new Child { parent_id = parent.id, label = \"a\" });\n        Assert.True(child.id > 0);\n        parentsRepo.AddEnriched(new(\"children\", \"id\", \"parent_id\", Many: true), childrenRepo);\n        var removed = await parentsRepo.Delete(new Parent { id = parent.id });\n        Assert.Equal(1, removed.RowsAffected);\n        Assert.Empty(await parentsRepo.Read().ToListAsync());\n        Assert.Equal(\"a\", Assert.Single(await childrenRepo.Read().ToListAsync()).label);\n    }"}
{"file":"docs/examples/skip-unloaded-lists/user_view.lazy_write_skips_unloaded_links.rust","test":"rust/datasources/tests/user_view.rs#lazy_write_skips_unloaded_links","from":459,"to":560,"raw":"#[tokio::test]\nasync fn lazy_write_skips_unloaded_links() {\n    let (mut users, seeded) = open(Some(Arc::new(LazyWriteEnrichmentStrategy::new(\n        None, None, false,\n    ))))\n    .await;\n    link(&mut users, &seeded);\n    let mut creating = record(&[\n        (\"username\", Value::from(\"ada\")),\n        (\"is_enabled\", Value::Bool(true)),\n        (\"user_type_id\", seeded.admin_type.get(\"id\").unwrap().clone()),\n        (\"groups\", encode_rows(&[seeded.engineering.clone()])),\n    ]);\n    let created = users.create(&mut creating).await.unwrap();\n    let created_role_links = seeded.user_roles.read(None, None).await.unwrap();\n    let created_group_links = seeded.user_groups.read(None, None).await.unwrap();\n    let next = record(&[\n        (\"id\", created.get(\"id\").unwrap().clone()),\n        (\"username\", Value::from(\"ada\")),\n        (\"is_enabled\", Value::Bool(false)),\n        (\"user_type_id\", seeded.admin_type.get(\"id\").unwrap().clone()),\n    ]);\n    let skipped = users.update(&next, None).await.unwrap();\n    let after_skip = users\n        .read_single_by_id(created.get(\"id\").unwrap())\n        .await\n        .unwrap()\n        .unwrap();\n    let skipped_role_links = seeded.user_roles.read(None, None).await.unwrap();\n    let skipped_group_links = seeded.user_groups.read(None, None).await.unwrap();\n    let linked_row = record(&[\n        (\"id\", created.get(\"id\").unwrap().clone()),\n        (\"username\", Value::from(\"ada\")),\n        (\"is_enabled\", Value::Bool(false)),\n        (\"user_type_id\", seeded.admin_type.get(\"id\").unwrap().clone()),\n        (\"roles\", encode_rows(&[seeded.editor_role.clone()])),\n    ]);\n    let linked = users.update(&linked_row, None).await.unwrap();\n    let linked_role_links = seeded.user_roles.read(None, None).await.unwrap();\n    let linked_group_links = seeded.user_groups.read(None, None).await.unwrap();\n    let removed = users\n        .delete(&record(&[(\"id\", created.get(\"id\").unwrap().clone())]), None)\n        .await\n        .unwrap();\n    assert_eq!(num(&created, \"id\") > 0, true);\n    assert!(created_role_links.is_empty());\n    assert_eq!(\n        ints(&created_group_links, \"user_id\"),\n        vec![num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&created_group_links, \"group_id\"),\n        vec![num(&seeded.engineering, \"id\")]\n    );\n    assert_eq!(skipped.rows_affected, 1);\n    assert_eq!(num(&after_skip, \"id\"), num(&created, \"id\"));\n    assert_eq!(after_skip.get(\"username\"), Some(&Value::from(\"ada\")));\n    assert_eq!(after_skip.get(\"is_enabled\"), Some(&Value::Bool(false)));\n    assert!(skipped_role_links.is_empty());\n    assert_eq!(\n        ints(&skipped_group_links, \"user_id\"),\n        vec![num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&skipped_group_links, \"group_id\"),\n        vec![num(&seeded.engineering, \"id\")]\n    );\n    assert_eq!(linked.rows_affected, 1);\n    assert_eq!(\n        ints(&linked_role_links, \"user_id\"),\n        vec![num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&linked_role_links, \"role_id\"),\n        vec![num(&seeded.editor_role, \"id\")]\n    );\n    assert_eq!(\n        ints(&linked_group_links, \"user_id\"),\n        vec![num(&created, \"id\")]\n    );\n    assert_eq!(\n        ints(&linked_group_links, \"group_id\"),\n        vec![num(&seeded.engineering, \"id\")]\n    );\n    assert_eq!(\n        names(&seeded.roles.read(None, None).await.unwrap()),\n        vec![\"admin\".to_string(), \"editor\".to_string()]\n    );\n    assert_eq!(\n        names(&seeded.groups.read(None, None).await.unwrap()),\n        vec![\"engineering\".to_string(), \"ops\".to_string()]\n    );\n    assert_eq!(removed.rows_affected, 1);\n    assert!(users.read(None, None).await.unwrap().is_empty());\n    assert!(seeded.user_roles.read(None, None).await.unwrap().is_empty());\n    assert!(seeded\n        .user_groups\n        .read(None, None)\n        .await\n        .unwrap()\n        .is_empty());\n}"}
{"file":"docs/examples/skip-unloaded-lists/UserViewCRUDRepository.test.lazy-write-skips-unloaded-links.typescript","test":"typescript/datasources/src/UserViewCRUDRepository.test.ts#lazy-write-skips-unloaded-links","from":248,"to":302,"raw":"  it(\"lazy write skips unloaded links\", async () => {\n    const seeded = await graph(new LazyWriteEnrichmentStrategy());\n    link(seeded.usersRepo, seeded);\n    const created = await seeded.usersRepo.create(Object.assign(new UserView(), {\n      username: \"ada\",\n      is_enabled: true,\n      user_type_id: seeded.adminType.id,\n      roles: null,\n      groups: [seeded.engineering],\n    }));\n    const createdRoleLinks = await collectAsync(seeded.userRolesRepo.read());\n    const createdGroupLinks = await collectAsync(seeded.userGroupsRepo.read());\n    const skipped = await seeded.usersRepo.update(Object.assign(new UserView(), {\n      id: created.id,\n      username: \"ada\",\n      is_enabled: false,\n      user_type_id: seeded.adminType.id,\n    }));\n    const afterSkip = await seeded.usersRepo.readSingleById(created.id);\n    const skippedRoleLinks = await collectAsync(seeded.userRolesRepo.read());\n    const skippedGroupLinks = await collectAsync(seeded.userGroupsRepo.read());\n    const linked = await seeded.usersRepo.update(Object.assign(new UserView(), {\n      id: created.id,\n      username: \"ada\",\n      is_enabled: false,\n      user_type_id: seeded.adminType.id,\n      roles: [seeded.editorRole],\n    }));\n    const linkedRoleLinks = await collectAsync(seeded.userRolesRepo.read());\n    const linkedGroupLinks = await collectAsync(seeded.userGroupsRepo.read());\n    const removed = await seeded.usersRepo.delete(Object.assign(new UserView(), { id: created.id, roles: null, groups: null }));\n\n    expect(created.id > 0).toEqual(true);\n    expect(createdRoleLinks).toEqual([]);\n    expect(createdGroupLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id]);\n    expect(createdGroupLinks.map((linkRow) => linkRow.group_id)).toEqual([seeded.engineering.id]);\n    expect(skipped.rowsAffected).toEqual(1);\n    expect(afterSkip?.id).toEqual(created.id);\n    expect(afterSkip?.username).toEqual(\"ada\");\n    expect(afterSkip?.is_enabled).toEqual(false);\n    expect(skippedRoleLinks).toEqual([]);\n    expect(skippedGroupLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id]);\n    expect(skippedGroupLinks.map((linkRow) => linkRow.group_id)).toEqual([seeded.engineering.id]);\n    expect(linked.rowsAffected).toEqual(1);\n    expect(linkedRoleLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id]);\n    expect(linkedRoleLinks.map((linkRow) => linkRow.role_id)).toEqual([seeded.editorRole.id]);\n    expect(linkedGroupLinks.map((linkRow) => linkRow.user_id)).toEqual([created.id]);\n    expect(linkedGroupLinks.map((linkRow) => linkRow.group_id)).toEqual([seeded.engineering.id]);\n    expect((await collectAsync(seeded.rolesRepo.read())).map((role) => role.name).sort()).toEqual([\"admin\", \"editor\"]);\n    expect((await collectAsync(seeded.groupsRepo.read())).map((group) => group.name).sort()).toEqual([\"engineering\", \"ops\"]);\n    expect(removed.rowsAffected).toEqual(1);\n    expect(await collectAsync(seeded.usersRepo.read())).toEqual([]);\n    expect(await collectAsync(seeded.userRolesRepo.read())).toEqual([]);\n    expect(await collectAsync(seeded.userGroupsRepo.read())).toEqual([]);\n  });"}
{"file":"docs/examples/skip-unloaded-lists/UserViewCRUDRepositoryTests.LazyCreateAndUpdateSkipUnloadedCollectionsAndDeleteCascades.csharp","test":"csharp/Providers/Sqlite.Tests/UserViewCRUDRepositoryTests.cs#LazyCreateAndUpdateSkipUnloadedCollectionsAndDeleteCascades","from":331,"to":399,"schema":"user-view-links","raw":"    [Fact]\n    public async Task LazyCreateAndUpdateSkipUnloadedCollectionsAndDeleteCascades()\n    {\n        var ds = Datasource.Default;\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"user-view-links\");\n        var graph = await GraphAsync(connection, new LazyWriteEnrichmentStrategy<UserView>());\n        var userViewRepo = Enrich(graph.UsersRepo, graph);\n\n        var created = await userViewRepo.Create(new UserView\n        {\n            Username = \"ada\",\n            IsEnabled = true,\n            UserTypeId = graph.AdminType.Id,\n            Roles = null,\n            Groups = [graph.Engineering]\n        });\n        var createdRoleLinks = await graph.UserRolesRepo.Read().ToListAsync();\n        var createdGroupLinks = await graph.UserGroupsRepo.Read().ToListAsync();\n        var skipped = await userViewRepo.Update(new UserView\n        {\n            Id = created.Id,\n            Username = \"ada\",\n            IsEnabled = false,\n            UserTypeId = graph.AdminType.Id,\n            Roles = null,\n            Groups = null\n        });\n        var afterSkip = await userViewRepo.ReadSingleById(created.Id);\n        var skippedRoleLinks = await graph.UserRolesRepo.Read().ToListAsync();\n        var skippedGroupLinks = await graph.UserGroupsRepo.Read().ToListAsync();\n        var linked = await userViewRepo.Update(new UserView\n        {\n            Id = created.Id,\n            Username = \"ada\",\n            IsEnabled = false,\n            UserTypeId = graph.AdminType.Id,\n            Roles = [graph.EditorRole],\n            Groups = null\n        });\n        var linkedRoleLinks = await graph.UserRolesRepo.Read().ToListAsync();\n        var linkedGroupLinks = await graph.UserGroupsRepo.Read().ToListAsync();\n        var roles = await graph.RolesRepo.Read().ToListAsync();\n        var groups = await graph.GroupsRepo.Read().ToListAsync();\n        var removed = await userViewRepo.Delete(new UserView { Id = created.Id, Roles = null, Groups = null });\n\n        Assert.True(created.Id > 0);\n        Assert.Empty(createdRoleLinks);\n        Assert.Equal((created.Id, graph.Engineering.Id), (createdGroupLinks[0].UserId, createdGroupLinks[0].GroupId));\n        Assert.Equal(1, skipped.RowsAffected);\n        Assert.Equal(created.Id, afterSkip!.Id);\n        Assert.Equal(\"ada\", afterSkip.Username);\n        Assert.False(afterSkip.IsEnabled);\n        Assert.Empty(skippedRoleLinks);\n        Assert.Equal((created.Id, graph.Engineering.Id), (skippedGroupLinks[0].UserId, skippedGroupLinks[0].GroupId));\n        Assert.Equal(1, linked.RowsAffected);\n        Assert.Equal([created.Id], linkedRoleLinks.Select(link => link.UserId));\n        Assert.Equal([graph.EditorRole.Id], linkedRoleLinks.Select(link => link.RoleId));\n        Assert.Equal((created.Id, graph.Engineering.Id), (linkedGroupLinks[0].UserId, linkedGroupLinks[0].GroupId));\n        Assert.Equal([\"admin\", \"editor\"], roles.Select(role => role.Name).OrderBy(name => name));\n        Assert.Equal([\"engineering\", \"ops\"], groups.Select(group => group.Name).OrderBy(name => name));\n        Assert.Equal(1, removed.RowsAffected);\n        Assert.Empty(await graph.UsersRepo.Read().ToListAsync());\n        Assert.Empty(await graph.UserRolesRepo.Read().ToListAsync());\n        Assert.Empty(await graph.UserGroupsRepo.Read().ToListAsync());\n        Assert.Equal([\"admin\", \"editor\"], (await graph.RolesRepo.Read().ToListAsync()).Select(role => role.Name).OrderBy(name => name));\n        Assert.Equal([\"engineering\", \"ops\"], (await graph.GroupsRepo.Read().ToListAsync()).Select(group => group.Name).OrderBy(name => name));\n        Assert.Equal(\"admin\", Assert.Single(await graph.UserTypesRepo.Read().ToListAsync()).Name);\n    }"}

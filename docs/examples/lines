{"file":"docs/examples/fill-roles-from-one-join/ReadonlyRepositoryIntegrationTests.FillsRolesFromAJoin.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#FillsRolesFromAJoin","from":326,"to":411,"schema":"user-roles-read","raw":"    [Fact]\n    public async Task FillsRolesFromAJoin()\n    {\n        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"DATASOURCE_URL\"] = \"sqlite:///:memory:\" });\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"user-roles-read\");\n        await Execute(connection, Seed());\n        var usersRepo = new ReadonlyRepository<UsersView>(connection, new ReadonlyRepositoryOptions<UsersView>\n        {\n            Entity = \"User\",\n            EntityMapper = new DictionaryMapper<string>(new Dictionary<string, string>\n            {\n                [\"User\"] = \"user\",\n                [\"UserType\"] = \"user_type\",\n                [\"UserRole\"] = \"user_roles\",\n                [\"Role\"] = \"roles\",\n            }),\n            ColumnMappings = new DictionaryMapper<string>(new Dictionary<string, string>\n            {\n                [\"Key\"] = \"id\",\n                [\"Login\"] = \"username\",\n                [\"Active\"] = \"is_enabled\",\n                [\"Opened\"] = \"created\",\n                [\"UserType\"] = \"user_type.name\",\n                [\"UserTypeId\"] = \"user_type_id\",\n                [\"UserId\"] = \"user_id\",\n                [\"RoleId\"] = \"role_id\",\n                [\"Name\"] = \"roles.name\",\n                [\"Id\"] = \"id\",\n            }),\n            Select = new TransformMapper<ISelectStatement, ISelectStatement>(\n                query => new SelectStatement(new()\n                {\n                    Table = \"User\",\n                    Fields =\n                    [\n                        \"User.Key\",\n                        \"User.Login\",\n                        \"User.Active\",\n                        \"User.Opened\",\n                        \"User.UserType\",\n                        \"UserRole.UserId\",\n                        \"UserRole.RoleId\",\n                        \"Role.Name\",\n                    ],\n                    Where = query.Where,\n                    Joins =\n                    [\n                        new Join(JoinKind.Left, \"UserType\", \"UserType.Id\", \"User.UserTypeId\"),\n                        new Join(JoinKind.Left, \"UserRole\", \"UserRole.UserId\", \"User.Key\"),\n                        new Join(JoinKind.Left, \"Role\", \"Role.Id\", \"UserRole.RoleId\"),\n                    ],\n                }),\n                query => query),\n        });\n        usersRepo.AddEnriched(\n            new(\"Roles\", \"Key\", \"UserId\", Many: true),\n            usersRepo,\n            new NestedToObjectEnrichmentStrategy<UsersView>(new TypeMap\n            {\n                Key = \"Key\",\n                Fields = new Dictionary<string, TypeMapField>\n                {\n                    [\"Key\"] = \"Key\",\n                    [\"Login\"] = \"Login\",\n                    [\"Active\"] = \"Active\",\n                    [\"Opened\"] = \"Opened\",\n                    [\"UserType\"] = \"UserType\",\n                    [\"Roles\"] = new TypeMapGroup\n                    {\n                        Key = \"RoleId\",\n                        Fields = new Dictionary<string, TypeMapField>\n                        {\n                            [\"RoleId\"] = \"RoleId\",\n                            [\"UserId\"] = \"UserId\",\n                            [\"Name\"] = \"Name\",\n                        }\n                    }\n                }\n            }));\n        var items = new List<UsersView>();\n        await foreach (var item in usersRepo.Read())\n            items.Add(item);\n        var ada = Assert.Single(items, item => item.Login == \"ada\");\n        var grace = Assert.Single(items, item => item.Login == \"grace\");\n        var lin = Assert.Single(items, item => item.Login == \"lin\");"}
{"file":"docs/examples/fill-roles-from-one-join/users-view-roles.repository.integration.test.fills-roles-from-a-join.typescript","test":"typescript/providers/sqlite/tests/users-view-roles.repository.integration.test.ts#fills-roles-from-a-join","from":118,"to":182,"raw":"    const usersRepo = new ReadonlyRepository(connection, {\n      type: UsersView,\n      entity: \"User\",\n      entityMapper: new DictionaryMapper([\n        [\"User\", \"user\"],\n        [\"UserType\", \"user_type\"],\n        [\"UserRole\", \"user_roles\"],\n        [\"Role\", \"roles\"],\n      ]),\n      columnMappings: new DictionaryMapper([\n        [\"Key\", \"id\"],\n        [\"Login\", \"username\"],\n        [\"Active\", \"is_enabled\"],\n        [\"Opened\", \"created\"],\n        [\"UserType\", \"user_type.name\"],\n        [\"UserTypeId\", \"user_type_id\"],\n        [\"UserId\", \"user_id\"],\n        [\"RoleId\", \"role_id\"],\n        [\"Name\", \"roles.name\"],\n        [\"Id\", \"id\"],\n      ]),\n      select: new TransformMapper(\n        (query) =>\n          new SelectStatement({\n            table: \"User\",\n            fields: [\n              \"User.Key\",\n              \"User.Login\",\n              \"User.Active\",\n              \"User.Opened\",\n              \"User.UserType\",\n              \"UserRole.UserId\",\n              \"UserRole.RoleId\",\n              \"Role.Name\",\n            ],\n            where: query.where,\n            joins: [\n              Join.left(\"UserType\", \"UserType.Id\", \"User.UserTypeId\"),\n              Join.left(\"UserRole\", \"UserRole.UserId\", \"User.Key\"),\n              Join.left(\"Role\", \"Role.Id\", \"UserRole.RoleId\"),\n            ],\n          }),\n        (query) => query,\n      ),\n    });\n    usersRepo.addEnriched(\n      { into: \"Roles\", from: \"Key\", by: \"UserId\", many: true },\n      usersRepo,\n      new NestedToObjectEnrichmentStrategy<UsersView>({\n        key: \"Key\",\n        fields: {\n          Key: \"Key\",\n          Login: \"Login\",\n          Active: \"Active\",\n          Opened: \"Opened\",\n          UserType: \"UserType\",\n          Roles: {\n            key: \"RoleId\",\n            fields: { RoleId: \"RoleId\", UserId: \"UserId\", Name: \"Name\" },\n          },\n        },\n      }),\n    );\n    const items: UsersView[] = [];\n    for await (const item of usersRepo.read()) items.push(item);"}
{"file":"docs/examples/fill-with-one-query/EnrichedReadonlyRepository.test.hashset-fills-lookup-select-and-leaves-missing-default.typescript","test":"typescript/datasources/src/EnrichedReadonlyRepository.test.ts#hashset-fills-lookup-select-and-leaves-missing-default","from":98,"to":114,"raw":"  it(\"hashset fills lookup select and leaves missing default\", async () => {\n    const person: Seed = { name: \"person\" };\n    const gone: Seed = { name: \"gone\" };\n    const typesConnection = await setup([person, gone]);\n    await remove(typesConnection, gone);\n    const connection = await setup([{ type_id: person.id }, { type_id: gone.id }]);\n    const parentsRepo = new ReadonlyRepository(Parent, connection);\n    const typesRepo = new ReadonlyRepository(TypeRow, typesConnection);\n    parentsRepo.addEnriched(\n      { into: \"type_name\", from: \"type_id\", by: \"id\", select: \"name\" },\n      typesRepo,\n      new HashsetOptimizedReadonlyEnrichmentStrategy(),\n    );\n    const items = await collectAsync(parentsRepo.read());\n    expect(items[0]?.type_name).toBe(\"person\");\n    expect(items[1]?.type_name).toBe(\"\");\n  });"}
{"file":"docs/examples/fill-with-one-query/EnrichedReadonlyRepositoryTests.HashsetFillsLookupSelectAndLeavesMissingDefault.csharp","test":"csharp/Datasources.Tests/EnrichedReadonlyRepositoryTests.cs#HashsetFillsLookupSelectAndLeavesMissingDefault","from":53,"to":72,"raw":"    [Fact]\n    public async Task HashsetFillsLookupSelectAndLeavesMissingDefault()\n    {\n        var person = new Row { [\"name\"] = \"person\" };\n        var gone = new Row { [\"name\"] = \"gone\" };\n        var typesConnection = await Setup(person, gone);\n        await typesConnection.CreateCommand().Execute(\"delete\", [new Parameter(\"id\", gone[\"id\"])]);\n        var connection = await Setup(\n            new Row { [\"type_id\"] = person[\"id\"] },\n            new Row { [\"type_id\"] = gone[\"id\"] });\n        var parentsRepo = new ReadonlyRepository<Parent>(connection);\n        var typesRepo = new ReadonlyRepository<TypeRow>(typesConnection);\n        parentsRepo.AddEnriched(\n            new(\"type_name\", \"type_id\", \"id\", \"name\"),\n            typesRepo,\n            new HashsetOptimizedReadonlyEnrichmentStrategy<Parent>());\n        var items = await parentsRepo.Read().ToListAsync();\n        Assert.Equal(\"person\", items[0].type_name);\n        Assert.Equal(\"\", items[1].type_name);\n    }"}
{"file":"docs/examples/fill-with-one-query/readonly_repository.fills_roles_with_a_hashset.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#fills_roles_with_a_hashset","from":460,"to":529,"schema":"user-roles-read","raw":"    #[tokio::test]\n    async fn fills_roles_with_a_hashset() {\n        let built = datasource();\n        let ds: &dyn Datasource = &*built;\n        let connection = open(ds).await;\n        apply_schema(connection.as_ref(), \"user-roles-read\")\n            .await\n            .unwrap();\n        execute_sql(&connection, &seed()).await;\n        let mut users_options = create_crud_repository_options::<UsersView>();\n        users_options.entity_mapper = Box::new(DictionaryMapper::new([(\n            \"UsersView\".to_string(),\n            \"user\".to_string(),\n        )]));\n        users_options.column_mappings = Box::new(DictionaryMapper::new([\n            (\"Key\".to_string(), \"id\".to_string()),\n            (\"Login\".to_string(), \"username\".to_string()),\n            (\"Active\".to_string(), \"is_enabled\".to_string()),\n            (\"Opened\".to_string(), \"created\".to_string()),\n            (\"UserType\".to_string(), \"user_type_id\".to_string()),\n        ]));\n        let mut type_options = create_crud_repository_options::<UserType>();\n        type_options.entity_mapper =\n            Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        type_options.column_mappings =\n            Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        let mut role_options = create_crud_repository_options::<UserRole>();\n        role_options.entity_mapper = Box::new(DictionaryMapper::new([(\n            \"UserRole\".to_string(),\n            \"user_roles\".to_string(),\n        )]));\n        role_options.column_mappings = Box::new(DictionaryMapper::new([\n            (\"UserId\".to_string(), \"user_id\".to_string()),\n            (\"Name\".to_string(), \"name\".to_string()),\n        ]));\n        role_options.select = Some(Arc::new(TransformMapper::new(roles_sql, |statement| statement)));\n        let mut users_repo =\n            ReadonlyRepository::new(connection.clone(), users_options.read).unwrap();\n        let types = ds.create_readonly_repository::<UserType>(\n            Some(connection.clone()),\n            Some(type_options.read),\n        );\n        let roles =\n            ds.create_readonly_repository::<UserRole>(Some(connection), Some(role_options.read));\n        let strategy = Arc::new(HashsetOptimizedReadonlyEnrichmentStrategy);\n        users_repo.add_enriched(\n            datasources::Enrichment::new(\"UserType\", \"UserType\", \"Id\", Some(\"Name\".into()), false),\n            types,\n            Some(strategy.clone()),\n        );\n        users_repo.add_enriched(\n            datasources::Enrichment::new(\"Roles\", \"Key\", \"UserId\", None, true),\n            roles,\n            Some(strategy),\n        );\n        let users_view = users_repo\n            .read_single(Some(&Where::binary(\"Key\", eq, ADA)), None)\n            .await\n            .unwrap()\n            .unwrap();\n        assert_eq!(users_view.get(\"UserType\"), Some(&Value::from(\"admin\")));\n        let mut names = role_names(users_view.get(\"Roles\").unwrap());\n        names.sort();\n        assert_eq!(names, [\"admin\", \"editor\"]);\n        assert!(users_view\n            .get(\"Roles\")\n            .unwrap()\n            .wire_text()\n            .contains(&format!(\"UserId={ADA}\")));\n    }"}
{"file":"docs/examples/first-key-wins-on-reverse/dictionary_mapper.first_key_wins_on_reverse.rust","test":"rust/datasources/src/mappers/dictionary_mapper.rs#first_key_wins_on_reverse","from":76,"to":88,"raw":"    #[test]\n    fn first_key_wins_on_reverse() {\n        let mapper = DictionaryMapper::new([\n            (\"Home\".to_string(), \"address\".to_string()),\n            (\"Work\".to_string(), \"address\".to_string()),\n        ]);\n        let home = mapper.map(\"Home\".into());\n        let work = mapper.map(\"Work\".into());\n        let address = mapper.reverse_map(\"address\".into());\n        assert_eq!(home, \"address\");\n        assert_eq!(work, \"address\");\n        assert_eq!(address, \"Home\");\n    }"}

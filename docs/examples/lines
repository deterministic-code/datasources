{"file":"docs/examples/map-join-rows-to-a-nested-contact/flat_to_nested_mapper.maps_join_rows_to_a_nested_contact.rust","test":"rust/datasources/src/mappers/flat_to_nested_mapper.rs#maps_join_rows_to_a_nested_contact","from":385,"to":453,"raw":"    #[test]\n    fn maps_join_rows_to_a_nested_contact() {\n        let mapper = FlatToNestedMapper::new(TypeMap::new(\n            \"id\",\n            vec![\n                (\"id\".into(), TypeMapField::column(\"id\")),\n                (\"first_name\".into(), TypeMapField::column(\"first_name\")),\n                (\"last_name\".into(), TypeMapField::column(\"last_name\")),\n                (\"email\".into(), TypeMapField::column(\"email\")),\n                (\n                    \"contact_source_name\".into(),\n                    TypeMapField::column(\"contact_source_name\"),\n                ),\n                (\n                    \"contact_type_name\".into(),\n                    TypeMapField::column(\"contact_type_name\"),\n                ),\n                (\n                    \"addresses\".into(),\n                    TypeMapField::Group(TypeMapGroup::new(\n                        \"address_id\",\n                        vec![\n                            (\"id\".into(), TypeMapField::column(\"address_id\")),\n                            (\"line1\".into(), TypeMapField::column(\"address_line1\")),\n                            (\"city\".into(), TypeMapField::column(\"address_city\")),\n                            (\n                                \"address_type_name\".into(),\n                                TypeMapField::column(\"address_type_name\"),\n                            ),\n                        ],\n                    )),\n                ),\n                (\n                    \"phones\".into(),\n                    TypeMapField::Group(TypeMapGroup::new(\n                        \"phone_id\",\n                        vec![\n                            (\"id\".into(), TypeMapField::column(\"phone_id\")),\n                            (\"number\".into(), TypeMapField::column(\"phone_number\")),\n                            (\n                                \"phone_type_name\".into(),\n                                TypeMapField::column(\"phone_type_name\"),\n                            ),\n                        ],\n                    )),\n                ),\n            ],\n        ));\n        let ada_home = cell(&[\n            (\"id\", Value::Int(7)),\n            (\"first_name\", Value::from(\"Ada\")),\n            (\"last_name\", Value::from(\"Lovelace\")),\n            (\"email\", Value::from(\"ada@ex.com\")),\n            (\"contact_source_name\", Value::from(\"Web\")),\n            (\"contact_type_name\", Value::from(\"Person\")),\n            (\"address_id\", Value::Int(101)),\n            (\"address_line1\", Value::from(\"10 Downing St\")),\n            (\"address_city\", Value::from(\"London\")),\n            (\"address_type_name\", Value::from(\"Home\")),\n            (\"phone_id\", Value::Int(201)),\n            (\"phone_number\", Value::from(\"+44\")),\n            (\"phone_type_name\", Value::from(\"Mobile\")),\n        ]);\n        let mut ada_work = ada_home.clone();\n        ada_work.insert(\"address_id\".into(), Value::Int(102));\n        ada_work.insert(\"address_line1\".into(), Value::from(\"1 Parliament Sq\"));\n        let nested = Mapper::map(&mapper, vec![ada_home.clone(), ada_work.clone()]);\n        let flat = Mapper::reverse_map(&mapper, nested.clone());\n        assert_eq!(many(&nested[0], \"addresses\").len(), 2);"}
{"file":"docs/examples/map-join-rows-to-a-nested-contact/FlatToNestedMapper.test.maps-join-rows-to-a-nested-contact.typescript","test":"typescript/datasources/src/mappers/FlatToNestedMapper.test.ts#maps-join-rows-to-a-nested-contact","from":90,"to":155,"raw":"  it(\"maps join rows to a nested contact\", () => {\n    const mapper = new FlatToNestedMapper<Contact>({\n      key: \"id\",\n      fields: {\n        id: \"id\",\n        first_name: \"first_name\",\n        last_name: \"last_name\",\n        email: \"email\",\n        contact_source_name: \"contact_source_name\",\n        contact_type_name: \"contact_type_name\",\n        addresses: {\n          key: \"address_id\",\n          fields: {\n            id: \"address_id\",\n            line1: \"address_line1\",\n            city: \"address_city\",\n            address_type_name: \"address_type_name\",\n          },\n        },\n        phones: {\n          key: \"phone_id\",\n          fields: {\n            id: \"phone_id\",\n            number: \"phone_number\",\n            phone_type_name: \"phone_type_name\",\n          },\n        },\n      },\n    });\n    const adaHome: Cells = {\n      id: 7,\n      first_name: \"Ada\",\n      last_name: \"Lovelace\",\n      email: \"ada@ex.com\",\n      contact_source_name: \"Web\",\n      contact_type_name: \"Person\",\n      address_id: 101,\n      address_line1: \"10 Downing St\",\n      address_city: \"London\",\n      address_type_name: \"Home\",\n      phone_id: 201,\n      phone_number: \"+44\",\n      phone_type_name: \"Mobile\",\n    };\n    const adaWork = {\n      ...adaHome,\n      address_id: 102,\n      address_line1: \"1 Parliament Sq\",\n    };\n    const nested = mapper.map([adaHome, adaWork]);\n    const flat = mapper.reverseMap(nested);\n    expect(nested[0]).toEqual({\n      id: 7,\n      first_name: \"Ada\",\n      last_name: \"Lovelace\",\n      email: \"ada@ex.com\",\n      contact_source_name: \"Web\",\n      contact_type_name: \"Person\",\n      addresses: [\n        { id: 101, line1: \"10 Downing St\", city: \"London\", address_type_name: \"Home\" },\n        { id: 102, line1: \"1 Parliament Sq\", city: \"London\", address_type_name: \"Home\" },\n      ],\n      phones: [{ id: 201, number: \"+44\", phone_type_name: \"Mobile\" }],\n    });\n    expect(flat).toEqual([adaHome, adaWork]);\n  });"}
{"file":"docs/examples/map-join-rows-to-a-nested-contact/FlatToNestedMapperTests.MapsJoinRowsToANestedContact.csharp","test":"csharp/Datasources.Tests/FlatToNestedMapperTests.cs#MapsJoinRowsToANestedContact","from":101,"to":164,"raw":"    [Fact]\n    public void MapsJoinRowsToANestedContact()\n    {\n        var mapper = new FlatToNestedMapper(new TypeMap\n        {\n            Key = \"id\",\n            Fields = new Dictionary<string, TypeMapField>\n            {\n                [\"id\"] = \"id\",\n                [\"first_name\"] = \"first_name\",\n                [\"last_name\"] = \"last_name\",\n                [\"email\"] = \"email\",\n                [\"contact_source_name\"] = \"contact_source_name\",\n                [\"contact_type_name\"] = \"contact_type_name\",\n                [\"addresses\"] = new TypeMapGroup\n                {\n                    Key = \"address_id\",\n                    Fields = new Dictionary<string, TypeMapField>\n                    {\n                        [\"id\"] = \"address_id\",\n                        [\"line1\"] = \"address_line1\",\n                        [\"city\"] = \"address_city\",\n                        [\"address_type_name\"] = \"address_type_name\",\n                    },\n                },\n                [\"phones\"] = new TypeMapGroup\n                {\n                    Key = \"phone_id\",\n                    Fields = new Dictionary<string, TypeMapField>\n                    {\n                        [\"id\"] = \"phone_id\",\n                        [\"number\"] = \"phone_number\",\n                        [\"phone_type_name\"] = \"phone_type_name\",\n                    },\n                },\n            },\n        });\n        var adaHome = new Row(\n        [\n            new(\"id\", 7),\n            new(\"first_name\", \"Ada\"),\n            new(\"last_name\", \"Lovelace\"),\n            new(\"email\", \"ada@ex.com\"),\n            new(\"contact_source_name\", \"Web\"),\n            new(\"contact_type_name\", \"Person\"),\n            new(\"address_id\", 101),\n            new(\"address_line1\", \"10 Downing St\"),\n            new(\"address_city\", \"London\"),\n            new(\"address_type_name\", \"Home\"),\n            new(\"phone_id\", 201),\n            new(\"phone_number\", \"+44\"),\n            new(\"phone_type_name\", \"Mobile\"),\n        ]);\n        var adaWork = new Row(adaHome)\n        {\n            [\"address_id\"] = 102,\n            [\"address_line1\"] = \"1 Parliament Sq\"\n        };\n        var nested = mapper.Map([adaHome, adaWork]);\n        var flat = mapper.ReverseMap(nested);\n        Assert.Equal(2, Many(nested[0], \"addresses\").Count);\n        Assert.Single(Many(nested[0], \"phones\"));\n        Assert.Equal(2, flat.Count);\n    }"}
{"file":"docs/examples/match-and-miss/builders.test.evaluates-compare-groups-not-and-in.typescript","test":"typescript/datasources/src/builders/builders.test.ts#evaluates-compare-groups-not-and-in","from":113,"to":191,"raw":"  it(\"evaluates compare, groups, not, and in\", () => {\n    expect(new StatementEvaluator().evaluate(new SelectStatement({ table: \"dual\", fields: [\"1\"] }))).toBeUndefined();\n    const evaluator = new ExpressionEvaluator();\n    const row = { id: 1, age: 21, name: \"a\" };\n    expect(evaluator.evaluate(new Where(new Operator.Equals(\"id\", 1)), row)).toBe(true);\n    expect(evaluator.evaluate(new Where(new Operator.Equals(\"id\", 2)), row)).toBe(false);\n    expect(evaluator.evaluate(new Where(new Operator.NotEquals(\"id\", 2)), row)).toBe(true);\n    expect(evaluator.evaluate(new Where(new Operator.GreaterThan(\"age\", 18)), row)).toBe(true);\n    expect(evaluator.evaluate(new Where(new Operator.LessThan(\"age\", 30)), row)).toBe(true);\n    expect(evaluator.evaluate(new Where(new Operator.GreaterThanOrEqual(\"age\", 21)), row)).toBe(true);\n    expect(evaluator.evaluate(new Where(new Operator.LessThanOrEqual(\"age\", 21)), row)).toBe(true);\n    expect(\n      evaluator.evaluate(\n        new Where(new Operator.And(new Operator.Equals(\"id\", 1), new Operator.GreaterThan(\"age\", 18))),\n        row,\n      ),\n    ).toBe(true);\n    expect(\n      evaluator.evaluate(\n        new Where(new Operator.Or(new Operator.Equals(\"id\", 0), new Operator.Equals(\"name\", \"a\"))),\n        row,\n      ),\n    ).toBe(true);\n    expect(evaluator.evaluate(new Where(new Operator.Not(new Operator.Equals(\"id\", 1))), row)).toBe(false);\n    expect(evaluator.evaluate(new Where(new Operator.In(\"id\", [1, 2])), row)).toBe(true);\n    expect(evaluator.evaluate(new Where(new Operator.Equals(new Literal(1), new Literal(1))), row)).toBe(true);\n    expect(evaluator.evaluate(new Where(new Operator.Equals(new Literal(1), new Literal(0))), row)).toBe(false);\n    expect(() => evaluator.evaluate(new WhereText(\"id = 1\"), row)).toThrow(\"text where is not evaluable\");\n    expect(() => evaluator.evaluate(new ArrayExpression([]), row)).toThrow(\"array is not a scalar\");\n    expect(() =>\n      evaluator.evaluate(new Operator.GreaterThan(new Literal(true), new Literal(1)), row),\n    ).toThrow(\"empty compare\");\n    expect(() =>\n      evaluator.evaluate(new Operator.In(new Identifier(\"id\"), new Literal(1)), row),\n    ).toThrow(\"empty in\");\n    expect(evaluator.evaluate(new Where(new Operator.LessThan(\"name\", \"b\")), row)).toBe(true);\n    expect(evaluator.evaluate(new Where(new Operator.GreaterThanOrEqual(\"name\", \"a\")), row)).toBe(true);\n    expect(evaluator.evaluate(new Where(new Operator.GreaterThan(\"name\", \"Z\")), row)).toBe(true);\n    expect(\n      DefaultStatementTextRenderer.instance.render(new Where(new Operator.In(new Identifier(\"id\"), new ArrayExpression([])))),\n    ).toBe(\"1 = 0\");\n    expect(new Where(new Identifier(\"id\")).parameters).toEqual([]);\n    expect(new Where(new ArrayExpression([new Literal(1)])).parameters).toEqual([]);\n    expect(() => new Where(new WhereText(\"x\")).parameters).toThrow(\"empty expression\");\n    expect(\n      evaluator.evaluate(new Operator.GreaterThan(new Literal(2n), new Literal(1n)), row),\n    ).toBe(true);\n    expect(\n      DefaultStatementTextRenderer.instance.render(new Where(new Operator.Equals(new Identifier(\"a\"), new Identifier(\"b\")))),\n    ).toBe(\"a = b\");\n    expect(\n      new Where(new Operator.Equals(new Identifier(\"a\"), new Identifier(\"b\"))).parameters,\n    ).toEqual([]);\n    expect(DefaultStatementTextRenderer.instance.render(new Where(new Operator.In(new Literal(1), new Literal(2))))).toBe(\"1 IN 2\");\n    expect(() => DefaultStatementTextRenderer.instance.render(new Where(new WhereText(\"x\")))).toThrow(\"empty expression\");\n    expect(evaluator.evaluate(new Identifier(\"missing\"), row)).toBeNull();\n    expect(evaluator.evaluate(new Literal(null), row)).toBeNull();\n    expect(() => evaluator.evaluate(new WhereText(\"x\"), row)).toThrow(\"text where is not evaluable\");\n    expect(\n      DefaultStatementTextRenderer.instance.render(new Where(new Operator.Equals(new Literal(true), new Literal(false)))),\n    ).toBe(\"true = false\");\n    expect(\n      DefaultStatementTextRenderer.instance.render(new Where(new Operator.Equals(new Literal(null), new Literal(null)))),\n    ).toBe(\"null = null\");\n    expect(\n      new Where(new Operator.Equals(new Literal(true), new Literal(false))).parameters,\n    ).toEqual([]);\n    class Ghost extends Operator {}\n    expect(() => evaluator.evaluate(new Ghost(), row)).toThrow(\"empty expression\");\n    expect(() => DefaultStatementTextRenderer.instance.render(new Where(new Ghost()))).toThrow(\"empty expression\");\n    expect(() => new Where(new Ghost()).parameters).toThrow(\"empty expression\");\n    expect(DefaultStatementTextRenderer.instance.render(new Where(new ArrayExpression([new Literal(1)])))).toBe(\"1\");\n    expect(\n      () =>\n        new Where(\n          new Operator.In(new Identifier(\"id\"), new ArrayExpression([new Identifier(\"x\")])),\n        ).parameters,\n    ).toThrow(\"empty in\");\n  });"}
{"file":"docs/examples/match-and-miss/CoreTests.EvaluatesWhere.csharp","test":"csharp/Datasources.Tests/CoreTests.cs#EvaluatesWhere","from":274,"to":353,"raw":"    [Fact]\n    public void EvaluatesWhere()\n    {\n        var evaluator = new ExpressionEvaluator();\n        IReadOnlyDictionary<string, Value> row = new Dictionary<string, Value> { [\"id\"] = 1, [\"age\"] = 21, [\"name\"] = \"a\" };\n        Assert.Equal(new Value.Bool(true), evaluator.Evaluate(new Where(new Operator.Equals(\"id\", 1)), row));\n        Assert.Equal(new Value.Bool(false), evaluator.Evaluate(new Where(new Operator.Equals(\"id\", 2)), row));\n        Assert.Equal(new Value.Bool(true), evaluator.Evaluate(new Where(new Operator.NotEquals(\"id\", 2)), row));\n        Assert.Equal(new Value.Bool(true), evaluator.Evaluate(new Where(new Operator.GreaterThan(\"age\", 18)), row));\n        Assert.Equal(new Value.Bool(true), evaluator.Evaluate(new Where(new Operator.LessThan(\"age\", 30)), row));\n        Assert.Equal(new Value.Bool(true), evaluator.Evaluate(new Where(new Operator.GreaterThanOrEqual(\"age\", 21)), row));\n        Assert.Equal(new Value.Bool(true), evaluator.Evaluate(new Where(new Operator.LessThanOrEqual(\"age\", 21)), row));\n        Assert.Equal(\n            new Value.Bool(true),\n            evaluator.Evaluate(new Where(new Operator.And(\n                new Operator.Equals(\"id\", 1),\n                new Operator.GreaterThan(\"age\", 18))), row));\n        Assert.Equal(\n            new Value.Bool(false),\n            evaluator.Evaluate(new Where(new Operator.And(\n                new Operator.Equals(\"id\", 0),\n                new Operator.GreaterThan(\"age\", 18))), row));\n        Assert.Equal(\n            new Value.Bool(true),\n            evaluator.Evaluate(new Where(new Operator.Or(\n                new Operator.Equals(\"id\", 0),\n                new Operator.Equals(\"name\", \"a\"))), row));\n        Assert.Equal(\n            new Value.Bool(true),\n            evaluator.Evaluate(new Where(new Operator.Or(\n                new Operator.Equals(\"id\", 1),\n                new Operator.Equals(\"name\", \"z\"))), row));\n        Assert.Equal(\n            new Value.Bool(false),\n            evaluator.Evaluate(new Where(new Operator.Not(new Operator.Equals(\"id\", 1))), row));\n        Assert.Equal(new Value.Bool(true), evaluator.Evaluate(new Where(new Operator.In(\"id\", [1, 2])), row));\n        Assert.Equal(\n            new Value.Bool(true),\n            evaluator.Evaluate(new Where(new Operator.Equals(new Literal(1), new Literal(1))), row));\n        Assert.Equal(\n            new Value.Bool(false),\n            evaluator.Evaluate(new Where(new Operator.Equals(new Literal(1), new Literal(0))), row));\n        Assert.Throws<InvalidOperationException>(() => evaluator.Evaluate(new WhereText(\"id = 1\"), row));\n        Assert.Throws<InvalidOperationException>(() => evaluator.Evaluate(new ArrayExpression([]), row));\n        Assert.Throws<InvalidOperationException>(() => evaluator.Evaluate(new WhereText(\"x\"), row));\n        Assert.Throws<InvalidOperationException>(() =>\n            evaluator.Evaluate(new Operator.GreaterThan(new Literal(true), new Literal(1)), row));\n        Assert.Throws<InvalidOperationException>(() =>\n            evaluator.Evaluate(new Operator.In(new Identifier(\"id\"), new Literal(1)), row));\n        Assert.Equal(Value.Null.Instance, evaluator.Evaluate(new Identifier(\"missing\"), row));\n        Assert.Equal(Value.Null.Instance, evaluator.Evaluate(new Identifier(\"id\"), null));\n        Assert.Equal(Value.Null.Instance, evaluator.Evaluate(new Literal(Value.Null.Instance), row));\n        Assert.Equal(new Value.Bool(true), evaluator.Evaluate(new Where(new Operator.LessThan(\"name\", \"b\")), row));\n        Assert.Equal(new Value.Bool(true), evaluator.Evaluate(new Where(new Operator.GreaterThanOrEqual(\"name\", \"a\")), row));\n        Assert.Equal(new Value.Bool(true), evaluator.Evaluate(new Where(new Operator.GreaterThan(\"name\", \"Z\")), row));\n        Assert.Equal(\n            new Value.Bool(true),\n            evaluator.Evaluate(new Operator.GreaterThan(new Literal(2.5), new Literal(1.5)), row));\n        Assert.Equal(\n            new Value.Bool(true),\n            evaluator.Evaluate(new Operator.GreaterThan(new Literal(2.5m), new Literal(1.5m)), row));\n        Assert.Equal(\n            new Value.Bool(true),\n            evaluator.Evaluate(new Operator.GreaterThan(new Literal(2), new Literal(1.5)), row));\n        Assert.Equal(\n            new Value.Bool(true),\n            evaluator.Evaluate(new Operator.GreaterThan(new Literal(2.5), new Literal(1)), row));\n        Assert.Equal(\n            new Value.Bool(true),\n            evaluator.Evaluate(new Operator.GreaterThan(new Literal(2), new Literal(1.5m)), row));\n        Assert.Equal(\n            new Value.Bool(true),\n            evaluator.Evaluate(new Operator.GreaterThan(new Literal(2.5m), new Literal(1)), row));\n        var now = new DateTime(2024, 1, 2, 0, 0, 0, DateTimeKind.Utc);\n        Assert.Equal(\n            new Value.Bool(true),\n            evaluator.Evaluate(\n                new Operator.GreaterThan(new Literal(now.AddDays(1)), new Literal(now)),\n                row));\n    }"}
{"file":"docs/examples/match-and-miss/datasources-mod.evaluates_where_statement.rust","test":"rust/datasources/src/tests/mod.rs#evaluates_where_statement","from":1417,"to":1602,"raw":"#[test]\nfn evaluates_where_statement() {\n    let evaluator = ExpressionEvaluator;\n    let row = record(&[\n        (\"id\", Value::Int(1)),\n        (\"age\", Value::Int(21)),\n        (\"name\", Value::Text(\"a\".into())),\n    ]);\n    let yes = Value::Bool(true);\n    let no = Value::Bool(false);\n    assert_eq!(\n        evaluator.evaluate_where(&Where::new(Operator::equals(\"id\", 1_i64)), &row),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(&Where::new(Operator::equals(\"id\", 2_i64)), &row),\n        no\n    );\n    assert_eq!(\n        evaluator.evaluate_where(&Where::new(Operator::not_equals(\"id\", 2_i64)), &row),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(&Where::new(Operator::greater_than(\"age\", 18_i64)), &row),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(&Where::new(Operator::less_than(\"age\", 30_i64)), &row),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(\n            &Where::new(Operator::greater_than_or_equal(\"age\", 21_i64)),\n            &row\n        ),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(\n            &Where::new(Operator::less_than_or_equal(\"age\", 21_i64)),\n            &row\n        ),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(\n            &Where::new(Operator::and(\n                Operator::equals(\"id\", 1_i64),\n                Operator::greater_than(\"age\", 18_i64)\n            )),\n            &row\n        ),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(\n            &Where::new(Operator::and(\n                Operator::equals(\"id\", 0_i64),\n                Operator::greater_than(\"age\", 18_i64)\n            )),\n            &row\n        ),\n        no\n    );\n    assert_eq!(\n        evaluator.evaluate_where(\n            &Where::new(Operator::or(\n                Operator::equals(\"id\", 0_i64),\n                Operator::equals(\"name\", \"a\")\n            )),\n            &row\n        ),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(\n            &Where::new(Operator::or(\n                Operator::equals(\"id\", 1_i64),\n                Operator::equals(\"name\", \"z\")\n            )),\n            &row\n        ),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(\n            &Where::new(Operator::not(Operator::equals(\"id\", 1_i64))),\n            &row\n        ),\n        no\n    );\n    assert_eq!(\n        evaluator.evaluate_where(\n            &Where::new(Operator::in_list(\"id\", vec![Value::Int(1), Value::Int(2)])),\n            &row\n        ),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(\n            &Where::new(Operator::Equals {\n                left: Box::new(Expression::Literal(Literal::new(1_i64))),\n                right: Box::new(Expression::Literal(Literal::new(1_i64))),\n            }),\n            &row\n        ),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(\n            &Where::new(Operator::Equals {\n                left: Box::new(Expression::Literal(Literal::new(1_i64))),\n                right: Box::new(Expression::Literal(Literal::new(0_i64))),\n            }),\n            &row\n        ),\n        no\n    );\n    assert_eq!(\n        evaluator.evaluate(&Expression::Identifier(Identifier::new(\"missing\")), &row),\n        Value::Null\n    );\n    assert_eq!(\n        evaluator.evaluate(&Expression::Literal(Literal::new(Value::Null)), &row),\n        Value::Null\n    );\n    assert_eq!(\n        evaluator.evaluate_where(&Where::new(Operator::less_than(\"name\", \"b\")), &row),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(\n            &Where::new(Operator::greater_than_or_equal(\"name\", \"a\")),\n            &row\n        ),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate_where(&Where::new(Operator::greater_than(\"name\", \"Z\")), &row),\n        yes\n    );\n    assert_eq!(\n        evaluator.evaluate(\n            &Expression::Operator(Operator::GreaterThan {\n                left: Box::new(Expression::Literal(Literal::new(2.5_f64))),\n                right: Box::new(Expression::Literal(Literal::new(1.5_f64))),\n            }),\n            &row\n        ),\n        Value::Bool(true)\n    );\n    assert_eq!(\n        evaluator.evaluate(\n            &Expression::Operator(Operator::GreaterThan {\n                left: Box::new(Expression::Literal(Literal::new(Value::Decimal(\n                    rust_decimal::Decimal::new(25, 1)\n                )))),\n                right: Box::new(Expression::Literal(Literal::new(Value::Decimal(\n                    rust_decimal::Decimal::new(15, 1)\n                )))),\n            }),\n            &row\n        ),\n        Value::Bool(true)\n    );\n    assert_eq!(\n        evaluator.evaluate(\n            &Expression::Operator(Operator::GreaterThan {\n                left: Box::new(Expression::Literal(Literal::new(2_i64))),\n                right: Box::new(Expression::Literal(Literal::new(1.5_f64))),\n            }),\n            &row\n        ),\n        Value::Bool(true)\n    );\n    assert_eq!(\n        evaluator.evaluate(\n            &Expression::Operator(Operator::GreaterThan {\n                left: Box::new(Expression::Literal(Literal::new(2.5_f64))),\n                right: Box::new(Expression::Literal(Literal::new(1_i64))),\n            }),\n            &row\n        ),\n        Value::Bool(true)\n    );\n}"}

{"file":"docs/examples/executereader-then-apply-flat-to-nested-mapper/command.execute_reader_then_apply_flat_to_nested_mapper.rust","test":"rust/providers/sqlite/tests/command.rs#execute_reader_then_apply_flat_to_nested_mapper","from":142,"to":195,"schema":"flat-users","raw":"#[tokio::test]\nasync fn execute_reader_then_apply_flat_to_nested_mapper() {\n    let _guard = super::env_lock();\n    let ds = default().unwrap();\n    let command = ds.create_command(None).await.unwrap();\n    apply_schema(ds.create_connection().await.unwrap().as_ref(), \"flat-users\").await.unwrap();\n    command\n        .execute_native(\n            &Native::new(\"INSERT INTO users (id, username, contact_name) VALUES (1, 'bobby', 'bob')\"),\n            None,\n        )\n        .await\n        .unwrap();\n    command\n        .execute_native(\n            &Native::new(\"INSERT INTO users (id, username, contact_name) VALUES (1, 'bobby', 'roberta')\"),\n            None,\n        )\n        .await\n        .unwrap();\n    let reader = command\n        .execute_reader(\"SELECT id, username, contact_name FROM users\", None)\n        .await\n        .unwrap();\n    let rows: Vec<_> = reader.read().try_collect().await.unwrap();\n    let mapper = FlatToNestedMapper::new(TypeMap::new(\n        \"id\",\n        vec![\n            (\"id\".into(), TypeMapField::column(\"id\")),\n            (\"username\".into(), TypeMapField::column(\"username\")),\n            (\n                \"contacts\".into(),\n                TypeMapField::Group(TypeMapGroup::new(\n                    \"contact_name\",\n                    vec![(\"name\".into(), TypeMapField::column(\"contact_name\"))],\n                )),\n            ),\n        ],\n    ));\n    let nested = Mapper::map(&mapper, rows);\n    assert_eq!(nested.len(), 1);\n    assert_eq!(nested[0].get(\"id\"), Some(&MappedValue::Cell(Value::Int(1))));\n    assert_eq!(\n        nested[0].get(\"username\"),\n        Some(&MappedValue::Cell(Value::from(\"bobby\")))\n    );\n    assert_eq!(\n        nested[0].get(\"contacts\"),\n        Some(&MappedValue::Many(vec![\n            MappedRow::from([(\"name\".into(), MappedValue::Cell(Value::from(\"bob\")))]),\n            MappedRow::from([(\"name\".into(), MappedValue::Cell(Value::from(\"roberta\")),)]),\n        ]))\n    );\n}"}
{"file":"docs/examples/executereader-then-apply-flat-to-nested-mapper/sqlite.integration.test.executereader-then-apply-flat-to-nested-mapper.typescript","test":"typescript/providers/sqlite/tests/sqlite.integration.test.ts#executereader-then-apply-flat-to-nested-mapper","from":120,"to":144,"schema":"flat-users","raw":"  it(\"executeReader, then apply flat to nested mapper\", async () => {\n    const ds = Datasource.default;\n    const command = await ds.createCommand();\n    await applySchema(command.connection, \"flat-users\");\n    await command.executeNative(new Native(\"INSERT INTO users (id, username, contact_name) VALUES (1, 'bobby', 'bob')\"));\n    await command.executeNative(new Native(\"INSERT INTO users (id, username, contact_name) VALUES (1, 'bobby', 'roberta')\"));\n    await using reader = await command.executeReader(\"SELECT id, username, contact_name FROM users\");\n    const rows = await Array.fromAsync(reader.read());\n    const mapper = new FlatToNestedMapper<{\n      id: number;\n      username: string;\n      contacts: { name: string }[];\n    }>({\n      key: \"id\",\n      fields: {\n        id: \"id\",\n        username: \"username\",\n        contacts: { key: \"contact_name\", fields: { name: \"contact_name\" } },\n      },\n    });\n    const nested = mapper.map(rows);\n    expect(nested).toEqual([\n      { id: 1, username: \"bobby\", contacts: [{ name: \"bob\" }, { name: \"roberta\" }] },\n    ]);\n  });"}
{"file":"docs/examples/executereader-then-apply-flat-to-nested-mapper/SqliteCommandIntegrationTests.ExecuteReaderThenApplyFlatToNestedMapper.csharp","test":"csharp/Providers/Sqlite.Tests/SqliteCommandIntegrationTests.cs#ExecuteReaderThenApplyFlatToNestedMapper","from":108,"to":137,"schema":"flat-users","raw":"    [Fact]\n    public async Task ExecuteReaderThenApplyFlatToNestedMapper()\n    {\n        var ds = Datasource.Default;\n        var command = await ds.CreateCommand();\n        await SchemaSpec.Apply(command.Connection, \"flat-users\");\n        await command.Execute(Native.N(\"INSERT INTO users (id, username, contact_name) VALUES (1, 'bobby', 'bob')\"));\n        await command.Execute(Native.N(\"INSERT INTO users (id, username, contact_name) VALUES (1, 'bobby', 'roberta')\"));\n        await using var reader = await command.ExecuteReader(\"SELECT id, username, contact_name FROM users\");\n        var rows = await reader.Read().ToListAsync();\n        var mapper = new FlatToNestedMapper(new TypeMap\n        {\n            Key = \"id\",\n            Fields = new Dictionary<string, TypeMapField>\n            {\n                [\"id\"] = \"id\",\n                [\"username\"] = \"username\",\n                [\"contacts\"] = new TypeMapGroup\n                {\n                    Key = \"contact_name\",\n                    Fields = new Dictionary<string, TypeMapField> { [\"name\"] = \"contact_name\" },\n                },\n            },\n        });\n        var nested = mapper.Map(rows);\n        Assert.Equal(new MappedValue.Cell(new Value.Int(1)), Assert.Single(nested)[\"id\"]);\n        Assert.Equal(new MappedValue.Cell(new Value.Text(\"bobby\")), nested[0][\"username\"]);\n        Assert.Equal(new MappedValue.Cell(new Value.Text(\"bob\")), ((MappedValue.Many)nested[0][\"contacts\"]).Items[0][\"name\"]);\n        Assert.Equal(new MappedValue.Cell(new Value.Text(\"roberta\")), ((MappedValue.Many)nested[0][\"contacts\"]).Items[1][\"name\"]);\n    }"}

{"file":"docs/examples/map-an-object-explicitly/readonly_repository.maps_an_object_explicitly.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#maps_an_object_explicitly","from":128,"to":156,"schema":"minimal-users","raw":"#[tokio::test]\nasync fn maps_an_object_explicitly() {\n    let built = datasource();\n    let ds: &dyn Datasource = &*built;\n    let connection = open(ds).await;\n    apply_schema(connection.as_ref(), \"minimal-users\").await.unwrap();\n    execute_sql(\n        &connection,\n        \"\n        INSERT INTO users (id, username, is_enabled) VALUES\n            (1, 'ada', 1),\n            (2, 'grace', 0);\n        \",\n    )\n    .await;\n    let mut options = create_crud_repository_options::<User>();\n    options.entity_mapper = Box::new(snake_then_plural());\n    options.column_mappings = Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n    options.object_converter = Some(Box::new(UserConverter));\n    let users_repo = ds.create_readonly_repository::<User>(Some(connection), Some(options.read));\n    let user = users_repo\n        .read_single(Some(&Where::binary(\"Id\", eq, 1_i64)), None)\n        .await\n        .unwrap()\n        .unwrap();\n    assert_eq!(user.get(\"Id\"), Some(&Value::Int(1)));\n    assert_eq!(user.get(\"Username\"), Some(&Value::from(\"ada\")));\n    assert_eq!(user.get(\"IsEnabled\"), Some(&Value::Bool(true)));\n}"}
{"file":"docs/examples/map-an-object-explicitly/readonly_repository.TypeConverterForUserConverter.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#TypeConverterForUserConverter","from":104,"to":126,"raw":"impl TypeConverter<Row, Row> for UserConverter {\n    fn convert(&self, from: &Row) -> Result<Row> {\n        let mut row = from.clone();\n        let enabled = match row.get(\"IsEnabled\") {\n            Some(Value::Bool(flag)) => Value::Bool(*flag),\n            Some(value) => value.clone(),\n            None => Value::Null,\n        };\n        row.insert(\"IsEnabled\".into(), enabled);\n        Ok(row)\n    }\n\n    fn reverse_convert(&self, to: &Row) -> Result<Row> {\n        let mut row = to.clone();\n        let enabled = match row.get(\"IsEnabled\") {\n            Some(Value::Bool(flag)) => Value::Int(if *flag { 1 } else { 0 }),\n            Some(value) => value.clone(),\n            None => Value::Null,\n        };\n        row.insert(\"IsEnabled\".into(), enabled);\n        Ok(row)\n    }\n}"}
{"file":"docs/examples/map-an-object-explicitly/readonly.repository.integration.test.maps-an-object-explicitly.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#maps-an-object-explicitly","from":92,"to":110,"schema":"minimal-users","raw":"  it(\"maps an object explicitly\", async () => {\n    const ds = new Datasource(\"sqlite\", new SqliteDriver(), { DATASOURCE_URL: \"sqlite:///:memory:\" });\n    const connection = await open(ds);\n    await applySchema(connection, \"minimal-users\");\n    await executeSql(connection, `\n      INSERT INTO users (id, username, is_enabled) VALUES\n        (1, 'ada', 1),\n        (2, 'grace', 0);\n    `);\n    const usersRepo = ds.createReadonlyRepository(MappedUser, connection, {\n      entityMapper: snakeThenPlural,\n      columnMappings: snake,\n      objectConverter: new UserConverter(),\n    });\n    const user = await usersRepo.readSingle(new Where(\"Id\", eq, 1));\n    expect(user?.Id).toBe(1);\n    expect(user?.Username).toBe(\"ada\");\n    expect(user?.IsEnabled).toBe(true);\n  });"}
{"file":"docs/examples/map-an-object-explicitly/readonly.repository.integration.test.UserConverter.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#UserConverter","from":44,"to":58,"raw":"class UserConverter extends TypeConverter<MappedUser, Cells> {\n  convert = (from: Cells): MappedUser => {\n    const user = new MappedUser();\n    user.Id = from.Id as number;\n    user.Username = from.Username as string;\n    user.IsEnabled = from.IsEnabled === true;\n    return user;\n  };\n\n  reverseConvert = (to: MappedUser): Cells => ({\n    Id: to.Id,\n    Username: to.Username,\n    IsEnabled: to.IsEnabled ? 1 : 0,\n  });\n}"}
{"file":"docs/examples/map-an-object-explicitly/ReadonlyRepositoryIntegrationTests.MapsAnObjectExplicitly.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#MapsAnObjectExplicitly","from":82,"to":106,"schema":"minimal-users","raw":"    [Fact]\n    public async Task MapsAnObjectExplicitly()\n    {\n        var driver = new SqliteDriver();\n        var ds = new Datasource(\"sqlite\", driver, new Dictionary<string, string?> { [\"DATASOURCE_URL\"] = \"sqlite:///:memory:\" });\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"minimal-users\");\n        await Execute(connection, \"\"\"\n            INSERT INTO users (id, username, is_enabled) VALUES\n                (1, 'ada', 1),\n                (2, 'grace', 0);\n            \"\"\");\n        var usersRepo = ds.CreateReadonlyRepository<User>(connection, new ReadonlyRepositoryOptions<User>\n        {\n            EntityMapper = SnakeThenPlural(),\n            ColumnMappings = Snake,\n            ObjectConverter = new UserConverter()\n        });\n\n        var user = await usersRepo.ReadSingle(new Where(\"Id\", eq, 1));\n\n        Assert.Equal(1, user!.Id);\n        Assert.Equal(\"ada\", user.Username);\n        Assert.True(user.IsEnabled);\n    }"}

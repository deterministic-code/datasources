{"file":"docs/examples/cascade-delete/CRUDRepository.test.delete-cascades-children-then-parent.typescript","test":"typescript/datasources/src/CRUDRepository.test.ts#delete-cascades-children-then-parent","from":345,"to":365,"raw":"  it(\"delete cascades children then parent\", async () => {\n    const connection = await setup();\n    const parentsRepo = repo(Parent, connection);\n    const childrenRepo = repo(Child, connection);\n    const notesRepo = repo(Note, connection);\n    const parent = await parentsRepo.create(new Parent());\n    expect(parent.Id).toBeGreaterThan(0);\n    const child = await childrenRepo.create(Object.assign(new Child(), { ParentId: parent.Id, Label: \"a\" }));\n    expect(child.Id).toBeGreaterThan(0);\n    const note = await notesRepo.create(Object.assign(new Note(), { ChildId: child.Id, Text: \"n\" }));\n    expect(note.Id).toBeGreaterThan(0);\n    const other = await notesRepo.create(Object.assign(new Note(), { Text: \"other\" }));\n    expect(other.Id).toBeGreaterThan(0);\n    childrenRepo.addEnriched({ destinationProperty: \"Notes\", sourceProperty: \"Id\", relatedKey: \"ChildId\", type: \"list\" }, notesRepo);\n    parentsRepo.addEnriched({ destinationProperty: \"Children\", sourceProperty: \"Id\", relatedKey: \"ParentId\", type: \"list\" }, childrenRepo);\n    const removed = await parentsRepo.delete(Object.assign(new Parent(), { Id: parent.Id }));\n    expect(removed.rowsAffected).toBe(1);\n    expect(await collectAsync(parentsRepo.read())).toEqual([]);\n    expect(await collectAsync(childrenRepo.read())).toEqual([]);\n    expect((await notesRepo.readSingle())?.Text).toBe(\"other\");\n  });"}
{"file":"docs/examples/cascade-delete/CRUDRepositoryTests.DeleteCascadesChildrenThenParent.csharp","test":"csharp/Datasources.Tests/CRUDRepositoryTests.cs#DeleteCascadesChildrenThenParent","from":300,"to":322,"raw":"    [Fact]\n    public async Task DeleteCascadesChildrenThenParent()\n    {\n        var connection = await Setup();\n        var parentsRepo = Open<Parent>(connection);\n        var childrenRepo = Open<Child>(connection);\n        var notesRepo = Open<Note>(connection);\n        var parent = await parentsRepo.Create(new Parent());\n        Assert.True(parent.Id > 0);\n        var child = await childrenRepo.Create(new Child { ParentId = parent.Id, Label = \"a\" });\n        Assert.True(child.Id > 0);\n        var note = await notesRepo.Create(new Note { ChildId = child.Id, Text = \"n\" });\n        Assert.True(note.Id > 0);\n        var other = await notesRepo.Create(new Note { Text = \"other\" });\n        Assert.True(other.Id > 0);\n        childrenRepo.AddEnriched(new(\"Notes\", \"Id\", \"ChildId\", Type: EnrichmentPropertyType.List), notesRepo);\n        parentsRepo.AddEnriched(new(\"Children\", \"Id\", \"ParentId\", Type: EnrichmentPropertyType.List), childrenRepo);\n        var removed = await parentsRepo.Delete(new Parent { Id = parent.Id });\n        Assert.Equal(1, removed.RowsAffected);\n        Assert.Empty(await parentsRepo.Read().ToListAsync());\n        Assert.Empty(await childrenRepo.Read().ToListAsync());\n        Assert.Equal(\"other\", Assert.Single(await notesRepo.Read().ToListAsync()).Text);\n    }"}
{"file":"docs/examples/cascade-delete/enriched.deep_delete_cascades_children_then_parent.rust","test":"rust/datasources/tests/enriched.rs#deep_delete_cascades_children_then_parent","from":1007,"to":1067,"raw":"#[tokio::test]\nasync fn deep_delete_cascades_children_then_parent() {\n    let connection = setup(&mut []).await;\n    let parents = mapped_crud(connection.clone(), \"Parent\");\n    let mut children_repo = mapped_crud(connection.clone(), \"Child\");\n    let notes = Arc::new(mapped_crud(connection, \"Note\"));\n    let parent = parents\n        .create(record(&[(\"Label\", Value::from(\"p\"))]))\n        .await\n        .unwrap();\n    assert!(num(&parent, \"Id\") > 0);\n    let parent_id = parent.get(\"Id\").unwrap().clone();\n    let child = children_repo\n        .create(record(&[\n            (\"ParentId\", parent_id.clone()),\n            (\"Label\", Value::from(\"a\")),\n        ]))\n        .await\n        .unwrap();\n    assert!(num(&child, \"Id\") > 0);\n    let child_id = child.get(\"Id\").unwrap().clone();\n    let note = notes\n        .create(record(&[\n            (\"ChildId\", child_id),\n            (\"Text\", Value::from(\"n\")),\n        ]))\n        .await\n        .unwrap();\n    assert!(num(&note, \"Id\") > 0);\n    let other = notes\n        .create(record(&[\n            (\"Text\", Value::from(\"other\")),\n            (\"Label\", Value::from(\"keep\")),\n        ]))\n        .await\n        .unwrap();\n    assert!(num(&other, \"Id\") > 0);\n    children_repo.add_enriched(\n        Enrichment::new(\"Notes\", \"Id\", \"ChildId\", None, datasources::EnrichmentPropertyType::List),\n        notes.clone(),\n        None,\n    );\n    let children = Arc::new(children_repo);\n    let mut parents = parents;\n    parents.add_enriched(\n        Enrichment::new(\"Children\", \"Id\", \"ParentId\", None, datasources::EnrichmentPropertyType::List),\n        children.clone(),\n        None,\n    );\n    let removed = parents\n        .delete(record(&[(\"Id\", parent_id)]), None)\n        .await\n        .unwrap();\n    assert_eq!(removed.rows_affected, 1);\n    assert!(parents.read(None, None, None).try_collect::<Vec<_>>().await.unwrap().is_empty());\n    assert!(children.read(None, None, None).try_collect::<Vec<_>>().await.unwrap().is_empty());\n    assert_eq!(\n        notes.read(None, None, None).try_collect::<Vec<_>>().await.unwrap()[0][\"Text\"],\n        Value::from(\"other\")\n    );\n}"}

{"file":"docs/examples/read-the-next-result-set/SqliteCommandIntegrationTests.NextResultReadsTheNextStatement.csharp","test":"csharp/Providers/Sqlite.Tests/SqliteCommandIntegrationTests.cs#NextResultReadsTheNextStatement","from":20,"to":42,"raw":"    [Fact]\n    public async Task NextResultReadsTheNextStatement()\n    {\n        var conn = new SqliteConnection(new SqliteConnectionOptions { Filename = \":memory:\" });\n        await conn.Open();\n        var command = new SqliteCommand(conn);\n        var reader = await command.ExecuteReader(\"SELECT 1 AS id; SELECT 2 AS id\");\n        var first = new List<Row>();\n        while (await reader.Next())\n            first.Add(reader.Current!);\n        var moved = await reader.NextResult();\n        var second = new List<Row>();\n        while (await reader.Next())\n            second.Add(reader.Current!);\n        var again = await reader.NextResult();\n        if (reader is IAsyncDisposable disposable)\n            await disposable.DisposeAsync();\n        await conn.Close();\n        Assert.True(moved);\n        Assert.False(again);\n        Assert.Equal(new Value.Int(1), first[0][\"id\"]);\n        Assert.Equal(new Value.Int(2), second[0][\"id\"]);\n    }"}
{"file":"docs/examples/read-users-by-id-and-by-username/readonly_repository.reads_users_by_id_and_by_username_and_enabled.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#reads_users_by_id_and_by_username_and_enabled","from":47,"to":85,"raw":"#[tokio::test]\nasync fn reads_users_by_id_and_by_username_and_enabled() {\n    let built = datasource();\n    let ds: &dyn Datasource = &*built;\n    let connection = open(\n        ds,\n        \"minimal-users\",\n        \"\n        INSERT INTO users (id, username, is_enabled) VALUES\n            (1, 'ada', 1),\n            (2, 'grace', 0);\n        \",\n    )\n    .await;\n    let mut options = create_crud_repository_options::<User>();\n    options.entity_mapper = Box::new(PluralizerMapper::new());\n    let repo = ds.create_readonly_repository::<User>(Some(connection), Some(options.read));\n    let by_id = repo\n        .read_single(Some(&Where::binary(\"id\", eq, 1_i64)), None)\n        .await\n        .unwrap()\n        .unwrap();\n    let disabled = repo\n        .read(\n            Some(&Where::binary(\"username\", eq, \"grace\").and(\n                \"is_enabled\",\n                eq,\n                0_i64,\n            )),\n            None,\n        )\n        .await\n        .unwrap();\n    assert_eq!(by_id.get(\"username\"), Some(&Value::from(\"ada\")));\n    assert_eq!(by_id.get(\"is_enabled\"), Some(&Value::Int(1)));\n    assert_eq!(disabled.len(), 1);\n    assert_eq!(disabled[0].get(\"id\"), Some(&Value::Int(2)));\n    assert_eq!(disabled[0].get(\"is_enabled\"), Some(&Value::Int(0)));\n}"}
{"file":"docs/examples/read-users-by-id-and-by-username/readonly.repository.integration.test.reads-users-by-id-and-by-username-and-enabled.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#reads-users-by-id-and-by-username-and-enabled","from":37,"to":55,"raw":"  it(\"reads users by id and by username and enabled\", async () => {\n    const ds = new Datasource(\"sqlite\", new SqliteDriver(), { filename: \":memory:\" });\n    const connection = await open(ds, \"minimal-users\", `\n      INSERT INTO users (id, username, is_enabled) VALUES\n        (1, 'ada', 1),\n        (2, 'grace', 0);\n    `);\n    const repo = ds.createReadonlyRepository(User, connection, {\n      entityMapper: new PluralizerMapper(),\n    });\n    const byId = await repo.readSingle(new Where(\"id\", eq, 1));\n    const disabled: User[] = [];\n    for await (const row of repo.read(new Where(\"username\", eq, \"grace\").and(\"is_enabled\", eq, 0)))\n      disabled.push(row);\n    expect(byId?.username).toBe(\"ada\");\n    expect(byId?.is_enabled).toBe(1);\n    expect(disabled.length).toBe(1);\n    expect(disabled[0]?.id).toBe(2);\n    expect(disabled[0]?.is_enabled).toBe(0);"}
{"file":"docs/examples/read-users-by-id-and-by-username/ReadonlyRepositoryIntegrationTests.ReadsUsersByIdAndByUsernameAndEnabled.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#ReadsUsersByIdAndByUsernameAndEnabled","from":29,"to":53,"raw":"    [Fact]\n    public async Task ReadsUsersByIdAndByUsernameAndEnabled()\n    {\n        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"filename\"] = \":memory:\" });\n        var connection = await Open(ds, \"minimal-users\", \"\"\"\n            INSERT INTO users (id, username, is_enabled) VALUES\n                (1, 'ada', 1),\n                (2, 'grace', 0);\n            \"\"\");\n        var repo = ds.CreateReadonlyRepository<User>(connection, new ReadonlyRepositoryOptions<User>\n        {\n            EntityMapper = new PluralizerMapper(),\n        });\n\n        var byId = await repo.ReadSingle(new Where(\"id\", eq, 1));\n        var disabled = new List<User>();\n        await foreach (var row in repo.Read(new Where(\"username\", eq, \"grace\").And(\"is_enabled\", eq, 0)))\n            disabled.Add(row);\n\n        Assert.Equal(\"ada\", byId!.username);\n        Assert.True(byId.is_enabled);\n        var grace = Assert.Single(disabled);\n        Assert.Equal(2, grace.id);\n        Assert.False(grace.is_enabled);\n    }"}

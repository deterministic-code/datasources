{"file":"docs/examples/join-statements/bulk_write_strategy.batch_command_i_bulk_write_strategy_joins_statements.rust","test":"rust/datasources/src/tests/bulk_write_strategy.rs#batch_command_i_bulk_write_strategy_joins_statements","from":72,"to":132,"raw":"#[tokio::test]\nasync fn batch_command_i_bulk_write_strategy_joins_statements() {\n    let (repo, command) = parents(Arc::new(BatchCommandIBulkWriteStrategy::new()));\n    let mut created = [\n        row(&[(\"label\", Value::from(\"a\"))]),\n        row(&[(\"label\", Value::from(\"b\"))]),\n    ];\n    repo.create_bulk(&mut created).await.unwrap();\n    {\n        let logs = command.execute_logs.lock().unwrap();\n        assert_eq!(logs.len(), 1);\n        assert_eq!(\n            logs[0].0,\n            \"INSERT INTO parents (label) VALUES ($label__0), ($label__1)\"\n        );\n        assert_eq!(logs[0].1[0].name, \"label__0\");\n        assert_eq!(logs[0].1[0].value, Value::from(\"a\"));\n        assert_eq!(logs[0].1[1].name, \"label__1\");\n        assert_eq!(logs[0].1[1].value, Value::from(\"b\"));\n    }\n    repo.update_bulk(\n        &[\n            row(&[(\"id\", Value::Int(1)), (\"label\", Value::from(\"a\"))]),\n            row(&[(\"id\", Value::Int(2)), (\"label\", Value::from(\"b\"))]),\n        ],\n        None,\n    )\n    .await\n    .unwrap();\n    repo.delete_bulk(\n        &[row(&[(\"id\", Value::Int(1))]), row(&[(\"id\", Value::Int(2))])],\n        None,\n    )\n    .await\n    .unwrap();\n    let logs = command.execute_logs.lock().unwrap();\n    assert_eq!(\n        logs[1].0,\n        \"UPDATE parents SET label = data.label FROM (SELECT $label__0 AS label, $id__0 AS id UNION ALL SELECT $label__1 AS label, $id__1 AS id) AS data WHERE parents.id = data.id\"\n    );\n    assert_eq!(\n        logs[1]\n            .1\n            .iter()\n            .map(|parameter| parameter.name.as_str())\n            .collect::<Vec<_>>(),\n        [\"label__0\", \"id__0\", \"label__1\", \"id__1\"]\n    );\n    assert_eq!(\n        logs[2].0,\n        \"DELETE FROM parents WHERE id IN ($id__0, $id__1)\"\n    );\n    assert_eq!(\n        logs[2]\n            .1\n            .iter()\n            .map(|parameter| parameter.name.as_str())\n            .collect::<Vec<_>>(),\n        [\"id__0\", \"id__1\"]\n    );\n}"}
{"file":"docs/examples/join-statements/BulkWriteStrategy.test.batch-commands-joins-statements.typescript","test":"typescript/datasources/src/BulkWriteStrategy.test.ts#batch-commands-joins-statements","from":60,"to":95,"raw":"  it(\"batch commands joins statements\", async () => {\n    const { repo, command } = open(Parent, new BatchCommandIBulkWriteStrategy<Parent>());\n    await repo.createBulk([\n      Object.assign(new Parent(), { label: \"a\" }),\n      Object.assign(new Parent(), { label: \"b\" }),\n    ]);\n    expect(command.executeCalls).toHaveLength(1);\n    expect(command.executeCalls[0]?.text).toBe(\n      \"INSERT INTO parents (label) VALUES ($label__0), ($label__1)\",\n    );\n    expect(command.executeCalls[0]?.parameters?.[0]).toMatchObject({ name: \"label__0\", value: \"a\" });\n    expect(command.executeCalls[0]?.parameters?.[1]).toMatchObject({ name: \"label__1\", value: \"b\" });\n\n    await repo.updateBulk([\n      Object.assign(new Parent(), { id: 1, label: \"a\" }),\n      Object.assign(new Parent(), { id: 2, label: \"b\" }),\n    ]);\n    expect(command.executeCalls[1]?.text).toBe(\n      \"UPDATE parents SET label = data.label FROM (SELECT $label__0 AS label, $id__0 AS id UNION ALL SELECT $label__1 AS label, $id__1 AS id) AS data WHERE parents.id = data.id\",\n    );\n    expect(command.executeCalls[1]?.parameters?.map((parameter) => parameter.name)).toEqual([\n      \"label__0\",\n      \"id__0\",\n      \"label__1\",\n      \"id__1\",\n    ]);\n\n    await repo.deleteBulk([\n      Object.assign(new Parent(), { id: 1 }),\n      Object.assign(new Parent(), { id: 2 }),\n    ]);\n    expect(command.executeCalls[2]?.text).toBe(\n      \"DELETE FROM parents WHERE id IN ($id__0, $id__1)\",\n    );\n    expect(command.executeCalls[2]?.parameters?.map((parameter) => parameter.name)).toEqual([\"id__0\", \"id__1\"]);\n  });"}
{"file":"docs/examples/join-statements/BulkWriteStrategyTests.BatchCommandIBulkWriteStrategyJoinsStatements.csharp","test":"csharp/Datasources.Tests/BulkWriteStrategyTests.cs#BatchCommandIBulkWriteStrategyJoinsStatements","from":42,"to":69,"raw":"    [Fact]\n    public async Task BatchCommandIBulkWriteStrategyJoinsStatements()\n    {\n        var (repo, command) = Repo(new BatchCommandIBulkWriteStrategy<Parent>());\n        await repo.Create([new Parent { label = \"a\" }, new Parent { label = \"b\" }]);\n        Assert.Single(command.ExecuteCalls);\n        Assert.Equal(\n            \"INSERT INTO parents (label) VALUES ($label__0), ($label__1)\",\n            command.ExecuteCalls[0].Text);\n        Assert.Equal(\"label__0\", command.ExecuteCalls[0].Parameters![0].Name);\n        Assert.Equal(new Value.Text(\"a\"), command.ExecuteCalls[0].Parameters![0].Value);\n        Assert.Equal(\"label__1\", command.ExecuteCalls[0].Parameters![1].Name);\n        Assert.Equal(new Value.Text(\"b\"), command.ExecuteCalls[0].Parameters![1].Value);\n\n        await repo.Update([new Parent { id = 1, label = \"a\" }, new Parent { id = 2, label = \"b\" }]);\n        Assert.Equal(\n            \"UPDATE parents SET label = data.label FROM (SELECT $label__0 AS label, $id__0 AS id UNION ALL SELECT $label__1 AS label, $id__1 AS id) AS data WHERE parents.id = data.id\",\n            command.ExecuteCalls[1].Text);\n        Assert.Equal(\n            [\"label__0\", \"id__0\", \"label__1\", \"id__1\"],\n            command.ExecuteCalls[1].Parameters!.Select(parameter => parameter.Name));\n\n        await repo.Delete([new Parent { id = 1 }, new Parent { id = 2 }]);\n        Assert.Equal(\n            \"DELETE FROM parents WHERE id IN ($id__0, $id__1)\",\n            command.ExecuteCalls[2].Text);\n        Assert.Equal([\"id__0\", \"id__1\"], command.ExecuteCalls[2].Parameters!.Select(parameter => parameter.Name));\n    }"}
{"file":"docs/examples/join-tables/statement_compile.joins_tables.rust","test":"rust/datasources/src/tests/statement_compile.rs#joins_tables","from":41,"to":57,"raw":"#[test]\nfn joins_tables() {\n    let where_clause = Where::new(Operator::equals(\"users.id\", 1_i64));\n    let query = SelectStatement::new(SelectStatementOptions {\n        where_clause: Some(&where_clause),\n        joins: &[\n            Join::inner(\"orders\", \"users.id\", \"orders.user_id\"),\n            Join::left(\"payments\", \"orders.id\", \"payments.order_id\"),\n            Join::right(\"profiles\", \"users.id\", \"profiles.user_id\"),\n        ],\n        ..SelectStatementOptions::new(\"users\", &[\"users.id\"])\n    });\n    assert_eq!(\n        stmt_text(&query),\n        \"SELECT users.id FROM users INNER JOIN orders ON users.id = orders.user_id LEFT JOIN payments ON orders.id = payments.order_id RIGHT JOIN profiles ON users.id = profiles.user_id WHERE users.id = $users.id\"\n    );\n}"}

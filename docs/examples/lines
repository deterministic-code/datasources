{"file":"docs/examples/bulk/BulkCRUDRepositoryTests.CreateWritesParentsAndChildren.csharp","test":"csharp/Datasources.Tests/BulkCRUDRepositoryTests.cs#CreateWritesParentsAndChildren","from":22,"to":41,"raw":"    [Fact]\n    public async Task CreateWritesParentsAndChildren()\n    {\n        var connection = await Setup();\n        var parentsRepo = new BulkCRUDRepository<Parent>(connection);\n        var childrenRepo = new BulkCRUDRepository<Child>(connection);\n        var response = await Repo(parentsRepo, childrenRepo).Create(\n        [\n            new Parent { children = [new Child { label = \"a\" }] },\n            new Parent { children = [new Child { label = \"b\" }, new Child { label = \"c\" }] }\n        ]);\n        var parents = await parentsRepo.Read().ToListAsync();\n        var children = await childrenRepo.Read().ToListAsync();\n        Assert.Equal(2, parents.Count);\n        Assert.All(parents, parent => Assert.True(parent.id > 0));\n        Assert.Equal(3, children.Count);\n        Assert.Equal(parents.Select(parent => parent.id), children.Select(child => child.parent_id).Distinct());\n        Assert.Equal(2, response.RowsAffected);\n        Assert.Equal(new Value.Int(parents.Max(parent => parent.id)), response.Result);\n    }"}
{"file":"docs/examples/bulk/datasources-mod.table_repository_maps_flat_row_into_contacts.rust","test":"rust/datasources/src/tests/mod.rs#table_repository_maps_flat_row_into_contacts","from":1897,"to":1939,"raw":"#[tokio::test]\nasync fn table_repository_maps_flat_row_into_contacts() {\n    let command = Arc::new(MockCommand::new());\n    command.reader_rows.lock().unwrap().push(record(&[\n        (\"id\", Value::Int(1)),\n        (\"username\", Value::from(\"bobby\")),\n        (\"email\", Value::from(\"bob@asdf.com\")),\n        (\"contact_name1\", Value::from(\"bob\")),\n        (\"contact_name2\", Value::from(\"roberta\")),\n    ]));\n    let connection = MockConnection::with_command_provider(command.clone(), \"memory\");\n    let mut options = CRUDRepositoryOptions::default();\n    options.entity = \"users\".into();\n    options.row_converter = Some(RowTypeConverter::of::<UserRow>());\n    options.rows_mapper = Box::new(user_contacts_mapper());\n    let repo = CRUDRepository::new(connection, options).unwrap();\n    let mut user = repo.read_single(None, None).await.unwrap().unwrap();\n    assert_eq!(user[\"username\"], Value::from(\"bobby\"));\n    assert_eq!(user[\"email\"], Value::from(\"bob@asdf.com\"));\n    assert_eq!(user[\"contacts\"], Value::from(\"bob,roberta\"));\n    assert_eq!(\n        command.reader_logs.lock().unwrap()[0].0,\n        \"SELECT contact_name1, contact_name2, email, id, username FROM users\"\n    );\n    *command.response.lock().unwrap() = Response::new(Value::Null, 1, None);\n    let created = repo.create(&mut user).await.unwrap();\n    assert_eq!(created[\"id\"], Value::Int(1));\n    assert_eq!(\n        command.execute_logs.lock().unwrap()[0].0,\n        \"INSERT INTO users (contact_name1, contact_name2, email, username) VALUES ($contact_name1, $contact_name2, $email, $username)\"\n    );\n    let updated = repo.update(&user, None).await.unwrap();\n    assert_eq!(updated.rows_affected, 1);\n    assert!(!command.execute_logs.lock().unwrap()[1]\n        .0\n        .contains(\"contacts\"));\n    let removed = repo.delete(&user, None).await.unwrap();\n    assert_eq!(removed.rows_affected, 1);\n    assert_eq!(\n        command.execute_logs.lock().unwrap()[2].0,\n        \"DELETE FROM users WHERE id = $id\"\n    );\n}"}
{"file":"docs/examples/call-a-stored-procedure-that-returns-two-results/integration.call_procedure_returns_two_results.rust","test":"rust/providers/mysql/tests/integration.rs#call_procedure_returns_two_results","from":372,"to":399,"raw":"async fn call_procedure_returns_two_results(command: &dyn Command) {\n    use datasources::ExecuteStoredProcedureStatement;\n    command\n        .execute_native(\n            &Native::new(\"CREATE PROCEDURE two_ids() BEGIN SELECT 1 AS id; SELECT 2 AS id; END\"),\n            None,\n        )\n        .await\n        .unwrap();\n    let reader = command\n        .execute_reader_statement(&ExecuteStoredProcedureStatement::new(\"two_ids\", &[]), None)\n        .await\n        .unwrap();\n    let mut first = Vec::new();\n    while reader.next().await.unwrap() {\n        first.push(reader.current());\n    }\n    let moved = reader.next_result().await.unwrap();\n    let mut second = Vec::new();\n    while reader.next().await.unwrap() {\n        second.push(reader.current());\n    }\n    let again = reader.next_result().await.unwrap();\n    assert_eq!(moved, true);\n    assert_eq!(again, false);\n    assert_eq!(first[0].as_ref().unwrap().get(\"id\"), Some(&Value::Int(1)));\n    assert_eq!(second[0].as_ref().unwrap().get(\"id\"), Some(&Value::Int(2)));\n}"}
{"file":"docs/examples/call-a-stored-procedure-that-returns-two-results/mysql.integration.test.callProcedureReturnsTwoResults.typescript","test":"typescript/providers/mysql/tests/mysql.integration.test.ts#callProcedureReturnsTwoResults","from":41,"to":60,"raw":"async function callProcedureReturnsTwoResults(command: MysqlCommand) {\n  await command.executeNative(new Native(`\n    CREATE PROCEDURE two_ids()\n    BEGIN\n      SELECT 1 AS id;\n      SELECT 2 AS id;\n    END\n  `));\n  await using reader = await command.executeReaderStatement(new ExecuteStoredProcedureStatement(\"two_ids\", []));\n  const first: { id: number }[] = [];\n  while (await reader.next()) first.push(reader.current as { id: number });\n  const moved = await reader.nextResult();\n  const second: { id: number }[] = [];\n  while (await reader.next()) second.push(reader.current as { id: number });\n  const again = await reader.nextResult();\n  expect(moved).toBe(true);\n  expect(again).toBe(false);\n  expect(first[0]?.id).toBe(1);\n  expect(second[0]?.id).toBe(2);\n}"}
{"file":"docs/examples/call-a-stored-procedure-that-returns-two-results/MysqlCommandIntegrationTests.CallProcedureReturnsTwoResults.csharp","test":"csharp/Providers/Mysql.Tests/MysqlCommandIntegrationTests.cs#CallProcedureReturnsTwoResults","from":81,"to":103,"raw":"    static async Task CallProcedureReturnsTwoResults(ICommand command)\n    {\n        await command.Execute(Native.N(\"\"\"\n            CREATE PROCEDURE two_ids()\n            BEGIN\n              SELECT 1 AS id;\n              SELECT 2 AS id;\n            END\n            \"\"\"));\n        await using var reader = await command.ExecuteReader(new ExecuteStoredProcedureStatement(\"two_ids\", []));\n        var first = new List<Row>();\n        while (await reader.Next())\n            first.Add(reader.Current!);\n        var moved = await reader.NextResult();\n        var second = new List<Row>();\n        while (await reader.Next())\n            second.Add(reader.Current!);\n        var again = await reader.NextResult();\n        Assert.True(moved);\n        Assert.False(again);\n        Assert.Equal(new Value.Int(1), first[0][\"id\"]);\n        Assert.Equal(new Value.Int(2), second[0][\"id\"]);\n    }"}

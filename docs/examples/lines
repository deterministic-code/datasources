{"file":"docs/examples/command-running-in-one-atomic-transaction/index.test.command-running-in-one-atomic-transaction.typescript","test":"typescript/providers/memory/src/index.test.ts#command-running-in-one-atomic-transaction","from":106,"to":120,"raw":"  it(\"command running in one atomic transaction\", async () => {\n    const ds = Datasource.default;\n    const connection = await ds.createConnection();\n    await connection.open();\n    const txn = await connection.startTransaction();\n    const command = connection.createCommand();\n    const fields = [{ name: \"name\", value: \"ada\" }];\n    await command.executeStatement(new InsertStatement(\"people\", fields), fields);\n    const reader = await command.executeReaderStatement(new SelectInsertedIdStatement(\"people\", \"id\"));\n    const moved = await reader.next();\n    const id = reader.current;\n    await txn.commit();\n    expect(moved).toBe(true);\n    expect(id).toEqual({ id: 1 });\n  });"}
{"file":"docs/examples/command-running-in-one-atomic-transaction/memory-lib.command_running_in_one_atomic_transaction.rust","test":"rust/providers/memory/src/lib.rs#command_running_in_one_atomic_transaction","from":118,"to":144,"raw":"    #[tokio::test]\n    async fn command_running_in_one_atomic_transaction() {\n        let _guard = super::env_lock();\n        clear_env();\n        let ds = default().unwrap();\n        let connection = ds.create_connection().await.unwrap();\n        connection.open().await.unwrap();\n        let txn = connection.start_transaction(None).await.unwrap();\n        let command = connection.create_command();\n        let fields = vec![Parameter::new(\"name\", \"ada\")];\n        command\n            .execute_statement(&InsertStatement::new(\"people\", &fields), Some(&fields))\n            .await\n            .unwrap();\n        let reader = command\n            .execute_reader_statement(&SelectInsertedIdStatement::new(\"people\", \"id\"), None)\n            .await\n            .unwrap();\n        let moved = reader.next().await.unwrap();\n        let id = reader.current();\n        txn.commit().await.unwrap();\n        assert_eq!(moved, true);\n        assert_eq!(\n            id.as_ref().and_then(|row| row.get(\"id\")),\n            Some(&Value::Int(1))\n        );\n    }"}
{"file":"docs/examples/command-running-in-one-atomic-transaction/TransactionLifecycleTests.CommandRunningInOneAtomicTransaction.csharp","test":"csharp/Providers/Memory.Tests/TransactionLifecycleTests.cs#CommandRunningInOneAtomicTransaction","from":45,"to":61,"raw":"    [Fact]\n    public async Task CommandRunningInOneAtomicTransaction()\n    {\n        var ds = Datasource.Default;\n        var connection = await ds.CreateConnection();\n        await connection.Open();\n        var txn = await connection.StartTransaction();\n        var command = connection.CreateCommand();\n        var fields = new Parameter[] { new(\"name\", \"ada\") };\n        await command.Execute(new InsertStatement(\"people\", fields), fields);\n        var reader = await command.ExecuteReader(new SelectInsertedIdStatement(\"people\", \"id\"));\n        var moved = await reader.Next();\n        var id = reader.Current![\"id\"];\n        await txn.Commit();\n        Assert.True(moved);\n        Assert.Equal(new Value.Int(1), id);\n    }"}
{"file":"docs/examples/commit-or-abort/transaction.commit_or_abort.rust","test":"rust/datasources/src/tests/transaction.rs#commit_or_abort","from":16,"to":31,"raw":"#[tokio::test]\nasync fn commit_or_abort() {\n    let _guard = super::env_lock();\n    clear_env();\n    let ds = default().expect(\"default\");\n    let connection = ds.create_connection().await.expect(\"connection\");\n    connection.open().await.expect(\"open\");\n    let txn = connection.start_transaction(None).await.expect(\"txn\");\n    let saved = true;\n    if saved {\n        txn.commit().await.expect(\"commit\");\n    } else {\n        txn.abort().await.expect(\"abort\");\n    }\n    assert_eq!(txn.isolation(), IsolationLevel::ReadCommitted);\n}"}

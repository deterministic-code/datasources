{"file":"docs/examples/replace-children/EnrichedCRUDRepository.test.cascade-update-deletes-children-and-recreates.typescript","test":"typescript/datasources/src/EnrichedCRUDRepository.test.ts#cascade-update-deletes-children-and-recreates","from":158,"to":186,"raw":"  it(\"cascade update deletes children and recreates\", async () => {\n    const connection = await setup();\n    const parentsRepo = new CRUDRepository<Parent>(connection, {\n      type: Parent,\n      write: new DefaultWriteEnrichmentStrategy(undefined, new CascadeDeleteUpdateEnrichmentStrategy()),\n    });\n    const childrenRepo = new CRUDRepository(Child, connection);\n    const notesRepo = new CRUDRepository(Note, connection);\n    const parent = await parentsRepo.create(new Parent());\n    expect(parent.id).toBeGreaterThan(0);\n    const child = await childrenRepo.create(Object.assign(new Child(), { parent_id: parent.id, label: \"a\" }));\n    expect(child.id).toBeGreaterThan(0);\n    const other = await childrenRepo.create(Object.assign(new Child(), { label: \"other\" }));\n    expect(other.id).toBeGreaterThan(0);\n    const note = await notesRepo.create(Object.assign(new Note(), { child_id: child.id, text: \"n\" }));\n    expect(note.id).toBeGreaterThan(0);\n    childrenRepo.addEnriched({ into: \"notes\", from: \"id\", by: \"child_id\", many: true }, notesRepo);\n    parentsRepo.addEnriched({ into: \"children\", from: \"id\", by: \"parent_id\", many: true }, childrenRepo);\n    const updated = await parentsRepo.update(Object.assign(new Parent(), {\n      id: parent.id,\n      children: [Object.assign(new Child(), { id: child.id, label: \"fresh\" })],\n    }));\n    expect(updated.rowsAffected).toBe(1);\n    const created = (await collectAsync(childrenRepo.read())).find((row) => row.label === \"fresh\");\n    expect(created?.id).not.toBe(child?.id);\n    expect(created?.label).toBe(\"fresh\");\n    expect(created?.parent_id).toBe(parent?.id);\n    expect(await collectAsync(notesRepo.read())).toEqual([]);\n  });"}
{"file":"docs/examples/replace-children/EnrichedCRUDRepositoryTests.CascadeUpdateDeletesChildrenAndRecreates.csharp","test":"csharp/Datasources.Tests/EnrichedCRUDRepositoryTests.cs#CascadeUpdateDeletesChildrenAndRecreates","from":129,"to":160,"raw":"    [Fact]\n    public async Task CascadeUpdateDeletesChildrenAndRecreates()\n    {\n        var connection = await Setup();\n        var parentsRepo = new CRUDRepository<Parent>(connection, new CRUDRepositoryOptions<Parent>\n        {\n            Write = new DefaultWriteEnrichmentStrategy<Parent>(update: new CascadeDeleteUpdateEnrichmentStrategy<Parent>()),\n        });\n        var childrenRepo = new CRUDRepository<Child>(connection);\n        var notesRepo = new CRUDRepository<Note>(connection);\n        var parent = await parentsRepo.Create(new Parent());\n        Assert.True(parent.id > 0);\n        var child = await childrenRepo.Create(new Child { parent_id = parent.id, label = \"a\" });\n        Assert.True(child.id > 0);\n        var other = await childrenRepo.Create(new Child { label = \"other\" });\n        Assert.True(other.id > 0);\n        var note = await notesRepo.Create(new Note { child_id = child.id, text = \"n\" });\n        Assert.True(note.id > 0);\n        childrenRepo.AddEnriched(new(\"notes\", \"id\", \"child_id\", Many: true), notesRepo);\n        parentsRepo.AddEnriched(new(\"children\", \"id\", \"parent_id\", Many: true), childrenRepo);\n        var updated = await parentsRepo.Update(new Parent\n        {\n            id = parent.id,\n            children = [new Child { id = child.id, label = \"fresh\" }]\n        });\n        Assert.Equal(1, updated.RowsAffected);\n        var created = (await childrenRepo.Read().ToListAsync()).Single(row => row.label == \"fresh\");\n        Assert.NotEqual(child.id, created.id);\n        Assert.Equal(\"fresh\", created.label);\n        Assert.Equal(parent.id, created.parent_id);\n        Assert.Empty(await notesRepo.Read().ToListAsync());\n    }"}
{"file":"docs/examples/replace-sync-children/enriched.deep_update_replace_syncs_children.rust","test":"rust/datasources/tests/enriched.rs#deep_update_replace_syncs_children","from":335,"to":404,"raw":"#[tokio::test]\nasync fn deep_update_replace_syncs_children() {\n    let connection = setup(&mut []).await;\n    let mut parents = crud(connection.clone(), \"Parent\");\n    let children = Arc::new(crud(connection, \"Child\"));\n    let parent = parents\n        .create(&mut record(&[(\"label\", Value::from(\"p\"))]))\n        .await\n        .unwrap();\n    assert!(num(&parent, \"id\") > 0);\n    let parent_id = parent.get(\"id\").unwrap().clone();\n    let kept = children\n        .create(&mut record(&[\n            (\"parent_id\", parent_id.clone()),\n            (\"label\", Value::from(\"a\")),\n        ]))\n        .await\n        .unwrap();\n    assert!(num(&kept, \"id\") > 0);\n    let dropped = children\n        .create(&mut record(&[\n            (\"parent_id\", parent_id.clone()),\n            (\"label\", Value::from(\"b\")),\n        ]))\n        .await\n        .unwrap();\n    assert!(num(&dropped, \"id\") > 0);\n    parents.add_enriched(\n        Enrichment::new(\"children\", \"id\", \"parent_id\", None, true),\n        children.clone(),\n        None,\n    );\n    let updated = parents\n        .update(\n            &record(&[\n                (\"id\", parent_id.clone()),\n                (\"label\", Value::from(\"p\")),\n                (\n                    \"children\",\n                    encode_rows(&[\n                        record(&[\n                            (\"id\", kept.get(\"id\").unwrap().clone()),\n                            (\"label\", Value::from(\"aa\")),\n                        ]),\n                        record(&[(\"label\", Value::from(\"c\"))]),\n                    ]),\n                ),\n            ]),\n            None,\n        )\n        .await\n        .unwrap();\n    assert_eq!(updated.rows_affected, 1);\n    let stored = children.read(None, None).await.unwrap();\n    assert_eq!(stored.len(), 2);\n    assert_eq!(\n        stored\n            .iter()\n            .find(|row| row.get(\"id\") == kept.get(\"id\"))\n            .unwrap()[\"label\"],\n        Value::from(\"aa\")\n    );\n    assert_eq!(\n        stored\n            .iter()\n            .find(|row| row.get(\"id\") != kept.get(\"id\"))\n            .unwrap()[\"label\"],\n        Value::from(\"c\")\n    );\n}"}
{"file":"docs/examples/replace-sync-children/EnrichedCRUDRepository.test.update-replace-syncs-children.typescript","test":"typescript/datasources/src/EnrichedCRUDRepository.test.ts#update-replace-syncs-children","from":132,"to":156,"raw":"  it(\"update replace-syncs children\", async () => {\n    const connection = await setup();\n    const parentsRepo = new CRUDRepository(Parent, connection);\n    const childrenRepo = new CRUDRepository(Child, connection);\n    const parent = await parentsRepo.create(new Parent());\n    expect(parent.id).toBeGreaterThan(0);\n    const kept = await childrenRepo.create(Object.assign(new Child(), { parent_id: parent.id, label: \"a\" }));\n    expect(kept.id).toBeGreaterThan(0);\n    const dropped = await childrenRepo.create(Object.assign(new Child(), { parent_id: parent.id, label: \"b\" }));\n    expect(dropped.id).toBeGreaterThan(0);\n    parentsRepo.addEnriched({ into: \"children\", from: \"id\", by: \"parent_id\", many: true }, childrenRepo);\n    const updated = await parentsRepo.update(Object.assign(new Parent(), {\n      id: parent.id,\n      children: [\n        Object.assign(new Child(), { id: kept.id, label: \"aa\" }),\n        Object.assign(new Child(), { label: \"c\" }),\n      ],\n    }));\n    expect(updated.rowsAffected).toBe(1);\n    const children = await collectAsync(childrenRepo.read());\n    expect(children).toHaveLength(2);\n    expect(children.find((child) => child.id === kept?.id)?.label).toBe(\"aa\");\n    expect(children.find((child) => child.id !== kept?.id)?.label).toBe(\"c\");\n    expect(children.every((child) => child.parent_id === parent?.id)).toBe(true);\n  });"}
{"file":"docs/examples/replace-sync-children/EnrichedCRUDRepositoryTests.UpdateReplaceSyncsChildren.csharp","test":"csharp/Datasources.Tests/EnrichedCRUDRepositoryTests.cs#UpdateReplaceSyncsChildren","from":99,"to":127,"raw":"    [Fact]\n    public async Task UpdateReplaceSyncsChildren()\n    {\n        var connection = await Setup();\n        var parentsRepo = new CRUDRepository<Parent>(connection);\n        var childrenRepo = new CRUDRepository<Child>(connection);\n        var parent = await parentsRepo.Create(new Parent { type_id = 0 });\n        Assert.True(parent.id > 0);\n        var kept = await childrenRepo.Create(new Child { parent_id = parent.id, label = \"a\" });\n        Assert.True(kept.id > 0);\n        var dropped = await childrenRepo.Create(new Child { parent_id = parent.id, label = \"b\" });\n        Assert.True(dropped.id > 0);\n        parentsRepo.AddEnriched(new(\"children\", \"id\", \"parent_id\", Many: true), childrenRepo);\n        var updated = await parentsRepo.Update(new Parent\n        {\n            id = parent.id,\n            children =\n            [\n                new Child { id = kept.id, label = \"aa\" },\n                new Child { label = \"c\" }\n            ]\n        });\n        Assert.Equal(1, updated.RowsAffected);\n        var children = await childrenRepo.Read().ToListAsync();\n        Assert.Equal(2, children.Count);\n        Assert.Equal(\"aa\", children.Single(child => child.id == kept.id).label);\n        Assert.Equal(\"c\", children.Single(child => child.id != kept.id).label);\n        Assert.All(children, child => Assert.Equal(parent.id, child.parent_id));\n    }"}

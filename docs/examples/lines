{"file":"docs/examples/lowercase-plural/pluralizer_mapper.lowercases_then_pluralizes.rust","test":"rust/datasources/src/mappers/pluralizer_mapper.rs#lowercases_then_pluralizes","from":63,"to":75,"raw":"    #[test]\n    fn lowercases_then_pluralizes() {\n        let casing = ChangeCasingMapper::new(Casing::Pascal, Casing::Snake);\n        let pluralizer = PluralizerMapper::new();\n        let contact = pluralizer.map(casing.map(\"Contact\".into()));\n        let address = pluralizer.map(casing.map(\"Address\".into()));\n        let contact_name = casing.reverse_map(pluralizer.reverse_map(contact.clone()));\n        let address_name = casing.reverse_map(pluralizer.reverse_map(address.clone()));\n        assert_eq!(contact, \"contacts\");\n        assert_eq!(address, \"addresses\");\n        assert_eq!(contact_name, \"Contact\");\n        assert_eq!(address_name, \"Address\");\n    }"}
{"file":"docs/examples/lowercase-plural/PluralizerMapper.test.lowercases-then-pluralizes.typescript","test":"typescript/datasources/src/mappers/PluralizerMapper.test.ts#lowercases-then-pluralizes","from":28,"to":39,"raw":"  it(\"lowercases then pluralizes\", () => {\n    const casing = new ChangeCasingMapper(\"pascalCase\", \"snakeCase\");\n    const pluralizer = new PluralizerMapper();\n    const contact = pluralizer.map(casing.map(\"Contact\"));\n    const address = pluralizer.map(casing.map(\"Address\"));\n    const contactName = casing.reverseMap(pluralizer.reverseMap(contact));\n    const addressName = casing.reverseMap(pluralizer.reverseMap(address));\n    expect(contact).toBe(\"contacts\");\n    expect(address).toBe(\"addresses\");\n    expect(contactName).toBe(\"Contact\");\n    expect(addressName).toBe(\"Address\");\n  });"}
{"file":"docs/examples/lowercase-plural/PluralizerMapperTests.LowercasesThenPluralizes.csharp","test":"csharp/Datasources.Tests/PluralizerMapperTests.cs#LowercasesThenPluralizes","from":35,"to":48,"raw":"    [Fact]\n    public void LowercasesThenPluralizes()\n    {\n        var casing = new ChangeCasingMapper(Casing.Pascal, Casing.Snake);\n        var pluralizer = new PluralizerMapper();\n        var contact = pluralizer.Map(casing.Map(\"Contact\"));\n        var address = pluralizer.Map(casing.Map(\"Address\"));\n        var contactName = casing.ReverseMap(pluralizer.ReverseMap(contact));\n        var addressName = casing.ReverseMap(pluralizer.ReverseMap(address));\n        Assert.Equal(\"contacts\", contact);\n        Assert.Equal(\"addresses\", address);\n        Assert.Equal(\"Contact\", contactName);\n        Assert.Equal(\"Address\", addressName);\n    }"}
{"file":"docs/examples/map-a-contact-name-and-email/mappers-mod.maps_a_contact_name_and_email.rust","test":"rust/datasources/src/mappers/mod.rs#maps_a_contact_name_and_email","from":147,"to":173,"raw":"    #[test]\n    fn maps_a_contact_name_and_email() {\n        let contact = Contact {\n            name: \"Ada\".into(),\n            email: \"ada@x.dev\".into(),\n        };\n        let mapper = TransformMapper::new(\n            |item: Contact| ContactRow {\n                contact_name: item.name,\n                contact_email: item.email,\n            },\n            |row: ContactRow| Contact {\n                name: row.contact_name,\n                email: row.contact_email,\n            },\n        );\n        let mapped = Mapper::map(&mapper, contact.clone());\n        let reversed = Mapper::reverse_map(&mapper, mapped.clone());\n        assert_eq!(\n            mapped,\n            ContactRow {\n                contact_name: \"Ada\".into(),\n                contact_email: \"ada@x.dev\".into(),\n            }\n        );\n        assert_eq!(reversed, contact);\n    }"}
{"file":"docs/examples/map-a-contact-name-and-email/transformMapper.test.maps-a-contact-name-and-email.typescript","test":"typescript/datasources/src/mappers/transformMapper.test.ts#maps-a-contact-name-and-email","from":55,"to":65,"raw":"  it(\"maps a contact name and email\", () => {\n    const contact: Contact = { name: \"Ada\", email: \"ada@x.dev\" };\n    const mapper = new TransformMapper<Contact, ContactRow>(\n      (item) => ({ contactName: item.name, contactEmail: item.email }),\n      (row) => ({ name: row.contactName, email: row.contactEmail }),\n    );\n    const mapped = mapper.map(contact);\n    const reversed = mapper.reverseMap(mapped);\n    expect(mapped).toEqual({ contactName: \"Ada\", contactEmail: \"ada@x.dev\" });\n    expect(reversed).toEqual(contact);\n  });"}
{"file":"docs/examples/map-a-contact-name-and-email/TransformMapperTests.MapsAContactNameAndEmail.csharp","test":"csharp/Datasources.Tests/TransformMapperTests.cs#MapsAContactNameAndEmail","from":41,"to":52,"raw":"    [Fact]\n    public void MapsAContactNameAndEmail()\n    {\n        var contact = new Contact(\"Ada\", \"ada@x.dev\");\n        var mapper = new TransformMapper<Contact, ContactRow>(\n            map: item => new ContactRow(item.Name, item.Email),\n            reverseMap: row => new Contact(row.ContactName, row.ContactEmail));\n        var mapped = mapper.Map(contact);\n        var reversed = mapper.ReverseMap(mapped);\n        Assert.Equal(new ContactRow(\"Ada\", \"ada@x.dev\"), mapped);\n        Assert.Equal(contact, reversed);\n    }"}
{"file":"docs/examples/map-an-object-explicitly/readonly_repository.maps_an_object_explicitly.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#maps_an_object_explicitly","from":142,"to":170,"schema":"minimal-users","raw":"#[tokio::test]\nasync fn maps_an_object_explicitly() {\n    let built = datasource();\n    let ds: &dyn Datasource = &*built;\n    let connection = open(ds).await;\n    apply_schema(connection.as_ref(), \"minimal-users\").await.unwrap();\n    execute_sql(\n        &connection,\n        \"\n        INSERT INTO users (id, username, is_enabled) VALUES\n            (1, 'ada', 1),\n            (2, 'grace', 0);\n        \",\n    )\n    .await;\n    let mut options = create_readonly_repository_mapping_options::<User>();\n    options.entity_mapper = Some(std::sync::Arc::new(snake_then_plural()));\n    options.property_mappings = Some(std::sync::Arc::new(snake()));\n    options.object_converter = Some(Box::new(UserConverter));\n    let users_repo = ds.create_readonly_repository::<User>(Some(connection), Some(options));\n    let user = users_repo\n        .read_single(Some(&Where::binary(\"Id\", eq, 1_i64)), None, None)\n        .await\n        .unwrap()\n        .unwrap();\n    assert_eq!(user.get(\"Id\"), Some(&Value::Int(1)));\n    assert_eq!(user.get(\"Username\"), Some(&Value::from(\"ada\")));\n    assert_eq!(user.get(\"IsEnabled\"), Some(&Value::Bool(true)));\n}"}
{"file":"docs/examples/map-an-object-explicitly/readonly_repository.TypeConverterForUserConverter.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#TypeConverterForUserConverter","from":118,"to":140,"raw":"impl TypeConverter<Row, Row> for UserConverter {\n    fn convert(&self, from: &Row) -> Result<Row> {\n        let mut row = from.clone();\n        let enabled = match row.get(\"IsEnabled\") {\n            Some(Value::Bool(flag)) => Value::Bool(*flag),\n            Some(value) => value.clone(),\n            None => Value::Null,\n        };\n        row.insert(\"IsEnabled\".into(), enabled);\n        Ok(row)\n    }\n\n    fn reverse_convert(&self, to: &Row) -> Result<Row> {\n        let mut row = to.clone();\n        let enabled = match row.get(\"IsEnabled\") {\n            Some(Value::Bool(flag)) => Value::Int(if *flag { 1 } else { 0 }),\n            Some(value) => value.clone(),\n            None => Value::Null,\n        };\n        row.insert(\"IsEnabled\".into(), enabled);\n        Ok(row)\n    }\n}"}
{"file":"docs/examples/map-an-object-explicitly/readonly.repository.integration.test.maps-an-object-explicitly.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#maps-an-object-explicitly","from":96,"to":114,"schema":"minimal-users","raw":"  it(\"maps an object explicitly\", async () => {\n    const ds = new Datasource(\"sqlite\", new SqliteDriver(), { DATASOURCE_URL: \"sqlite:///:memory:\" });\n    const connection = await open(ds);\n    await applySchema(connection, \"minimal-users\");\n    await executeSql(connection, `\n      INSERT INTO users (id, username, is_enabled) VALUES\n        (1, 'ada', 1),\n        (2, 'grace', 0);\n    `);\n    const usersRepo = ds.createReadonlyRepository(User, connection, {\n      entityMapper: snakeThenPlural(),\n      propertyMappings: snake(),\n      objectConverter: new UserConverter(),\n    });\n    const user = await usersRepo.readSingle(new Where(\"Id\", eq, 1));\n    expect(user?.Id).toBe(1);\n    expect(user?.Username).toBe(\"ada\");\n    expect(user?.IsEnabled).toBe(true);\n  });"}
{"file":"docs/examples/map-an-object-explicitly/readonly.repository.integration.test.UserConverter.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#UserConverter","from":44,"to":58,"raw":"class UserConverter extends TypeConverter<User, Cells> {\n  convert = (from: Cells): User => {\n    const user = new User();\n    user.Id = from.Id as number;\n    user.Username = from.Username as string;\n    user.IsEnabled = from.IsEnabled === true;\n    return user;\n  };\n\n  reverseConvert = (to: User): Cells => ({\n    Id: to.Id,\n    Username: to.Username,\n    IsEnabled: to.IsEnabled ? 1 : 0,\n  });\n}"}
{"file":"docs/examples/map-an-object-explicitly/ReadonlyRepositoryIntegrationTests.MapsAnObjectExplicitly.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#MapsAnObjectExplicitly","from":92,"to":116,"schema":"minimal-users","raw":"    [Fact]\n    public async Task MapsAnObjectExplicitly()\n    {\n        var driver = new SqliteDriver();\n        var ds = new Datasource(\"sqlite\", driver, new Dictionary<string, string?> { [\"DATASOURCE_URL\"] = \"sqlite:///:memory:\" });\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"minimal-users\");\n        await Execute(connection, \"\"\"\n            INSERT INTO users (id, username, is_enabled) VALUES\n                (1, 'ada', 1),\n                (2, 'grace', 0);\n            \"\"\");\n        var usersRepo = ds.CreateReadonlyRepository<User>(connection, new ReadonlyRepositoryMappingOptions<User>\n        {\n            EntityMapper = SnakeThenPlural(),\n            PropertyMappings = Snake(),\n            ObjectConverter = new UserConverter()\n        });\n\n        var user = await usersRepo.ReadSingle(new Where(\"Id\", eq, 1));\n\n        Assert.Equal(1L, user!.Id);\n        Assert.Equal(\"ada\", user.Username);\n        Assert.True(user.IsEnabled);\n    }"}
{"file":"docs/examples/map-an-object-explicitly/ReadonlyRepositoryIntegrationTests.UserConverter.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#UserConverter","from":75,"to":90,"raw":"    sealed class UserConverter : TypeConverter<User, Row>\n    {\n        public override User Convert(Row from) => new()\n        {\n            Id = (long)from[\"Id\"].ToObject()!,\n            Username = (string)from[\"Username\"].ToObject()!,\n            IsEnabled = (bool)from[\"IsEnabled\"].ToObject()!\n        };\n\n        public override Row ReverseConvert(User to) => new()\n        {\n            [\"Id\"] = to.Id,\n            [\"Username\"] = to.Username,\n            [\"IsEnabled\"] = to.IsEnabled\n        };\n    }"}
{"file":"docs/examples/map-and-reverse-map/dictionary_mapper.maps_known_names_and_passes_through_the_rest.rust","test":"rust/datasources/src/mappers/dictionary_mapper.rs#maps_known_names_and_passes_through_the_rest","from":51,"to":74,"raw":"    #[test]\n    fn maps_known_names_and_passes_through_the_rest() {\n        let mapper = DictionaryMapper::new([\n            (\"FirstName\".to_string(), \"given_name\".to_string()),\n            (\"LastName\".to_string(), \"family_name\".to_string()),\n            (\"Email\".to_string(), \"email_address\".to_string()),\n        ]);\n        let first_name = mapper.map(\"FirstName\".into());\n        let last_name = mapper.map(\"LastName\".into());\n        let email = mapper.map(\"Email\".into());\n        let phone = mapper.map(\"Phone\".into());\n        let from_first = mapper.reverse_map(\"given_name\".into());\n        let from_last = mapper.reverse_map(\"family_name\".into());\n        let from_email = mapper.reverse_map(\"email_address\".into());\n        let from_phone = mapper.reverse_map(\"Phone\".into());\n        assert_eq!(first_name, \"given_name\");\n        assert_eq!(last_name, \"family_name\");\n        assert_eq!(email, \"email_address\");\n        assert_eq!(phone, \"Phone\");\n        assert_eq!(from_first, \"FirstName\");\n        assert_eq!(from_last, \"LastName\");\n        assert_eq!(from_email, \"Email\");\n        assert_eq!(from_phone, \"Phone\");\n    }"}
{"file":"docs/examples/map-and-reverse-map/DictionaryMapper.test.maps-known-names-and-passes-through-the-rest.typescript","test":"typescript/datasources/src/mappers/DictionaryMapper.test.ts#maps-known-names-and-passes-through-the-rest","from":14,"to":36,"raw":"  it(\"maps known names and passes through the rest\", () => {\n    const mapper = new DictionaryMapper([\n      [\"FirstName\", \"given_name\"],\n      [\"LastName\", \"family_name\"],\n      [\"Email\", \"email_address\"],\n    ]);\n    const firstName = mapper.map(\"FirstName\");\n    const lastName = mapper.map(\"LastName\");\n    const email = mapper.map(\"Email\");\n    const phone = mapper.map(\"Phone\");\n    const fromFirst = mapper.reverseMap(\"given_name\");\n    const fromLast = mapper.reverseMap(\"family_name\");\n    const fromEmail = mapper.reverseMap(\"email_address\");\n    const fromPhone = mapper.reverseMap(\"Phone\");\n    expect(firstName).toBe(\"given_name\");\n    expect(lastName).toBe(\"family_name\");\n    expect(email).toBe(\"email_address\");\n    expect(phone).toBe(\"Phone\");\n    expect(fromFirst).toBe(\"FirstName\");\n    expect(fromLast).toBe(\"LastName\");\n    expect(fromEmail).toBe(\"Email\");\n    expect(fromPhone).toBe(\"Phone\");\n  });"}
{"file":"docs/examples/map-and-reverse-map/DictionaryMapperTests.MapsKnownNamesAndPassesThroughTheRest.csharp","test":"csharp/Datasources.Tests/DictionaryMapperTests.cs#MapsKnownNamesAndPassesThroughTheRest","from":14,"to":38,"raw":"    public void MapsKnownNamesAndPassesThroughTheRest()\n    {\n        var mapper = new DictionaryMapper<string>(new Dictionary<string, string>\n        {\n            [\"FirstName\"] = \"given_name\",\n            [\"LastName\"] = \"family_name\",\n            [\"Email\"] = \"email_address\",\n        });\n        var firstName = mapper.Map(\"FirstName\");\n        var lastName = mapper.Map(\"LastName\");\n        var email = mapper.Map(\"Email\");\n        var phone = mapper.Map(\"Phone\");\n        var fromFirst = mapper.ReverseMap(\"given_name\");\n        var fromLast = mapper.ReverseMap(\"family_name\");\n        var fromEmail = mapper.ReverseMap(\"email_address\");\n        var fromPhone = mapper.ReverseMap(\"Phone\");\n        Assert.Equal(\"given_name\", firstName);\n        Assert.Equal(\"family_name\", lastName);\n        Assert.Equal(\"email_address\", email);\n        Assert.Equal(\"Phone\", phone);\n        Assert.Equal(\"FirstName\", fromFirst);\n        Assert.Equal(\"LastName\", fromLast);\n        Assert.Equal(\"Email\", fromEmail);\n        Assert.Equal(\"Phone\", fromPhone);\n    }"}

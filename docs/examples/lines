{"file":"docs/examples/read-multiple-results-returned-in-a-single-command/command.read_multiple_results.rust","test":"rust/providers/sqlite/tests/command.rs#read_multiple_results","from":421,"to":444,"raw":"#[tokio::test]\nasync fn read_multiple_results() {\n    let _guard = super::env_lock();\n    let ds = default().unwrap();\n    let command = ds.create_command(None).await.unwrap();\n    let reader = command\n        .execute_reader_native(&Native::new(\"SELECT 1 AS id; SELECT 2 AS id\"), None)\n        .await\n        .unwrap();\n    let mut first = Vec::new();\n    while reader.next().await.unwrap() {\n        first.push(reader.current());\n    }\n    let moved = reader.next_result().await.unwrap();\n    let mut second = Vec::new();\n    while reader.next().await.unwrap() {\n        second.push(reader.current());\n    }\n    let again = reader.next_result().await.unwrap();\n    assert!(moved);\n    assert!(!again);\n    assert_eq!(first[0].as_ref().unwrap().get(\"id\"), Some(&Value::Int(1)));\n    assert_eq!(second[0].as_ref().unwrap().get(\"id\"), Some(&Value::Int(2)));\n}"}
{"file":"docs/examples/read-multiple-results-returned-in-a-single-command/sqlite.integration.test.reads-multiple-results-returned-in-a-single-command.typescript","test":"typescript/providers/sqlite/tests/sqlite.integration.test.ts#reads-multiple-results-returned-in-a-single-command","from":234,"to":248,"raw":"  it(\"reads multiple results returned in a single command\", async () => {\n    const ds = Datasource.default;\n    const command = await ds.createCommand();\n    await using reader = await command.executeReaderNative(new Native(\"SELECT 1 AS id; SELECT 2 AS id\"));\n    const first: { id: number }[] = [];\n    while (await reader.next()) first.push(reader.current as { id: number });\n    const moved = await reader.nextResult();\n    const second: { id: number }[] = [];\n    while (await reader.next()) second.push(reader.current as { id: number });\n    const again = await reader.nextResult();\n    expect(moved).toBe(true);\n    expect(again).toBe(false);\n    expect(first[0]?.id).toBe(1);\n    expect(second[0]?.id).toBe(2);\n  });"}
{"file":"docs/examples/read-multiple-results-returned-in-a-single-command/SqliteCommandIntegrationTests.ReadMultipleResults.csharp","test":"csharp/Providers/Sqlite.Tests/SqliteCommandIntegrationTests.cs#ReadMultipleResults","from":232,"to":250,"raw":"    [Fact]\n    public async Task ReadMultipleResults()\n    {\n        var ds = Datasource.Default;\n        var command = await ds.CreateCommand();\n        await using var reader = await command.ExecuteReader(Native.N(\"SELECT 1 AS id; SELECT 2 AS id\"));\n        var first = new List<Row>();\n        while (await reader.Next())\n            first.Add(reader.Current!);\n        var moved = await reader.NextResult();\n        var second = new List<Row>();\n        while (await reader.Next())\n            second.Add(reader.Current!);\n        var again = await reader.NextResult();\n        Assert.True(moved);\n        Assert.False(again);\n        Assert.Equal(new Value.Int(1), first[0][\"id\"]);\n        Assert.Equal(new Value.Int(2), second[0][\"id\"]);\n    }"}
{"file":"docs/examples/read-with-where-clause-and-custom-flat-to-nested-custom-object-mapping-options/read_with_where_clause_and_custom_flat_to_nested_object_mapping_options.read_with_where_clause_and_custom_flat_to_nested_object_mapping_options.rust","test":"rust/datasources/tests/read_with_where_clause_and_custom_flat_to_nested_object_mapping_options.rs#read_with_where_clause_and_custom_flat_to_nested_object_mapping_options","from":61,"to":173,"raw":"#[tokio::test]\nasync fn read_with_where_clause_and_custom_flat_to_nested_object_mapping_options() {\n    let connection = MemoryDriver.connection(None);\n    connection.open().await.unwrap();\n    let types = Arc::new(types_repo(connection.clone()));\n    let created_type = types.create(record(&[(\"Name\", Value::from(\"person\"))])).await.unwrap();\n    let mut parents = parents_repo(connection);\n    parents.add_enriched(\n        Enrichment::new(\n            \"TypeName\",\n            \"Type\",\n            \"Id\",\n            Some(\"Name\".into()),\n            EnrichmentPropertyType::Object,\n        ),\n        as_readonly(types.clone()),\n        None,\n    );\n    let parent = record(&[(\"Type\", created_type.get(\"Id\").unwrap().clone())]);\n    parents.create(parent).await.unwrap();\n    let enriched = parents.read_single(None, None, None).await.unwrap();\n\n    let command = Arc::new(MockCommand::new());\n    command.reader_rows.lock().unwrap().extend([\n        record(&[\n            (\"Id\", Value::Int(1)),\n            (\"TypeName\", Value::from(\"person\")),\n            (\"ChildId\", Value::Int(10)),\n            (\"Label\", Value::from(\"a\")),\n        ]),\n        record(&[\n            (\"Id\", Value::Int(1)),\n            (\"TypeName\", Value::from(\"person\")),\n            (\"ChildId\", Value::Int(11)),\n            (\"Label\", Value::from(\"b\")),\n        ]),\n    ]);\n    let mut join_repo = parents_repo(MockConnection::with_command_provider(\n        command,\n        \"memory\",\n    ));\n    join_repo.add_enriched(\n        Enrichment::new(\n            \"TypeName\",\n            \"Type\",\n            \"Id\",\n            Some(\"Name\".into()),\n            EnrichmentPropertyType::Object,\n        ),\n        as_readonly(types),\n        None,\n    );\n    join_repo.add_enriched(\n        Enrichment::new(\n            \"Children\",\n            \"Id\",\n            \"ParentId\",\n            None,\n            EnrichmentPropertyType::List,\n        ),\n        Arc::new(CRUDRepository::new(\n            Arc::new(StubConnection::new(\"memory\")),\n            CRUDRepositoryOptions::default(),\n        ).unwrap()),\n        Some(Arc::new(NestedToObjectEnrichmentStrategy::new(TypeMap::new(\n            \"Id\",\n            vec![\n                (\"Id\".into(), TypeMapField::column(\"Id\")),\n                (\"TypeName\".into(), TypeMapField::column(\"TypeName\")),\n                (\n                    \"Children\".into(),\n                    TypeMapField::Group(TypeMapGroup::new(\n                        \"ChildId\",\n                        vec![\n                            (\"Id\".into(), TypeMapField::column(\"ChildId\")),\n                            (\"Label\".into(), TypeMapField::column(\"Label\")),\n                        ],\n                    )),\n                ),\n            ],\n        )))),\n    );\n    let where_clause = Where::new(Operator::equals(\"Parent.Id\", Value::Int(1)));\n    let join = SelectStatement::new(SelectStatementOptions {\n        joins: &[Join::left(\"Child\", \"Parent.Id\", \"Child.ParentId\")],\n        where_clause: Some(&where_clause),\n        ..SelectStatementOptions::new(\n            \"Parent\",\n            &[\n                \"Parent.Id\",\n                \"Parent.TypeName\",\n                \"Child.Id\",\n                \"Child.Label\",\n            ],\n        )\n    });\n    let mut options = ReadonlyRepositoryMappingOptions::default();\n    options.entity_mapper = Some(Arc::new(join_entity()));\n    let items = join_repo\n        .read(Some(&join), None, Some(&options))\n        .try_collect::<Vec<_>>().await\n        .unwrap();\n    assert_eq!(\n        enriched.as_ref().unwrap().get(\"TypeName\"),\n        Some(&Value::from(\"person\"))\n    );\n    assert_eq!(items.len(), 1);\n    assert_eq!(items[0].get(\"Id\"), Some(&Value::Int(1)));\n    assert_eq!(items[0].get(\"TypeName\"), Some(&Value::from(\"person\")));\n    let children = items[0].get(\"Children\").unwrap().wire_text();\n    assert!(children.contains(\"Label=a\"));\n    assert!(children.contains(\"Label=b\"));\n}"}
{"file":"docs/examples/read-with-where-clause-and-custom-flat-to-nested-custom-object-mapping-options/readWithWhereClauseAndCustomFlatToNestedObjectMappingOptions.test.read-with-where-clause-and-custom-flat-to-nested-object-mapping-options.typescript","test":"typescript/datasources/src/readWithWhereClauseAndCustomFlatToNestedObjectMappingOptions.test.ts#read-with-where-clause-and-custom-flat-to-nested-object-mapping-options","from":18,"to":125,"raw":"  it(\"read with where clause and custom flat to nested object mapping options\", async () => {\n    class UserType {\n      Id = 0;\n      Name = \"\";\n    }\n\n    class Parent {\n      Id = 0;\n      Type = new UserType();\n      TypeName = \"\";\n      Children: Child[] = [];\n    }\n\n    class Child {\n      Id = 0;\n      ParentId = 0;\n      Label = \"\";\n    }\n\n    type Seed = Record<string, Scalar>;\n\n    const snake = new ChangeCasingMapper(\"pascalCase\", \"snakeCase\");\n    const references = new DictionaryMapper<string>([[\"Type\", \"type_id\"]]);\n    const columns: IMapper<string, string> = new TransformMapper(\n      (name) => {\n        const mapped = references.map(name);\n        return mapped !== name ? mapped : snake.map(name);\n      },\n      (name) => {\n        const from = references.reverseMap(name);\n        return from !== name ? from : snake.reverseMap(name);\n      },\n    );\n\n    const joinEntity = new DictionaryMapper([\n      [\"Parent\", \"parent\"],\n      [\"Child\", \"child\"],\n    ]);\n\n    const setup = async (): Promise<IConnection> => {\n      const connection = new MemoryDriver().connection();\n      await connection.open();\n      return connection;\n    };\n\n    const typesRepo = (connection: IConnection) =>\n      new CRUDRepository(connection, { type: UserType, ids: [\"Id\"], propertyMappings: columns });\n\n    const parentsRepo = (connection: IConnection) =>\n      new CRUDRepository(connection, { type: Parent, ids: [\"Id\"], propertyMappings: columns });\n\n    const connection = await setup();\n    const types = typesRepo(connection);\n    const type = await types.create(Object.assign(new UserType(), { Name: \"person\" }));\n    const parents = parentsRepo(connection);\n    parents.addEnriched(\n      { destinationProperty: \"TypeName\", sourceProperty: \"Type\", relatedKey: \"Id\", relatedProperty: \"Name\" },\n      types,\n    );\n    await parents.create(Object.assign(new Parent(), { Type: Object.assign(new UserType(), { Id: type.Id }) }));\n    const enriched = await parents.readSingle();\n\n    const row1: Seed = { Id: 1, TypeName: \"person\", ChildId: 10, Label: \"a\" };\n    const row2: Seed = { Id: 1, TypeName: \"person\", ChildId: 11, Label: \"b\" };\n    const mockConnection = new MockConnection({ provider: \"memory\" });\n    const command = new MockCommand(mockConnection);\n    mockConnection.command = command;\n    const joinParents = parentsRepo(mockConnection);\n    joinParents.addEnriched(\n      { destinationProperty: \"TypeName\", sourceProperty: \"Type\", relatedKey: \"Id\", relatedProperty: \"Name\" },\n      types,\n    );\n    joinParents.addEnriched(\n      { destinationProperty: \"Children\", sourceProperty: \"Id\", relatedKey: \"ParentId\", type: \"list\" },\n      joinParents,\n      new NestedToObjectEnrichmentStrategy<Parent>({\n        key: \"Id\",\n        fields: {\n          Id: \"Id\",\n          TypeName: \"TypeName\",\n          Children: {\n            key: \"ChildId\",\n            fields: { Id: \"ChildId\", Label: \"Label\" },\n          },\n        },\n      }),\n    );\n    const join = new SelectStatement({\n      table: \"Parent\",\n      fields: [\n        \"Parent.Id\",\n        \"Parent.TypeName\",\n        \"Child.Id\",\n        \"Child.Label\",\n      ],\n      joins: [Join.left(\"Child\", \"Parent.Id\", \"Child.ParentId\")],\n      where: new Where(new Operator.Equals(\"Parent.Id\", 1)),\n    });\n    command.reader = new MockReader([row1, row2]);\n    const items = await collectAsync(\n      joinParents.read(join, undefined, { entityMapper: joinEntity }),\n    );\n    expect(enriched?.TypeName).toBe(\"person\");\n    expect(items).toHaveLength(1);\n    expect(items[0]?.Id).toBe(1);\n    expect(items[0]?.TypeName).toBe(\"person\");\n    expect(items[0]?.Children.map((child) => child.Label)).toEqual([\"a\", \"b\"]);\n  });"}
{"file":"docs/examples/read-with-where-clause-and-custom-flat-to-nested-custom-object-mapping-options/ReadWithWhereClauseAndCustomFlatToNestedObjectMappingOptionsTests.ReadWithWhereClauseAndCustomFlatToNestedObjectMappingOptions.csharp","test":"csharp/Datasources.Tests/ReadWithWhereClauseAndCustomFlatToNestedObjectMappingOptionsTests.cs#ReadWithWhereClauseAndCustomFlatToNestedObjectMappingOptions","from":46,"to":108,"raw":"    [Fact]\n    public async Task ReadWithWhereClauseAndCustomFlatToNestedObjectMappingOptions()\n    {\n        var connection = await Setup();\n        var typesRepo = TypesRepo(connection);\n        var type = await typesRepo.Create(new UserType { Name = \"person\" });\n        var parentsRepo = ParentsRepo(connection);\n        parentsRepo.AddEnriched(new(\"TypeName\", \"Type\", \"Id\", \"Name\"), typesRepo);\n        await parentsRepo.Create(new Parent { Type = new UserType { Id = type.Id } });\n        var enriched = await parentsRepo.ReadSingle();\n\n        var row1 = new Row { [\"Id\"] = 1L, [\"TypeName\"] = \"person\", [\"ChildId\"] = 10L, [\"Label\"] = \"a\" };\n        var row2 = new Row { [\"Id\"] = 1L, [\"TypeName\"] = \"person\", [\"ChildId\"] = 11L, [\"Label\"] = \"b\" };\n        var mockConnection = new MockConnection { Provider = \"memory\" };\n        var command = new MockCommand(mockConnection);\n        mockConnection.Command = command;\n        var joinRepo = ParentsRepo(mockConnection);\n        joinRepo.AddEnriched(new(\"TypeName\", \"Type\", \"Id\", \"Name\"), typesRepo);\n        joinRepo.AddEnriched(\n            new(\"Children\", \"Id\", \"ParentId\", Type: EnrichmentPropertyType.List),\n            joinRepo,\n            new NestedToObjectEnrichmentStrategy<Parent>(new TypeMap\n            {\n                Key = \"Id\",\n                Fields = new Dictionary<string, TypeMapField>\n                {\n                    [\"Id\"] = \"Id\",\n                    [\"TypeName\"] = \"TypeName\",\n                    [\"Children\"] = new TypeMapGroup\n                    {\n                        Key = \"ChildId\",\n                        Fields = new Dictionary<string, TypeMapField>\n                        {\n                            [\"Id\"] = \"ChildId\",\n                            [\"Label\"] = \"Label\",\n                        },\n                    },\n                },\n            }));\n        var join = new SelectStatement(new()\n        {\n            Table = \"Parent\",\n            Fields =\n            [\n                \"Parent.Id\",\n                \"Parent.TypeName\",\n                \"Child.Id\",\n                \"Child.Label\",\n            ],\n            Joins = [Join.Left(\"Child\", \"Parent.Id\", \"Child.ParentId\")],\n            Where = new Where(new Operator.Equals(\"Parent.Id\", 1)),\n        });\n        command.Reader = new MockReader<Row>([row1, row2]);\n        var items = await joinRepo.Read(\n            join,\n            null,\n            new ReadonlyRepositoryMappingOptions<Parent> { EntityMapper = JoinEntity }).ToListAsync();\n        Assert.Equal(\"person\", enriched!.TypeName);\n        var parent = Assert.Single(items);\n        Assert.Equal(1L, parent.Id);\n        Assert.Equal(\"person\", parent.TypeName);\n        Assert.Equal([\"a\", \"b\"], parent.Children.Select(child => child.Label));\n    }"}
{"file":"docs/examples/recreate-children/CRUDRepository.test.cascade-update-deletes-children-and-recreates.typescript","test":"typescript/datasources/src/CRUDRepository.test.ts#cascade-update-deletes-children-and-recreates","from":274,"to":303,"raw":"  it(\"cascade update deletes children and recreates\", async () => {\n    const connection = await setup();\n    const parentsRepo = repo(\n      Parent,\n      connection,\n      new DefaultWriteEnrichmentStrategy(undefined, new CascadeDeleteUpdateEnrichmentStrategy()),\n    );\n    const childrenRepo = repo(Child, connection);\n    const notesRepo = repo(Note, connection);\n    const parent = await parentsRepo.create(new Parent());\n    expect(parent.Id).toBeGreaterThan(0);\n    const child = await childrenRepo.create(Object.assign(new Child(), { ParentId: parent.Id, Label: \"a\" }));\n    expect(child.Id).toBeGreaterThan(0);\n    const other = await childrenRepo.create(Object.assign(new Child(), { Label: \"other\" }));\n    expect(other.Id).toBeGreaterThan(0);\n    const note = await notesRepo.create(Object.assign(new Note(), { ChildId: child.Id, Text: \"n\" }));\n    expect(note.Id).toBeGreaterThan(0);\n    childrenRepo.addEnriched({ destinationProperty: \"Notes\", sourceProperty: \"Id\", relatedKey: \"ChildId\", type: \"list\" }, notesRepo);\n    parentsRepo.addEnriched({ destinationProperty: \"Children\", sourceProperty: \"Id\", relatedKey: \"ParentId\", type: \"list\" }, childrenRepo);\n    const updated = await parentsRepo.update(Object.assign(new Parent(), {\n      Id: parent.Id,\n      Children: [Object.assign(new Child(), { Id: child.Id, Label: \"fresh\" })],\n    }));\n    expect(updated.rowsAffected).toBe(1);\n    const created = (await collectAsync(childrenRepo.read())).find((row) => row.Label === \"fresh\");\n    expect(created?.Id).toBe(child?.Id);\n    expect(created?.Label).toBe(\"fresh\");\n    expect(created?.ParentId).toBe(parent?.Id);\n    expect(await collectAsync(notesRepo.read())).toEqual([]);\n  });"}
{"file":"docs/examples/recreate-children/CRUDRepositoryTests.CascadeUpdateDeletesChildrenAndRecreates.csharp","test":"csharp/Datasources.Tests/CRUDRepositoryTests.cs#CascadeUpdateDeletesChildrenAndRecreates","from":241,"to":269,"raw":"    [Fact]\n    public async Task CascadeUpdateDeletesChildrenAndRecreates()\n    {\n        var connection = await Setup();\n        var parentsRepo = Open(connection, new DefaultWriteEnrichmentStrategy<Parent>(update: new CascadeDeleteUpdateEnrichmentStrategy<Parent>()));\n        var childrenRepo = Open<Child>(connection);\n        var notesRepo = Open<Note>(connection);\n        var parent = await parentsRepo.Create(new Parent());\n        Assert.True(parent.Id > 0);\n        var child = await childrenRepo.Create(new Child { ParentId = parent.Id, Label = \"a\" });\n        Assert.True(child.Id > 0);\n        var other = await childrenRepo.Create(new Child { Label = \"other\" });\n        Assert.True(other.Id > 0);\n        var note = await notesRepo.Create(new Note { ChildId = child.Id, Text = \"n\" });\n        Assert.True(note.Id > 0);\n        childrenRepo.AddEnriched(new(\"Notes\", \"Id\", \"ChildId\", Type: EnrichmentPropertyType.List), notesRepo);\n        parentsRepo.AddEnriched(new(\"Children\", \"Id\", \"ParentId\", Type: EnrichmentPropertyType.List), childrenRepo);\n        var updated = await parentsRepo.Update(new Parent\n        {\n            Id = parent.Id,\n            Children = [new Child { Id = child.Id, Label = \"fresh\" }]\n        });\n        Assert.Equal(1, updated.RowsAffected);\n        var created = (await childrenRepo.Read().ToListAsync()).Single(row => row.Label == \"fresh\");\n        Assert.Equal(child.Id, created.Id);\n        Assert.Equal(\"fresh\", created.Label);\n        Assert.Equal(parent.Id, created.ParentId);\n        Assert.Empty(await notesRepo.Read().ToListAsync());\n    }"}
{"file":"docs/examples/recreate-children/enriched.cascade_update_deletes_children_and_recreates.rust","test":"rust/datasources/tests/enriched.rs#cascade_update_deletes_children_and_recreates","from":738,"to":819,"raw":"#[tokio::test]\nasync fn cascade_update_deletes_children_and_recreates() {\n    let connection = setup(&mut []).await;\n    let mut parents = mapped_crud(connection.clone(), \"Parent\").with_write(Arc::new(\n        DefaultWriteEnrichmentStrategy::new(\n            None,\n            Some(Arc::new(CascadeDeleteUpdateEnrichmentStrategy)),\n            None,\n            false,\n        ),\n    ));\n    let mut children_repo = mapped_crud(connection.clone(), \"Child\");\n    let notes = Arc::new(mapped_crud(connection, \"Note\"));\n    let parent = parents\n        .create(record(&[(\"Label\", Value::from(\"p\"))]))\n        .await\n        .unwrap();\n    assert!(num(&parent, \"Id\") > 0);\n    let parent_id = parent.get(\"Id\").unwrap().clone();\n    let child = children_repo\n        .create(record(&[\n            (\"ParentId\", parent_id.clone()),\n            (\"Label\", Value::from(\"a\")),\n        ]))\n        .await\n        .unwrap();\n    assert!(num(&child, \"Id\") > 0);\n    let other = children_repo\n        .create(record(&[(\"Label\", Value::from(\"other\"))]))\n        .await\n        .unwrap();\n    assert!(num(&other, \"Id\") > 0);\n    let child_id = child.get(\"Id\").unwrap().clone();\n    let note = notes\n        .create(record(&[\n            (\"ChildId\", child_id.clone()),\n            (\"Text\", Value::from(\"n\")),\n        ]))\n        .await\n        .unwrap();\n    assert!(num(&note, \"Id\") > 0);\n    children_repo.add_enriched(\n        Enrichment::new(\"Notes\", \"Id\", \"ChildId\", None, datasources::EnrichmentPropertyType::List),\n        notes.clone(),\n        None,\n    );\n    let children = Arc::new(children_repo);\n    parents.add_enriched(\n        Enrichment::new(\"Children\", \"Id\", \"ParentId\", None, datasources::EnrichmentPropertyType::List),\n        children.clone(),\n        None,\n    );\n    let updated_row_3 = record(&[\n                (\"Id\", parent_id.clone()),\n                (\"Label\", Value::from(\"p\")),\n                (\n                    \"Children\",\n                    encode_rows(&[record(&[\n                        (\"Id\", child_id.clone()),\n                        (\"Label\", Value::from(\"fresh\")),\n                    ])]),\n                ),\n            ]);\n    let updated = parents\n        .update(\n            updated_row_3,\n            None,\n        )\n        .await\n        .unwrap();\n    assert_eq!(updated.rows_affected, 1);\n    let stored = children.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n    let created = stored\n        .iter()\n        .find(|row| row.get(\"Label\") == Some(&Value::from(\"fresh\")))\n        .unwrap();\n    assert_eq!(stored.len(), 2);\n    assert_eq!(created.get(\"Id\"), Some(&child_id));\n    assert_eq!(created.get(\"Label\"), Some(&Value::from(\"fresh\")));\n    assert_eq!(created.get(\"ParentId\"), Some(&parent_id));\n    assert!(notes.read(None, None, None).try_collect::<Vec<_>>().await.unwrap().is_empty());\n}"}
{"file":"docs/examples/register-a-fill/enriched.enriched_fills_lookup_select_and_leaves_missing_default.rust","test":"rust/datasources/tests/enriched.rs#enriched_fills_lookup_select_and_leaves_missing_default","from":137,"to":162,"raw":"#[tokio::test]\nasync fn enriched_fills_lookup_select_and_leaves_missing_default() {\n    let mut seeds = [\n        record(&[(\"name\", Value::from(\"person\"))]),\n        record(&[(\"name\", Value::from(\"gone\"))]),\n    ];\n    let types_connection = setup(&mut seeds).await;\n    let person = seeds[0].clone();\n    let gone = seeds[1].clone();\n    drop_row(&types_connection, &gone).await;\n    let mut parents = [\n        record(&[(\"type_id\", person.get(\"id\").unwrap().clone())]),\n        record(&[(\"type_id\", gone.get(\"id\").unwrap().clone())]),\n    ];\n    let connection = setup(&mut parents).await;\n    let mut parents_repo = mapped(connection, \"Parent\");\n    let types_repo = Arc::new(mapped(types_connection, \"UserType\"));\n    parents_repo.add_enriched(\n        Enrichment::new(\"TypeName\", \"Type\", \"Id\", Some(\"Name\".into()), datasources::EnrichmentPropertyType::Object),\n        types_repo,\n        None,\n    );\n    let items = parents_repo.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n    assert_eq!(items[0][\"TypeName\"], Value::from(\"person\"));\n    assert!(!items[1].contains_key(\"TypeName\") || items[1][\"TypeName\"] == Value::from(\"\"));\n}"}
{"file":"docs/examples/register-a-fill/ReadonlyRepository.test.fills-lookup-select-and-leaves-missing-default.typescript","test":"typescript/datasources/src/ReadonlyRepository.test.ts#fills-lookup-select-and-leaves-missing-default","from":94,"to":106,"raw":"  it(\"fills lookup select and leaves missing default\", async () => {\n    const person: Seed = { name: \"person\" };\n    const gone: Seed = { name: \"gone\" };\n    const typesConnection = await setup([person, gone]);\n    await remove(typesConnection, gone);\n    const connection = await setup([{ type_id: person.id }, { type_id: gone.id }]);\n    const parentsRepo = repo(Parent, connection);\n    const typesRepo = repo(UserType, typesConnection);\n    parentsRepo.addEnriched({ destinationProperty: \"TypeName\", sourceProperty: \"Type\", relatedKey: \"Id\", relatedProperty: \"Name\" }, typesRepo);\n    const items = await collectAsync(parentsRepo.read());\n    expect(items[0]?.TypeName).toBe(\"person\");\n    expect(items[1]?.TypeName).toBe(\"\");\n  });"}
{"file":"docs/examples/register-a-fill/ReadonlyRepositoryTests.ReadFillsLookupSelectAndLeavesMissingDefault.csharp","test":"csharp/Datasources.Tests/ReadonlyRepositoryTests.cs#ReadFillsLookupSelectAndLeavesMissingDefault","from":72,"to":88,"raw":"    [Fact]\n    public async Task ReadFillsLookupSelectAndLeavesMissingDefault()\n    {\n        var person = new Row { [\"name\"] = \"person\" };\n        var gone = new Row { [\"name\"] = \"gone\" };\n        var typesConnection = await Setup(person, gone);\n        await typesConnection.CreateCommand().Execute(\"delete\", [new Parameter(\"id\", gone[\"id\"])]);\n        var connection = await Setup(\n            new Row { [\"type_id\"] = person[\"id\"] },\n            new Row { [\"type_id\"] = gone[\"id\"] });\n        var parentsRepo = Open<Parent>(connection);\n        var typesRepo = Open<UserType>(typesConnection);\n        parentsRepo.AddEnriched(new(\"TypeName\", \"Type\", \"Id\", \"Name\"), typesRepo);\n        var items = await parentsRepo.Read().ToListAsync();\n        Assert.Equal(\"person\", items[0].TypeName);\n        Assert.Equal(\"\", items[1].TypeName);\n    }"}

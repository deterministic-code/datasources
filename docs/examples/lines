{"file":"docs/examples/bulk/BulkCRUDRepository.test.creates-parents-and-children.typescript","test":"typescript/datasources/src/BulkCRUDRepository.test.ts#creates-parents-and-children","from":33,"to":49,"raw":"  it(\"creates parents and children\", async () => {\n    const connection = await setup();\n    const parentsRepo = new BulkCRUDRepository(Parent, connection);\n    const childrenRepo = new BulkCRUDRepository(Child, connection);\n    const ids = await relate(parentsRepo, childrenRepo).createBulk([\n      Object.assign(new Parent(), { children: [Object.assign(new Child(), { label: \"a\" })] }),\n      Object.assign(new Parent(), {\n        children: [Object.assign(new Child(), { label: \"b\" }), Object.assign(new Child(), { label: \"c\" })],\n      }),\n    ]);\n    const parents = await collectAsync(parentsRepo.read());\n    const children = await collectAsync(childrenRepo.read());\n    expect(parents).toHaveLength(2);\n    expect(parents.every((parent) => parent.id > 0)).toBe(true);\n    expect(children).toHaveLength(3);\n    expect(ids.map((row) => row.id).sort()).toEqual(parents.map((parent) => parent.id).sort());\n  });"}
{"file":"docs/examples/bulk/BulkCRUDRepositoryTests.CreateWritesParentsAndChildren.csharp","test":"csharp/Datasources.Tests/BulkCRUDRepositoryTests.cs#CreateWritesParentsAndChildren","from":29,"to":47,"raw":"    [Fact]\n    public async Task CreateWritesParentsAndChildren()\n    {\n        var connection = await Setup();\n        var parentsRepo = new BulkCRUDRepository<Parent>(connection);\n        var childrenRepo = new BulkCRUDRepository<Child>(connection);\n        var ids = await Repo(parentsRepo, childrenRepo).Create(\n        [\n            new Parent { children = [new Child { label = \"a\" }] },\n            new Parent { children = [new Child { label = \"b\" }, new Child { label = \"c\" }] }\n        ]);\n        var parents = await parentsRepo.Read().ToListAsync();\n        var children = await childrenRepo.Read().ToListAsync();\n        Assert.Equal(2, parents.Count);\n        Assert.All(parents, parent => Assert.True(parent.id > 0));\n        Assert.Equal(3, children.Count);\n        Assert.Equal(parents.Select(parent => parent.id), children.Select(child => child.parent_id).Distinct());\n        Assert.Equal(parents.Select(parent => parent.id).OrderBy(id => id), ids.Select(parent => parent.id).OrderBy(id => id));\n    }"}
{"file":"docs/examples/bulk/enriched.bulk_create_writes_parents_and_children.rust","test":"rust/datasources/tests/enriched.rs#bulk_create_writes_parents_and_children","from":1088,"to":1126,"raw":"#[tokio::test]\nasync fn bulk_create_writes_parents_and_children() {\n    let connection = setup(&mut []).await;\n    let mut options = CRUDRepositoryOptions::default();\n    options.entity = \"Parent\".into();\n    let mut parents = BulkCRUDRepository::new(connection.clone(), options).unwrap();\n    let mut child_options = CRUDRepositoryOptions::default();\n    child_options.entity = \"Child\".into();\n    let children = Arc::new(BulkCRUDRepository::new(connection, child_options).unwrap());\n    parents.add_enriched(\n        Enrichment::new(\"children\", \"id\", \"parent_id\", None, datasources::EnrichmentPropertyType::List),\n        children.clone(),\n        None,\n    );\n    let ids = parents\n        .create_bulk(&mut [\n            record(&[(\n                \"children\",\n                encode_rows(&[record(&[(\"label\", Value::from(\"a\"))])]),\n            )]),\n            record(&[(\n                \"children\",\n                encode_rows(&[\n                    record(&[(\"label\", Value::from(\"b\"))]),\n                    record(&[(\"label\", Value::from(\"c\"))]),\n                ]),\n            )]),\n        ])\n        .await\n        .unwrap();\n    let stored_parents = parents.read(None, None, None).try_collect::<Vec<_>>().await.unwrap();\n    assert_eq!(stored_parents.len(), 2);\n    assert_eq!(children.read(None, None, None).try_collect::<Vec<_>>().await.unwrap().len(), 3);\n    let mut created_ids: Vec<_> = ids.iter().map(|row| num(row, \"id\")).collect();\n    let mut stored_ids: Vec<_> = stored_parents.iter().map(|row| num(row, \"id\")).collect();\n    created_ids.sort();\n    stored_ids.sort();\n    assert_eq!(created_ids, stored_ids);\n}"}
{"file":"docs/examples/call-a-stored-procedure-that-returns-two-results/integration.call_procedure_returns_two_results.rust","test":"rust/providers/mysql/tests/integration.rs#call_procedure_returns_two_results","from":380,"to":407,"raw":"async fn call_procedure_returns_two_results(command: &dyn Command) {\n    use datasources::ExecuteStoredProcedureStatement;\n    command\n        .execute_native(\n            &Native::new(\"CREATE PROCEDURE two_ids() BEGIN SELECT 1 AS id; SELECT 2 AS id; END\"),\n            None,\n        )\n        .await\n        .unwrap();\n    let reader = command\n        .execute_reader_statement(&ExecuteStoredProcedureStatement::new(\"two_ids\", &[]), None)\n        .await\n        .unwrap();\n    let mut first = Vec::new();\n    while reader.next().await.unwrap() {\n        first.push(reader.current());\n    }\n    let moved = reader.next_result().await.unwrap();\n    let mut second = Vec::new();\n    while reader.next().await.unwrap() {\n        second.push(reader.current());\n    }\n    let again = reader.next_result().await.unwrap();\n    assert_eq!(moved, true);\n    assert_eq!(again, false);\n    assert_eq!(first[0].as_ref().unwrap().get(\"id\"), Some(&Value::Int(1)));\n    assert_eq!(second[0].as_ref().unwrap().get(\"id\"), Some(&Value::Int(2)));\n}"}
{"file":"docs/examples/call-a-stored-procedure-that-returns-two-results/mysql.integration.test.callProcedureReturnsTwoResults.typescript","test":"typescript/providers/mysql/tests/mysql.integration.test.ts#callProcedureReturnsTwoResults","from":45,"to":64,"raw":"async function callProcedureReturnsTwoResults(command: MysqlCommand) {\n  await command.executeNative(new Native(`\n    CREATE PROCEDURE two_ids()\n    BEGIN\n      SELECT 1 AS id;\n      SELECT 2 AS id;\n    END\n  `));\n  await using reader = await command.executeReaderStatement(new ExecuteStoredProcedureStatement(\"two_ids\", []));\n  const first: { id: number }[] = [];\n  while (await reader.next()) first.push(reader.current as { id: number });\n  const moved = await reader.nextResult();\n  const second: { id: number }[] = [];\n  while (await reader.next()) second.push(reader.current as { id: number });\n  const again = await reader.nextResult();\n  expect(moved).toBe(true);\n  expect(again).toBe(false);\n  expect(first[0]?.id).toBe(1);\n  expect(second[0]?.id).toBe(2);\n}"}
{"file":"docs/examples/call-a-stored-procedure-that-returns-two-results/MysqlCommandIntegrationTests.CallProcedureReturnsTwoResults.csharp","test":"csharp/Providers/Mysql.Tests/MysqlCommandIntegrationTests.cs#CallProcedureReturnsTwoResults","from":82,"to":104,"raw":"    static async Task CallProcedureReturnsTwoResults(ICommand command)\n    {\n        await command.Execute(Native.N(\"\"\"\n            CREATE PROCEDURE two_ids()\n            BEGIN\n              SELECT 1 AS id;\n              SELECT 2 AS id;\n            END\n            \"\"\"));\n        await using var reader = await command.ExecuteReader(new ExecuteStoredProcedureStatement(\"two_ids\", []));\n        var first = new List<Row>();\n        while (await reader.Next())\n            first.Add(reader.Current!);\n        var moved = await reader.NextResult();\n        var second = new List<Row>();\n        while (await reader.Next())\n            second.Add(reader.Current!);\n        var again = await reader.NextResult();\n        Assert.True(moved);\n        Assert.False(again);\n        Assert.Equal(new Value.Int(1), first[0][\"id\"]);\n        Assert.Equal(new Value.Int(2), second[0][\"id\"]);\n    }"}

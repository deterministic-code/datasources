{"file":"docs/examples/one-json-call/bulk_write_strategy.stored_procedure_bulk_write_strategy_sends_one_json_call.rust","test":"rust/datasources/src/tests/bulk_write_strategy.rs#stored_procedure_bulk_write_strategy_sends_one_json_call","from":134,"to":182,"raw":"#[tokio::test]\nasync fn stored_procedure_bulk_write_strategy_sends_one_json_call() {\n    let (repo, command) = parents(Arc::new(StoredProcedureBulkWriteStrategy::new(\n        \"bulk_create_parent\",\n        \"bulk_update_parent\",\n        \"bulk_delete_parent\",\n    )));\n    let mut created = [\n        row(&[(\"label\", Value::from(\"a\"))]),\n        row(&[(\"label\", Value::from(\"b\"))]),\n    ];\n    repo.create_bulk(&mut created).await.unwrap();\n    repo.update_bulk(\n        &[\n            row(&[(\"id\", Value::Int(1)), (\"label\", Value::from(\"a\"))]),\n            row(&[(\"id\", Value::Int(2)), (\"label\", Value::from(\"b\"))]),\n        ],\n        None,\n    )\n    .await\n    .unwrap();\n    repo.delete_bulk(\n        &[\n            row(&[(\"id\", Value::Int(1)), (\"label\", Value::from(\"\"))]),\n            row(&[(\"id\", Value::Int(2)), (\"label\", Value::from(\"\"))]),\n        ],\n        None,\n    )\n    .await\n    .unwrap();\n    let logs = command.execute_logs.lock().unwrap();\n    assert_eq!(logs.len(), 3);\n    assert_eq!(logs[0].0, \"CALL bulk_create_parent($payload, $ids)\");\n    assert_eq!(logs[0].1[0].name, \"payload\");\n    assert_eq!(\n        logs[0].1[0].value,\n        Value::from(r#\"[{\"label\":\"a\"},{\"label\":\"b\"}]\"#)\n    );\n    assert_eq!(logs[1].0, \"CALL bulk_update_parent($payload)\");\n    assert_eq!(\n        logs[1].1[0].value,\n        Value::from(r#\"[{\"id\":1,\"label\":\"a\"},{\"id\":2,\"label\":\"b\"}]\"#)\n    );\n    assert_eq!(logs[2].0, \"CALL bulk_delete_parent($payload)\");\n    assert_eq!(\n        logs[2].1[0].value,\n        Value::from(r#\"[{\"id\":1,\"label\":\"\"},{\"id\":2,\"label\":\"\"}]\"#)\n    );\n}"}
{"file":"docs/examples/one-json-call/BulkWriteStrategy.test.stored-procedure-commands-sends-one-json-call.typescript","test":"typescript/datasources/src/BulkWriteStrategy.test.ts#stored-procedure-commands-sends-one-json-call","from":109,"to":143,"raw":"  it(\"stored procedure commands sends one json call\", async () => {\n    const { repo, command } = open(\n      Parent,\n      new StoredProcedureBulkWriteStrategy<Parent>(\"bulk_create_parent\", \"bulk_update_parent\", \"bulk_delete_parent\"),\n    );\n    await repo.createBulk([\n      Object.assign(new Parent(), { label: \"a\" }),\n      Object.assign(new Parent(), { label: \"b\" }),\n    ]);\n    expect(command.executeCalls).toHaveLength(1);\n    expect(command.executeCalls[0]?.text).toBe(\"CALL bulk_create_parent($payload, $ids)\");\n    expect(command.executeCalls[0]?.parameters?.[0]).toMatchObject({\n      name: \"payload\",\n      value: '[{\"label\":\"a\"},{\"label\":\"b\"}]',\n    });\n    expect(command.executeCalls[0]?.parameters?.[1]).toMatchObject({ name: \"ids\", direction: \"inputOutput\" });\n\n    await repo.updateBulk([\n      Object.assign(new Parent(), { id: 1, label: \"a\" }),\n      Object.assign(new Parent(), { id: 2, label: \"b\" }),\n    ]);\n    expect(command.executeCalls[1]?.text).toBe(\"CALL bulk_update_parent($payload)\");\n    expect(command.executeCalls[1]?.parameters?.[0]?.value).toBe(\n      '[{\"id\":1,\"label\":\"a\"},{\"id\":2,\"label\":\"b\"}]',\n    );\n\n    await repo.deleteBulk([\n      Object.assign(new Parent(), { id: 1 }),\n      Object.assign(new Parent(), { id: 2 }),\n    ]);\n    expect(command.executeCalls[2]?.text).toBe(\"CALL bulk_delete_parent($payload)\");\n    expect(command.executeCalls[2]?.parameters?.[0]?.value).toBe(\n      '[{\"id\":1,\"label\":\"\"},{\"id\":2,\"label\":\"\"}]',\n    );\n  });"}
{"file":"docs/examples/one-json-call/BulkWriteStrategyTests.StoredProcedureBulkWriteStrategySendsOneJsonCall.csharp","test":"csharp/Datasources.Tests/BulkWriteStrategyTests.cs#StoredProcedureBulkWriteStrategySendsOneJsonCall","from":71,"to":96,"raw":"    [Fact]\n    public async Task StoredProcedureBulkWriteStrategySendsOneJsonCall()\n    {\n        var (repo, command) = Repo(new StoredProcedureBulkWriteStrategy<Parent>(\n            \"bulk_create_parent\", \"bulk_update_parent\", \"bulk_delete_parent\"));\n        await repo.Create([new Parent { label = \"a\" }, new Parent { label = \"b\" }]);\n        Assert.Single(command.ExecuteCalls);\n        Assert.Equal(\"CALL bulk_create_parent($payload, $ids)\", command.ExecuteCalls[0].Text);\n        Assert.Equal(\"payload\", command.ExecuteCalls[0].Parameters![0].Name);\n        Assert.Equal(\n            new Value.Text(\"\"\"[{\"label\":\"a\"},{\"label\":\"b\"}]\"\"\"),\n            command.ExecuteCalls[0].Parameters![0].Value);\n        Assert.Equal(ParameterDirection.InputOutput, command.ExecuteCalls[0].Parameters![1].Direction);\n\n        await repo.Update([new Parent { id = 1, label = \"a\" }, new Parent { id = 2, label = \"b\" }]);\n        Assert.Equal(\"CALL bulk_update_parent($payload)\", command.ExecuteCalls[1].Text);\n        Assert.Equal(\n            new Value.Text(\"\"\"[{\"id\":1,\"label\":\"a\"},{\"id\":2,\"label\":\"b\"}]\"\"\"),\n            command.ExecuteCalls[1].Parameters![0].Value);\n\n        await repo.Delete([new Parent { id = 1 }, new Parent { id = 2 }]);\n        Assert.Equal(\"CALL bulk_delete_parent($payload)\", command.ExecuteCalls[2].Text);\n        Assert.Equal(\n            new Value.Text(\"\"\"[{\"id\":1,\"label\":\"\"},{\"id\":2,\"label\":\"\"}]\"\"\"),\n            command.ExecuteCalls[2].Parameters![0].Value);\n    }"}
{"file":"docs/examples/one-statement-per-row/bulk_write_strategy.single_command_i_bulk_write_strategy_writes_one_statement_per_row.rust","test":"rust/datasources/src/tests/bulk_write_strategy.rs#single_command_i_bulk_write_strategy_writes_one_statement_per_row","from":29,"to":70,"raw":"#[tokio::test]\nasync fn single_command_i_bulk_write_strategy_writes_one_statement_per_row() {\n    let (repo, command) = parents(Arc::new(SingleCommandIBulkWriteStrategy::new()));\n    *command.response.lock().unwrap() = crate::Response::new(Value::Int(9), 1, None);\n    let mut created = [\n        row(&[(\"label\", Value::from(\"a\"))]),\n        row(&[(\"label\", Value::from(\"b\"))]),\n    ];\n    repo.create_bulk(&mut created).await.unwrap();\n    repo.update_bulk(\n        &[\n            row(&[(\"id\", Value::Int(1)), (\"label\", Value::from(\"a\"))]),\n            row(&[(\"id\", Value::Int(2)), (\"label\", Value::from(\"b\"))]),\n        ],\n        None,\n    )\n    .await\n    .unwrap();\n    repo.delete_bulk(\n        &[\n            row(&[(\"id\", Value::Int(1)), (\"label\", Value::from(\"a\"))]),\n            row(&[(\"id\", Value::Int(2)), (\"label\", Value::from(\"b\"))]),\n        ],\n        None,\n    )\n    .await\n    .unwrap();\n    let logs = command.execute_logs.lock().unwrap();\n    assert_eq!(logs.len(), 6);\n    assert_eq!(logs[0].0, \"INSERT INTO parents (label) VALUES ($label)\");\n    assert_eq!(logs[1].0, \"INSERT INTO parents (label) VALUES ($label)\");\n    assert_eq!(\n        logs[2].0,\n        \"UPDATE parents SET label = $label WHERE id = $id\"\n    );\n    assert_eq!(\n        logs[3].0,\n        \"UPDATE parents SET label = $label WHERE id = $id\"\n    );\n    assert_eq!(logs[4].0, \"DELETE FROM parents WHERE id = $id\");\n    assert_eq!(logs[5].0, \"DELETE FROM parents WHERE id = $id\");\n}"}
{"file":"docs/examples/one-statement-per-row/BulkWriteStrategy.test.single-commands-writes-one-statement-per-row.typescript","test":"typescript/datasources/src/BulkWriteStrategy.test.ts#single-commands-writes-one-statement-per-row","from":36,"to":58,"raw":"  it(\"single commands writes one statement per row\", async () => {\n    const { repo, command } = open(Parent, new SingleCommandIBulkWriteStrategy<Parent>());\n    command.response = { result: 9, rowsAffected: 1 };\n    await repo.createBulk([\n      Object.assign(new Parent(), { label: \"a\" }),\n      Object.assign(new Parent(), { label: \"b\" }),\n    ]);\n    await repo.updateBulk([\n      Object.assign(new Parent(), { id: 1, label: \"a\" }),\n      Object.assign(new Parent(), { id: 2, label: \"b\" }),\n    ]);\n    await repo.deleteBulk([\n      Object.assign(new Parent(), { id: 1, label: \"a\" }),\n      Object.assign(new Parent(), { id: 2, label: \"b\" }),\n    ]);\n    expect(command.executeCalls).toHaveLength(6);\n    expect(command.executeCalls[0]?.text).toBe(\"INSERT INTO parents (label) VALUES ($label)\");\n    expect(command.executeCalls[1]?.text).toBe(\"INSERT INTO parents (label) VALUES ($label)\");\n    expect(command.executeCalls[2]?.text).toBe(\"UPDATE parents SET label = $label WHERE id = $id\");\n    expect(command.executeCalls[3]?.text).toBe(\"UPDATE parents SET label = $label WHERE id = $id\");\n    expect(command.executeCalls[4]?.text).toBe(\"DELETE FROM parents WHERE id = $id\");\n    expect(command.executeCalls[5]?.text).toBe(\"DELETE FROM parents WHERE id = $id\");\n  });"}
{"file":"docs/examples/one-statement-per-row/BulkWriteStrategyTests.SingleCommandIBulkWriteStrategyWritesOneStatementPerRow.csharp","test":"csharp/Datasources.Tests/BulkWriteStrategyTests.cs#SingleCommandIBulkWriteStrategyWritesOneStatementPerRow","from":25,"to":40,"raw":"    [Fact]\n    public async Task SingleCommandIBulkWriteStrategyWritesOneStatementPerRow()\n    {\n        var (repo, command) = Repo(new SingleCommandIBulkWriteStrategy<Parent>());\n        command.Response = new Response(new Value.Int(9), 1);\n        await repo.Create([new Parent { label = \"a\" }, new Parent { label = \"b\" }]);\n        await repo.Update([new Parent { id = 1, label = \"a\" }, new Parent { id = 2, label = \"b\" }]);\n        await repo.Delete([new Parent { id = 1, label = \"a\" }, new Parent { id = 2, label = \"b\" }]);\n        Assert.Equal(6, command.ExecuteCalls.Count);\n        Assert.Equal(\"INSERT INTO parents (label) VALUES ($label)\", command.ExecuteCalls[0].Text);\n        Assert.Equal(\"INSERT INTO parents (label) VALUES ($label)\", command.ExecuteCalls[1].Text);\n        Assert.Equal(\"UPDATE parents SET label = $label WHERE id = $id\", command.ExecuteCalls[2].Text);\n        Assert.Equal(\"UPDATE parents SET label = $label WHERE id = $id\", command.ExecuteCalls[3].Text);\n        Assert.Equal(\"DELETE FROM parents WHERE id = $id\", command.ExecuteCalls[4].Text);\n        Assert.Equal(\"DELETE FROM parents WHERE id = $id\", command.ExecuteCalls[5].Text);\n    }"}

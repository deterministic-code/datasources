          )),\n                        ),\n                    ],\n                ),\n            ))),\n        );\n        let items = users_repo.read(Some(command.as_ref()), None).await.unwrap();\n        let view = |login: &str| {\n            items\n                .iter()\n                .find(|item| item.get(\"Login\") == Some(&Value::from(login)))\n                .unwrap()\n                .clone()\n        };\n        let ada = view(\"ada\");\n        let grace = view(\"grace\");\n        let lin = view(\"lin\");\n        assert_eq!(items.len(), 3);\n        assert_eq!(ada.get(\"UserType\"), Some(&Value::from(\"admin\")));\n        let mut names = role_names(ada.get(\"Roles\").unwrap());\n        names.sort();\n        assert_eq!(names, [\"admin\", \"editor\"]);\n        assert!(ada\n            .get(\"Roles\")\n            .unwrap()\n            .wire_text()\n            .contains(&format!(\"UserId={ADA}\")));\n        assert_eq!(role_names(grace.get(\"Roles\").unwrap()), [\"viewer\"]);\n        assert_eq!(lin.get(\"Roles\"), Some(&Value::from(\"\")));\n    }"}
{"file":"docs/examples/fill-roles-from-one-join/ReadonlyRepositoryIntegrationTests.FillsRolesFromAJoin.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#FillsRolesFromAJoin","from":266,"to":340,"raw":"        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"filename\"] = \":memory:\" });\n        var connection = await Open(ds, \"user-roles-read\", Seed());\n        var mappings = new DictionaryMapper<string>(new Dictionary<string, string>\n        {\n            [\"Key\"] = \"id\",\n            [\"Login\"] = \"username\",\n            [\"Active\"] = \"is_enabled\",\n            [\"Opened\"] = \"created\",\n            [\"UserType\"] = \"user_type.name\",\n            [\"UserId\"] = \"user_id\",\n            [\"RoleId\"] = \"role_id\",\n            [\"Name\"] = \"roles.name\",\n        });\n        var usersRepo = new ReadonlyRepository<UsersView>(connection, new ReadonlyRepositoryOptions<UsersView>\n        {\n            ColumnMappings = mappings,\n        });\n        usersRepo.AddEnriched(\n            new(\"Roles\", \"Key\", \"UserId\", Many: true),\n            usersRepo,\n            new NestedToObjectEnrichmentStrategy<UsersView>(new TypeMap\n            {\n                Key = \"Key\",\n                Fields = new Dictionary<string, TypeMapField>\n                {\n                    [\"Key\"] = \"Key\",\n                    [\"Login\"] = \"Login\",\n                    [\"Active\"] = \"Active\",\n                    [\"Opened\"] = \"Opened\",\n                    [\"UserType\"] = \"UserType\",\n                    [\"Roles\"] = new TypeMapGroup\n                    {\n                        Key = \"RoleId\",\n                        Fields = new Dictionary<string, TypeMapField>\n                        {\n                            [\"RoleId\"] = \"RoleId\",\n                            [\"UserId\"] = \"UserId\",\n                            [\"Name\"] = \"Name\",\n                        }\n                    }\n                }\n            }));\n        var items = new List<UsersView>();\n        await foreach (var item in usersRepo.Read(new SelectStatement(new()\n        {\n            Table = \"user\",\n            Fields =\n            [\n                \"user.id\",\n                \"user.username\",\n                \"user.is_enabled\",\n                \"user.created\",\n                \"user_type.name\",\n                \"user_roles.user_id\",\n                \"user_roles.role_id\",\n                \"roles.name\",\n            ],\n            Joins =\n            [\n                new Join(JoinKind.Left, \"user_type\", \"user_type.id\", \"user.user_type_id\"),\n                new Join(JoinKind.Left, \"user_roles\", \"user_roles.user_id\", \"user.id\"),\n                new Join(JoinKind.Left, \"roles\", \"roles.id\", \"user_roles.role_id\"),\n            ],\n        })))\n            items.Add(item);\n        var ada = Assert.Single(items, item => item.Login == \"ada\");\n        var grace = Assert.Single(items, item => item.Login == \"grace\");\n        var lin = Assert.Single(items, item => item.Login == \"lin\");\n\n        Assert.Equal(\"admin\", ada.UserType);\n        Assert.Equal([\"admin\", \"editor\"], ada.Roles.Select(role => role.Name).OrderBy(name => name));\n        Assert.Equal(ada.Roles.Count, ada.Roles.Count(role => role.UserId == Ada));\n        Assert.Equal([\"viewer\"], grace.Roles.Select(role => role.Name));\n        Assert.Empty(lin.Roles);\n    }"}
{"file":"docs/examples/fill-roles-from-one-join/users-view-roles.repository.integration.test.fills-roles-from-a-join.typescript","test":"typescript/providers/sqlite/tests/users-view-roles.repository.integration.test.ts#fills-roles-from-a-join","from":114,"to":166,"raw":"    const usersRepo = new ReadonlyRepository(connection, {\n      type: UsersView,\n      columnMappings: new DictionaryMapper([\n        [\"Key\", \"id\"],\n        [\"Login\", \"username\"],\n        [\"Active\", \"is_enabled\"],\n        [\"Opened\", \"created\"],\n        [\"UserType\", \"user_type.name\"],\n        [\"UserId\", \"user_id\"],\n        [\"RoleId\", \"role_id\"],\n        [\"Name\", \"roles.name\"],\n      ]),\n    });\n    usersRepo.addEnriched(\n      { into: \"Roles\", from: \"Key\", by: \"UserId\", many: true },\n      usersRepo,\n      new NestedToObjectEnrichmentStrategy<UsersView>({\n        key: \"Key\",\n        fields: {\n          Key: \"Key\",\n          Login: \"Login\",\n          Active: \"Active\",\n          Opened: \"Opened\",\n          UserType: \"UserType\",\n          Roles: {\n            key: \"RoleId\",\n            fields: { RoleId: \"RoleId\", UserId: \"UserId\", Name: \"Name\" },\n          },\n        },\n      }),\n    );\n    const items: UsersView[] = [];\n    for await (const item of usersRepo.read(\n      new SelectStatement({\n        table: \"user\",\n        fields: [\n          \"user.id\",\n          \"user.username\",\n          \"user.is_enabled\",\n          \"user.created\",\n          \"user_type.name\",\n          \"user_roles.user_id\",\n          \"user_roles.role_id\",\n          \"roles.name\",\n        ],\n        joins: [\n          Join.left(\"user_type\", \"user_type.id\", \"user.user_type_id\"),\n          Join.left(\"user_roles\", \"user_roles.user_id\", \"user.id\"),\n          Join.left(\"roles\", \"roles.id\", \"user_roles.role_id\"),\n        ],\n      }),\n    ))\n      items.push(item);"}
{"file":"docs/examples/fill-user-type-on-a-user-view/readonly_repository.fills_user_type_on_user_view.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#fills_user_type_on_user_view","from":204,"to":272,"raw":"    #[tokio::test]\n    async fn fills_user_type_on_user_view() {\n        let built = datasource();\n        let ds: &dyn Datasource = &*built;\n        let connection = open(\n            ds,\n            \"user-type-lookup\",\n            &format!(\n                \"\n            INSERT INTO user_type (id, name) VALUES\n                (1, 'admin'),\n                (2, 'user'),\n                (3, 'service');\n            INSERT INTO user (id, username, is_enabled, created, user_type_id) VALUES\n                ('{ADA}', 'ada', 1, '2020-01-01T00:00:00.000Z', 1),\n                ('{GRACE}', 'grace', 1, '2024-06-01T00:00:00.000Z', 2),\n                ('{LIN}', 'lin', 0, '2024-06-01T00:00:00.000Z', 3);\n            \"\n            ),\n        )\n        .await;\n        let mut users_options = create_crud_repository_options::<UserAccount>();\n        users_options.entity = \"user\".into();\n        users_options.column_mappings = Box::new(DictionaryMapper::new([\n            (\"Key\".to_string(), \"id\".to_string()),\n            (\"Login\".to_string(), \"username\".to_string()),\n            (\"Active\".to_string(), \"is_enabled\".to_string()),\n            (\"Opened\".to_string(), \"created\".to_string()),\n            (\"UserTypeId\".to_string(), \"user_type_id\".to_string()),\n        ]));\n        let mut type_options = create_crud_repository_options::<UserType>();\n        type_options.entity = \"UserType\".into();\n        type_options.entity_mapper =\n            Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        type_options.column_mappings =\n            Box::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake));\n        let mut users_repo = ReadonlyRepository::new(\n            connection.clone(),\n            users_options.read,\n        )\n        .unwrap();\n        let types =\n            ds.create_readonly_repository::<UserType>(Some(connection), Some(type_options.read));\n        users_repo.add_enriched(datasources::Enrichment::new(\"UserType\", \"UserTypeId\", \"Id\", Some(\"Name\".into()), false), types, None);\n        let account = users_repo\n            .read_single(\n                Some(&Where::binary(\n                    \"Key\",\n                    eq,\n                    Uuid::parse_str(ADA).unwrap(),\n                )),\n                None,\n            )\n            .await\n            .unwrap()\n            .unwrap();\n        let mut users_view = account.clone();\n        users_view.remove(\"UserTypeId\");\n        assert_eq!(account.get(\"UserTypeId\"), Some(&Value::Int(1)));\n        assert_eq!(users_view.get(\"UserType\"), Some(&Value::from(\"admin\")));\n        assert_eq!(users_view.get(\"Login\"), Some(&Value::from(\"ada\")));\n        assert_eq!(users_view.get(\"Key\"), Some(&Value::from(ADA)));\n        assert_eq!(users_view.get(\"Active\"), Some(&Value::Int(1)));\n        assert_eq!(\n            users_view.get(\"Opened\"),\n            Some(&Value::from(\"2020-01-01T00:00:00.000Z\"))\n        );\n        assert!(users_view.get(\"UserTypeId\").is_none());\n    }"}
{"file":"docs/examples/fill-user-type-on-a-user-view/readonly.repository.integration.test.fills-user-type-on-a-user-view.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#fills-user-type-on-a-user-view","from":108,"to":143,"raw":"  it(\"fills user type on a user view\", async () => {\n    const ds = new Datasource(\"sqlite\", new SqliteDriver(), { filename: \":memory:\" });\n    const connection = await open(ds, \"user-type-lookup\", `\n      INSERT INTO user_type (id, name) VALUES\n        (1, 'admin'),\n        (2, 'user'),\n        (3, 'service');\n      INSERT INTO user (id, username, is_enabled, created, user_type_id) VALUES\n        ('${ada}', 'ada', 1, '2020-01-01T00:00:00.000Z', 1),\n        ('${grace}', 'grace', 1, '2024-06-01T00:00:00.000Z', 2),\n        ('${lin}', 'lin', 0, '2024-06-01T00:00:00.000Z', 3);\n    `);\n    const casing = new ChangeCasingMapper(\"pascalCase\", \"snakeCase\");\n    const usersRepo = ds.createReadonlyRepository(UsersView, connection, {\n      entityMapper: new DictionaryMapper([[\"UsersView\", \"user\"]]),\n      columnMappings: new DictionaryMapper([\n        [\"Key\", \"id\"],\n        [\"Login\", \"username\"],\n        [\"Active\", \"is_enabled\"],\n        [\"Opened\", \"created\"],\n        [\"UserType\", \"user_type_id\"],\n      ]),\n    }) as ReadonlyRepository<UsersView>;\n    const typesRepo = ds.createReadonlyRepository(UserType, connection, {\n      entityMapper: casing,\n      columnMappings: casing,\n    });\n    usersRepo.addEnriched({ into: \"UserType\", from: \"UserType\", by: \"Id\", select: \"Name\" }, typesRepo);\n    const usersView = await usersRepo.readSingle(new Where(\"Key\", eq, ada));\n    expect(usersView?.UserType).toBe(\"admin\");\n    expect(usersView?.Login).toBe(\"ada\");\n    expect(usersView?.Key).toBe(ada);\n    expect(usersView?.Active).toBe(1);\n    expect(usersView?.Opened).toBe(\"2020-01-01T00:00:00.000Z\");\n    expect(usersView === undefined || !(\"UserTypeId\" in usersView)).toBe(true);\n  });"}
{"file":"docs/examples/fill-user-type-on-a-user-view/ReadonlyRepositoryIntegrationTests.FillsUserTypeOnUsersView.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#FillsUserTypeOnUsersView","from":129,"to":169,"raw":"    public async Task FillsUserTypeOnUsersView()\n    {\n        var ds = new Datasource(\"sqlite\", new SqliteDriver(), new Dictionary<string, string?> { [\"filename\"] = \":memory:\" });\n        var connection = await Open(ds, \"user-type-lookup\", $\"\"\"\n            INSERT INTO user_type (id, name) VALUES\n                (1, 'admin'),\n                (2, 'user'),\n                (3, 'service');\n            INSERT INTO user (id, username, is_enabled, created, user_type_id) VALUES\n                ('{Ada}', 'ada', 1, '2020-01-01T00:00:00.000Z', 1),\n                ('{Grace}', 'grace', 1, '2024-06-01T00:00:00.000Z', 2),\n                ('{Lin}', 'lin', 0, '2024-06-01T00:00:00.000Z', 3);\n            \"\"\");\n        var casing = new ChangeCasingMapper(Casing.Pascal, Casing.Snake);\n        var usersRepo = (ReadonlyRepository<UsersView>)ds.CreateReadonlyRepository<UsersView>(connection, new ReadonlyRepositoryOptions<UsersView>\n        {\n            EntityMapper = new DictionaryMapper<string>(new Dictionary<string, string> { [\"UsersView\"] = \"user\" }),\n            ColumnMappings = new DictionaryMapper<string>(new Dictionary<string, string>\n            {\n                [\"Key\"] = \"id\",\n                [\"Login\"] = \"username\",\n                [\"Active\"] = \"is_enabled\",\n                [\"Opened\"] = \"created\",\n                [\"UserType\"] = \"user_type_id\",\n            }),\n        });\n        var typesRepo = ds.CreateReadonlyRepository<UserType>(connection, new ReadonlyRepositoryOptions<UserType>\n        {\n            EntityMapper = casing,\n            ColumnMappings = casing,\n        });\n        usersRepo.AddEnriched(new(\"UserType\", \"UserType\", \"Id\", \"Name\"), typesRepo);\n        var usersView = await usersRepo.ReadSingle(new Where(\"Key\", eq, Ada));\n\n        Assert.Equal(\"admin\", usersView!.UserType);\n        Assert.Equal(\"ada\", usersView.Login);\n        Assert.Equal(Ada, usersView.Key);\n        Assert.True(usersView.Active);\n        Assert.Equal(2020, usersView.Opened.Year);\n        Assert.Null(typeof(UsersView).GetProperty(\"UserTypeId\"));\n    }"}

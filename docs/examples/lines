{"file":"docs/examples/read-multiple-results-returned-in-a-single-command/command.read_multiple_results.rust","test":"rust/providers/sqlite/tests/command.rs#read_multiple_results","from":380,"to":405,"raw":"#[tokio::test]\nasync fn read_multiple_results() {\n    let _guard = super::env_lock();\n    let ds = default().unwrap();\n    let connection = ds.create_connection().await.unwrap();\n    connection.open().await.unwrap();\n    let command = connection.create_command();\n    let reader = command\n        .execute_reader_native(&Native::new(\"SELECT 1 AS id; SELECT 2 AS id\"), None)\n        .await\n        .unwrap();\n    let mut first = Vec::new();\n    while reader.next().await.unwrap() {\n        first.push(reader.current());\n    }\n    let moved = reader.next_result().await.unwrap();\n    let mut second = Vec::new();\n    while reader.next().await.unwrap() {\n        second.push(reader.current());\n    }\n    let again = reader.next_result().await.unwrap();\n    assert!(moved);\n    assert!(!again);\n    assert_eq!(first[0].as_ref().unwrap().get(\"id\"), Some(&Value::Int(1)));\n    assert_eq!(second[0].as_ref().unwrap().get(\"id\"), Some(&Value::Int(2)));\n}"}
{"file":"docs/examples/read-multiple-results-returned-in-a-single-command/sqlite.integration.test.reads-multiple-results-returned-in-a-single-command.typescript","test":"typescript/providers/sqlite/tests/sqlite.integration.test.ts#reads-multiple-results-returned-in-a-single-command","from":239,"to":255,"raw":"  it(\"reads multiple results returned in a single command\", async () => {\n    const ds = Datasource.default;\n    await using connection = await ds.createConnection();\n    await connection.open();\n    const command = connection.createCommand();\n    await using reader = await command.executeReaderNative(new Native(\"SELECT 1 AS id; SELECT 2 AS id\"));\n    const first: { id: number }[] = [];\n    while (await reader.next()) first.push(reader.current as { id: number });\n    const moved = await reader.nextResult();\n    const second: { id: number }[] = [];\n    while (await reader.next()) second.push(reader.current as { id: number });\n    const again = await reader.nextResult();\n    expect(moved).toBe(true);\n    expect(again).toBe(false);\n    expect(first[0]?.id).toBe(1);\n    expect(second[0]?.id).toBe(2);\n  });"}
{"file":"docs/examples/read-multiple-results-returned-in-a-single-command/SqliteCommandIntegrationTests.ReadMultipleResults.csharp","test":"csharp/Providers/Sqlite.Tests/SqliteCommandIntegrationTests.cs#ReadMultipleResults","from":244,"to":264,"raw":"    [Fact]\n    public async Task ReadMultipleResults()\n    {\n        var ds = Datasource.Default;\n        await using var connection = await ds.CreateConnection();\n        await connection.Open();\n        var command = connection.CreateCommand();\n        await using var reader = await command.ExecuteReader(Native.N(\"SELECT 1 AS id; SELECT 2 AS id\"));\n        var first = new List<Row>();\n        while (await reader.Next())\n            first.Add(reader.Current!);\n        var moved = await reader.NextResult();\n        var second = new List<Row>();\n        while (await reader.Next())\n            second.Add(reader.Current!);\n        var again = await reader.NextResult();\n        Assert.True(moved);\n        Assert.False(again);\n        Assert.Equal(new Value.Int(1), first[0][\"id\"]);\n        Assert.Equal(new Value.Int(2), second[0][\"id\"]);\n    }"}
{"file":"docs/examples/read-with-case-mapping/command.read_with_case_mapping.rust","test":"rust/providers/sqlite/tests/command.rs#read_with_case_mapping","from":150,"to":179,"schema":"case-contacts","raw":"#[tokio::test]\nasync fn read_with_case_mapping() {\n    let _guard = super::env_lock();\n    let ds = default().unwrap();\n    let connection = ds.create_connection().await.unwrap();\n    connection.open().await.unwrap();\n    apply_schema(connection.as_ref(), \"case-contacts\").await.unwrap();\n    let command = connection.create_command();\n    command\n        .execute(\n            \"INSERT INTO contacts (user_id, first_name) VALUES (1, 'Ada')\",\n            None,\n        )\n        .await\n        .unwrap();\n    let reader = command\n        .execute_reader(\"SELECT user_id, first_name FROM contacts\", None)\n        .await\n        .unwrap();\n    let casing = ChangeCasingMapper::new(Casing::Pascal, Casing::Snake);\n    let mut mapped = Row::new();\n    while reader.next().await.unwrap() {\n        mapped.clear();\n        for (key, value) in reader.current().unwrap() {\n            mapped.insert(Mapper::reverse_map(&casing, key), value);\n        }\n    }\n    assert_eq!(mapped.get(\"UserId\"), Some(&Value::Int(1)));\n    assert_eq!(mapped.get(\"FirstName\"), Some(&Value::from(\"Ada\")));\n}"}
{"file":"docs/examples/read-with-case-mapping/sqlite.integration.test.reads-with-case-mapping.typescript","test":"typescript/providers/sqlite/tests/sqlite.integration.test.ts#reads-with-case-mapping","from":118,"to":134,"schema":"case-contacts","raw":"  it(\"reads with case mapping\", async () => {\n    const ds = Datasource.default;\n    await using connection = await ds.createConnection();\n    await connection.open();\n    const command = connection.createCommand();\n    await applySchema(connection, \"case-contacts\");\n    await command.execute(\"INSERT INTO contacts (user_id, first_name) VALUES (1, 'Ada')\");\n    await using reader = await command.executeReader(\"SELECT user_id, first_name FROM contacts\");\n    const casing = new ChangeCasingMapper(\"pascalCase\", \"snakeCase\");\n    let mapped: Cells | undefined;\n    while (await reader.next()) {\n      const row: Cells = {};\n      for (const [key, value] of Object.entries(reader.current!)) row[casing.reverseMap(key)] = value;\n      mapped = row;\n    }\n    expect(mapped).toEqual({ UserId: 1, FirstName: \"Ada\" });\n  });"}
{"file":"docs/examples/read-with-case-mapping/SqliteCommandIntegrationTests.ReadWithCaseMapping.csharp","test":"csharp/Providers/Sqlite.Tests/SqliteCommandIntegrationTests.cs#ReadWithCaseMapping","from":107,"to":128,"schema":"case-contacts","raw":"    [Fact]\n    public async Task ReadWithCaseMapping()\n    {\n        var ds = Datasource.Default;\n        await using var connection = await ds.CreateConnection();\n        await connection.Open();\n        var command = connection.CreateCommand();\n        await SchemaSpec.Apply(connection, \"case-contacts\");\n        await command.Execute(\"INSERT INTO contacts (user_id, first_name) VALUES (1, 'Ada')\");\n        await using var reader = await command.ExecuteReader(\"SELECT user_id, first_name FROM contacts\");\n        var casing = new ChangeCasingMapper(Casing.Pascal, Casing.Snake);\n        Row? mapped = null;\n        while (await reader.Next())\n        {\n            var row = new Row();\n            foreach (var (key, value) in reader.Current!)\n                row[casing.ReverseMap(key)] = value;\n            mapped = row;\n        }\n        Assert.Equal(new Value.Int(1), mapped![\"UserId\"]);\n        Assert.Equal(new Value.Text(\"Ada\"), mapped[\"FirstName\"]);\n    }"}
{"file":"docs/examples/recreate-children/enriched.cascade_update_deletes_children_and_recreates.rust","test":"rust/datasources/tests/enriched.rs#cascade_update_deletes_children_and_recreates","from":406,"to":485,"raw":"#[tokio::test]\nasync fn cascade_update_deletes_children_and_recreates() {\n    let connection = setup(&mut []).await;\n    let mut parents = crud(connection.clone(), \"Parent\").with_write(Arc::new(\n        DefaultWriteEnrichmentStrategy::new(\n            None,\n            Some(Arc::new(CascadeDeleteUpdateEnrichmentStrategy)),\n            false,\n        ),\n    ));\n    let mut children_repo = crud(connection.clone(), \"Child\");\n    let notes = Arc::new(crud(connection, \"Note\"));\n    let parent = parents\n        .create(&mut record(&[(\"label\", Value::from(\"p\"))]))\n        .await\n        .unwrap();\n    assert!(num(&parent, \"id\") > 0);\n    let parent_id = parent.get(\"id\").unwrap().clone();\n    let child = children_repo\n        .create(&mut record(&[\n            (\"parent_id\", parent_id.clone()),\n            (\"label\", Value::from(\"a\")),\n        ]))\n        .await\n        .unwrap();\n    assert!(num(&child, \"id\") > 0);\n    let other = children_repo\n        .create(&mut record(&[(\"label\", Value::from(\"other\"))]))\n        .await\n        .unwrap();\n    assert!(num(&other, \"id\") > 0);\n    let child_id = child.get(\"id\").unwrap().clone();\n    let note = notes\n        .create(&mut record(&[\n            (\"child_id\", child_id.clone()),\n            (\"text\", Value::from(\"n\")),\n        ]))\n        .await\n        .unwrap();\n    assert!(num(&note, \"id\") > 0);\n    children_repo.add_enriched(\n        Enrichment::new(\"notes\", \"id\", \"child_id\", None, true),\n        notes.clone(),\n        None,\n    );\n    let children = Arc::new(children_repo);\n    parents.add_enriched(\n        Enrichment::new(\"children\", \"id\", \"parent_id\", None, true),\n        children.clone(),\n        None,\n    );\n    let updated = parents\n        .update(\n            &record(&[\n                (\"id\", parent_id.clone()),\n                (\"label\", Value::from(\"p\")),\n                (\n                    \"children\",\n                    encode_rows(&[record(&[\n                        (\"id\", child_id.clone()),\n                        (\"label\", Value::from(\"fresh\")),\n                    ])]),\n                ),\n            ]),\n            None,\n        )\n        .await\n        .unwrap();\n    assert_eq!(updated.rows_affected, 1);\n    let stored = children.read(None, None).await.unwrap();\n    let created = stored\n        .iter()\n        .find(|row| row.get(\"label\") == Some(&Value::from(\"fresh\")))\n        .unwrap();\n    assert_eq!(stored.len(), 2);\n    assert_ne!(created.get(\"id\"), Some(&child_id));\n    assert_eq!(created.get(\"label\"), Some(&Value::from(\"fresh\")));\n    assert_eq!(created.get(\"parent_id\"), Some(&parent_id));\n    assert!(notes.read(None, None).await.unwrap().is_empty());\n}"}
{"file":"docs/examples/recreate-children/EnrichedCRUDRepository.test.cascade-update-deletes-children-and-recreates.typescript","test":"typescript/datasources/src/EnrichedCRUDRepository.test.ts#cascade-update-deletes-children-and-recreates","from":158,"to":186,"raw":"  it(\"cascade update deletes children and recreates\", async () => {\n    const connection = await setup();\n    const parentsRepo = new CRUDRepository<Parent>(connection, {\n      type: Parent,\n      write: new DefaultWriteEnrichmentStrategy(undefined, new CascadeDeleteUpdateEnrichmentStrategy()),\n    });\n    const childrenRepo = new CRUDRepository(Child, connection);\n    const notesRepo = new CRUDRepository(Note, connection);\n    const parent = await parentsRepo.create(new Parent());\n    expect(parent.id).toBeGreaterThan(0);\n    const child = await childrenRepo.create(Object.assign(new Child(), { parent_id: parent.id, label: \"a\" }));\n    expect(child.id).toBeGreaterThan(0);\n    const other = await childrenRepo.create(Object.assign(new Child(), { label: \"other\" }));\n    expect(other.id).toBeGreaterThan(0);\n    const note = await notesRepo.create(Object.assign(new Note(), { child_id: child.id, text: \"n\" }));\n    expect(note.id).toBeGreaterThan(0);\n    childrenRepo.addEnriched({ into: \"notes\", from: \"id\", by: \"child_id\", many: true }, notesRepo);\n    parentsRepo.addEnriched({ into: \"children\", from: \"id\", by: \"parent_id\", many: true }, childrenRepo);\n    const updated = await parentsRepo.update(Object.assign(new Parent(), {\n      id: parent.id,\n      children: [Object.assign(new Child(), { id: child.id, label: \"fresh\" })],\n    }));\n    expect(updated.rowsAffected).toBe(1);\n    const created = (await collectAsync(childrenRepo.read())).find((row) => row.label === \"fresh\");\n    expect(created?.id).not.toBe(child?.id);\n    expect(created?.label).toBe(\"fresh\");\n    expect(created?.parent_id).toBe(parent?.id);\n    expect(await collectAsync(notesRepo.read())).toEqual([]);\n  });"}
{"file":"docs/examples/recreate-children/EnrichedCRUDRepositoryTests.CascadeUpdateDeletesChildrenAndRecreates.csharp","test":"csharp/Datasources.Tests/EnrichedCRUDRepositoryTests.cs#CascadeUpdateDeletesChildrenAndRecreates","from":129,"to":160,"raw":"    [Fact]\n    public async Task CascadeUpdateDeletesChildrenAndRecreates()\n    {\n        var connection = await Setup();\n        var parentsRepo = new CRUDRepository<Parent>(connection, new CRUDRepositoryOptions<Parent>\n        {\n            Write = new DefaultWriteEnrichmentStrategy<Parent>(update: new CascadeDeleteUpdateEnrichmentStrategy<Parent>()),\n        });\n        var childrenRepo = new CRUDRepository<Child>(connection);\n        var notesRepo = new CRUDRepository<Note>(connection);\n        var parent = await parentsRepo.Create(new Parent());\n        Assert.True(parent.id > 0);\n        var child = await childrenRepo.Create(new Child { parent_id = parent.id, label = \"a\" });\n        Assert.True(child.id > 0);\n        var other = await childrenRepo.Create(new Child { label = \"other\" });\n        Assert.True(other.id > 0);\n        var note = await notesRepo.Create(new Note { child_id = child.id, text = \"n\" });\n        Assert.True(note.id > 0);\n        childrenRepo.AddEnriched(new(\"notes\", \"id\", \"child_id\", Many: true), notesRepo);\n        parentsRepo.AddEnriched(new(\"children\", \"id\", \"parent_id\", Many: true), childrenRepo);\n        var updated = await parentsRepo.Update(new Parent\n        {\n            id = parent.id,\n            children = [new Child { id = child.id, label = \"fresh\" }]\n        });\n        Assert.Equal(1, updated.RowsAffected);\n        var created = (await childrenRepo.Read().ToListAsync()).Single(row => row.label == \"fresh\");\n        Assert.NotEqual(child.id, created.id);\n        Assert.Equal(\"fresh\", created.label);\n        Assert.Equal(parent.id, created.parent_id);\n        Assert.Empty(await notesRepo.Read().ToListAsync());\n    }"}
{"file":"docs/examples/register-a-fill/enriched.enriched_fills_lookup_select_and_leaves_missing_default.rust","test":"rust/datasources/tests/enriched.rs#enriched_fills_lookup_select_and_leaves_missing_default","from":108,"to":133,"raw":"#[tokio::test]\nasync fn enriched_fills_lookup_select_and_leaves_missing_default() {\n    let mut seeds = [\n        record(&[(\"name\", Value::from(\"person\"))]),\n        record(&[(\"name\", Value::from(\"gone\"))]),\n    ];\n    let types_connection = setup(&mut seeds).await;\n    let person = seeds[0].clone();\n    let gone = seeds[1].clone();\n    drop_row(&types_connection, &gone).await;\n    let mut parents = [\n        record(&[(\"type_id\", person.get(\"id\").unwrap().clone())]),\n        record(&[(\"type_id\", gone.get(\"id\").unwrap().clone())]),\n    ];\n    let connection = setup(&mut parents).await;\n    let mut parents_repo = readonly(connection, \"Parent\");\n    let types_repo = Arc::new(readonly(types_connection, \"TypeRow\"));\n    parents_repo.add_enriched(\n        Enrichment::new(\"type_name\", \"type_id\", \"id\", Some(\"name\".into()), false),\n        types_repo,\n        None,\n    );\n    let items = parents_repo.read(None, None).await.unwrap();\n    assert_eq!(items[0][\"type_name\"], Value::from(\"person\"));\n    assert!(!items[1].contains_key(\"type_name\") || items[1][\"type_name\"] == Value::from(\"\"));\n}"}
{"file":"docs/examples/register-a-fill/EnrichedReadonlyRepository.test.fills-lookup-select-and-leaves-missing-default.typescript","test":"typescript/datasources/src/EnrichedReadonlyRepository.test.ts#fills-lookup-select-and-leaves-missing-default","from":84,"to":96,"raw":"  it(\"fills lookup select and leaves missing default\", async () => {\n    const person: Seed = { name: \"person\" };\n    const gone: Seed = { name: \"gone\" };\n    const typesConnection = await setup([person, gone]);\n    await remove(typesConnection, gone);\n    const connection = await setup([{ type_id: person.id }, { type_id: gone.id }]);\n    const parentsRepo = new ReadonlyRepository(Parent, connection);\n    const typesRepo = new ReadonlyRepository(TypeRow, typesConnection);\n    parentsRepo.addEnriched({ into: \"type_name\", from: \"type_id\", by: \"id\", select: \"name\" }, typesRepo);\n    const items = await collectAsync(parentsRepo.read());\n    expect(items[0]?.type_name).toBe(\"person\");\n    expect(items[1]?.type_name).toBe(\"\");\n  });"}

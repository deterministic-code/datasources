{"file":"docs/examples/simple-crud/readonly_repository.writes_user_from_the_type.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#writes_user_from_the_type","from":664,"to":716,"schema":"user-pascal","raw":"    #[tokio::test]\n    async fn writes_user_from_the_type() {\n        let _guard = super::super::env_lock();\n        let ds = default().unwrap();\n        let connection = open(ds.as_ref()).await;\n        apply_schema(connection.as_ref(), \"user-pascal\").await.unwrap();\n        let mut options = create_crud_repository_options::<User>();\n        options.property_mappings = Some(std::sync::Arc::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake)));\n        options.ids = vec![\"Id\".into()];\n        let users_repo = ds.create_repository::<User>(Some(connection), Some(options));\n        let mut created = datasources::Row::new();\n        created.insert(\"Username\".into(), Value::from(\"ada\"));\n        created.insert(\"IsEnabled\".into(), Value::Bool(true));\n        let mut created = users_repo.create(created).await.unwrap();\n        let by_id = users_repo\n            .read_single_by_id(created.get(\"Id\").unwrap())\n            .await\n            .unwrap()\n            .unwrap();\n        let matches = users_repo\n            .read(\n                Some(&Where::binary(\"Username\", eq, \"ada\").and(\n                    \"IsEnabled\",\n                    eq,\n                    Value::Bool(true),\n                )),\n                None, None\n        )\n            .try_collect::<Vec<_>>().await\n            .unwrap();\n        created.insert(\"Username\".into(), Value::from(\"ada-v2\"));\n        let updated = users_repo.update(created.clone(), None).await.unwrap();\n        let renamed = users_repo\n            .read_single_by_id(created.get(\"Id\").unwrap())\n            .await\n            .unwrap()\n            .unwrap();\n        let removed = users_repo.delete(created.clone(), None).await.unwrap();\n        let gone = users_repo\n            .read_single_by_id(created.get(\"Id\").unwrap())\n            .await\n            .unwrap();\n        assert_eq!(matches!(created.get(\"Id\"), Some(Value::Int(id)) if *id > 0), true);\n        assert_eq!(updated.rows_affected, 1);\n        assert_eq!(removed.rows_affected, 1);\n        assert_eq!(by_id.get(\"Id\"), created.get(\"Id\"));\n        assert_eq!(by_id.get(\"Username\"), Some(&Value::from(\"ada\")));\n        assert_eq!(by_id.get(\"IsEnabled\"), Some(&Value::Bool(true)));\n        assert_eq!(matches.len(), 1);\n        assert_eq!(matches[0].get(\"Username\"), Some(&Value::from(\"ada\")));\n        assert_eq!(renamed.get(\"Username\"), Some(&Value::from(\"ada-v2\")));\n        assert!(gone.is_none());\n    }"}
{"file":"docs/examples/simple-crud/readonly.repository.integration.test.writes-a-user-from-the-type.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#writes-a-user-from-the-type","from":229,"to":256,"schema":"user-pascal","raw":"  it(\"writes a user from the type\", async () => {\n    const ds = Datasource.default;\n    const connection = await open(ds);\n    await applySchema(connection, \"user-pascal\");\n    const casing = new ChangeCasingMapper(\"pascalCase\", \"snakeCase\");\n    const usersRepo = ds.createRepository(User, connection, {\n      ...createCRUDRepositoryOptions(User),\n      propertyMappings: casing,\n      ids: [\"Id\"],\n    });\n    const created = await usersRepo.create(Object.assign(new User(), { Username: \"ada\", IsEnabled: true }));\n    const byId = await usersRepo.readSingleById(created.Id);\n    const matches: User[] = [];\n    for await (const row of usersRepo.read(new Where(\"Username\", eq, \"ada\").and(\"IsEnabled\", eq, true)))\n      matches.push(row);\n    created.Username = \"ada-v2\";\n    const updated = await usersRepo.update(created);\n    const renamed = await usersRepo.readSingleById(created.Id);\n    const removed = await usersRepo.delete(created);\n    const gone = await usersRepo.readSingleById(created.Id);\n    expect(created.Id).toBeGreaterThan(0);\n    expect(updated.rowsAffected).toBe(1);\n    expect(removed.rowsAffected).toBe(1);\n    expect(byId).toEqual({ Id: created.Id, Username: \"ada\", IsEnabled: true });\n    expect(matches.map((row) => row.Username)).toEqual([\"ada\"]);\n    expect(renamed?.Username).toBe(\"ada-v2\");\n    expect(gone).toBeUndefined();\n  });"}
{"file":"docs/examples/simple-crud/ReadonlyRepositoryIntegrationTests.WritesUserFromTheType.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#WritesUserFromTheType","from":624,"to":656,"schema":"user-pascal","raw":"    [Fact]\n    public async Task WritesUserFromTheType()\n    {\n        var ds = Datasource.Default;\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"user-pascal\");\n        var casing = new ChangeCasingMapper(Casing.Pascal, Casing.Snake);\n        var usersRepo = ds.CreateRepository<User>(connection, new CRUDRepositoryOptions<User>\n        {\n            PropertyMappings = casing,\n            Ids = [\"Id\"],\n        });\n        var created = await usersRepo.Create(new User { Username = \"ada\", IsEnabled = true });\n        var byId = await usersRepo.ReadSingleById(created.Id);\n        var matches = new List<User>();\n        await foreach (var row in usersRepo.Read(new Where(\"Username\", eq, \"ada\").And(\"IsEnabled\", eq, true)))\n            matches.Add(row);\n        created.Username = \"ada-v2\";\n        var updated = await usersRepo.Update(created);\n        var renamed = await usersRepo.ReadSingleById(created.Id);\n        var removed = await usersRepo.Delete(created);\n        var gone = await usersRepo.ReadSingleById(created.Id);\n\n        Assert.True(created.Id > 0);\n        Assert.Equal(1, updated.RowsAffected);\n        Assert.Equal(1, removed.RowsAffected);\n        Assert.Equal(created.Id, byId!.Id);\n        Assert.Equal(\"ada\", byId.Username);\n        Assert.True(byId.IsEnabled);\n        Assert.Equal(\"ada\", Assert.Single(matches).Username);\n        Assert.Equal(\"ada-v2\", renamed!.Username);\n        Assert.Null(gone);\n    }"}

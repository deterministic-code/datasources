{"file":"docs/examples/collapse-join-rows/readonly_repository.fills_roles_from_a_join.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#fills_roles_from_a_join","from":540,"to":652,"schema":"user-roles-read","raw":"    #[tokio::test]\n    async fn fills_roles_from_a_join() {\n        let built = datasource();\n        let ds: &dyn Datasource = &*built;\n        let connection = open(ds).await;\n        apply_schema(connection.as_ref(), \"user-roles-read\")\n            .await\n            .unwrap();\n        execute_sql(&connection, &seed()).await;\n        let mut options = ReadonlyRepositoryMappingOptions::default();\n        options.entity = \"User\".into();\n        options.entity_mapper = Some(std::sync::Arc::new(DictionaryMapper::new([\n            (\"User\".into(), \"user\".into()),\n            (\"UserType\".into(), \"user_type\".into()),\n            (\"UserRole\".into(), \"user_roles\".into()),\n            (\"Role\".into(), \"roles\".into()),\n        ])));\n        options.property_mappings = Some(std::sync::Arc::new(DictionaryMapper::new([\n            (\"Key\".into(), \"id\".into()),\n            (\"Login\".into(), \"username\".into()),\n            (\"Active\".into(), \"is_enabled\".into()),\n            (\"Opened\".into(), \"created\".into()),\n            (\"UserType\".into(), \"user_type.name\".into()),\n            (\"UserTypeId\".into(), \"user_type_id\".into()),\n            (\"UserId\".into(), \"user_id\".into()),\n            (\"RoleId\".into(), \"role_id\".into()),\n            (\"Name\".into(), \"roles.name\".into()),\n            (\"Id\".into(), \"id\".into()),\n        ])));\n        let mut users_repo = ReadonlyRepository::<Row>::new(connection.clone(), options).unwrap();\n        users_repo.add_enriched(\n            datasources::Enrichment::new(\"Roles\", \"Key\", \"UserId\", None, datasources::EnrichmentPropertyType::List),\n            Arc::new(ReadonlyRepository::<Row>::new(\n                connection.clone(),\n                ReadonlyRepositoryMappingOptions::default(),\n            ).unwrap()),\n            Some(Arc::new(NestedToObjectEnrichmentStrategy::new(\n                TypeMap::new(\n                    \"Key\",\n                    vec![\n                        (\"Key\".into(), TypeMapField::column(\"Key\")),\n                        (\"Login\".into(), TypeMapField::column(\"Login\")),\n                        (\"Active\".into(), TypeMapField::column(\"Active\")),\n                        (\"Opened\".into(), TypeMapField::column(\"Opened\")),\n                        (\"UserType\".into(), TypeMapField::column(\"UserType\")),\n                        (\n                            \"Roles\".into(),\n                            TypeMapField::Group(TypeMapGroup::new(\n                                \"RoleId\",\n                                vec![\n                                    (\"RoleId\".into(), TypeMapField::column(\"RoleId\")),\n                                    (\"UserId\".into(), TypeMapField::column(\"UserId\")),\n                                    (\"Name\".into(), TypeMapField::column(\"Name\")),\n                                ],\n                            )),\n                        ),\n                    ],\n                ),\n            ))),\n        );\n        let joined = joined_users();\n        let items = users_repo.read(Some(&joined), None, None).try_collect::<Vec<_>>().await.unwrap();\n        let view = |login: &str| {\n            items\n                .iter()\n                .find(|item| item.get(\"Login\") == Some(&Value::from(login)))\n                .unwrap()\n                .clone()\n        };\n        let ada = view(\"ada\");\n        let grace = view(\"grace\");\n        let lin = view(\"lin\");\n        assert_eq!(items.len(), 3);\n        assert_eq!(ada.get(\"Key\"), Some(&Value::from(ADA)));\n        assert_eq!(ada.get(\"Login\"), Some(&Value::from(\"ada\")));\n        assert_eq!(ada.get(\"Active\"), Some(&Value::Bool(true)));\n        assert_eq!(\n            ada.get(\"Opened\"),\n            Some(&Value::from(\"2020-01-01T00:00:00.000Z\"))\n        );\n        assert_eq!(ada.get(\"UserType\"), Some(&Value::from(\"admin\")));\n        let mut names = role_names(ada.get(\"Roles\").unwrap());\n        names.sort();\n        assert_eq!(names, [\"admin\", \"editor\"]);\n        assert!(ada\n            .get(\"Roles\")\n            .unwrap()\n            .wire_text()\n            .contains(&format!(\"UserId={ADA}\")));\n        assert_eq!(grace.get(\"Key\"), Some(&Value::from(GRACE)));\n        assert_eq!(grace.get(\"Login\"), Some(&Value::from(\"grace\")));\n        assert_eq!(grace.get(\"Active\"), Some(&Value::Bool(true)));\n        assert_eq!(\n            grace.get(\"Opened\"),\n            Some(&Value::from(\"2024-06-01T00:00:00.000Z\"))\n        );\n        assert_eq!(grace.get(\"UserType\"), Some(&Value::from(\"user\")));\n        assert_eq!(role_names(grace.get(\"Roles\").unwrap()), [\"viewer\"]);\n        assert!(grace\n            .get(\"Roles\")\n            .unwrap()\n            .wire_text()\n            .contains(&format!(\"UserId={GRACE}\")));\n        assert_eq!(lin.get(\"Key\"), Some(&Value::from(LIN)));\n        assert_eq!(lin.get(\"Login\"), Some(&Value::from(\"lin\")));\n        assert_eq!(lin.get(\"Active\"), Some(&Value::Bool(false)));\n        assert_eq!(\n            lin.get(\"Opened\"),\n            Some(&Value::from(\"2024-06-01T00:00:00.000Z\"))\n        );\n        assert_eq!(lin.get(\"UserType\"), Some(&Value::from(\"service\")));\n        assert_eq!(lin.get(\"Roles\"), Some(&Value::from(\"\")));\n    }"}
{"file":"docs/examples/collapse-join-rows/ReadonlyRepository.test.collapses-join-rows.typescript","test":"typescript/datasources/src/ReadonlyRepository.test.ts#collapses-join-rows","from":312,"to":327,"raw":"  it(\"collapses join rows\", async () => {\n    const person: Seed = { TypeName: \"person\" };\n    const org: Seed = { TypeName: \"org\" };\n    const connection = await setup([person, org]);\n    person.Id = person.id;\n    org.Id = org.id;\n    const parents: Parent[] = [];\n    const parentsRepo = repo(Parent, connection);\n    await new NestedToObjectEnrichmentStrategy<Parent>({\n      key: \"Id\",\n      fields: { Id: \"Id\", TypeName: \"TypeName\" },\n    }).apply(parentsRepo, { destinationProperty: \"TypeName\", sourceProperty: \"Id\", relatedKey: \"Id\" }, parents, [person, org]);\n    const items = parents;\n    expect(items.map((item) => item.Id)).toEqual([person.id, org.id]);\n    expect(items.map((item) => item.TypeName)).toEqual([\"person\", \"org\"]);\n  });"}
{"file":"docs/examples/collapse-join-rows/ReadonlyRepositoryTests.FlatToNestedCollapsesJoinRows.csharp","test":"csharp/Datasources.Tests/ReadonlyRepositoryTests.cs#FlatToNestedCollapsesJoinRows","from":213,"to":231,"raw":"    [Fact]\n    public async Task FlatToNestedCollapsesJoinRows()\n    {\n        var person = new Row { [\"TypeName\"] = \"person\" };\n        var org = new Row { [\"TypeName\"] = \"org\" };\n        var connection = await Setup(person, org);\n        person[\"Id\"] = person[\"id\"];\n        org[\"Id\"] = org[\"id\"];\n        IList<Parent> parents = [];\n        var parentsRepo = Open<Parent>(connection);\n        await new NestedToObjectEnrichmentStrategy<Parent>(new TypeMap\n        {\n            Key = \"Id\",\n            Fields = new Dictionary<string, TypeMapField> { [\"Id\"] = \"Id\", [\"TypeName\"] = \"TypeName\" }\n        }).Apply(parentsRepo, new(\"TypeName\", \"Id\", \"Id\"), parents, [person, org]);\n        var items = parents;\n        Assert.Equal([Id(person), Id(org)], items.Select(item => item.Id));\n        Assert.Equal([\"person\", \"org\"], items.Select(item => item.TypeName));\n    }"}
{"file":"docs/examples/column-alias-literal/builders.test.renders-comparison-symbols.typescript","test":"typescript/datasources/src/builders/builders.test.ts#renders-comparison-symbols","from":430,"to":447,"raw":"  it(\"renders comparison symbols\", () => {\n    const equals = new Where(\"username\", eq, \"grace\");\n    const notEquals = new Where(\"id\", ne, 2);\n    const greater = new Where(\"n\", gt, 0);\n    const less = new Where(\"n\", lt, 0);\n    const greaterOrEqual = new Where(\"n\", ge, 0);\n    const lessOrEqual = new Where(\"n\", le, 0);\n    const both = equals.and(\"is_enabled\", eq, 0);\n    const either = equals.or(\"is_enabled\", eq, 0);\n    expect(DefaultStatementTextRenderer.instance.render(equals)).toBe(\"username = $username\");\n    expect(DefaultStatementTextRenderer.instance.render(notEquals)).toBe(\"id <> $id\");\n    expect(DefaultStatementTextRenderer.instance.render(greater)).toBe(\"n > $n\");\n    expect(DefaultStatementTextRenderer.instance.render(less)).toBe(\"n < $n\");\n    expect(DefaultStatementTextRenderer.instance.render(greaterOrEqual)).toBe(\"n >= $n\");\n    expect(DefaultStatementTextRenderer.instance.render(lessOrEqual)).toBe(\"n <= $n\");\n    expect(DefaultStatementTextRenderer.instance.render(both)).toBe(\"username = $username AND is_enabled = $is_enabled\");\n    expect(DefaultStatementTextRenderer.instance.render(either)).toBe(\"username = $username OR is_enabled = $is_enabled\");\n  });"}

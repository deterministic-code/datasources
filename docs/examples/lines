{"file":"docs/examples/transform-a-contact/mappers-mod.maps_a_contact_name_and_email.rust","test":"rust/datasources/src/mappers/mod.rs#maps_a_contact_name_and_email","from":147,"to":173,"raw":"    #[test]\n    fn maps_a_contact_name_and_email() {\n        let contact = Contact {\n            name: \"Ada\".into(),\n            email: \"ada@x.dev\".into(),\n        };\n        let mapper = TransformMapper::new(\n            |item: Contact| ContactRow {\n                contact_name: item.name,\n                contact_email: item.email,\n            },\n            |row: ContactRow| Contact {\n                name: row.contact_name,\n                email: row.contact_email,\n            },\n        );\n        let mapped = Mapper::map(&mapper, contact.clone());\n        let reversed = Mapper::reverse_map(&mapper, mapped.clone());\n        assert_eq!(\n            mapped,\n            ContactRow {\n                contact_name: \"Ada\".into(),\n                contact_email: \"ada@x.dev\".into(),\n            }\n        );\n        assert_eq!(reversed, contact);\n    }"}
{"file":"docs/examples/transform-a-contact/transformMapper.test.maps-a-contact-name-and-email.typescript","test":"typescript/datasources/src/mappers/transformMapper.test.ts#maps-a-contact-name-and-email","from":55,"to":65,"raw":"  it(\"maps a contact name and email\", () => {\n    const contact: Contact = { name: \"Ada\", email: \"ada@x.dev\" };\n    const mapper = new TransformMapper<Contact, ContactRow>(\n      (item) => ({ contactName: item.name, contactEmail: item.email }),\n      (row) => ({ name: row.contactName, email: row.contactEmail }),\n    );\n    const mapped = mapper.map(contact);\n    const reversed = mapper.reverseMap(mapped);\n    expect(mapped).toEqual({ contactName: \"Ada\", contactEmail: \"ada@x.dev\" });\n    expect(reversed).toEqual(contact);\n  });"}
{"file":"docs/examples/transform-a-contact/TransformMapperTests.MapsAContactNameAndEmail.csharp","test":"csharp/Datasources.Tests/TransformMapperTests.cs#MapsAContactNameAndEmail","from":41,"to":52,"raw":"    [Fact]\n    public void MapsAContactNameAndEmail()\n    {\n        var contact = new Contact(\"Ada\", \"ada@x.dev\");\n        var mapper = new TransformMapper<Contact, ContactRow>(\n            map: item => new ContactRow(item.Name, item.Email),\n            reverseMap: row => new Contact(row.ContactName, row.ContactEmail));\n        var mapped = mapper.Map(contact);\n        var reversed = mapper.ReverseMap(mapped);\n        Assert.Equal(new ContactRow(\"Ada\", \"ada@x.dev\"), mapped);\n        Assert.Equal(contact, reversed);\n    }"}
{"file":"docs/examples/type-mapping/readonly_repository.updates_users_view_when_the_version_matches.rust","test":"rust/providers/sqlite/tests/readonly_repository.rs#updates_users_view_when_the_version_matches","from":772,"to":925,"schema":"user-view-version","raw":"    #[tokio::test]\n    async fn updates_users_view_when_the_version_matches() {\n        let _guard = super::super::super::env_lock();\n        let ds = default().unwrap();\n        let connection = open(ds.as_ref()).await;\n        apply_schema(connection.as_ref(), \"user-view-version\").await.unwrap();\n        let mut users_options = create_crud_repository_options::<User>();\n        users_options.ids = vec![\"Key\".into()];\n        users_options.entity_mapper =\n            Some(std::sync::Arc::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake)));\n        users_options.property_mappings = Some(std::sync::Arc::new(DictionaryMapper::new([\n            (\"Key\".to_string(), \"id\".to_string()),\n            (\"Login\".to_string(), \"username\".to_string()),\n            (\"Active\".to_string(), \"is_enabled\".to_string()),\n            (\"Opened\".to_string(), \"created\".to_string()),\n            (\"UserType\".to_string(), \"user_type_id\".to_string()),\n            (\"Version\".to_string(), \"version\".to_string()),\n        ])));\n        users_options.row_converter = Some(RowTypeConverter::of::<User>());\n        users_options.object_converter = Some(Box::new(\n            MetaDataRowTypeConverter::of::<User>().with_references(\n                vec![\"UserType\".into()],\n                Box::new(DictionaryMapper::new([\n                    (\"Key\".to_string(), \"id\".to_string()),\n                    (\"Login\".to_string(), \"username\".to_string()),\n                    (\"Active\".to_string(), \"is_enabled\".to_string()),\n                    (\"Opened\".to_string(), \"created\".to_string()),\n                    (\"UserType\".to_string(), \"user_type_id\".to_string()),\n                    (\"Version\".to_string(), \"version\".to_string()),\n                ])),\n            ),\n        ));\n        let casing = ChangeCasingMapper::new(Casing::Pascal, Casing::Snake);\n        let mut type_options = create_crud_repository_options::<UserType>();\n        type_options.entity_mapper =\n            Some(std::sync::Arc::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake)));\n        type_options.property_mappings = Some(std::sync::Arc::new(casing));\n        type_options.row_converter = Some(RowTypeConverter::of::<UserType>());\n        let mut role_options = create_crud_repository_options::<UserRole>();\n        role_options.entity_mapper =\n            Some(std::sync::Arc::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake)));\n        role_options.property_mappings =\n            Some(std::sync::Arc::new(ChangeCasingMapper::new(Casing::Pascal, Casing::Snake)));\n        role_options.row_converter = Some(RowTypeConverter::of::<UserRole>());\n        let mut users_repo = CRUDRepository::<Row>::new(connection.clone(), users_options).unwrap();\n        let user_types_repo =\n            Arc::new(CRUDRepository::<Row>::new(connection.clone(), type_options).unwrap());\n        let user_roles_repo = Arc::new(CRUDRepository::<Row>::new(connection, role_options).unwrap());\n        users_repo.add_enriched(\n            datasources::Enrichment::new(\n                \"UserType\",\n                \"UserType\",\n                \"Id\",\n                None,\n                datasources::EnrichmentPropertyType::Object,\n            ),\n            user_types_repo.clone(),\n            None,\n        );\n        users_repo.add_enriched(\n            datasources::Enrichment::new(\"Roles\", \"Key\", \"UserId\", None, datasources::EnrichmentPropertyType::List),\n            user_roles_repo.clone(),\n            None,\n        );\n        let mut admin = datasources::Row::new();\n        admin.insert(\"Name\".into(), Value::from(\"admin\"));\n        let admin = user_types_repo.create(admin).await.unwrap();\n        let mut admin_role = datasources::Row::new();\n        admin_role.insert(\"Name\".into(), Value::from(\"admin\"));\n        let mut editor_role = datasources::Row::new();\n        editor_role.insert(\"Name\".into(), Value::from(\"editor\"));\n        let mut user = datasources::Row::new();\n        user.insert(\"Login\".into(), Value::from(\"ada\"));\n        user.insert(\"Active\".into(), Value::Bool(true));\n        user.insert(\"Opened\".into(), Value::from(\"2020-01-01T00:00:00.000Z\"));\n        user.insert(\"UserType\".into(), admin.get(\"Id\").cloned().unwrap());\n        user.insert(\"Version\".into(), Value::Int(1));\n        user.insert(\"Roles\".into(), encode_rows(&[admin_role, editor_role]));\n        let user = users_repo.create(user).await.unwrap();\n        let mut viewer_role = datasources::Row::new();\n        viewer_role.insert(\"Name\".into(), Value::from(\"viewer\"));\n        let mut grace = datasources::Row::new();\n        grace.insert(\"Login\".into(), Value::from(\"grace\"));\n        grace.insert(\"Active\".into(), Value::Bool(true));\n        grace.insert(\"Opened\".into(), Value::from(\"2024-06-01T00:00:00.000Z\"));\n        grace.insert(\"UserType\".into(), admin.get(\"Id\").cloned().unwrap());\n        grace.insert(\"Version\".into(), Value::Int(1));\n        grace.insert(\"Roles\".into(), encode_rows(&[viewer_role]));\n        let grace = users_repo.create(grace).await.unwrap();\n        let key = user.get(\"Key\").cloned().unwrap();\n        let mut loaded = users_repo\n            .read_single(Some(&Where::binary(\"Key\", eq, key.clone())), None, None)\n            .await\n            .unwrap()\n            .unwrap();\n        let version = loaded.get(\"Version\").cloned().unwrap();\n        let mut member = datasources::Row::new();\n        member.insert(\"Name\".into(), Value::from(\"member\"));\n        let member = user_types_repo.create(member).await.unwrap();\n        let mut owner_role = datasources::Row::new();\n        owner_role.insert(\"Name\".into(), Value::from(\"owner\"));\n        let mut kept_admin = datasources::Row::new();\n        kept_admin.insert(\"Name\".into(), Value::from(\"admin\"));\n        let mut kept_editor = datasources::Row::new();\n        kept_editor.insert(\"Name\".into(), Value::from(\"editor\"));\n        loaded.insert(\"Login\".into(), Value::from(\"ada-v2\"));\n        loaded.insert(\"UserType\".into(), member.get(\"Id\").cloned().unwrap());\n        loaded.insert(\n            \"Roles\".into(),\n            encode_rows(&[kept_admin, kept_editor, owner_role]),\n        );\n        loaded.insert(\"Version\".into(), Value::Int(2));\n        let updated = users_repo\n            .update(\n                loaded.clone(),\n                Some(&Where::binary(\"Key\", eq, key.clone()).and(\"Version\", eq, version.clone())),\n            )\n            .await\n            .unwrap();\n        let current = users_repo\n            .read_single(Some(&Where::binary(\"Key\", eq, key.clone())), None, None)\n            .await\n            .unwrap()\n            .unwrap();\n        let stale = users_repo\n            .update(\n                loaded.clone(),\n                Some(&Where::binary(\"Key\", eq, key.clone()).and(\"Version\", eq, version)),\n            )\n            .await\n            .unwrap();\n        let removed = users_repo.delete(loaded, None).await.unwrap();\n        let gone = users_repo.read_single_by_id(&key).await.unwrap();\n        assert_eq!(current.get(\"Version\"), Some(&Value::Int(2)));\n        assert_eq!(current.get(\"Login\"), Some(&Value::from(\"ada-v2\")));\n        assert_eq!(current.get(\"Active\"), Some(&Value::Bool(true)));\n        assert_eq!(current.get(\"UserType\"), Some(&Value::from(\"Id=2,Name=member\")));\n        let mut current_names = role_names(current.get(\"Roles\").unwrap());\n        current_names.sort();\n        assert_eq!(current_names, [\"admin\", \"editor\", \"owner\"]);\n        let roles = user_roles_repo\n            .read(Some(&Where::binary(\"UserId\", eq, key.clone())), None, None)\n            .try_collect::<Vec<_>>().await\n            .unwrap();\n        assert_eq!(admin.get(\"Id\"), Some(&Value::Int(1)));\n        assert_eq!(user.get(\"Key\"), Some(&Value::Int(1)));\n        assert_eq!(grace.get(\"Key\"), Some(&Value::Int(2)));\n        assert_eq!(member.get(\"Id\"), Some(&Value::Int(2)));\n        assert_eq!(updated.rows_affected, 1);\n        assert_eq!(stale.rows_affected, 0);\n        assert_eq!(removed.rows_affected, 1);\n        assert_eq!(gone.is_none(), true);\n        assert_eq!(roles.is_empty(), true);\n    }"}
{"file":"docs/examples/type-mapping/readonly.repository.integration.test.updates-a-user-view-when-the-version-matches.typescript","test":"typescript/providers/sqlite/tests/readonly.repository.integration.test.ts#updates-a-user-view-when-the-version-matches","from":288,"to":369,"schema":"user-view-version","raw":"  it(\"updates a user view when the version matches\", async () => {\n    const ds = Datasource.default;\n    const connection = await open(ds);\n    await applySchema(connection, \"user-view-version\");\n    const casing = new ChangeCasingMapper(\"pascalCase\", \"snakeCase\");\n    const usersRepo = new CRUDRepository(connection, {\n      ...createCRUDRepositoryOptions(User),\n      ids: [\"Key\"],\n      entity: \"User\",\n      entityMapper: casing,\n      propertyMappings: new DictionaryMapper([\n        [\"Key\", \"id\"],\n        [\"Login\", \"username\"],\n        [\"Active\", \"is_enabled\"],\n        [\"Opened\", \"created\"],\n        [\"UserType\", \"user_type_id\"],\n        [\"Version\", \"version\"],\n      ]),\n    });\n    const userTypesRepo = new CRUDRepository(connection, {\n      ...createCRUDRepositoryOptions(UserType),\n      entity: \"UserType\",\n      entityMapper: casing,\n      propertyMappings: casing,\n    });\n    const userRolesRepo = new CRUDRepository(connection, {\n      ...createCRUDRepositoryOptions(UserRole),\n      entity: \"UserRole\",\n      entityMapper: casing,\n      propertyMappings: casing,\n    });\n    usersRepo.addEnriched({ destinationProperty: \"UserType\", sourceProperty: \"UserType\", relatedKey: \"Id\" }, userTypesRepo);\n    usersRepo.addEnriched({ destinationProperty: \"Roles\", sourceProperty: \"Key\", relatedKey: \"UserId\", type: \"list\" }, userRolesRepo);\n    const admin = await userTypesRepo.create(Object.assign(new UserType(), { Name: \"admin\" }));\n    const user = Object.assign(new User(), {\n      Login: \"ada\",\n      Active: true,\n      Opened: \"2020-01-01T00:00:00.000Z\",\n      UserType: admin,\n      Version: 1,\n      Roles: [Object.assign(new UserRole(), { Name: \"admin\" }), Object.assign(new UserRole(), { Name: \"editor\" })],\n    });\n    const created = await usersRepo.create(user);\n    const grace = await usersRepo.create(Object.assign(new User(), {\n      Login: \"grace\",\n      Active: true,\n      Opened: \"2024-06-01T00:00:00.000Z\",\n      UserType: admin,\n      Version: 1,\n      Roles: [Object.assign(new UserRole(), { Name: \"viewer\" })],\n    }));\n    const loaded = await usersRepo.readSingle(new Where(\"Key\", eq, user.Key));\n    const version = loaded!.Version;\n    const member = await userTypesRepo.create(Object.assign(new UserType(), { Name: \"member\" }));\n    loaded!.Login = \"ada-v2\";\n    loaded!.UserType = member;\n    loaded!.Roles.push(Object.assign(new UserRole(), { Name: \"owner\" }));\n    loaded!.Version = version + 1;\n    const updated = await usersRepo.update(loaded!, new Where(\"Key\", eq, loaded!.Key).and(\"Version\", eq, version));\n    const current = await usersRepo.readSingle(new Where(\"Key\", eq, loaded!.Key));\n    const stale = await usersRepo.update(loaded!, new Where(\"Key\", eq, loaded!.Key).and(\"Version\", eq, version));\n    const removed = await usersRepo.delete(loaded!);\n    const gone = await usersRepo.readSingleById(loaded!.Key);\n    expect(current?.Version).toBe(2);\n    expect(current?.Login).toBe(\"ada-v2\");\n    expect(current?.Active).toBe(true);\n    expect(current?.UserType).toEqual({ Id: member.Id, Name: \"member\" });\n    expect(current?.Roles.map((role) => role.Name).sort()).toEqual([\"admin\", \"editor\", \"owner\"]);\n    const roles: UserRole[] = [];\n    for await (const role of userRolesRepo.read(new Where(\"UserId\", eq, loaded!.Key)))\n      roles.push(role);\n    expect(admin.Id).toBe(1);\n    expect(created.Key).toBe(1);\n    expect(user.Key).toBe(1);\n    expect(grace.Key).toBe(2);\n    expect(member.Id).toBe(2);\n    expect(updated.rowsAffected).toBe(1);\n    expect(stale.rowsAffected).toBe(0);\n    expect(removed.rowsAffected).toBe(1);\n    expect(gone).toBeUndefined();\n    expect(roles).toEqual([]);\n  });"}
{"file":"docs/examples/type-mapping/ReadonlyRepositoryIntegrationTests.UpdatesUsersViewWhenTheVersionMatches.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#UpdatesUsersViewWhenTheVersionMatches","from":208,"to":295,"schema":"user-view-version","raw":"    [Fact]\n    public async Task UpdatesUsersViewWhenTheVersionMatches()\n    {\n        var ds = Datasource.Default;\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"user-view-version\");\n        var casing = new ChangeCasingMapper(Casing.Pascal, Casing.Snake);\n        var usersRepo = new CRUDRepository<User>(connection, new CRUDRepositoryOptions<User>\n        {\n            Ids = [\"Key\"],\n            EntityMapper = casing,\n            PropertyMappings = new DictionaryMapper<string>(new Dictionary<string, string>\n            {\n                [\"Key\"] = \"id\",\n                [\"Login\"] = \"username\",\n                [\"Active\"] = \"is_enabled\",\n                [\"Opened\"] = \"created\",\n                [\"UserType\"] = \"user_type_id\",\n                [\"Version\"] = \"version\",\n            }),\n        });\n        var userTypesRepo = new CRUDRepository<UserType>(connection, new CRUDRepositoryOptions<UserType>\n        {\n            Ids = [\"Id\"],\n            EntityMapper = casing,\n            PropertyMappings = casing,\n        });\n        var userRolesRepo = new CRUDRepository<UserRole>(connection, new CRUDRepositoryOptions<UserRole>\n        {\n            Ids = [],\n            EntityMapper = casing,\n            PropertyMappings = casing,\n        });\n        usersRepo.AddEnriched(new(\"UserType\", \"UserType\", \"Id\"), userTypesRepo);\n        usersRepo.AddEnriched(new(\"Roles\", \"Key\", \"UserId\", Type: EnrichmentPropertyType.List), userRolesRepo);\n        var admin = await userTypesRepo.Create(new UserType { Name = \"admin\" });\n        var user = new User\n        {\n            Login = \"ada\",\n            Active = true,\n            Opened = new DateTime(2020, 1, 1, 0, 0, 0, DateTimeKind.Utc),\n            UserType = admin,\n            Version = 1,\n            Roles = [new UserRole { Name = \"admin\" }, new UserRole { Name = \"editor\" }],\n        };\n        var created = await usersRepo.Create(user);\n        var grace = await usersRepo.Create(new User\n        {\n            Login = \"grace\",\n            Active = true,\n            Opened = new DateTime(2024, 6, 1, 0, 0, 0, DateTimeKind.Utc),\n            UserType = admin,\n            Version = 1,\n            Roles = [new UserRole { Name = \"viewer\" }],\n        });\n        var loaded = await usersRepo.ReadSingle(new Where(\"Key\", eq, user.Key));\n        var version = loaded!.Version;\n        var member = await userTypesRepo.Create(new UserType { Name = \"member\" });\n        loaded.Login = \"ada-v2\";\n        loaded.UserType = member;\n        loaded.Roles.Add(new UserRole { Name = \"owner\" });\n        loaded.Version = version + 1;\n        var updated = await usersRepo.Update(loaded, new Where(\"Key\", eq, loaded.Key).And(\"Version\", eq, version));\n        var current = await usersRepo.ReadSingle(new Where(\"Key\", eq, loaded.Key));\n        var stale = await usersRepo.Update(loaded, new Where(\"Key\", eq, loaded.Key).And(\"Version\", eq, version));\n        var removed = await usersRepo.Delete(loaded);\n        var gone = await usersRepo.ReadSingleById(loaded.Key);\n        Assert.Equal(2L, current!.Version);\n        Assert.Equal(\"ada-v2\", current.Login);\n        Assert.True(current.Active);\n        Assert.Equal(member.Id, current.UserType.Id);\n        Assert.Equal(\"member\", current.UserType.Name);\n        Assert.Equal([\"admin\", \"editor\", \"owner\"], current.Roles.Select(role => role.Name).OrderBy(name => name));\n        var roles = new List<UserRole>();\n        await foreach (var role in userRolesRepo.Read(new Where(\"UserId\", eq, loaded.Key)))\n            roles.Add(role);\n\n        Assert.Equal(1L, admin.Id);\n        Assert.Equal(1L, created.Key);\n        Assert.Equal(1L, user.Key);\n        Assert.Equal(2L, grace.Key);\n        Assert.Equal(2L, member.Id);\n        Assert.Equal(1, updated.RowsAffected);\n        Assert.Equal(0, stale.RowsAffected);\n        Assert.Equal(1, removed.RowsAffected);\n        Assert.Null(gone);\n        Assert.Empty(roles);\n    }"}
{"file":"docs/examples/wrap-query-text-and-an-optional-where/statement_compile.wraps_query_text_and_an_optional_where.rust","test":"rust/datasources/src/tests/statement_compile.rs#wraps_query_text_and_an_optional_where","from":10,"to":22,"raw":"#[test]\nfn wraps_query_text_and_an_optional_where() {\n    let select = SelectStatement::new(SelectStatementOptions::new(\"dual\", &[\"1\"]));\n    let by_id = WhereText::new(\"id = 1\");\n    let with_where = SelectStatement::new(SelectStatementOptions {\n        where_clause: Some(&by_id),\n        ..SelectStatementOptions::new(\"dual\", &[\"1\"])\n    });\n    assert_eq!(stmt_text(&select), \"SELECT 1 FROM dual\");\n    assert!(select.where_clause().is_none());\n    assert!(with_where.where_clause().is_some());\n    assert_eq!(where_sql(&by_id), \"id = 1\");\n}"}
{"file":"docs/examples/wrap-query-text-and-an-optional-where/StatementCompile.test.wraps-query-text-and-an-optional-where.typescript","test":"typescript/datasources/src/statements/StatementCompile.test.ts#wraps-query-text-and-an-optional-where","from":49,"to":57,"raw":"  it(\"wraps query text and an optional where\", () => {\n    const select = new SelectStatement({ table: \"dual\", fields: [\"1\"] });\n    const byId = new WhereText(\"id = 1\");\n    const withWhere = new SelectStatement({ table: \"dual\", fields: [\"1\"], where: byId });\n    expect(DefaultStatementTextRenderer.instance.render(select)).toBe(\"SELECT 1 FROM dual\");\n    expect(select.where).toBeUndefined();\n    expect(withWhere.where).toBe(byId);\n    expect(DefaultStatementTextRenderer.instance.render(byId)).toBe(\"id = 1\");\n  });"}
{"file":"docs/examples/wrap-query-text-and-an-optional-where/StatementCompileTests.WrapsQueryTextAndAnOptionalWhere.csharp","test":"csharp/Datasources.Tests/StatementCompileTests.cs#WrapsQueryTextAndAnOptionalWhere","from":7,"to":17,"raw":"    [Fact]\n    public void WrapsQueryTextAndAnOptionalWhere()\n    {\n        var select = new SelectStatement(new() { Table = \"dual\", Fields = [\"1\"] });\n        var byId = new WhereText(\"id = 1\");\n        var withWhere = new SelectStatement(new() { Table = \"dual\", Fields = [\"1\"], Where = byId });\n        Assert.Equal(\"SELECT 1 FROM dual\", DefaultStatementTextRenderer.Instance.Render(select));\n        Assert.Null(select.Where);\n        Assert.Same(byId, withWhere.Where);\n        Assert.Equal(\"id = 1\", DefaultStatementTextRenderer.Instance.Render(byId));\n    }"}

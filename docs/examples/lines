{"file":"docs/examples/create-read-update-and-delete/ReadonlyRepositoryIntegrationTests.WritesUserFromTheType.csharp","test":"csharp/Providers/Sqlite.Tests/ReadonlyRepositoryIntegrationTests.cs#WritesUserFromTheType","from":624,"to":656,"schema":"user-pascal","raw":"    [Fact]\n    public async Task WritesUserFromTheType()\n    {\n        var ds = Datasource.Default;\n        var connection = await Open(ds);\n        await SchemaSpec.Apply(connection, \"user-pascal\");\n        var casing = new ChangeCasingMapper(Casing.Pascal, Casing.Snake);\n        var usersRepo = ds.CreateRepository<User>(connection, new CRUDRepositoryOptions<User>\n        {\n            PropertyMappings = casing,\n            Ids = [\"Id\"],\n        });\n        var created = await usersRepo.Create(new User { Username = \"ada\", IsEnabled = true });\n        var byId = await usersRepo.ReadSingleById(created.Id);\n        var matches = new List<User>();\n        await foreach (var row in usersRepo.Read(new Where(\"Username\", eq, \"ada\").And(\"IsEnabled\", eq, true)))\n            matches.Add(row);\n        created.Username = \"ada-v2\";\n        var updated = await usersRepo.Update(created);\n        var renamed = await usersRepo.ReadSingleById(created.Id);\n        var removed = await usersRepo.Delete(created);\n        var gone = await usersRepo.ReadSingleById(created.Id);\n\n        Assert.True(created.Id > 0);\n        Assert.Equal(1, updated.RowsAffected);\n        Assert.Equal(1, removed.RowsAffected);\n        Assert.Equal(created.Id, byId!.Id);\n        Assert.Equal(\"ada\", byId.Username);\n        Assert.True(byId.IsEnabled);\n        Assert.Equal(\"ada\", Assert.Single(matches).Username);\n        Assert.Equal(\"ada-v2\", renamed!.Username);\n        Assert.Null(gone);\n    }"}
{"file":"docs/examples/create-using-dynamic-after-register/datasource_plural.creates_using_dynamic_after_register.rust","test":"rust/providers/sqlite/tests/datasource_plural.rs#creates_using_dynamic_after_register","from":60,"to":87,"schema":"user-pascal","raw":"#[tokio::test]\nasync fn creates_using_dynamic_after_register() {\n    let _guard = super::env_lock();\n    let ds = default().unwrap();\n    let connection = open(ds.as_ref()).await;\n    apply_schema(connection.as_ref(), \"user-pascal\")\n        .await\n        .unwrap();\n    register(&ds);\n    let users = ds.as_ref().users();\n    let mut created = Row::new();\n    created.insert(\"Username\".into(), Value::from(\"ada\"));\n    created.insert(\"IsEnabled\".into(), Value::Bool(true));\n    let created = users.create(created).await.unwrap();\n    let loaded: Option<Row> = users.read_single(None, None, None).await.unwrap();\n    let updated: Response = users.update(created.clone(), None).await.unwrap();\n    let deleted: Response = users.delete(created.clone(), None).await.unwrap();\n    assert_eq!(\n        matches!(created.get(\"Id\"), Some(Value::Int(id)) if *id > 0),\n        true\n    );\n    assert_eq!(\n        loaded.as_ref().and_then(|row| row.get(\"Username\")),\n        Some(&Value::from(\"ada\"))\n    );\n    assert_eq!(updated.rows_affected, 1);\n    assert_eq!(deleted.rows_affected, 1);\n}"}

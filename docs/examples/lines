{"file":"docs/examples/commit-or-abort/TransactionTests.CommitOrAbort.csharp","test":"csharp/Datasources.Tests/TransactionTests.cs#CommitOrAbort","from":24,"to":37,"raw":"    [Fact]\n    public async Task CommitOrAbort()\n    {\n        var ds = Datasource.Default;\n        var connection = await ds.CreateConnection();\n        await connection.Open();\n        var txn = await connection.StartTransaction();\n        var saved = true;\n        if (saved)\n            await txn.Commit();\n        else\n            await txn.Abort();\n        Assert.Equal(IsolationLevel.Serializable, txn.Isolation);\n    }"}

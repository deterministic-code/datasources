{"file":"docs/examples/cascade-delete/enriched.deep_delete_cascades_children_then_parent.rust","test":"rust/datasources/tests/enriched.rs#deep_delete_cascades_children_then_parent","from":667,"to":727,"raw":"#[tokio::test]\nasync fn deep_delete_cascades_children_then_parent() {\n    let connection = setup(&mut []).await;\n    let parents = crud(connection.clone(), \"Parent\");\n    let mut children_repo = crud(connection.clone(), \"Child\");\n    let notes = Arc::new(crud(connection, \"Note\"));\n    let parent = parents\n        .create(&mut record(&[(\"label\", Value::from(\"p\"))]))\n        .await\n        .unwrap();\n    assert!(num(&parent, \"id\") > 0);\n    let parent_id = parent.get(\"id\").unwrap().clone();\n    let child = children_repo\n        .create(&mut record(&[\n            (\"parent_id\", parent_id.clone()),\n            (\"label\", Value::from(\"a\")),\n        ]))\n        .await\n        .unwrap();\n    assert!(num(&child, \"id\") > 0);\n    let child_id = child.get(\"id\").unwrap().clone();\n    let note = notes\n        .create(&mut record(&[\n            (\"child_id\", child_id),\n            (\"text\", Value::from(\"n\")),\n        ]))\n        .await\n        .unwrap();\n    assert!(num(&note, \"id\") > 0);\n    let other = notes\n        .create(&mut record(&[\n            (\"text\", Value::from(\"other\")),\n            (\"label\", Value::from(\"keep\")),\n        ]))\n        .await\n        .unwrap();\n    assert!(num(&other, \"id\") > 0);\n    children_repo.add_enriched(\n        Enrichment::new(\"notes\", \"id\", \"child_id\", None, true),\n        notes.clone(),\n        None,\n    );\n    let children = Arc::new(children_repo);\n    let mut parents = parents;\n    parents.add_enriched(\n        Enrichment::new(\"children\", \"id\", \"parent_id\", None, true),\n        children.clone(),\n        None,\n    );\n    let removed = parents\n        .delete(&record(&[(\"id\", parent_id)]), None)\n        .await\n        .unwrap();\n    assert_eq!(removed.rows_affected, 1);\n    assert!(parents.read(None, None).await.unwrap().is_empty());\n    assert!(children.read(None, None).await.unwrap().is_empty());\n    assert_eq!(\n        notes.read(None, None).await.unwrap()[0][\"text\"],\n        Value::from(\"other\")\n    );\n}"}
{"file":"docs/examples/cascade-delete/EnrichedCRUDRepository.test.delete-cascades-children-then-parent.typescript","test":"typescript/datasources/src/EnrichedCRUDRepository.test.ts#delete-cascades-children-then-parent","from":227,"to":247,"raw":"  it(\"delete cascades children then parent\", async () => {\n    const connection = await setup();\n    const parentsRepo = new CRUDRepository(Parent, connection);\n    const childrenRepo = new CRUDRepository(Child, connection);\n    const notesRepo = new CRUDRepository(Note, connection);\n    const parent = await parentsRepo.create(new Parent());\n    expect(parent.id).toBeGreaterThan(0);\n    const child = await childrenRepo.create(Object.assign(new Child(), { parent_id: parent.id, label: \"a\" }));\n    expect(child.id).toBeGreaterThan(0);\n    const note = await notesRepo.create(Object.assign(new Note(), { child_id: child.id, text: \"n\" }));\n    expect(note.id).toBeGreaterThan(0);\n    const other = await notesRepo.create(Object.assign(new Note(), { text: \"other\" }));\n    expect(other.id).toBeGreaterThan(0);\n    childrenRepo.addEnriched({ into: \"notes\", from: \"id\", by: \"child_id\", many: true }, notesRepo);\n    parentsRepo.addEnriched({ into: \"children\", from: \"id\", by: \"parent_id\", many: true }, childrenRepo);\n    const removed = await parentsRepo.delete(Object.assign(new Parent(), { id: parent.id }));\n    expect(removed.rowsAffected).toBe(1);\n    expect(await collectAsync(parentsRepo.read())).toEqual([]);\n    expect(await collectAsync(childrenRepo.read())).toEqual([]);\n    expect((await notesRepo.readSingle())?.text).toBe(\"other\");\n  });"}
{"file":"docs/examples/cascade-delete/EnrichedCRUDRepositoryTests.DeleteCascadesChildrenThenParent.csharp","test":"csharp/Datasources.Tests/EnrichedCRUDRepositoryTests.cs#DeleteCascadesChildrenThenParent","from":194,"to":216,"raw":"    [Fact]\n    public async Task DeleteCascadesChildrenThenParent()\n    {\n        var connection = await Setup();\n        var parentsRepo = new CRUDRepository<Parent>(connection);\n        var childrenRepo = new CRUDRepository<Child>(connection);\n        var notesRepo = new CRUDRepository<Note>(connection);\n        var parent = await parentsRepo.Create(new Parent());\n        Assert.True(parent.id > 0);\n        var child = await childrenRepo.Create(new Child { parent_id = parent.id, label = \"a\" });\n        Assert.True(child.id > 0);\n        var note = await notesRepo.Create(new Note { child_id = child.id, text = \"n\" });\n        Assert.True(note.id > 0);\n        var other = await notesRepo.Create(new Note { text = \"other\" });\n        Assert.True(other.id > 0);\n        childrenRepo.AddEnriched(new(\"notes\", \"id\", \"child_id\", Many: true), notesRepo);\n        parentsRepo.AddEnriched(new(\"children\", \"id\", \"parent_id\", Many: true), childrenRepo);\n        var removed = await parentsRepo.Delete(new Parent { id = parent.id });\n        Assert.Equal(1, removed.RowsAffected);\n        Assert.Empty(await parentsRepo.Read().ToListAsync());\n        Assert.Empty(await childrenRepo.Read().ToListAsync());\n        Assert.Equal(\"other\", Assert.Single(await notesRepo.Read().ToListAsync()).text);\n    }"}

    const converter = new RowTypeConverter({}, { flag: new OnlyOne() });
    const dest = converter.convert({ flag: 1, name: "a" });
    expect(dest.flag).toBe(true);
    expect(dest.name).toBe("a");
    expect(converter.reverseConvert(dest).flag).toBe(true);
  });

    [Fact]
    public void RegisterAndCreate()
    {
        DatasourceFactory.Register("memory", new MemoryProvider());
        var ds = DatasourceFactory.Create(new Dictionary<string, string?> { ["provider"] = "memory" });
        Assert.Equal("memory", ds.Provider);
    }

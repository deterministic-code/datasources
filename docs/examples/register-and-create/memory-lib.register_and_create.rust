    #[test]
    fn register_and_create() {
        reset();
        register("memory", Arc::new(MemoryProvider));
        let ds = create(Some(&HashMap::from([("provider".into(), "memory".into())]))).unwrap();
        assert_eq!(ds.provider(), "memory");

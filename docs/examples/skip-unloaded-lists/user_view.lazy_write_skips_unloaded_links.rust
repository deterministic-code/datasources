let (mut users, seeded) = open(Some(Arc::new(LazyWriteEnrichmentStrategy::new(
    None, None, None, false,
))))
.await;
link(&mut users, &seeded);
let creating = record(&[
    ("username", Value::from("ada")),
    ("is_enabled", Value::Bool(true)),
    ("user_type_id", seeded.admin_type.get("id").unwrap().clone()),
    ("groups", encode_rows(&[seeded.engineering.clone()])),
]);
let created = users.create(creating).await.unwrap();
let created_role_links = seeded.user_roles.read(&()).try_collect::<Vec<_>>().await.unwrap();
let created_group_links = seeded.user_groups.read(&()).try_collect::<Vec<_>>().await.unwrap();
let next = record(&[
    ("id", created.get("id").unwrap().clone()),
    ("username", Value::from("ada")),
    ("is_enabled", Value::Bool(false)),
    ("user_type_id", seeded.admin_type.get("id").unwrap().clone()),
]);
let skipped = users.update(next).await.unwrap();
let after_skip = users
    .read_single_by_id(created.get("id").unwrap())
    .await
    .unwrap()
    .unwrap();
let skipped_role_links = seeded.user_roles.read(&()).try_collect::<Vec<_>>().await.unwrap();
let skipped_group_links = seeded.user_groups.read(&()).try_collect::<Vec<_>>().await.unwrap();
let linked_row = record(&[
    ("id", created.get("id").unwrap().clone()),
    ("username", Value::from("ada")),
    ("is_enabled", Value::Bool(false)),
    ("user_type_id", seeded.admin_type.get("id").unwrap().clone()),
    ("roles", encode_rows(&[seeded.editor_role.clone()])),
]);
let linked = users.update(linked_row).await.unwrap();
let linked_role_links = seeded.user_roles.read(&()).try_collect::<Vec<_>>().await.unwrap();
let linked_group_links = seeded.user_groups.read(&()).try_collect::<Vec<_>>().await.unwrap();
let removed = users
    .delete(record(&[("id", created.get("id").unwrap().clone())]))
    .await
    .unwrap();

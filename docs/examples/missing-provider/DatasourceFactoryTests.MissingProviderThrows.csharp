    [Fact]
    public void MissingProviderThrows()
    {
        var error = Assert.Throws<ProviderNotInstalledException>(() =>
            DatasourceFactory.Create(new Dictionary<string, string?> { ["provider"] = "missing" }));
        Assert.Equal("missing", error.Provider);
    }

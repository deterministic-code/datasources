use datasources::{Parameter, ReturnStatement};
command
    .execute(
        "CREATE FUNCTION add_one(n INT) RETURNS INT LANGUAGE sql AS $$ SELECT n + 1 $$",
        None,
    )
    .await
    .unwrap();
let parameters = [Parameter::new("n", 4_i64)];
let ret = command
    .execute_statement(
        &ReturnStatement::new("add_one", &parameters),
        Some(&parameters),
    )
    .await
    .unwrap();

test: typescript/datasources/src/mappers/FlatToNestedMapper.test.ts#maps-join-rows-to-a-nested-contact
lines: 90-155

  it("maps join rows to a nested contact", () => {
    const mapper = new FlatToNestedMapper<Contact>({
      key: "id",
      fields: {
        id: "id",
        first_name: "first_name",
        last_name: "last_name",
        email: "email",
        contact_source_name: "contact_source_name",
        contact_type_name: "contact_type_name",
        addresses: {
          key: "address_id",
          fields: {
            id: "address_id",
            line1: "address_line1",
            city: "address_city",
            address_type_name: "address_type_name",
          },
        },
        phones: {
          key: "phone_id",
          fields: {
            id: "phone_id",
            number: "phone_number",
            phone_type_name: "phone_type_name",
          },
        },
      },
    });
    const adaHome: Cells = {
      id: 7,
      first_name: "Ada",
      last_name: "Lovelace",
      email: "ada@ex.com",
      contact_source_name: "Web",
      contact_type_name: "Person",
      address_id: 101,
      address_line1: "10 Downing St",
      address_city: "London",
      address_type_name: "Home",
      phone_id: 201,
      phone_number: "+44",
      phone_type_name: "Mobile",
    };
    const adaWork = {
      ...adaHome,
      address_id: 102,
      address_line1: "1 Parliament Sq",
    };
    const nested = mapper.map([adaHome, adaWork]);
    const flat = mapper.reverseMap(nested);
    expect(nested[0]).toEqual({
      id: 7,
      first_name: "Ada",
      last_name: "Lovelace",
      email: "ada@ex.com",
      contact_source_name: "Web",
      contact_type_name: "Person",
      addresses: [
        { id: 101, line1: "10 Downing St", city: "London", address_type_name: "Home" },
        { id: 102, line1: "1 Parliament Sq", city: "London", address_type_name: "Home" },
      ],
      phones: [{ id: 201, number: "+44", phone_type_name: "Mobile" }],
    });
    expect(flat).toEqual([adaHome, adaWork]);
  });

let (repo, command) = family(
    Arc::new(BatchCommandIBulkWriteStrategy::new()),
    Arc::new(BatchCommandIBulkWriteStrategy::new()),
);
repo.create_bulk(&mut [
    row(&[
        ("id", Value::Int(1)),
        ("label", Value::from("a")),
        (
            "children",
            crate::default_write_enrichment_strategy::encode_rows(&[row(&[
                ("id", Value::Int(10)),
                ("label", Value::from("x")),
            ])]),
        ),
    ]),
    row(&[
        ("id", Value::Int(2)),
        ("label", Value::from("b")),
        (
            "children",
            crate::default_write_enrichment_strategy::encode_rows(&[row(&[
                ("id", Value::Int(11)),
                ("label", Value::from("y")),
            ])]),
        ),
    ]),
])
.await
.unwrap();
let logs = command.execute_logs.lock().unwrap();

let texts = Arc::new(Mutex::new(Vec::new()));
let connection: Arc<dyn Connection> = Arc::new(RecordingConnection::new(
    setup(&mut []).await,
    Arc::clone(&texts),
));
let types = Arc::new(mapped_crud(Arc::clone(&connection), "UserType"));
let mut parents = mapped_crud(connection, "Parent");
types
    .create(record(&[("Name", Value::from("work"))]))
    .await
    .unwrap();
parents.add_enriched(
    Enrichment::new("TypeName", "Type", "Id", Some("Name".into()), datasources::EnrichmentPropertyType::Object),
    types,
    None,
);
let created = parents
    .create(record(&[("TypeName", Value::from("work"))]))
    .await
    .unwrap();
assert!(num(&created, "Id") > 0);
